{
   "builds": {
      "web": {
         "default": true
      },
      "native": {
         "packager": "cordova",
         "cordova": {
            "config": {
               "id": "kr.co.bnksys",
               "name": "BNK",
               "platforms": "android"
            }
         }
      }
   },
   "name": "BNK",
   "namespace": "BNK",
   "version": "1.0.0.0",
   "framework": "ext",
   "toolkit": "modern",
   "theme": "theme-material-3fa3dfe7-bcda-45e6-8482-18fb99207cc7",
   "requires": [
      "calendar",
      "font-awesome",
      "ux",
      "sencha-charts",
      "ext-locale",
      "google",
      "ext-ux"
   ],
   "locale": "ko",
   "indexHtmlPath": "index.html",
   "classpath": "${app.dir}/app,${app.dir}/app/override/grid/,${app.dir}/app/override/field/",
   "overrides": [
      "overrides",
      "${app.dir}/overrides",
      "${app.dir}/locale/${app.locale}"
   ],
   "fashion": {
      "missingParameters": "error",
      "inliner": {
         "enable": false
      }
   },
   "sass": {
      "namespace": "BNK",
      "generated": {
         "var": "sass/save.scss",
         "src": "sass/save"
      },
      "etc": [
         "sass/etc/all.scss"
      ],
      "var": [
         "sass/var/all.scss",
         "sass/var"
      ],
      "src": [
         "sass/src"
      ]
   },
   "js": [
      {
         "path": "${framework.dir}/build/ext-modern-all-debug.js"
      },
      {
         "path": "Properties.js",
         "includeInBundle": true
      },
      {
         "path": "FieldUtils.js",
         "includeInBundle": true
      },
      {
         "path": "StoreUtils.js",
         "includeInBundle": true
      },
      {
         "path": "ReportUtils.js",
         "includeInBundle": true
      },
      {
         "path": "CodeUtils.js",
         "includeInBundle": true
      },
      {
         "path": "Native.js",
         "includeInBundle": true
      },
      {
         "path": "app/override/grid/Grid.js",
         "includeInBundle": true
      },
      {
         "path": "Messages.js",
         "includeInBundle": true
      },
      {
         "path": "DateUtils.js",
         "includeInBundle": true
      },
      {
         "path": "ext-locale-ko.js",
         "includeInBundle": true
      },
      {
         "path": "FormatUtils.js",
         "includeInBundle": true
      },
      {
         "path": "WebUtils.js",
         "includeInBundle": true
      },
      {
         "path": "ApprovalBoxSvc.js",
         "includeInBundle": true
      },
      {
         "path": "SecurityUtils.js",
         "includeInBundle": true
      },
      {
         "path": "Property.js",
         "includeInBundle": true
      },
      {
         "path": "app/override/field/ComboBox.js",
         "includeInBundle": true
      },
      {
         "path": "JsonUtils.js",
         "includeInBundle": true
      },
      {
         "path": "Constants.js",
         "includeInBundle": true
      },
      {
         "path": "ComboboxUtils.js",
         "includeInBundle": true
      },
      {
         "path": "resources/lib/jsencrypt/3.0.0.rc-1/jsencrypt.min.js"
      },
      {
         "path": "app.js",
         "bundle": true
      }
   ],
   "css": [
      {
         "path": "${build.out.css.path}",
         "bundle": true,
         "exclude": [
            "fashion"
         ]
      }
   ],
   "loader": {
      "cache": false,
      "cacheParam": "_dc"
   },
   "production": {
      "output": {
         "appCache": {
            "enable": true,
            "path": "cache.appcache"
         }
      },
      "loader": {
         "cache": "${build.timestamp}"
      },
      "cache": {
         "enable": true
      },
      "compressor": {
         "type": "yui"
      }
   },
   "testing": {},
   "development": {
      "watch": {
         "delay": 250
      }
   },
   "bootstrap": {
      "base": "${app.dir}",
      "microloader": "bootstrap.js",
      "css": "bootstrap.css"
   },
   "output": {
      "base": "${workspace.build.dir}/${build.environment}/${app.name}",
      "appCache": {
         "enable": false
      }
   },
   "cache": {
      "enable": false,
      "deltas": true
   },
   "appCache": {
      "cache": [
         "index.html"
      ],
      "network": [
         "*"
      ],
      "fallback": []
   },
   "resources": [
      {
         "path": "resources",
         "output": "shared"
      }
   ],
   "archivePath": "archive",
   "slicer": null,
   "ignore": [
      "(^|/)CVS(/?$|/.*?$)"
   ],
   "id": "27c5a213-bcd5-4abe-82bc-f0bd54e58c48"
}