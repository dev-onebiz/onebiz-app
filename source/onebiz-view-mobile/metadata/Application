                    "// 요청전 Ajax Interceptor",
                    "Ext.Ajax.on('beforerequest', function(conn, options) {",
                    "",
                    "    if(!options.headers.hasOwnProperty('enableMask') || options.headers.enableMask){",
                    "        Ext.Viewport.setMasked({",
                    "            xtype: 'loadmask',",
