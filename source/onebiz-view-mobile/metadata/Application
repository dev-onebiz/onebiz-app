                    "        'cmgrpId'          : principal && principal.hasOwnProperty('comCmmCmgrpId') ? principal.comCmmCmgrpId : null,",
                    "        'sysId'            : principal && principal.hasOwnProperty('comCmmSystemId') ? principal.comCmmSystemId : null,",
                    "        'serviceId'        : options.headers.serviceId || null,",
                    "        'viewId'           : options.headers.viewId || null",
                    "    };",
                    "",
                    "    // iOS인 경우 User-Agent 헤더 추가",
                    "    if (customUserAgent) {",
                    "        options.headers['User-Agent'] = customUserAgent;",
                    "    }",
                    "",
                    "    options.url = Property.API_URL;",
                    "    if ('F' === Property.PROFILE) {",
                    "        options.url = Ext.String.format('./testdata/{0}.json', options.headers.serviceId);",
                    "    } else if (options.isUpload) {",
                    "        options.url = Property.BASE_URL + Property.FILE_URL;",
                    "        options.params = options.headers;",
                    "    }",
                    "",
                    "    // PROXY 페이징정보 보정 page: 페이지, size: 한페이지에 보여질 내용건 수",
                    "    if (options.hasOwnProperty('params')) {",
                    "        var page = null,",
                    "            size = null;",
                    "",
                    "        if (options.params.hasOwnProperty('limit')) size = options.params.limit; delete options.params.limit; // default limit 10",
                    "        if (options.params.hasOwnProperty('start'))                              delete options.params.start;",
                    "        if (options.params.hasOwnProperty('page'))  page = options.params.page;",
                    "",
                    "        if (!size) {",
                    "            options.params.size = Property.DEFAULT_PAGE_SIZE;",
                    "        }",
                    "        else {",
                    "            options.params.size = size;",
                    "        }",
                    "",
                    "        if (!page) {",
                    "            options.params.page = 1;",
                    "        }",
                    "    }",
                    "",
                    "    if (Property.IS_DEBUG) {",
                    "        var params = options.jsonData || options.params;",
                    "        console.log('>>> ', options.method, options.headers.serviceId, params);",
                    "        if (customUserAgent) {",
                    "            console.log('>>> User-Agent:', customUserAgent);",
                    "        }",
                    "    }",
                    "}.bind(this)); // 중요: this 바인딩 추가",
                    "",
                    "// 요청완료 - 새로고침/조회 후 이미지 재처리 추가",
                    "Ext.Ajax.on('requestcomplete', function(conn, response, options) {",
                    "    Ext.Viewport.setMasked(false);",
                    "    if (Property.IS_DEBUG) {",
                    "        if (response) {",
                    "            console.log('<<< ', response);",
                    "        }",
                    "    }",
                    "",
                    "    // 응답값에서 토큰갱신",
                    "    if (options.isUpload) {",
                    "        // 파일처리",
                    "    } else if (response && response.getResponseHeader('Authorization')) {",
                    "        localStorage.setItem(Property.JWT_TOKEN_NAME, response.getResponseHeader('Authorization').replace('Bearer ', ''));",
                    "    }",
                    "",
                    "    // 새로고침/조회 후 이미지 재처리",
                    "    var me = this;",
                    "    setTimeout(function() {",
                    "        if (me.isIOSPlatform()) {",
                    "            me.reprocessImagesAfterRefresh();",
                    "        }",
                    "    }, 100);",
                    "",
                    "    var status = response.status;",
                    "    switch (status) {",
                    "        case 0:",
                    "            Ext.Msg.alert(Property.SYSTEM_NAME, '서버와 연결이 원활하지 않습니다.<br />인터넷 연결 상태를 확인하고 다시 시도해주시길 바랍니다.');",
                    "            break;",
                    "        default :",
                    "            break;",
                    "    }",
                    "}.bind(this));",
                    "",
                    "// 요청오류",
                    "Ext.Ajax.on('requestexception', function (conn, response, options) {",
                    "    Ext.Viewport.setMasked(false);",
                    "",
                    "    // 응답값에서 토큰갱신",
                    "    if (options.isUpload) {",
                    "        // 파일처리",
                    "    } else if (response && response.getResponseHeader('Authorization')) {",
                    "        localStorage.setItem(Property.JWT_TOKEN_NAME, response.getResponseHeader('Authorization').replace('Bearer ', ''));",
                    "    }",
