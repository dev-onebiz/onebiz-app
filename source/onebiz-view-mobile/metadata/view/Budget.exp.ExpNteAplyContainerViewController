            "userConfig": {
                "fn": "addForm",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    items = refs.items,",
                    "    vmItems = vm.get('records'),",
                    "    command = vm.get('command'),",
                    "    aprHistId = vm.get('aprHistId');",
                    "",
                    "if(vmItems.length > 0){",
                    "    if(vmItems && !vmItems[0].isAply){",
                    "        vm.set('aplDt', DateUtils.encodeDate(new Date(), 'Y-m-d'));",
                    "    }",
                    "}",
                    "",
                    "// 결재문서 초기화 설정",
                    "ApprovalBoxSvc.setup({",
                    "    command   : command,",
                    "    viewModel : vm,",
                    "    aprHistId : aprHistId,",
                    "    edocCd    : 'ExpNteAply71',",
                    "    scope     : me",
                    "});",
                    "",
                    "var item = null;",
                    "for(var i in vmItems){",
                    "    item = Ext.create('ExpNteAplyItems', { // alternateClassName : ITEMs // userClassName과 다름",
                    "        data : vmItems[i],",
                    "    });",
                    "    items.add(item);",
                    "",
                    "}",
                    "",
                    "// ExpNteDoc02M (지출결의서 현황)에서 넘어온 경우 Hidden",
                    "if(vm.get('doc')){",
                    "",
                    "    var innerItems = refs.items.innerItems;",
                    "    for(var i in innerItems){",
                    "        var innerRefs = innerItems[i].getReferences();",
                    "        innerRefs.btnFindUser.setHidden(true);",
                    "        refs.items.innerItems[i].getReferences().btnSales.setHidden(true);",
                    "",
                    "        refs.items.innerItems[i].getReferences().aplRscn.setReadOnly(true); // 적요 readOnly",
                    "",
                    "        refs.items.innerItems[i].getReferences().btnTakePic.setHidden(true);",
                    "        refs.items.innerItems[i].getReferences().btnOpenGallery.setHidden(true);",
                    "        refs.items.innerItems[i].getReferences().btnDeletePicture.setHidden(true);",
                    "",
                    "        // 웹에서 사진 추가하는 버튼",
                    "        refs.items.innerItems[i].getReferences().webOnly.setHidden(true);",
                    "",
                    "        if(vm.get('etcRcpt')){",
                    "            innerRefs.cdno.setHidden(true);",
                    "            innerRefs.canYn.setHidden(true);",
                    "            innerRefs.mcAddr.setHidden(true);",
                    "        }",
                    "",
                    "        // 회의록에서 사용하는 화면 분류",
                    "        refs.items.innerItems[i].getViewModel().set('conferenceView', true);",
                    "",
                    "    }",
                    "}",
                    "",
                    "// ExpNteAply02M (법인카드 작성)에서 넘어온 경우 Hidden",
                    "if(vm.get('aply02')){",
                    "",
                    "    for(var i in refs.items.innerItems){",
                    "        refs.items.innerItems[i].getReferences().btnSales.setHidden(true);",
                    "    }",
                    "",
                    "}",
                    "",
                    "// ExpNteAply71M (법인카드 결재)에서 넘어온 경우 Hidden",
                    "if(vm.get('aply71')){",
                    "    for(var i in refs.items.innerItems){",
                    "        refs.items.innerItems[i].getReferences().btnFindUser.setHidden(true);",
                    "",
                    "        refs.items.innerItems[i].getReferences().aplRscn.setReadOnly(true); // 적요 readOnly",
                    "",
                    "        refs.items.innerItems[i].getReferences().btnTakePic.setHidden(true);",
                    "        refs.items.innerItems[i].getReferences().btnOpenGallery.setHidden(true);",
                    "        refs.items.innerItems[i].getReferences().btnDeletePicture.setHidden(true);",
                    "",
                    "        // 웹에서 사진 추가하는 버튼",
                    "        refs.items.innerItems[i].getReferences().webOnly.setHidden(true);",
                    "",
                    "        // 회의록에서 사용하는 화면 분류",
                    "        refs.items.innerItems[i].getViewModel().set('conferenceView', true);",
                    "",
                    "    }",
                    "}",
                    "",
                    "",
                    "",
                    ""
                ]
            },
            "configAlternates": {
                "fn": "string",
                "implHandler": "code"
