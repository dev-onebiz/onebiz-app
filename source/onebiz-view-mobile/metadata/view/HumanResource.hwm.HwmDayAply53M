                "fn": "onGoogleMapPainted",
                "implHandler": [
                    "var me = this,",
                    "    refs = me.getReferences(),",
                    "    googleMapPanel = refs.googleMapPanel;",
                    "",
                    "// 인자1. 패널id",
                    "Native.newInitMap(googleMapPanel.id);",
                    "",
                    "// geolocation api 지원여부 확인 및 GPS 정보 조회",
                    "try{",
                    "    if('geolocation' in navigator){",
                    "        // GPS 정보 검색 & 각 근무지별과의 거리 표시",
                    "        me.getGPS();",
                    "    }",
                    "    else{",
                    "        refs.nowLocation.setHtml('not support GPS in this browser');",
                    "    }",
                    "}",
                    "catch(err){",
                    "    console.log(err);",
                    "    refs.nowLocation.setHtml(err);",
                    "}"
                ],
