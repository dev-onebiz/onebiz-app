                                "fn": "renderer",
                                "implHandler": [
                                    "var dtDataTemp = record.data.aplOutDt.replace(/-/g,\"\");",
                                    "",
                                    "var dateMMdd = dtDataTemp.substr(4,2) + '월 ' +dtDataTemp.substr(6,2) + '일';",
                                    "var dateYyMMdd =dtDataTemp.substr(0,4) + '-' + dtDataTemp.substr(4,2) + '-' +dtDataTemp.substr(6,2);",
                                    "var aplDvcdNm = record.data.aplDvcdNm;",
                                    "var aplDvcd = record.data.aplDvcd;",
                                    "",
                                    "aplDvcdNm = aplDvcd == '02' ? \"<font color= 'red'>\" +aplDvcdNm+ \"</font>\":aplDvcdNm;",
                                    "",
                                    "var result = '<div><span style=\"font-size:15px;font-weight:bold;width:100%;overflow: hidden;white-space:nowrap;text-overflow:ellipsis;display:inline-block;\">'+dateMMdd+' 외근 '+aplDvcdNm+'</span></div>';",
                                    "",
                                    "var AplOutStrdt = record.data.aplOutStrdt;",
                                    "var AplOutEdt = record.data.aplOutEdt;",
                                    "var AplOutStrtm = record.data.aplOutStrtm;",
                                    "var AplOutEdtm = record.data.aplOutEdtm;",
                                    "",
                                    "",
                                    "if(AplOutStrdt != AplOutEdt){",
                                    "    result += '<div style=\"font-size : 10px\">'+AplOutStrdt+' '+AplOutStrtm+' ~ '+AplOutEdt + ' '+AplOutEdtm+'</div>';",
                                    "}else{",
                                    "    result += '<div>'+AplOutStrdt+' | '+AplOutStrtm+'~'+AplOutEdtm+'</div>';",
                                    "}",
                                    "",
                                    "",
                                    "",
                                    "",
                                    "cell.setStyle('padding:0px;');",
                                    "return result;",
                                    ""
                                ]
                            },
