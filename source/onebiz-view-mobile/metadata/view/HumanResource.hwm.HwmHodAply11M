                                "fn": "renderer",
                                "implHandler": [
                                    "var dtDataTemp = record.data.aplHodDt.replace(/-/g,\"\");",
                                    "",
                                    "var dateMMdd = dtDataTemp.substr(4,2) + '월 ' +dtDataTemp.substr(6,2) + '일';",
                                    "var dateYyMMdd =dtDataTemp.substr(0,4) + '-' + dtDataTemp.substr(4,2) + '-' +dtDataTemp.substr(6,2);",
                                    "var aplDvcdNm = record.data.aplDvcdNm;",
                                    "var aplDvcd = record.data.aplDvcd;",
                                    "",
                                    "aplDvcdNm = aplDvcd == '02' ? \"<font color= 'red'>\" +aplDvcdNm+ \"</font>\":aplDvcdNm;",
                                    "",
                                    "var result = '<div><span style=\"font-size:15px;font-weight:bold;width:100%;overflow: hidden;white-space:nowrap;text-overflow:ellipsis;display:inline-block;\">'+dateMMdd+' 휴일근무 '+aplDvcdNm+'</span></div>';",
                                    "",
                                    "var hodStrdt = record.data.hodStrdt;",
                                    "var hodEdt = record.data.hodEdt;",
                                    "var hodStrtm = record.data.hodStrtm;",
                                    "var hodEdtm = record.data.hodEdtm;",
                                    "",
                                    "",
                                    "if(hodStrdt != hodEdt){",
                                    "",
                                    "\tresult += '<div style=\"font-size : 10px\">'+hodStrdt+' '+hodStrtm+' ~ '+hodEdt + ' '+hodEdtm+'</div>';",
                                    "}else{",
                                    "\tresult += '<div>'+hodStrdt+' | '+hodStrtm+'~'+hodEdtm+'</div>';",
                                    "}",
                                    "",
                                    "",
                                    "",
                                    "cell.setStyle('padding:0px;');",
                                    "return result;",
                                    ""
                                ]
                            },
