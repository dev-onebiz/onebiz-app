                                                                "designer|commentHeader": [
                                                                    "근무확인 버튼 Event"
                                                                ],
                                                                "fn": "onCheckTap",
                                                                "implHandler": [
                                                                    "var me = this,",
                                                                    "    vm = me.getViewModel(),",
                                                                    "    viewId = me.getViewId(),",
                                                                    "    values = {",
                                                                    "        hrHrpmEmpId: SecurityUtils.getPrincipal().hrHrpmEmpId,",
                                                                    "        stcd : Constants.stcd.NORMAL,",
                                                                    "        crtDt : DateUtils.getDate(new Date()),",
                                                                    "        wrkDtStrdt : DateUtils.getDate(DateUtils.getFirstDateOfMonth(new Date())),",
                                                                    "        wrkDtEdt : DateUtils.getDate(DateUtils.getLastDateOfMonth(new Date())),",
                                                                    "        needWrkDtAfterToday : true,",
                                                                    "    };",
                                                                    "",
                                                                    "me.setLockCheckBtn(true);",
                                                                    "",
                                                                    "//근무지 정보 확인",
                                                                    "Ext.Ajax.request({",
                                                                    "    headers: {",
                                                                    "        serviceId: 'HwmWplSvc.findAllHwmWplInfo',",
                                                                    "        viewId: viewId,",
                                                                    "        scope: me,",
                                                                    "    },",
                                                                    "    jsonData: values,",
                                                                    "    success: function(res) {",
                                                                    "        var result = JSON.parse(res.responseText).page;",
                                                                    "        var msg = \"\";",
                                                                    "",
                                                                    "        if(!Ext.isEmpty(result) && (result.length != 1 || result[0].hrWrkmWkplcId != Constants.wkplcId.EMPTY_WKPLC)){ //근무지있음",
                                                                    "            vm.set('wkplcList', result);",
                                                                    "",
                                                                    "            // 근무일기준 근무지만 필터링",
                                                                    "            var oldGpsVal = vm.get('workGpsVal'),",
                                                                    "                newGpsVal = [];",
                                                                    "",
                                                                    "            for (var gpsVal in oldGpsVal) {",
                                                                    "                for (var wkplc in result) {",
                                                                    "                    if (result[wkplc].hrWrkmWkplcId == oldGpsVal[gpsVal].hrWrkmWkplcId) {",
                                                                    "                        newGpsVal.push(oldGpsVal[gpsVal]);",
                                                                    "                        break;",
                                                                    "                    }",
                                                                    "                }",
                                                                    "            }",
                                                                    "            vm.set('workGpsVal', newGpsVal);",
                                                                    "",
                                                                    "            Ext.Msg.show({",
                                                                    "                message: '지금 근무확인 처리 하시겠습니까?<br>',",
                                                                    "                title: '근무확인',",
                                                                    "                buttons : {",
                                                                    "                    yes : {itemId : Ext.MessageBox.YES, text : '확인'},",
                                                                    "                    no : {itemId : Ext.MessageBox.NO, text : '취소'},",
                                                                    "                },",
                                                                    "                fn: function(btn){",
                                                                    "                    if(btn === 'yes'){",
                                                                    "                        me.getGPS('check');",
                                                                    "                    }",
                                                                    "                    else{",
                                                                    "                        me.setLockCheckBtn(false);",
                                                                    "                    }",
                                                                    "                }",
                                                                    "            });",
                                                                    "",
                                                                    "        }",
                                                                    "",
                                                                    "        else { //근무지없음 :: result값이 없거나, 조회된 근무지 정보가 근무지없음 밖에 없는 경우.",
                                                                    "",
                                                                    "            msg += \"<b>근무지 : 근무지 없음</b><br>\";",
                                                                    "            msg += \"<b>기간 : -</b><br><br>\";",
                                                                    "            msg += \"<b style='color:red'>근무지 정보가 다를 경우, </b><br>\";",
                                                                    "            msg += \"<b style='color:red'>근무확인이 안될수가 있습니다.</b><br>\";",
                                                                    "            msg += \"정확한 인력현황을 위하여 <br>\";",
                                                                    "            msg += \"근무지 정보를 최신화 바랍니다.<br>\";",
                                                                    "",
                                                                    "            Ext.Msg.show({",
                                                                    "                message: msg,",
                                                                    "                title: \"근무지 정보 알림\",",
                                                                    "                buttons : {",
                                                                    "                    yes : {itemId : Ext.MessageBox.YES, text : '변경신청'},",
                                                                    "                },",
                                                                    "                fn: function(btn){",
                                                                    "                    if(btn === 'yes'){",
                                                                    "                        var naviView = me.getView().up('navigationview');",
                                                                    "                        me.PUSH_VIEW(naviView, {",
                                                                    "                            menuId  : 'HwmWplAply02M',",
                                                                    "                            title   : '근무지변경 신청',",
                                                                    "                            parentView : me.getView(),",
                                                                    "                            isSubView : true,",
                                                                    "                            records : []",
                                                                    "                        });",
                                                                    "                    }",
                                                                    "                }",
                                                                    "            });",
                                                                    "",
                                                                    "            me.setLockCheckBtn(false);",
                                                                    "        }",
                                                                    "",
                                                                    "    }",
                                                                    "});"
