                                                        "designer|commentHeader": [
                                                            "위치 설정 화면으로 이동하는 버튼 Event"
                                                        ],
                                                        "fn": "onLocationConfTap",
                                                        "implHandler": [
                                                            "var me = this,",
                                                            "    vm = me.getViewModel(),",
                                                            "    refs = me.getReferences();",
                                                            "",
                                                            "if (Property.PROFILE != 'L' && Ext.Object.isEmpty(navigator.geolocation)) {",
                                                            "    //GPS플러그인 지원되지 않을 경우, 안내 메시지 출력 후 탐색하지 않음",
                                                            "//     var toast = Ext.toast('GPS 기능을 지원하지 않습니다.', 1500);",
                                                            "//     toast.setBottom('50px');",
                                                            "    Ext.Msg.alert('안내', 'GPS 기능을 지원하지 않습니다.');",
                                                            "",
                                                            "    return;",
                                                            "}",
                                                            "",
                                                            "if(refs.atdTmdtInfo.getHidden() && !Ext.isEmpty(vm.get('runnerGps'))){",
                                                            "    // clearInterval(timerHome);",
                                                            "    vm.get('runnerGps').stopAll();",
                                                            "}",
                                                            "",
                                                            "",
                                                            "// // 위치 설정 화면으로 전환",
                                                            "// var naviView = me.getView().up('navigationview');",
                                                            "// me.PUSH_VIEW(naviView, {",
                                                            "//     menuId  : 'HwmDayAply02M',",
                                                            "//     title   : '근무위치',",
                                                            "//     workZoneGps : vm.get('workGpsVal')",
                                                            "// });",
                                                            "",
                                                            "//////////////////////",
                                                            "",
                                                            "var win = Ext.create('HwmDayAply52M',{",
                                                            "    workZoneGps : vm.get('workGpsVal')",
                                                            "});",
                                                            "",
                                                            "me.mon(win, 'select', function(gps){",
                                                            "//     refs.getGpsInfo.setHtml('위치정보 로딩 중...');",
                                                            "",
                                                            "    // gps 값 없음",
                                                            "    if(Ext.Object.isEmpty(gps)){",
                                                            "        refs.getGpsInfo.setHtml('디바이스 위치 기능 활성화 필요');",
                                                            "    }",
                                                            "    // gps 값 있음",
                                                            "    else{",
                                                            "        // 근무지 근처인지 체크",
                                                            "        var workGpsInfo = vm.get('workGpsVal');",
                                                            "        var isWorkZone = false;",
                                                            "        for(var i in workGpsInfo){",
                                                            "            var innerArea = me.measureDistance(gps, workGpsInfo[i].gpsLatdVal, workGpsInfo[i].gpsLotdVal, workGpsInfo[i].gpsLmDstnCnt);",
                                                            "            console.log('근무지와의 거리(measureDistance) : ' + vm.get('strKm'));",
                                                            "            if(innerArea){",
                                                            "                isWorkZone = true;",
                                                            "                vm.set('wkplcNm', workGpsInfo[i].wkplcNm); // 근무지명",
                                                            "                break;",
                                                            "            }",
                                                            "        }",
                                                            "        if( isWorkZone !== true ){",
                                                            "            refs.getGpsInfo.setHtml('허용거리초과');",
                                                            "        }",
                                                            "        else{",
                                                            "            if(refs.in.getHidden() !== true){",
                                                            "                refs.getGpsInfo.setHtml('출근가능');",
                                                            "            }",
                                                            "            else{",
                                                            "                refs.getGpsInfo.setHtml('퇴근가능');",
                                                            "            }",
                                                            "        }",
                                                            "    }",
                                                            "});",
                                                            "",
                                                            "win.show();"
                                                        ],
