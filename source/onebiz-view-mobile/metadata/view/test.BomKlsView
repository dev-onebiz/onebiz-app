                "fn": "onContainerInitialize",
                "implHandler": [
                    "        var me = this;",
                    "        var vm = me.getViewModel();",
                    "        var refs = me.getReferences();",
                    "",
                    "        refs.mainCtn.bodyElement.on('scroll',function(){",
                    "            me.onScrollEvent();",
                    "        });",
                    "",
                    "        var cat = vm.initialConfig.view.config.cat;",
                    "        if(cat == 'News'){",
                    "            this.onSelectNews();",
                    "        }",
                    "",
                    "        else if(cat == 'Rept'){",
                    "            this.onSelectRept();",
                    "        }",
                    "",
                    "        else if(cat == 'Trnd'){",
                    "            this.onSelectTrnd();",
                    "        }",
                    ""
                ],
                "name": "initialize",
                "scope": "me"
            },
