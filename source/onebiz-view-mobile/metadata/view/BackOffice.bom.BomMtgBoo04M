                                        ],
                                        "iconCls": "x-fa fa-search",
                                        "reference": "btnFindUserAtnd",
                                        "text": "조회"
                                    },
                                    "configAlternates": {
                                        "iconCls": "string",
                                        "text": "string",
                                        "hidden": "binding",
                                        "reference": "string"
                                    },
                                    "name": "MyButton",
                                    "designerId": "055c61b6-b88c-415b-97c2-55827a3cdd3a",
                                    "cn": [
                                        {
                                            "type": "viewcontrollereventbinding",
                                            "reference": {
                                                "name": "listeners",
                                                "type": "array"
                                            },
                                            "codeClass": null,
                                            "userConfig": {
                                                "fn": "onFindUsers",
                                                "implHandler": [
                                                    "var me = this;",
                                                    "var vm = me.getViewModel();",
                                                    "",
                                                    "// 팝업창 생성 및 데이터전달",
                                                    "var win = Ext.create('FindUserPopupM', {",
                                                    "    accItemCd : vm.get('cardItem.accItemCd'),",
                                                    "    gridData : vm.get('cardItem.hrHromJasPrjList'),",
                                                    "});",
                                                    "",
                                                    "// 팝업창에서 이벤트 호출시 실행되는 함수",
                                                    "me.mon(win, 'selected', function(data) {",
                                                    "    var me = this;",
                                                    "",
                                                    "    // 사용자 팝업에서 선택한 사용자들 기억하여 다시 사용자 팝업으로 돌려주기",
                                                    "    var gridData = data.items;",
                                                    "    if(gridData && gridData.length > 0){",
                                                    "        vm.set('cardItem.gridData', []);",
                                                    "        for(var row in gridData){",
                                                    "            vm.get('cardItem.gridData').push(gridData[row]);",
                                                    "        }",
                                                    "    }",
                                                    "",
                                                    "    var result = '';",
                                                    "    var userInfoList = [];",
                                                    "    var hrHromJasPrjId = null;",
                                                    "",
                                                    "    if(vm.get('cardItem.hrHromJasPrjId')){ // 사용부문",
                                                    "        hrHromJasPrjId = vm.get('cardItem.hrHromJasPrjId');",
                                                    "    }",
                                                    "",
                                                    "    for(var i in data.items){",
                                                    "        userInfoList[i] = data.items[i].data;",
                                                    "        userInfoList[i].hrHromJasPrjId = hrHromJasPrjId;",
                                                    "",
                                                    "        result += data.items[i].data.empeNm + '(' + data.items[i].data.dpnm + ')';",
                                                    "        if(i != data.items.length - 1){",
                                                    "            result += ', ';",
                                                    "        }",
                                                    "    }",
                                                    "",
                                                    "    vm.set('cardItem.userInfoList', userInfoList);",
                                                    "    vm.set('cardItem.userOrUseDept', result);",
                                                    "",
                                                    "//     var jasPrjRefs = this.getView().getReferences().jasPrj;",
                                                    "//     var userNotEmpty = vm.get('cardItem.userOrUseDept');",
                                                    "//     if(userNotEmpty && userNotEmpty.length > 0){",
                                                    "//         jasPrjRefs.setDisabled(false);",
                                                    "//     } else if(!userNotEmpty || userNotEmpty === '' || userNotEmpty.length === 0){",
                                                    "//         jasPrjRefs.setDisabled(true);",
                                                    "//         vm.set('cardItem.hrHromJasPrjId', null);",
                                                    "//         vm.set('cardItem.hrHromJasPrjText', null);",
                                                    "//         jasPrjRefs.setValue(null);",
                                                    "//     }",
                                                    "",
                                                    "     // 2019-07-30 손승범 사용자별 사용부문처리를 위해 추가",
                                                    "     var records = [];",
                                                    "     for (i in gridData) {",
                                                    "         data = gridData[i].data;",
                                                    "         // 사용자명 포매팅 추가설정",
                                                    "         data.formattedEmpeNm = Ext.String.format('{0}({1})', data.empeNm, data.dpnm);",
                                                    "         records.push(data);",
                                                    "     }",
                                                    "",
