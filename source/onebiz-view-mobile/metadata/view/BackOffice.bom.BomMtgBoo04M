                        {
                            "type": "Ext.Button",
                            "reference": {
                                "name": "items",
                                "type": "array"
                            },
                            "codeClass": null,
                            "userConfig": {
                                "designer|displayName": "예약 취소",
                                "hidden": true,
                                "layout|flex": 1,
                                "padding": "5px",
                                "reference": "btnCancel",
                                "text": "예약 취소"
                            },
                            "configAlternates": {
                                "text": "string",
                                "designer|displayName": "string",
                                "layout|flex": "number",
                                "hidden": "boolean",
                                "reference": "string",
                                "padding": "auto"
                            },
                            "name": "MyButton16",
                            "designerId": "8804894e-0a9d-4c6f-b4ff-98f3b992f95c",
                            "cn": [
                                {
                                    "type": "viewcontrollereventbinding",
                                    "reference": {
                                        "name": "listeners",
                                        "type": "array"
                                    },
                                    "codeClass": null,
                                    "userConfig": {
                                        "designer|commentHeader": [
                                            "예약 취소"
                                        ],
                                        "fn": "onButtonTapCancel",
                                        "implHandler": [
                                            "var me = this;",
                                            "var refs = me.getReferences();",
                                            "var vm = me.getViewModel();",
                                            "",
                                            "var info = vm.data.info;",
                                            "",
                                            "Ext.Msg.show({",
                                            "    title:'회의 취소',",
                                            "    message:'회의를 취소하시겠습니까?',",
                                            "    closable:true,",
                                            "    buttons:Ext.MessageBox.YESNO,",
                                            "    fn:function(btn){",
                                            "        if (btn == 'yes') {",
                                            "            // 취소 시작",
                                            "",
                                            "            var param={};",
                                            "",
                                            "            param.crud = vm.data.crud;",
                                            "            param.stcd = Constants.stcd.DELETE;",
                                            "            param.booStcd = Constants.booStcd.BOO_CANCLE;",
                                            "            //param.mtgNm = info.mtgNm;",
                                            "            //param.booAftLemeYn = info.booAftLemeYn;",
                                            "            //param.booAftLemeYn = null;",
                                            "            //param.dd1BefLemeYn = info.dd1BefLemeYn;",
                                            "            //param.min30BefLemeYn = info.min30BefLemeYn;",
                                            "            //param.mtgBooStrdt = info.mtgBooStrdt;",
                                            "            //param.mtgBooStrtm = info.mtgBooStrtm;",
                                            "            //param.mtgBooEdtm = info.mtgBooEdtm;",
                                            "            //param.mtgCgpEmpeNo = info.mtgCgpEmpeNo;",
                                            "            param.extYn = Constants.yesNo.NO; //연장여부",
                                            "            param.cancelYn = Constants.yesNo.YES; //취소여부",
                                            "            param.cancelPushYn = '';  //푸쉬 발송여부",
                                            "            param.mtgRoomNm = vm.data.mtgRoomDvcd.selection.data.text;",
                                            "            param.mtgCgpDpnm = vm.data.rqpr.value.split('/')[1];",
                                            "            param.mtgCgpEmpeNm = vm.data.rqpr.value.split('/')[2];",
                                            "            param.info = vm.data.info;",
                                            "",
                                            "            param.boMtgmRoomId = info.boMtgmRoomId;",
                                            "",
                                            "            if(!Ext.isEmpty(vm.data.originalJasPrjStore)){",
                                            "                param.gridRecords = vm.data.originalJasPrjStore;",
                                            "            }",
                                            "            else{",
                                            "                param.gridRecords = [];",
                                            "            }",
                                            "",
                                            "            // 복사된 회의에 대해 취소를 진행하는 경우",
                                            "            if (!Ext.isEmpty(vm.data.copyMtgmRoomId)) {",
                                            "                // 복사된 회의ID로 변경",
                                            "                param.boMtgmRoomId = vm.data.copyMtgmRoomId;",
                                            "            }",
                                            "",
                                            "",
                                            "",
                                            "            Ext.Msg.show({",
                                            "                title:'회의 취소',",
                                            "                message:'취소에 대한 푸쉬 알림을 발송하시겠습니까?',",
                                            "                closable:true,",
                                            "                buttons:Ext.MessageBox.YESNO,",
                                            "                fn:function(btn){",
                                            "                    if (btn == 'yes') {",
                                            "                        // 취소 푸쉬 발송여부 설정",
                                            "                        param.cancelPushYn = Constants.yesNo.YES;",
                                            "                    }",
                                            "                    else if(btn == 'no'){",
                                            "                        // 취소 푸쉬 발송여부 설정",
                                            "                        param.cancelPushYn = Constants.yesNo.NO;",
                                            "                    }else {",
                                            "                        return;",
                                            "                    }",
                                            "",
                                            "                    Ext.Ajax.request({",
                                            "                        headers: {",
                                            "                            viewId : me.getViewId(),",
                                            "                            serviceId : 'BomMtgSvc.saveMtgBoo'",
                                            "                        },",
                                            "                        jsonData : param,",
                                            "                        scope : me,",
                                            "                        success : function(response) {",
                                            "                            var res = Ext.JSON.decode(response.responseText);",
                                            "",
                                            "                            // 복사된 회의ID로 취소 처리하여 현재 복사된 회의ID를 가지고 있을 경우",
                                            "                            if (!Ext.isEmpty(vm.data.copyMtgmRoomId)) {",
                                            "                                // 빈 값으로 초기화",
                                            "                                vm.set('copyMtgmRoomId', null);",
                                            "                            }",
                                            "",
                                            "                            //                 var toast = Ext.toast(Messages.getMessage('I0000'),1500);",
                                            "                            //                 toast.setBottom('50px');",
                                            "                            //                 toast.show();",
                                            "                            Ext.Msg.alert('안내', Messages.getMessage('I0000'));",
                                            "                            me.getView().up().down('BomMtgBoo01M').controller.onSelect();",
                                            "                            vm.getView().up().pop();",
                                            "",
                                            "                        }",
                                            "                    });",
                                            "                }",
                                            "            });",
                                            "",
                                            "        }",
                                            "    }",
                                            "});"
                                        ],
                                        "name": "tap",
                                        "scope": "me"
                                    },
                                    "configAlternates": {
                                        "designer|commentHeader": "comment",
                                        "fn": "string",
                                        "name": "string",
                                        "scope": "string",
                                        "implHandler": "code"
                                    },
                                    "name": "onButtonTapCancel",
                                    "designerId": "38cd0655-8895-4f86-b534-4229ca2a632c"
                                }
                            ]
                        },
                        {
                            "type": "Ext.Button",
                            "reference": {
                                "name": "items",
                                "type": "array"
                            },
                            "codeClass": null,
                            "userConfig": {
                                "designer|displayName": "예약 복사",
                                "hidden": true,
                                "layout|flex": 1,
                                "padding": "5px",
                                "reference": "btnCopy",
                                "text": "예약 복사"
                            },
                            "configAlternates": {
                                "text": "string",
                                "designer|displayName": "string",
                                "layout|flex": "number",
                                "hidden": "boolean",
                                "reference": "string",
                                "padding": "auto"
                            },
                            "name": "MyButton20",
                            "designerId": "930e9568-e8a4-48e5-bd34-d64a2b95b832",
                            "cn": [
                                {
                                    "type": "viewcontrollereventbinding",
                                    "reference": {
                                        "name": "listeners",
                                        "type": "array"
                                    },
                                    "codeClass": null,
                                    "userConfig": {
                                        "designer|commentHeader": [
                                            "복사"
                                        ],
                                        "fn": "onButtonTapCopy",
                                        "implHandler": [
                                            "var me = this;",
                                            "var refs = me.getReferences();",
                                            "var vm = me.getViewModel();",
                                            "",
                                            "/***************",
                                            "* 유효성검증 시작 *",
                                            "****************/",
                                            "var validationMsg = '';",
                                            "var tmpMsg = '';",
                                            "",
                                            "/********** 날짜 **********/",
                                            "tmpMsg = '';",
                                            "if(Ext.isEmpty(refs.mtgBooStrdt.getValue())){",
                                            "    tmpMsg += '- 회의 일자<br>';",
                                            "}",
                                            "validationMsg += tmpMsg;",
                                            "",
                                            "/********** 시작 종료 시간 **********/",
                                            "tmpMsg = '';",
                                            "if(Ext.isEmpty(refs.mtgBooStrtm.getValue())){",
                                            "    tmpMsg += '- 회의 시작 시간<br>';",
                                            "}",
                                            "if(Ext.isEmpty(refs.mtgBooEdtm.getValue())){",
                                            "    tmpMsg += '- 회의 종료 시간<br>';",
                                            "}",
                                            "validationMsg += tmpMsg;",
                                            "",
                                            "/********** 장소 **********/",
                                            "tmpMsg = '';",
                                            "if(Ext.isEmpty(refs.mtgRoomDvcd.getValue()) || refs.mtgRoomDvcd.getValue() == '99'){",
                                            "    tmpMsg += '- 장소<br>';",
                                            "}",
                                            "validationMsg += tmpMsg;",
                                            "",
                                            "/********** 회의명 **********/",
                                            "tmpMsg = '';",
                                            "if(!Ext.isEmpty(refs.mtgNm.getValue())){",
                                            "    if(refs.mtgNm.getValue().trim().length === 0){",
                                            "        tmpMsg += '- 회의명<br>';",
                                            "    }",
                                            "}",
                                            "else{",
                                            "    tmpMsg += '- 회의명<br>';",
                                            "}",
                                            "",
                                            "validationMsg += tmpMsg;",
                                            "",
                                            "/********** 시작보다 빠른 종료 시간 **********/",
                                            "if(Ext.isEmpty(validationMsg)){",
                                            "    var startTm = DateUtils.getTimeFormat(refs.mtgBooStrtm.getValue(),'His');",
                                            "    var endTm = DateUtils.getTimeFormat(refs.mtgBooEdtm.getValue(),'His');",
                                            "    if(startTm - endTm >= 0){",
                                            "        validationMsg += '시작시간에 종료시간보다 작은 값을 입력해주십시오.';",
                                            "    }",
                                            "}",
                                            "",
                                            "/********** 이미 지난 시간 **********/",
                                            "if(Ext.isEmpty(validationMsg)){",
                                            "    var startDt = DateUtils.getDate(refs.mtgBooStrdt.getValue());",
                                            "    var startTm = DateUtils.getTimeFormat(refs.mtgBooStrtm.getValue(),'His');",
                                            "    // 예약 날짜가 오늘 및 이전 날짜일 경우",
                                            "    if (startDt <= Ext.Date.format(new Date(), 'Ymd')) {",
                                            "        // 예약 시간이 현재 시간 이전일 경우",
                                            "        if (startTm < Ext.Date.format(new Date(), 'His')) {",
                                            "            // 예약 불가 메시지",
                                            "            validationMsg += '이미 지난 일시에는 예약이 불가능합니다.';",
                                            "        }",
                                            "    }",
                                            "}",
                                            "",
                                            "if(validationMsg !== ''){",
                                            "    Ext.Msg.alert('안내',validationMsg);",
                                            "    return;",
                                            "}",
                                            "",
                                            "/***************",
                                            "* 유효성검증 종료 *",
                                            "****************/",
                                            "else{",
                                            "    // 복사(저장)",
                                            "    var param={};",
                                            "    param.crud = Constants.crudState.CREATE;",
                                            "    param.boMtgcRoomId = vm.data.info.boMtgcRoomId;",
                                            "    param.boMtgmRoomId = null;  // 현재 회의와 중복검사가 가능하도록 초기화",
                                            "    param.booStcd = Constants.booStcd.BOO;",
                                            "    param.mtgCgpEmpeNo = vm.data.rqpr.value.split('/')[0]; //담당자사번",
                                            "    //param.booAftLemeYn = me.lRef.booAftLemeYn.value; //알림옵션1",
                                            "    param.booAftLemeYn = null;",
                                            "    param.pstlyMtgExtTms = 0; //연장횟수",
                                            "    param.extYn = Constants.yesNo.NO; //연장여부",
                                            "    param.mtgRoomNm = vm.data.mtgRoomDvcd.selection.data.text;",
                                            "    param.mtgRoomDvcd = vm.data.mtgRoomDvcd.value;",
                                            "    param.mtgCgpDpnm = vm.data.rqpr.value.split('/')[1];",
                                            "    param.mtgCgpEmpeNm = vm.data.rqpr.value.split('/')[2];",
                                            "    param.mtgBooStrdt = DateUtils.getDate(vm.data.mtgBooStrdt.value);",
                                            "    param.mtgBooStrtm = DateUtils.getTimeFormat(vm.data.mtgBooStrtm.value,'His');",
                                            "    param.mtgBooEdt = DateUtils.getDate(vm.data.mtgBooStrdt.value);",
                                            "    param.mtgBooEdtm = DateUtils.getTimeFormat(vm.data.mtgBooEdtm.value,'His');",
                                            "    param.mtgNm = vm.data.mtgNm.value;",
                                            "",
                                            "    if(!Ext.isEmpty(vm.data.hrHromJasPrjStore)){",
                                            "        param.gridRecords = vm.data.hrHromJasPrjStore;",
                                            "    }",
                                            "    else{",
                                            "        param.gridRecords = [];",
                                            "    }",
                                            "",
                                            "    // 알림옵션1",
                                            "    if(refs.booAftLemeYn.isChecked()){",
                                            "        param.booAftLemeYn = '1';",
                                            "    }",
                                            "    else{",
                                            "        param.booAftLemeYn = '0';",
                                            "    }",
                                            "    // 알림옵션2",
                                            "    if(refs.dd1BefLemeYn.isChecked()){",
                                            "        param.dd1BefLemeYn = '1';",
                                            "    }",
                                            "    else{",
                                            "        param.dd1BefLemeYn = '0';",
                                            "    }",
                                            "    // 알림옵션3",
                                            "    if(refs.min30BefLemeYn.isChecked()){",
                                            "        param.min30BefLemeYn = '1';",
                                            "    }",
                                            "    else{",
                                            "        param.min30BefLemeYn = '0';",
                                            "    }",
                                            "",
                                            "",
                                            "",
                                            "    Ext.Ajax.request({",
                                            "        headers: {",
                                            "            viewId : me.getViewId(),",
                                            "            serviceId : 'BomMtgSvc.saveMtgBoo'",
                                            "        },",
                                            "        jsonData : param,",
                                            "        scope : me,",
                                            "        success : function(response) {",
                                            "            var res = Ext.JSON.decode(response.responseText);",
                                            "",
                                            "            if(!Ext.isEmpty(res.result)){",
                                            "                var msg = '';",
                                            "                msg += res.result + '<br>';",
                                            "",
                                            "                var strTm = res.dupCheck[res.dupCheck.length - 1].strTm;",
                                            "                strTm = strTm.substr(0,2) + ':' + strTm.substr(2,2);",
                                            "                var endTm = res.dupCheck[res.dupCheck.length - 1].endTm;",
                                            "                endTm = endTm.substr(0,2) + ':' + endTm.substr(2,2);",
                                            "                msg += ' - ' + strTm + ' ~ ' + endTm;",
                                            "",
                                            "                Ext.Msg.alert('안내',msg);",
                                            "            }",
                                            "            else{",
                                            "                // 복사된 회의ID 저장",
                                            "                vm.set('copyMtgmRoomId', res.request.id);",
                                            "",
                                            "                var startDt = DateUtils.getDate(refs.mtgBooStrdt.getValue());",
                                            "                startDt = startDt.substr(0,4) + '/' + startDt.substr(4,2) + '/' + startDt.substr(6,2);",
                                            "                var startTm = DateUtils.getTimeFormat(refs.mtgBooStrtm.getValue(),'Hi');",
                                            "                startTm = startTm.substr(0,2) + ':'+startTm.substr(2,2);",
                                            "                var startDtTm = new Date(startDt+' '+startTm);",
                                            "                var startDtTmBefore10 = new Date(startDtTm.setMinutes(startDtTm.getMinutes() - 10));",
                                            "                if(new Date() >= startDtTmBefore10){",
                                            "                    refs.btnCancel.setHidden(true);",
                                            "                }",
                                            "                else{",
                                            "                    refs.btnCancel.setHidden(false);",
                                            "                }",
                                            "",
                                            "                // 복사 처리 후 메시지",
                                            "                var msg = '';",
                                            "                var before = vm.data.info.mtgBooStrdt;",
                                            "                before = '<b>' + before.substr(0,4) + '년 ' + before.substr(4,2) + '월 ' + before.substr(6,2) + '일</b>';",
                                            "                msg += before + ' 회의가<br>';",
                                            "",
                                            "                var after = DateUtils.getDate(refs.mtgBooStrdt.getValue());",
                                            "                after = '<b>' + after.substr(0,4) + '년 ' + after.substr(4,2) + '월 ' + after.substr(6,2) + '일</b>';",
                                            "                msg += after + ' 로 복사되었습니다.<br>';",
                                            "",
                                            "                Ext.Msg.alert('안내',msg);",
                                            "",
                                            "                //             Ext.toast(Messages.getMessage('I0000'),1500);",
                                            "            }",
                                            "        }",
                                            "    });",
                                            "}"
                                        ],
