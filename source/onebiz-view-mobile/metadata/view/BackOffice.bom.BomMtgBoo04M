                                        "type": "array"
                                    },
                                    "codeClass": null,
                                    "userConfig": {
                                        "designer|commentHeader": [
                                            "확인"
                                        ],
                                        "fn": "onButtonTapBook",
                                        "implHandler": [
                                            "var me = this;",
                                            "var refs = me.getReferences();",
                                            "var vm = me.getViewModel();",
                                            "",
                                            "/***************",
                                            "* 유효성검증 시작 *",
                                            "****************/",
                                            "var validationMsg = '';",
                                            "var tmpMsg = '';",
                                            "",
                                            "/********** 날짜 **********/",
                                            "tmpMsg = '';",
                                            "if(Ext.isEmpty(refs.mtgBooStrdt.getValue())){",
                                            "    tmpMsg += '- 회의 일자<br>';",
                                            "}",
                                            "validationMsg += tmpMsg;",
                                            "",
                                            "/********** 시작 종료 시간 **********/",
                                            "tmpMsg = '';",
                                            "if(Ext.isEmpty(refs.mtgBooStrtm.getValue())){",
                                            "    tmpMsg += '- 회의 시작 시간<br>';",
                                            "}",
                                            "if(Ext.isEmpty(refs.mtgBooEdtm.getValue())){",
                                            "    tmpMsg += '- 회의 종료 시간<br>';",
                                            "}",
                                            "validationMsg += tmpMsg;",
                                            "",
                                            "/********** 장소 **********/",
                                            "tmpMsg = '';",
                                            "if(Ext.isEmpty(refs.mtgRoomDvcd.getValue()) || refs.mtgRoomDvcd.getValue() == '99'){",
                                            "    tmpMsg += '- 장소<br>';",
                                            "}",
                                            "validationMsg += tmpMsg;",
                                            "",
                                            "/********** 회의명 **********/",
                                            "tmpMsg = '';",
                                            "if(!Ext.isEmpty(refs.mtgNm.getValue())){",
                                            "    if(refs.mtgNm.getValue().trim().length === 0){",
                                            "        tmpMsg += '- 회의명<br>';",
                                            "    }",
                                            "}",
                                            "else{",
                                            "    tmpMsg += '- 회의명<br>';",
                                            "}",
                                            "",
                                            "validationMsg += tmpMsg;",
                                            "",
                                            "",
                                            "/********** 시작보다 빠른 종료 시간 **********/",
                                            "if(Ext.isEmpty(validationMsg)){",
                                            "    var startTm = DateUtils.getTimeFormat(refs.mtgBooStrtm.getValue(),'His');",
                                            "    var endTm = DateUtils.getTimeFormat(refs.mtgBooEdtm.getValue(),'His');",
                                            "    if(startTm - endTm >= 0){",
                                            "        validationMsg += '시작시간에 종료시간보다 작은 값을 입력해주십시오.';",
                                            "    }",
                                            "}",
                                            "",
                                            "/********** 이미 지난 시간 **********/",
                                            "if(Ext.isEmpty(validationMsg)){",
                                            "    var startDt = DateUtils.getDate(refs.mtgBooStrdt.getValue());",
                                            "    var startTm = DateUtils.getTimeFormat(refs.mtgBooStrtm.getValue(),'His');",
                                            "    // 예약 날짜가 오늘 및 이전 날짜일 경우",
                                            "    if (startDt <= Ext.Date.format(new Date(), 'Ymd')) {",
                                            "        // 예약 시간이 현재 시간 이전일 경우",
                                            "        if (startTm < Ext.Date.format(new Date(), 'His')) {",
                                            "            // 예약 불가 메시지",
                                            "            validationMsg += '이미 지난 일시에는 예약이 불가능합니다.';",
                                            "        }",
                                            "    }",
                                            "}",
                                            "",
                                            "if(validationMsg !== ''){",
                                            "    Ext.Msg.alert('안내',validationMsg);",
                                            "    return;",
                                            "}",
                                            "",
                                            "/***************",
                                            "* 유효성검증 종료 *",
                                            "****************/",
                                            "else{",
                                            "    // 복사(저장)",
                                            "    var param={};",
                                            "",
                                            "    param.crud = vm.get('crud');",
                                            "    param.mtgRoomDvcd = vm.data.mtgRoomDvcd.value;",
                                            "    param.booStcd = Constants.booStcd.BOO;",
                                            "    param.mtgCgpEmpeNo = vm.data.rqpr.value.split('/')[0]; //담당자사번",
                                            "    param.booAftLemeYn = null;",
                                            "    param.pstlyMtgExtTms = 0; //연장횟수",
                                            "    param.extYn = Constants.yesNo.NO; //연장여부",
                                            "    param.mtgRoomNm = vm.data.mtgRoomDvcd.selection.data.text;",
                                            "    param.mtgCgpDpnm = vm.data.rqpr.value.split('/')[1];",
                                            "    param.mtgCgpEmpeNm = vm.data.rqpr.value.split('/')[2];",
                                            "    param.mtgBooStrdt = DateUtils.getDate(vm.data.mtgBooStrdt.value);",
                                            "    param.mtgBooStrtm = DateUtils.getTimeFormat(vm.data.mtgBooStrtm.value,'His');",
                                            "    param.mtgBooEdt = DateUtils.getDate(vm.data.mtgBooStrdt.value);",
                                            "    param.mtgBooEdtm = DateUtils.getTimeFormat(vm.data.mtgBooEdtm.value,'His');",
                                            "    param.mtgNm = vm.data.mtgNm.value;",
                                            "",
                                            "",
                                            "    if(!Ext.isEmpty(vm.data.hrHromJasPrjStore)){",
                                            "        param.gridRecords = vm.data.hrHromJasPrjStore;",
                                            "    }",
                                            "    else{",
                                            "        param.gridRecords = [];",
                                            "    }",
                                            "",
                                            "    // 알림옵션1",
                                            "    if(refs.booAftLemeYn.isChecked()){",
                                            "        param.booAftLemeYn = '1';",
                                            "    }",
                                            "    else{",
                                            "        param.booAftLemeYn = '0';",
                                            "    }",
                                            "    // 알림옵션2",
                                            "    if(refs.dd1BefLemeYn.isChecked()){",
                                            "        param.dd1BefLemeYn = '1';",
                                            "    }",
                                            "    else{",
                                            "        param.dd1BefLemeYn = '0';",
                                            "    }",
                                            "    // 알림옵션3",
                                            "    if(refs.min30BefLemeYn.isChecked()){",
                                            "        param.min30BefLemeYn = '1';",
                                            "    }",
                                            "    else{",
                                            "        param.min30BefLemeYn = '0';",
                                            "    }",
                                            "",
                                            "    Ext.Ajax.request({",
                                            "        headers: {",
                                            "            viewId : me.getViewId(),",
                                            "            serviceId : 'BomMtgSvc.saveMtgBoo'",
                                            "        },",
                                            "        jsonData : param,",
                                            "        scope : me,",
                                            "        success : function(response) {",
                                            "            var res = Ext.JSON.decode(response.responseText);",
                                            "",
                                            "            if(!Ext.isEmpty(res.result)){",
                                            "                var msg = '';",
                                            "                msg += res.result + '<br>';",
                                            "",
                                            "                var strTm = res.dupCheck[res.dupCheck.length - 1].strTm;",
                                            "                strTm = strTm.substr(0,2) + ':' + strTm.substr(2,2);",
                                            "                var endTm = res.dupCheck[res.dupCheck.length - 1].endTm;",
                                            "                endTm = endTm.substr(0,2) + ':' + endTm.substr(2,2);",
                                            "                msg += ' - ' + strTm + ' ~ ' + endTm;",
                                            "",
                                            "                Ext.Msg.alert('안내',msg);",
                                            "            }",
                                            "            else{",
                                            "                // 메시지 출력",
                                            "                //                 var toast = Ext.toast(Messages.getMessage('I0000'),1500);",
                                            "                //                 toast.setBottom('50px');",
                                            "                //                 toast.show();",
                                            "                Ext.Msg.alert('안내', Messages.getMessage('I0000'));",
                                            "                me.getView().up().down('BomMtgBoo01M').controller.onSelect();",
                                            "                vm.getView().up().pop();",
                                            "            }",
                                            "        }",
                                            "    });",
                                            "}"
                                        ],
                                        "name": "tap",
                                        "scope": "me"
                                    },
