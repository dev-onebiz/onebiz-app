                "fn": "initialize",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences();",
                    "",
                    "var empeNm = SecurityUtils.getPrincipal().empeNm;",
                    "refs.empeNm.setHtml(empeNm);",
                    "",
                    "var timestamp = component.initialConfig.timestamp;",
                    "// 출.퇴근 일자, 시간",
                    "var date = new Date(),",
                    "    dayOfTheWeek = date.getDay(timestamp),",
                    "    week = ['일', '월', '화', '수', '목', '금', '토'],",
                    "    strDay = String(week[dayOfTheWeek]),",
                    "    fullDate = \"\", nowTime = \"\";",
                    "",
                    "// 서버시간으로 표시. ELSE는 기존 로직인데 향후 삭제 예정",
                    "if(timestamp.length >= 14){",
                    "    fullDate = timestamp.substr(0, 4) + '-' + timestamp.substr(4, 2) +",
                    "        '-' + timestamp.substr(6, 2) + '(' + strDay + ')' ;",
                    "",
                    "    nowTime = timestamp.substr(8, 2) + ':' + timestamp.substr(10, 2) +",
                    "        ':' + timestamp.substr(12, 2);",
                    "} else {",
                    "    fullDate = date.getFullYear()  + '-' +",
                    "    (date.getMonth() < 9 ? '0' : '') + (date.getMonth() + 1)  + '-' +",
                    "    (date.getDate() < 10 ? '0' : '') + date.getDate() +",
                    "    '(' + strDay + ')';",
                    "",
                    "    nowTime = (date.getHours() < 10 ? '0' : '') + date.getHours() + \":\" +",
                    "    (date.getMinutes() < 10 ? '0' : '') + date.getMinutes() + \":\"+",
                    "    (date.getSeconds() < 10 ? '0' : '') + date.getSeconds();",
                    "}",
                    "",
                    "var wkplcNm = component.initialConfig.wkplcNm;",
                    "",
                    "refs.tapDate.setHtml('일자 : ' + fullDate);",
                    "refs.tapTime.setHtml('시간 : ' + nowTime);",
                    "refs.tapLocation.setHtml('장소 : ' + wkplcNm);",
                    "",
                    "// 출석, 퇴근 완료 팝업 메시지 설정",
                    "var attendance = component.initialConfig.attendance,",
                    "    sayMsg = '',",
                    "    backgroundColor = '',",
                    "    borderColor = '';",
                    "",
                    "if(attendance){ // 출근을 누른 경우",
                    "    sayMsg = '오늘도 힘찬 하루 되세요!';",
                    "    refs.inFinish.setHidden(false);",
                    "} else { // 퇴근을 누른 경우",
                    "    sayMsg = '오늘도 수고하셨습니다!';",
                    "    refs.outFinish.setHidden(false);",
                    "}",
                    "",
                    "refs.say.setHtml(sayMsg);",
                    ""
                ],
                "name": "initialize",
                "scope": "me"
            },
