                "fn": "onContainerInitialize",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    edocCd = 'HwmOvtRept71', \t\t\t\t\t// 문서코드",
                    "    edocNm = '연장근무 보고서',",
                    "    approvalLineGrid = refs.approvalLineGrid, \t// 결재선",
                    "    afterchangeform = refs.frmDetail,",
                    "    initialConfig = component.config,\t\t \t// 화면초기데이터",
                    "    command = initialConfig.command, \t\t\t// 결재선구분커맨드",
                    "    aprHistData = initialConfig.aprHistData, \t// 결재이력데이터",
                    "    // 결재함(ExpNteApr02)에서는 docData,",
                    "    // 연장근무신청(HwmOvtRept01)에서는 aprHistData.docData",
                    "    docData = (aprHistData) ? aprHistData.docData : initialConfig.docData, \t// 문서데이터",
                    "    afterchange = docData.afterchange,",
                    "    aprHistId = initialConfig.aprHistId, \t\t\t\t// 결재내역ID",
                    "    userId = SecurityUtils.getPrincipal().hrHrpmEmpId, \t// 사용자ID",
                    "    record = initialConfig.record; \t\t\t\t\t\t// 결재함 목록에서 선택한 레코드",
                    "",
                    "vm.set('docCd', edocCd);",
                    "vm.set('docNm', edocNm);",
                    "vm.set('aprHistId', aprHistId);",
                    "vm.set('afterchange', afterchange);",
                    "vm.set('record', record);",
                    "",
                    "var aplOvtStrtm = afterchange.aplOvtStrtm,",
                    "    aplOvtEdtm = afterchange.aplOvtEdtm,",
                    "    wrkStrtm = afterchange.wrkStrtm,",
                    "    wrkEdtm = afterchange.wrkEdtm;",
                    "afterchange.aplOvtStrtm = DateUtils.encodeDate(DateUtils.getTimeToDate(aplOvtStrtm),\"H:i\");",
                    "afterchange.aplOvtEdtm = DateUtils.encodeDate(DateUtils.getTimeToDate(aplOvtEdtm),\"H:i\");",
                    "afterchange.wrkStrtm = DateUtils.encodeDate(DateUtils.getTimeToDate(wrkStrtm),\"H:i:s\");",
                    "afterchange.wrkEdtm = DateUtils.encodeDate(DateUtils.getTimeToDate(wrkEdtm),\"H:i:s\");",
                    "",
                    "var aplOvtDt = afterchange.aplOvtDt,",
                    "    aplOvtStrdt = afterchange.aplOvtStrdt,",
                    "    aplOvtEdt = afterchange.aplOvtEdt,",
                    "    wrkStrdt = afterchange.wrkStrdt,",
                    "    wrkEdt = afterchange.wrkEdt;",
                    "afterchange.aplOvtDt = DateUtils.parseDate(aplOvtDt);",
                    "afterchange.aplOvtStrdt = DateUtils.parseDate(aplOvtStrdt);",
                    "afterchange.aplOvtEdt = DateUtils.parseDate(aplOvtEdt);",
                    "afterchange.wrkStrdt = DateUtils.parseDate(wrkStrdt);",
                    "afterchange.wrkEdt = DateUtils.parseDate(wrkEdt);",
                    "afterchange.aplDvcdNm = CodeUtils.getText('HWM009', afterchange.aplDvcd);",
                    "",
                    "me.fnInitComponentForm(afterchangeform);",
                    "",
                    "me.setAprHistId(aprHistId); // 결재이력아이디",
                    "me.setRecord(record); \t\t// 동시성 제어를 하기 위한 용도로 Config에 저장함",
                    "me.setCommand(command); \t// 결재처리 커맨드",
                    "",
                    "// 결재문서 초기화 설정",
                    "ApprovalBoxSvc.setup({",
                    "    command : command, \t\t// 결재선구분커맨드",
                    "    viewModel : vm,",
                    "    edocCd : edocCd, \t\t// 전자문서관리화면에 설정된 문서코드: 화면ID를 사용",
                    "    aprHistId : aprHistId, \t// 결재이력ID",
                    "    scope : me",
                    "});",
                    "",
                    "afterchangeform.setValues(afterchange);",
                    "",
                    "var rgdt = (aprHistData) ? record.reptAplDtm : record.fstRgDtti;\t\t// 연장근무신청(reptAplDtm) , 결재함(fstRgDtti)",
                    "refs.rgdt.setHtml(rgdt.substr(0,10));",
                    "",
                    "refs.aplOvtStrtm.el.select('.x-error-el').setStyle('margin','0px');",
                    "refs.aplOvtEdtm.el.select('.x-error-el').setStyle('margin',\t'0px');",
                    "refs.aplOvtStrtm.el.select('.x-error-el').setStyle('height','0px');",
                    "refs.aplOvtEdtm.el.select('.x-error-el').setStyle('height',\t'0px');"
