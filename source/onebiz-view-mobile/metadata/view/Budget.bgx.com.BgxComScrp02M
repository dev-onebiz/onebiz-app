                                    "if (trdv == '승인') {",
                                    "    color = 'blue';",
                                    "",
                                    "} else if (trdv == '취소') {",
                                    "   color = 'red';",
                                    "   result2 = '<div style=\"color:red;\">' + trdv + ' | ' + aprno + '</div>';",
                                    "//    result2 = '<div style=\"color:red;\">' + trdv + ' |' + tdt + '</div>';",
                                    "}",
                                    "",
                                    "result = '<div style=\"font-size:15px;font-weight:bold;color:' + color + ';\">' + result + '</div>' + result2;",
