            "userConfig": {
                "fn": "Initialize",
                "implHandler": [
                    "var me = this;",
                    "var vm = me.getViewModel();",
                    "var refs = me.getReferences();",
                    "var items = component.records;",
                    "var aplTotSmamt = 0;",
                    "me.setParentView(component.parentView);",
                    "",
                    "var componentList = [",
                    "    'aplOvtStrdt',",
                    "    'aplOvtStrtm',",
                    "    'aplOvtEdt',",
                    "    'aplOvtEdtm',",
                    "    'aplCntn'];",
                    "",
                    "if(items.length === 0){",
                    "",
                    "    vm.clicked = 'new';",
                    "    var vm = me.getViewModel();",
                    "    var principal = SecurityUtils.getPrincipal();",
                    "    var ovwUsr = principal.hrHrpmEmpId+\" / \"+ principal.dpnm + \" / \" +",
                    "        principal.empeNm +\" / \" + principal.empePsitNm;",
                    "    refs.rqpr.setValue(ovwUsr);",
                    "    refs.aplDvcdNm.setValue(\"신청\");",
                    "    refs.aplDvcd.setValue(Constants.wrkAplDvcd.APPLY);",
                    "",
                    "    var date = new Date();",
                    "    var month = (date.getMonth()+1) +\"\";",
                    "    month = month.length == 1 ? \"0\" + month: month;",
                    "    var dateDD = date.getDate()+\"\";",
                    "    dateDD = dateDD.length == 1 ? \"0\" + dateDD: dateDD;",
                    "    var toDate = date.getFullYear() +'-'+ month +'-'+ dateDD;",
                    "",
                    "    refs.aplOvtDt.setValue(toDate);",
                    "    refs.aplOvtStrdt.setValue(toDate);",
                    "    refs.aplOvtStrtm.setValue(\"19:00\");",
                    "    refs.aplOvtEdt.setValue(toDate);",
                    "    refs.aplOvtEdtm.setValue(\"21:00\");",
                    "//     refs.aplCntn.setValue('금일 연장근무 신청하겠습니다.');",
                    "",
                    "    refs.aplOvtDt.setDisabled(false);",
                    "    //     refs.aplOvtStrdt.setDisabled(false);",
                    "    refs.aplOvtStrtm.setDisabled(false);",
                    "    //     refs.aplOvtEdt.setDisabled(false);",
                    "    refs.aplOvtEdtm.setDisabled(false);",
                    "    refs.aplCntn.setDisabled(false);",
                    "",
                    "    refs.apLn.setHidden(false);",
                    "    refs.ap.setHidden(false);",
                    "    refs.reAp.setHidden(true);",
                    "    refs.rept.setHidden(true);",
                    "    refs.cancel.setHidden(true);",
                    "",
                    "    var date = new Date();",
                    "    var nHour = date.getHours();",
                    "    nHour = nHour < 10 ? '0'+nHour :  nHour;",
                    "    var nMin = date.getMinutes();",
                    "    nMin = nMin  < 10 ? '0'+nMin :  nMin;",
                    "    var nSec = date.getSeconds();",
                    "    nSec = nSec  < 10 ? '0'+nSec :  nSec;",
                    "    refs.aplDt.setValue();",
                    "    refs.aplTm.setValue(nHour+\"\"+nMin+\"\"+nSec);",
                    "",
                    "    vm.set('docCd', 'HwmOvtAply71');",
                    "    vm.set('docNm', '연장근무 신청서');",
                    "",
                    "    me.setOvtHodInfo();",
                    "}else{",
                    "",
                    "    vm.clicked = 'clicked';",
                    "    var data = items[0].data;",
                    "    var ovwUsr = data.empeNo +\" / \"+data.dpnm +\" / \"+data.empeNm +\" / \"+data.lv ;",
                    "    refs.rqpr.setValue(ovwUsr);",
                    "    ",
                    "    // 여비정산서 신청여부 (여비정산서가 있을경우 취소신청을 할수없음)",
                    "    vm.set('existBgBtrYn', data.existBgBtrYn);",
                    "",
                    "    refs.aplDvcdNm.setValue(data.aplDvcdNm);",
                    "    refs.aplDvcd.setValue(data.aplDvcd);",
                    "",
                    "    refs.aplOvtDt.setValue(data.aplOvtDt);",
                    "    refs.aplOvtStrdt.setValue(data.aplOvtStrdt);",
                    "    refs.aplOvtStrtm.setValue(data.aplOvtStrtm);",
                    "    refs.aplOvtEdt.setValue(data.aplOvtEdt);",
                    "    refs.aplOvtEdtm.setValue(data.aplOvtEdtm);",
                    "    refs.aplCntn.setValue(data.aplCntn);",
                    "    refs.aplTm.setValue(data.aplTm);",
                    "    refs.aplOvtDt.setDisabled(true);",
                    "    //     refs.aplOvtStrdt.setDisabled(true);",
                    "    refs.aplOvtStrtm.setDisabled(true);",
                    "    //     refs.aplOvtEdt.setDisabled(true);",
                    "    refs.aplOvtEdtm.setDisabled(true);",
                    "    refs.aplCntn.setDisabled(true);",
                    "",
                    "    refs.times.setHidden(true);",
                    "",
                    "    refs.apLn.setHidden(true);",
                    "    refs.ap.setHidden(true);",
                    "    refs.reAp.setHidden(false);",
                    "",
                    "    if(data.aplStcd == '91'){",
                    "        refs.cancel.setHidden(false);",
                    "        refs.rept.setHidden(false);",
                    "    }else{",
                    "        refs.cancel.setHidden(true);",
                    "        refs.rept.setHidden(true);",
                    "    }",
                    "",
                    "    if(refs.aplDvcd.getValue() == Constants.wrkAplDvcd.CANCEL){",
                    "        refs.button.setHidden(true);",
                    "        vm.set('docCd', 'HwmOvtAply72');",
