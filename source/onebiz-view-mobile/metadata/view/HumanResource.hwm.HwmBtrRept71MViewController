                "designer|commentHeader": [
                    "뷰 초기화"
                ],
                "fn": "initView",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    approvalLineGrid = refs.approvalLineGrid;",
                    "",
                    "var docData = vm.get('docData'),",
                    "    gridScheduleInfoItems = vm.get('gridScheduleInfoItems'),",
                    "    applyItemList = vm.get('applyItemList'),",
                    "    hrWrkmBtrApfId = vm.get('hrWrkmBtrApfId'),",
                    "    afterchange = vm.get('afterchange'),",
                    "    aprHistId = vm.get('aprHistId'),",
                    "    record = vm.get('record'),",
                    "    command = vm.get('command'),",
                    "    aplDvcdLbl = CodeUtils.getText('HWM009', afterchange.aplDvcd),  // 신청구분",
                    "    btrDvcdLbl = CodeUtils.getText('HWM016', afterchange.btrDvcd),  // 출장구분",
                    "    btrPeriod = afterchange.btrPeriod,\t\t\t\t\t\t\t\t// 출장일수",
                    "    atchFileId = vm.get('atchFileId'),\t\t\t\t\t\t\t\t// 첨부파일 ID",
                    "    atchFileNm = vm.get('atchFileNm'),\t\t\t\t\t\t\t\t// 첨부파일명",
                    "    atchFileParentId = vm.get('atchFileParentId'),\t\t\t\t\t// 첨부파일",
                    "    totalAmt = 0;\t\t\t\t\t\t\t\t\t\t\t\t\t// 총 금액",
                    "",
                    "// 뷰 초기화",
                    "refs.rgdt.setHtml(record.rgdt);",
                    "refs.headTitle.setHtml(record.docNm);",
                    "refs.aplDvcdLbl.setValue(aplDvcdLbl);",
                    "refs.btrDvcdLbl.setValue(btrDvcdLbl);",
                    "refs.btrPeriod.setValue(btrPeriod);",
                    "refs.atchFileId.setValue(atchFileId);",
                    "refs.atchFileParentId.setValue(atchFileParentId);",
                    "",
                    "",
                    "// 첨부파일 유무에 따라 disabled 처리",
                    "if(!atchFileId){",
                    "    refs.btnDown.setDisabled(true);",
                    "}",
                    "// 첨부파일 유무에 따라 파일명 처리",
                    "if(!atchFileNm){",
                    "    refs.atchFileNm.setValue(\"첨부파일 없음\");",
                    "}else{",
                    "    refs.atchFileNm.setValue(atchFileNm);",
                    "}",
                    "",
                    "// 출장기간/장소 그리드 그리기",
                    "var gridScheduleInfoStore = vm.storeInfo.gridScheduleInfoStore;",
                    "refs.gridScheduleInfo.setStore(gridScheduleInfoStore);",
                    "gridScheduleInfoStore.loadData(gridScheduleInfoItems);"
                ]
