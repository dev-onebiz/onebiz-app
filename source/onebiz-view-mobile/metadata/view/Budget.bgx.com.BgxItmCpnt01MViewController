                "fn": "setExpItemInputData",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    cmm = refs.common_input_container,",
                    "    cmmRefs = cmm.getReferences();",
                    "",
                    "vm.set('expItemInputData', vm.get('expItemData'));\t//expItemData -> expItemInputData",
                    "",
                    "// codeList (계정과목)",
                    "if (vm.get('codeList')) {",
                    "    cmmRefs.xpnitKeyCd.getStore().add(vm.get('codeList.xpnitCodeList'));",
                    "}",
                    "cmmRefs.dgDsbInfoGrid.setHidden(true);  // 법인카드는 지급정보 X",
                    "cmmRefs.imgPanel.setHidden(true);\t\t// 사진",
                    "",
                    "",
                    "if (vm.get('readOnlyFlag')) {",
                    "    // 상세조회화면",
                    "    if (vm.get('expItemData').xpnitKeyCd == Constants.xpnitKeyCd.SUPPLIES_EXPENSE) {",
                    "        // 소모품비 - 영수증",
                    "        refs.cardEvidImag.setHidden(false);",
                    "    }",
                    "   ",
                    "    if(Ext.isEmpty(vm.get('expItemData.expItemUserInfo'))){",
                    "        cmmRefs.btnXpnitInfo.setDisabled(true); //직접 추가인 경우, 집행대상 조회 불가하도록 설정    ",
                    "    }",
                    "   ",
                    "    me.fnSetSummaryUserLabel();\t\t// 집행대상라벨",
                    "}",
                    "",
                    "if(Property.PROFILE == 'L' && !vm.get('readOnlyFlag')) {",
                    "    cmmRefs.webOnly.setHidden(false);",
                    "}"
                ]
            },
