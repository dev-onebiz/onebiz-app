                                                            "var btrStrtm = data.btrStrtm;",
                                                            "var btrEdtm = data.btrEdtm;",
                                                            "var btrStrtmFmt = DateUtils.parseTime(btrStrtm.substring(0, btrStrtm.length-2));// 출장출발시간",
                                                            "var btrEdtmFmt = DateUtils.parseTime(btrEdtm.substring(0,btrEdtm.length-2));\t\t// 출장도착시간",
                                                            "",
                                                            "if(psthPlcNm == ''){",
                                                            "    dptArvlPlcNm = dptPlcNm + \" -> \" + arvlPlcNm;",
                                                            "}else{",
                                                            "    dptArvlPlcNm = dptPlcNm + \" -> \" + psthPlcNm + \" -> \" + arvlPlcNm;",
                                                            "}",
                                                            "",
                                                            "var topInfo = '<div style=\"display:inline\"><div style=\"float:left;height:20px;\">' + btrDt + '</div><div style=\"float:right\">' + dptArvlPlcNm + '</div></div>'; // 리스트 아이템 상위 정보",
