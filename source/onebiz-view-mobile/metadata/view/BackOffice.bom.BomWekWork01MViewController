                    "                        padding : '0 20',",
                    "                        hidden : (reptList[i].reprtYn==Constants.yesNo.NO && reptList[i].weekWorkStcd != 20 && (Ext.isEmpty(reptList[i].strdt)&&Ext.isEmpty(reptList[i].edt)))? true : false,",
                    "                        layout : {",
                    "                            type : 'hbox',",
                    "                            align : 'stretch'",
                    "                        },",
                    "                        items : [",
                    "                            {",
                    "                                // 개발수행보고 라벨",
                    "                                xtype: 'label',",
                    "                                reference: 'currentReport'+i,",
                    "                                padding : '2.33 6.98 2.67 10.02',",
                    "                                margin : '0 4 0 0',",
                    "                                html : reptList[i].reprtYn == Constants.yesNo.YES? '개발수행보고' : '' ,",
                    "                                height : '22',",
                    "                                style: 'background:#FAFAFA 0% 0% no-repeat padding-box;border-radius:11px;font:normal normal normal 12px/36px Noto Sans;display:flex;justify-content:center;align-items:center;color:#666666',",
                    "                                hidden : reptList[i].reprtYn == Constants.yesNo.YES? false : true,",
                    "                            },",
                    "                            {",
                    "                                // 작업기간 라벨",
                    "                                xtype: 'label',",
                    "                                reference: 'dateLabel'+i,",
                    "                                padding : '2.33 6.98 2.67 10.02',",
                    "                                html : dateLabel ,",
                    "                                height : '22',",
                    "                                style: 'background:#FAFAFA 0% 0% no-repeat padding-box;border-radius:11px;font:normal normal normal 12px/36px Noto Sans;display:flex;justify-content:center;align-items:center;color:#666666',",
                    "                                hidden : (Ext.isEmpty(reptList[i].strdt)&&Ext.isEmpty(reptList[i].edt))? true : false,",
                    "                            },",
                    "                            {",
                    "                                xtype : 'spacer',",
                    "                                flex : 1,",
                    "                            },",
                    "                            {",
                    "                                // 진행률 라벨",
                    "                                xtype: 'label',",
                    "                                reference: 'pstlyPrgr'+i,",
                    "                                padding : '2.33 6.98 2.67 10.02',",
                    "                                html : '진척률:'+ reptList[i].pstlyPrgr + '%',",
                    "                                height : '22',",
                    "                                style: 'background:#FAFAFA 0% 0% no-repeat padding-box;border-radius:11px;font:normal normal normal 12px/36px Noto Sans;display:flex;justify-content:center;align-items:center;color:#666666',",
                    "                                hidden : reptList[i].weekWorkStcd != 20? true : false,",
                    "                            },",
                    "                        ]",
                    "                    },",
                    "                ]",
                    "            }",
                    "        );",
                    "    }",
                    "    refs.nextCtn.add({xtype : 'spacer', height : '70'});",
                    "    refs.allLabel.setHtml(reptList.length);",
                    "    refs.completeLabel.setHtml(completeCnt);",
                    "    refs.progressLabel.setHtml(progressCnt);",
                    "    refs.expectedLabel.setHtml(expectedCnt);",
                    "}",
                    "else{",
