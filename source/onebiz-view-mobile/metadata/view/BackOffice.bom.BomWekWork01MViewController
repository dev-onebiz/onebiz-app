            "userConfig": {
                "fn": "onSelectRept",
                "implHandler": [
                    "var me = this;",
                    "var vm = me.getViewModel();",
                    "var refs = me.getReferences();",
                    "",
                    "var boWekmTmrdId = vm.get('tmrdInfo.boWekmTmrdId');",
                    "",
                    "Ext.Ajax.request({",
                    "    headers: {",
                    "        viewId : me.getViewId(),",
                    "        serviceId : 'BomWekWorkSvc.findOneBomWekWorkEmpInfo'",
                    "    },",
                    "    jsonData : {",
                    "        boWekmTmrdId : boWekmTmrdId,",
                    "    },",
                    "    scope : me,",
                    "    success : function(response) {",
                    "        var res = Ext.JSON.decode(response.responseText);",
                    "        var strdt = res.tmrdInfo.strdt;",
                    "        var edt = res.tmrdInfo.edt;",
                    "",
                    "        var weekLabel = res.tmrdInfo.mnthWeekTmrdNm.substr(6);",
                    "        var dateLabel = strdt.substr(0,4) + '.' + strdt.substr(4,2) + '.' + strdt.substr(6,2) + '~' + edt.substr(0,4) + '.' + edt.substr(4,2) + '.' + edt.substr(6,2);",
                    "",
                    "        refs.weekLabel.setHtml(weekLabel);",
                    "        refs.dateLabel.setHtml(dateLabel);",
                    "",
                    "        vm.set('reptList',res.reptList);",
                    "        vm.set('tmrdInfo',res.tmrdInfo);",
                    "        vm.set('empInfo',res.empInfo);",
                    "",
                    "        if(res.tmrdInfo.wrtrState == 'TRUE'){",
                    "                if(res.tmrdInfo.leadBoWekmTmrdId == 0){",
                    "                    refs.writeBtn.setHidden(false);",
                    "                }",
                    "                else{",
                    "                    refs.writeBtn.setHidden(true);",
                    "                }",
                    "",
                    "                Ext.Ajax.request({",
                    "                    headers: {",
                    "                        viewId : me.getViewId(),",
                    "                        serviceId : 'BomWekWorkSvc.saveBomWekWorkState' // 저장",
                    "                    },",
                    "                    jsonData : {",
                    "                        boWekmTmrdId : res.tmrdInfo.boWekmTmrdId",
                    "                    },",
                    "                    scope : me,",
                    "                    success : function(response) {",
                    "                        me.onSelect();",
                    "                    }",
                    "                });",
                    "        }",
                    "        else{",
                    "                refs.writeBtn.setHidden(true);",
                    "                me.onSelect();",
                    "        }",
                    "",
                    "    }",
                    "});"
                ]
            },
