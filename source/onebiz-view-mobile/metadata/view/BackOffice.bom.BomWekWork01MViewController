                    "    refs.completeLabel.setHtml(0);",
                    "    refs.progressLabel.setHtml(0);",
                    "    refs.expectedLabel.setHtml(0);",
                    "    refs.nextCtn.add(",
                    "        {",
                    "            xtype : 'container',",
                    "            layout: {",
                    "                type: 'vbox',",
                    "                align: 'center'",
                    "            },",
                    "            style : 'background-color:white;border-radius : 8px; box-shadow:0px 4px 8px rgba(9,38,95,0.06)',",
                    "            height : '148',",
                    "            margin : '15 20',",
                    "            items :[",
                    "                {",
                    "                    xtype : 'image',",
                    "                    src : 'resources/images/icon-empty-content.png',",
