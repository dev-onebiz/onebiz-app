                    "        var stcdStyle = commonStyle;",
                    "        var dateLabel = '';",
                    "",
                    "        if(!Ext.isEmpty(reptList[i].strdt) && !Ext.isEmpty(reptList[i].edt)){",
                    "            var strdt = reptList[i].strdt.substr(4,2) + '.' + reptList[i].strdt.substr(6,2);",
                    "            var edt = reptList[i].edt.substr(4,2) + '.' + reptList[i].edt.substr(6,2);",
                    "            dateLabel = strdt + ' ~ ' + edt;",
                    "        }",
                    "        else if(!Ext.isEmpty(reptList[i].strdt)){",
                    "            var strdt = reptList[i].strdt.substr(4,2) + '.' + reptList[i].strdt.substr(6,2);",
                    "            dateLabel = strdt + ' ~';",
                    "        }",
                    "        else if(!Ext.isEmpty(reptList[i].edt)){",
                    "            var edt = reptList[i].edt.substr(4,2) + '.' + reptList[i].edt.substr(6,2);",
                    "            dateLabel = '~ ' + edt;",
                    "        }",
                    "",
                    "",
                    "        // 10:예정   20:진행\t90:완료",
                    "        if(reptList[i].weekWorkStcd == '10'){",
                    "            stcdStyle += expectedStyle;",
                    "            expectedCnt++;",
                    "        }",
                    "        else if(reptList[i].weekWorkStcd == '20'){",
                    "            stcdStyle += progressStyle;",
                    "            progressCnt++;",
                    "        }",
                    "        else{",
                    "            stcdStyle += completeStyle;",
                    "            completeCnt++;",
                    "        }",
                    "",
                    "        //8자가 넘어갈경우 자르기",
                    "        if((!Ext.isEmpty(reptList[i].rolNm)) && reptList[i].rolNm.length>=8){",
                    "            reptList[i].rolNm = reptList[i].rolNm.substr(0,\t8) + '...';",
                    "        }",
                    "        if((!Ext.isEmpty(reptList[i].prjNm)) && reptList[i].prjNm.length>=8){",
                    "            reptList[i].prjNm = reptList[i].prjNm.substr(0,\t8) + '...';",
                    "        }",
                    "",
                    "        refs.nextCtn.add(",
                    "            {",
