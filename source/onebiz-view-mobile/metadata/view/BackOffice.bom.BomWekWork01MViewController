                    "                reference: 'current'+i,",
                    "                layout: {",
                    "                    type: 'vbox',",
                    "                    align: 'start'",
                    "                },",
                    "                minHeight : '108',",
                    "                margin : '15 20',",
                    "                style : 'background-color:white;border-radius : 8px; box-shadow:0px 4px 8px rgba(9,38,95,0.06)',",
