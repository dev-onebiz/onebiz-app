                                    "var errMsg = me.formValid(afterchange);",
                                    "if(errMsg.length > 0){",
                                    "    Ext.Msg.alert('유효성 검증', errMsg);",
                                    "    refs.frmDetail.clearErrors();",
                                    "    return false;",
                                    "}",
                                    "",
