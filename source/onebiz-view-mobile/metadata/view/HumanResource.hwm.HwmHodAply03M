                                    "codeClass": null,
                                    "userConfig": {
                                        "designer|commentHeader": [
                                            "날짜 선택"
                                        ],
                                        "fn": "onDatefieldChange",
                                        "implHandler": [
                                            "var me = this,",
                                            "    vm = me.getViewModel(),",
                                            "    refs = me.getReferences();",
                                            "",
                                            "switch (datefield.name) {",
                                            "    case 'hodStrdt':",
                                            "        var date = refs.hodStrdt.getValue();",
                                            "        if (date) {",
                                            "            refs.hodEdt.setMinDate(date);",
                                            "            refs.hodEdt.setMaxDate(DateUtils.addDate(date, 1)); //다음날까지가 최대.",
                                            "        }",
                                            "        break;",
                                            "    case 'aplHodDt':",
                                            "        if(refs.aplHodDt.getValue()==null)",
                                            "            return;",
                                            "",
                                            "        var values = {",
                                            "            wrkDt : DateUtils.getDate(datefield.getValue()),",
                                            "            hrHrpmEmpId : vm.get('detail.hrHrpmEmpId'),",
                                            "            wrkStdt : DateUtils.getDate(DateUtils.getFirstDateOfMonth(datefield.getValue())),",
                                            "            wrkEddt : DateUtils.getDate(DateUtils.getLastDateOfMonth(datefield.getValue()))",
                                            "        };",
                                            "",
                                            "        Ext.Ajax.request({",
                                            "            headers : {",
                                            "                serviceId : 'HwmHodSvc.findAllHwmHodHist',",
                                            "                viewId : me.getViewId(),",
                                            "                scope : me,",
                                            "            },",
                                            "            jsonData : values,",
                                            "            success : function(response) {",
                                            "                var res = Ext.JSON.decode(response.responseText),",
                                            "                    hodtmMnth = 0;",
                                            "                for(var i=0; i<res.initData.length;i++){",
                                            "                    var value = res.initData[i];",
                                            "                    value.rplHodEdtm = ''+(value.rplHodEdtm/1 + (value.rplHodEdt-value.rplHodStrdt)*240000);",
                                            "                    var hodLength = value.rplHodEdtm.length;",
                                            "                    for(var j=0;j<6-hodLength;j++)",
                                            "                        value.rplHodEdtm = 0 + value.rplHodEdtm;",
                                            "                    //            if(this.data.wrkDt != value.hodDt) // 해당일 시간 빼기",
                                            "                    hodtmMnth += me.timeDiff(value.rplHodStrtm, value.rplHodEdtm);",
                                            "                    hodtmMnth = Math.floor(hodtmMnth*2)*0.5;",
                                            "                }",
                                            "                refs.hodtmMnth.setValue(hodtmMnth);",
                                            "                refs.hodStrdt.setValue(datefield.getValue());",
                                            "                refs.hodEdt.setValue(datefield.getValue());",
                                            "",
                                            "                refs.maxHodtmMnth.setValue((res.maxHodtm[0]==null || res.maxHodtm[0].maxHodtmMnth==null)? 0:res.maxHodtm[0].maxHodtmMnth);",
                                            "                refs.maxHodtmDay.setValue((res.maxHodtm[0]==null || res.maxHodtm[0].maxHodtmDay==null)? 0:res.maxHodtm[0].maxHodtmDay);",
                                            "                refs.mnth.setValue(hodtmMnth +\" / \"+refs.maxHodtmMnth.getValue());",
                                            "",
                                            "                if(vm.get('btnCancel') !=null){ //취소신청일 때",
                                            "                    refs.aplHodDt.setReadOnly(true);",
                                            "                    //            refs.hodStrdt.setReadOnly(true);",
                                            "                    refs.hodStrtm.setReadOnly(true);",
                                            "                    //            refs.hodEdt.setReadOnly(true);",
                                            "                    refs.hodEdtm.setReadOnly(true);",
                                            "                    refs.aplCntn.setValue('취소 신청하겠습니다.');",
                                            "                    refs.aplDvcd.setValue(Constants.wrkAplDvcd.CANCEL);",
                                            "                    refs.aplDvcdNm.setValue(CodeUtils.getText('HWM009', Constants.wrkAplDvcd.CANCEL));",
                                            "                    refs.hodStrtm.setValue(DateUtils.encodeDate(DateUtils.getTimeToDate(refs.hodStrtm.getValue()),\"H:i\"));",
                                            "                    refs.hodEdtm.setValue(DateUtils.encodeDate(DateUtils.getTimeToDate(refs.hodEdtm.getValue()),\"H:i\"));",
                                            "                    return;",
                                            "                } else{",
                                            "                    refs.aplHodDt.setReadOnly(false);",
                                            "                    //            refs.hodStrdt.setReadOnly(false);",
                                            "                    refs.hodStrtm.setReadOnly(false);",
                                            "                    //            refs.hodEdt.setReadOnly(false);",
                                            "                    refs.hodEdtm.setReadOnly(false);",
                                            "                }",
                                            "",
                                            "                if(res.maxHodtm[0] != null && res.maxHodtm[0].wrkDt != null){",
                                            "                    //            Ext.Msg.alert(\"안내\", \"휴일근무일자와 근무일자가 겹칩니다. <br/> 관리자에게 문의해주십시오.\");",
                                            "                    if(refs.btnReApply == null){",
                                            "                        refs.hodStrtm.setValue(DateUtils.parseTime('0900'));",
                                            "                        refs.hodEdtm.setValue(DateUtils.parseTime('1100'));",
                                            "                    }",
                                            "                }",
                                            "                else if(vm.get('btnReApply') == null){ //재기안이 아닐 때",
                                            "                    refs.hodStrtm.setValue(DateUtils.getTimeToDate('090000'));",
                                            "                    refs.hodEdtm.setValue(DateUtils.getTimeToDate('110000'));",
                                            "                } else {//근무기준이 존재하지만 재기안일 때",
                                            "                    refs.hodStrtm.setValue(DateUtils.encodeDate(DateUtils.getTimeToDate(refs.hodStrtm.getValue()),\"H:i\"));",
                                            "                    refs.hodEdtm.setValue(DateUtils.encodeDate(DateUtils.getTimeToDate(refs.hodEdtm.getValue()),\"H:i\"));",
                                            "                }",
                                            "                //총 시간외근무시간 표시 (금월/금주)",
                                            "                refs.totOvtHodMonthHr.setValue(res.totAdmtOvtHod.totOvtHodMonthHr);",
                                            "                refs.totOvtHodWeekHr.setValue(res.totAdmtOvtHod.totOvtHodWeekHr);",
                                            "",
                                            "                //결재진행중인 시간 표시",
                                            "                vm.set('criTime' , res.criTime); //기준시간(월)",
                                            "                vm.set('criTimeWeek' , res.criTimeWeek); //기준시간(주)",
                                            "                vm.set('totAdmtOvthodHr' , res.totAdmtOvtHod.totOvtHodMonthHr); //인정시간",
                                            "                vm.set('totAdmtOvthodWeekHr' , res.totAdmtOvtHod.totOvtHodWeekHr); //주인정시간",
                                            "                vm.set('totIngOvthodHr' , res.totIngOvthodHr); //현재 보고 결재 진행중이거나, 보고 전인 시간외근무 시간",
                                            "            }",
                                            "        });",
                                            "}"
                                        ],
                                        "name": "change",
                                        "scope": "me"
                                    },
