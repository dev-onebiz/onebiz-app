                                    "    frmDetail = refs.frmDetail,",
                                    "    approvalLineGrid = refs.approvalLineGrid,",
                                    "    aprHistId = null;",
                                    "",
                                    "// formData",
                                    "var afterchange = {} ;",
                                    "for(var field in frmDetail.getFields()) {",
                                    "    var item = frmDetail.getFields()[field];",
                                    "    if (Ext.isArray(item) || item.name == 'null') {",
                                    "        continue;",
                                    "    }",
                                    "    if ( Ext.isDate(item.getValue()) ) {",
                                    "        afterchange[item.name] =  DateUtils.encodeDate(item.getValue(), item.submitFormat);",
                                    "    } else {",
                                    "        afterchange[item.name] = item.getValue();",
