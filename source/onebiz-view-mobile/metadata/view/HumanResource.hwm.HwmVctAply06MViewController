            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "휴가신청 필수값 검증"
                ],
                "designer|params": [
                    "formData"
                ],
                "fn": "formValid",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    reNo = /[^\\d]/,",
                    "    errMsg = '';",
                    "",
                    "var applyInfo = refs.applyInfo.getValues(); //신청정보",
                    "var vctItems = refs.vctItems.innerItems;   //휴가정보",
                    "",
                    "//[START] 신청정보",
                    "",
                    "//휴가일자",
                    "if(Ext.isEmpty(applyInfo.aplVctStrdt) || Ext.isEmpty(applyInfo.aplVctEdt)){",
                    "    errMsg += '휴가 시작/종료일자를 다시 확인해주세요.<br>';",
                    "}",
                    "",
                    "//휴가일수",
                    "if(applyInfo.aplVctCnt === 0){",
                    "    errMsg += '휴가일수를 다시 확인해주세요.<br>';",
                    "}",
                    "",
                    "//사유확인",
                    "if(applyInfo.aplCntn){",
                    "    if(applyInfo.aplCntn.length > 65){",
                    "        errMsg += '사유의 길이를 확인해주세요.<br>';",
                    "    }",
                    "}",
                    "else{",
                    "    errMsg += '사유를 입력해주세요.<br>';",
                    "}",
                    "",
                    "//결재선",
                    "if(!vm.get('applyLine')){",
                    "    errMsg += '결재선을 선택해주세요.<br>';",
                    "}",
                    "",
                    "//[END]   신청정보",
                    "",
                    "",
                    "//[START] 각 휴가 유효성 검사",
                    "",
                    "var vctItem = null;",
                    "var formPanel = null;",
                    "var fields = null;",
                    "var field = null;",
                    "var subErrMsg = null;",
                    "for(var i = 0; i < vctItems.length; i++){",
                    "    subErrMsg = '';",
                    "",
                    "    vctItem = vctItems[i];",
                    "    formPanel = vctItem.down('formpanel');",
                    "    fields = formPanel.getFields();",
                    "",
                    "    formPanel.validate(); //유효성 검사에 걸린 항목들 focus처리해줌",
                    "",
                    "    for(var key in fields){",
                    "        field = fields[key];",
                    "        if (!field.isValid()) {",
                    "            subErrMsg += '- ' + field.getErrorMessage() + '<br>';",
                    "        }",
                    "    }",
                    "",
                    "    if(subErrMsg.length > 0){",
                    "        errMsg = errMsg + '<b>' + (i+1) + '번 휴가정보</b><br>' + subErrMsg;",
                    "    }",
                    "}",
                    "",
                    "if(!Ext.isEmpty(errMsg)){",
                    "    errMsg.substring(0, errMsg.lastIndexOf(\"<br>\"));",
                    "}",
                    "",
                    "//[END]   각 휴가 유효성 검사",
                    "",
                    "return errMsg;",
                    ""
                ]
            },
