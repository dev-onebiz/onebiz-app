                    "휴가 일수 계산"
                ],
                "fn": "fnCalcTotVct",
                "implHandler": [
                    "var me = this;",
                    "var refs = me.getReferences();",
                    "var vm = me.getViewModel();",
                    "",
                    "var vctItems = refs.vctItems.innerItems;",
                    "var vctItem = null;",
                    "var vctDtlDvcd1 = null;",
                    "var vctDtlDvcd2 = null;",
                    "var totVct = 0;",
                    "for(var i = 0; i < vctItems.length; i++){",
                    "    vctItem = vctItems[i];",
                    "",
                    "    vctDtlDvcd1 = vctItem.down('#vctDtlDvcd1').getValue();",
                    "    vctDtlDvcd2 = vctItem.down('#vctDtlDvcd2').getValue();",
                    "",
                    "    if(vctDtlDvcd1 == '01' || (vctDtlDvcd1 == '02' && vctDtlDvcd2 == '03')){ //하루종일인 경우 or 오전&오후 반차 모두 있을 경우",
                    "        totVct += 1;",
                    "    }",
                    "    else if((vctDtlDvcd1 == '02' && Ext.isEmpty(vctDtlDvcd2)) || vctDtlDvcd1 == '03'){ //오전or오후 반차 하나만 있을 경우",
                    "        totVct += 0.5;",
                    "    }",
                    "}",
                    "",
                    "refs.aplVctCnt.setValue(totVct); //휴가일수"
                ]
            },
            "configAlternates": {
                "fn": "string",
                "implHandler": "code",
                "designer|commentHeader": "comment"
            },
            "name": "fnCalcTotVct",
            "designerId": "4c51746a-334f-4f5b-9e78-5fd81c93ce69"
