                                    },
                                    "codeClass": null,
                                    "userConfig": {
                                        "designer|commentHeader": [
                                            "확인용 버튼"
                                        ],
                                        "fn": "onBtnCurrentPositionCheck",
                                        "implHandler": [
                                            "var me = this;",
                                            "var vm = this.getViewModel();",
                                            "",
                                            "// 더블클릭 오류 방지",
                                            "if(vm.get('isRun') === true) return;",
                                            "vm.set('isRun',true);",
                                            "",
                                            "// gps 센서 사용 불가 시 경과시간 확인용",
                                            "vm.set('gpsnum',0);",
                                            "",
                                            "// 현재 위치 확인 시 동작하는 타이머가 없으면 바로 닫을 때의 오류 발생 방지",
                                            "vm.set('timerStarted',true);",
                                            "",
                                            "// timer = setInterval(function(){",
                                            "//     // 경과 시간 확인을 위해 1씩 증가",
                                            "//     vm.set('gpsnum', vm.get('gpsnum') + 1);",
                                            "//     me.onBtnGpsAct('checkparams');",
                                            "// },1200);",
                                            "",
                                            "//TASK RUNNER SETTING",
                                            "vm.set('runnerGps', null);",
                                            "vm.set('taskGps', null);",
                                            "if(Ext.isEmpty(vm.get('runnerGps'))){",
                                            "",
                                            "    var runnerGps = new Ext.util.TaskRunner();",
                                            "    vm.set('cntGps', 0);",
                                            "",
                                            "    var taskGps = {",
                                            "",
                                            "        run : function(){",
                                            "            try{",
                                            "                if (vm.get('cntGps') < 5) {",
                                            "                    vm.set('cntGps',vm.get('cntGps') + 1);",
                                            "                    // gps api 호출",
                                            "                    me.onBtnGpsAct('checkparams');",
                                            "                    console.log('api 호출 중...');",
                                            "                } else {",
                                            "                    if(!Ext.isEmpty(vm.get('runnerGps'))){",
                                            "                        vm.get('runnerGps').stopAll();",
                                            "                    }",
                                            "                    console.log('timer stop - 정상');",
                                            "                }",
                                            "            } catch(e){",
                                            "                if(!Ext.isEmpty(vm.get('runnerGps'))){",
                                            "                    vm.get('runnerGps').stopAll();",
                                            "                }",
                                            "                console.log('timer stop - 오류');",
                                            "            }",
                                            "",
                                            "        },",
                                            "",
                                            "        interval : 1200",
                                            "",
                                            "    };",
                                            "",
                                            "    //TASK RUNNER SETTING",
                                            "    vm.set('runnerGps', runnerGps);",
                                            "    vm.set('taskGps', taskGps);",
                                            "",
                                            "    //TASK RUNNER START",
                                            "    runnerGps.start(taskGps);",
                                            "",
                                            "}"
                                        ],
                                        "name": "tap",
                                        "scope": "me"
                                    },
                                    "configAlternates": {
