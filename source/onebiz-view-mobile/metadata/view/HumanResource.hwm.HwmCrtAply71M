                "fn": "Initialize",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    aprHistId = component.initialConfig.aprHistId,",
                    "    record = component.initialConfig.record,",
                    "    command = component.command,",
                    "    docData = component.docData,",
                    "    afterchange = docData.afterchange,",
                    "    items = afterchange.items,",
                    "    aplTct = afterchange.aplTct, // 건수",
                    "    aplTotSmamt = afterchange.aplTotSmamt, // render 합계금액",
                    "    str = String(aplTotSmamt),",
                    "    aplTotSmamtRender = str.replace(/(\\d)(?=(?:\\d{3})+(?!\\d))/g, '$1,'),",
                    "    fromDoc = component.initialConfig.fromDoc;",
                    "",
                    "",
                    "items = me.recoveryFormRender(items);",
                    "",
                    "for(var i in items){",
                    "    items[i].isAply = true; // 결재 화면으로 사용하는 Items에서는 readOnly 처리하기 위해 사용하는 플래그",
                    "}",
                    "",
                    "",
                    "var data = {",
                    "    aplTct : aplTct,",
                    "    aplTotSmamtRender : aplTotSmamtRender",
                    "};",
                    "",
                    "vm.set('data', data);",
                    "vm.set('records', items);",
                    "vm.set('afterchange', afterchange);",
                    "vm.set('docData', docData);",
                    "vm.set('aplTct', aplTct); // 건수",
                    "vm.set('aplTotSmamtRender', aplTotSmamtRender); // render 합계금액",
                    "",
                    "vm.set('aprHistId', aprHistId);",
                    "vm.set('record', record);",
                    "",
                    "",
                    "var dataAft = docData.afterchange;",
                    "refs.rgdt.setHtml(record.rgdt);",
                    "",
                    "refs.rqpr.setValue(dataAft.rqpr);",
                    "",
                    "refs.headTitle.setHtml( \"근태정정신청\");",
                    "refs.aplDvcdNm.setValue(dataAft.aplDvcd == '01' ? '신청' : '취소신청');",
                    "refs.aplDvcd.setValue(dataAft.aplDvcd);",
                    "",
                    "",
                    "refs.aplWrkDt.setValue(me.dateFormat(dataAft.aplWrkDt,'date'));",
                    "refs.bfrCrrStrdt.setValue(me.dateFormat(dataAft.bfrCrrStrdt,'date'));",
                    "refs.bfrCrrStrtm.setValue(me.dateFormat(dataAft.bfrCrrStrtm,'time'));",
                    "refs.bfrCrrEdt.setValue(me.dateFormat(dataAft.bfrCrrEdt,'date'));",
                    "refs.bfrCrrEdtm.setValue(me.dateFormat(dataAft.bfrCrrEdtm,'time'));",
                    "refs.aplWrkStrdt.setValue(me.dateFormat(dataAft.aplWrkStrdt,'date'));",
                    "refs.aplWrkStrtm.setValue(me.dateFormat(dataAft.aplWrkStrtm,'time'));",
                    "refs.aplWrkEdt.setValue(me.dateFormat(dataAft.aplWrkEdt,'date'));",
                    "refs.aplWrkEdtm.setValue(me.dateFormat(dataAft.aplWrkEdtm,'time'));",
                    "refs.aplCntn.setValue(dataAft.aplCntn);",
                    "refs.aplDvcd.setValue(dataAft.aplDvcd);",
                    "",
                    "// 근무지정보",
                    "refs.hrWrkhEmpDayWkplcId.setValue(dataAft.hrWrkhEmpDayWkplcId);",
                    "if (dataAft.bfrHrWrkmEmpWkplcId == null || dataAft.bfrHrWrkmWkplcId == null || dataAft.bfrWkplcNm == null) {",
                    "    refs.bfrWkplcNm.setValue(' ');",
                    "} else {",
                    "    refs.bfrWkplcNm.setValue(dataAft.bfrWkplcNm);",
                    "    refs.bfrHrWrkmEmpWkplcId.setValue(dataAft.bfrHrWrkmEmpWkplcId);",
                    "    refs.bfrHrWrkmWkplcId.setValue(dataAft.bfrHrWrkmWkplcId);",
                    "}",
                    "",
                    "if (dataAft.aplHrWrkmEmpWkplcId == null || dataAft.aplHrWrkmWkplcId == null || dataAft.aplWkplcNm == null) {",
                    "    refs.aplWkplcNm.setValue(' ');",
                    "} else {",
                    "    refs.aplWkplcNm.setValue(dataAft.aplWkplcNm);",
                    "    refs.aplHrWrkmEmpWkplcId.setValue(dataAft.aplHrWrkmEmpWkplcId);",
                    "    refs.aplHrWrkmWkplcId.setValue(dataAft.aplHrWrkmWkplcId);",
                    "}",
                    "",
                    "",
                    "refs.bfrCrrStrtm.el.select('.x-error-el').setStyle('margin','0px');",
                    "refs.bfrCrrEdtm.el.select('.x-error-el').setStyle('margin',\t'0px');",
                    "",
                    "refs.aplWrkStrtm.el.select('.x-error-el').setStyle('margin','0px');",
                    "refs.aplWrkEdtm.el.select('.x-error-el').setStyle('margin',\t'0px');",
