                "fn": "onContainerInitialize",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    config = component.config,",
                    "    pViewData = config.param,",
                    "    standardCombobox = config.standardCombobox;\t\t//기준 콤보박스 설정함 . [결의서-사업부문 , 여비정산서-계정과목 ]",
                    "",
                    "if (!pViewData || !pViewData.expItemInputData) {",
                    "    me.onBtnClose();",
                    "}",
                    "",
                    "vm.set('readOnlyFlag', pViewData.readOnlyFlag);",
                    "vm.set('xpnitKeyCdReadOnlyFlag', pViewData.xpnitKeyCdReadOnlyFlag);",
                    "vm.set('expItemInputData', pViewData.expItemInputData);",
                    "vm.set('StandardCombobox', standardCombobox);",
                    "",
                    "refs.extenalEmp.setDisabled(true);",
                    "",
                    "// if( vm.get('expItemInputData.bgBudcBsnsId') && vm.get('expItemInputData.xpnitKeyCd')){",
                    "// close 할때 xpnitKeyCd 바인딩을 막기위함",
                    "vm.set('initXpnitKeyCd', pViewData.expItemInputData.xpnitKeyCd);",
                    "//     me.onSelect();",
                    "// }",
                    "",
                    "// 사용자",
                    "if (pViewData.expItemUserInfo) {",
                    "    var userInfos = pViewData.expItemUserInfo,",
                    "        userList = [],",
                    "        innerEmpeCnt = 0,",
                    "        outerEmpeCnt = 0;",
                    "",
                    "    for(var i in userInfos) {",
                    "        userList.push(userInfos[i]);",
                    "        refs.userCnt.add(Ext.create('BgxNfmAply52MItems', {",
                    "            data : userInfos[i]",
                    "        }));",
                    "        switch (userInfos[i].stfDvcd) {",
                    "            case Constants.stfDvcd.IN :",
                    "                innerEmpeCnt++;",
                    "                break;",
                    "            case Constants.stfDvcd.OUT :",
                    "                outerEmpeCnt++;",
                    "                break;",
                    "        }",
                    "    }",
                    "",
                    "    vm.set('userList', userList);",
                    "    vm.set('tct', userInfos.length);",
                    "    vm.set('innerEmpeCnt', innerEmpeCnt);",
                    "    vm.set('outerEmpeCnt', outerEmpeCnt);",
                    "",
                    "    var data = {",
                    "        bgBudcXpnitYyId : userInfos[0].bgBudcXpnitYyId,",
                    "        text : vm.get('expItemInputData.xpnitKeyNm'),",
                    "        value : vm.get('expItemInputData.xpnitKeyCd'),",
                    "        xpnitKeyCd : vm.get('expItemInputData.xpnitKeyCd')",
                    "    };",
                    "    refs.xpnitKeyCd.setValue(data);",
                    "} else {",
                    "    vm.set('tct', 0);",
                    "    vm.set('innerEmpeCnt', 0);",
                    "    vm.set('outerEmpeCnt', 0);",
                    "}",
                    "",
                    "/* 배정받은 사업부문들만 가져와서 세팅. / 기준 */",
                    "switch (vm.get('StandardCombobox')) {",
                    "    case Constants.nfcmAplyTrgtSttCbx.BSNS:",
                    "        me.fnMakeCbxAssignedBsns();",
                    "        break;",
                    "    default:",
                    "        break;",
                    "}"
                ],
                "name": "initialize",
                "scope": "me"
            },
