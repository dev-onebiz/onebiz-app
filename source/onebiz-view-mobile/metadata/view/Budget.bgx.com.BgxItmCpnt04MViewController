            "userConfig": {
                "designer|commentHeader": [
                    "BgxItmCpnt32M"
                ],
                "fn": "setExpItemInputData",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    cmm = refs.common_input_container,",
                    "    cmmRefs = cmm.getReferences();",
                    "",
                    "vm.set('expItemInputData', vm.get('expItemData'));",
                    "",
                    "// codeList (계정과목)",
                    "if (vm.get('codeList')) {",
                    "    cmmRefs.xpnitKeyCd.getStore().add(vm.get('codeList.xpnitCodeList'));",
                    "}",
                    "",
                    "if (vm.get('readOnlyFlag')) {",
                    "    // 상세조회화면",
                    "    refs.cardEvidImg.setHidden(false);\t// 영수증 버튼",
                    "    cmmRefs.imgPanel.setHidden(true);\t// 사진",
                    "    ",
                    "    if(Ext.isEmpty(vm.get('expItemData.expItemUserInfo'))){",
                    "        cmmRefs.btnXpnitInfo.setDisabled(true); //직접 추가인 경우, 집행대상 조회 불가하도록 설정",
                    "    }",
                    "",
                    "    me.fnSetSummaryUserLabel();\t\t\t// 집행대상라벨",
                    "",
                    "    // 지급정보",
                    "    var dgDsbInfo = vm.get('applyInfo.dgDsbInfo');",
                    "    if (dgDsbInfo) {",
                    "        var bcncSeq = dgDsbInfo.bcncSeq,\t\t// 사번",
                    "            bcncDpwnm = dgDsbInfo.bcncDpwnm;\t// 이름",
                    "        cmmRefs.dgDsbInfoGrid.setHidden(true);",
                    "        cmmRefs.dgDsbInfoCont.setHidden(false);",
                    "        cmmRefs.dgDsbInfoLabel.setHtml(bcncSeq + ' / ' + bcncDpwnm);",
                    "    }",
                    "} else {",
                    "    // 신청서 작성",
                    "    vm.set('applyInfo.dgDsbInfo.bcncSeq', SecurityUtils.getPrincipal().hrHrpmEmpId);\t//지급정보 초기값 (본인)",
                    "}",
                    "",
                    "if(Property.PROFILE == 'L' && !vm.get('readOnlyFlag')) {",
                    "    cmmRefs.webOnly.setHidden(false);",
                    "}"
                ]
            },
