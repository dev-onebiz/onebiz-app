        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "집행대상라벨"
                ],
                "fn": "fnSetSummaryUserLabel",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    expItemData = Ext.clone(vm.get('expItemData')),",
                    "    userRecords = expItemData.expItemUserInfo,",
                    "    trnsAmt = expItemData.trnsAmt,  //공급가액",
                    "    innerEmpeCnt = 0,",
                    "    outerEmpeCnt = 0,",
                    "    rtnStr = '',",
                    "    defaultStr = '승인금액',",
                    "    xpnitKeyCd = expItemData.xpnitKeyCd,",
                    "    xpnitKeyNm = expItemData.xpnitKeyNm;",
                    "",
                    "if (userRecords) {",
                    "    for (var i = 0; i < userRecords.length; i++) {",
                    "        var record = userRecords[i];",
                    "        if (record.stfDvcd == Constants.stfDvcd.IN) {",
                    "            innerEmpeCnt++;",
                    "        } else {",
                    "            outerEmpeCnt++;",
                    "        }",
                    "    }",
                    "    var amtByUser = (innerEmpeCnt == 0 ? 0 : Math.round(trnsAmt / innerEmpeCnt));",
                    "",
                    "    rtnStr = Ext.String.format('<span style = \"line-height : 20px;\">집행대상 ( 총 <span style =\"color : red;\">{0}</span>명 ) <br>'",
                    "                               + '[ 내부직원 {1} 명 / 외부직원 {2} 명 ] <br>'",
                    "                               + '<span style = \"color :gray;\" >[{3} 기준 1인당 {4}원]</span></span>',",
                    "                               userRecords.length, innerEmpeCnt, outerEmpeCnt, defaultStr ,",
                    "                               amtByUser.toString().replace(/\\B(?=(\\d{3})+(?!\\d))/g,\",\"));",
                    "",
                    "}",
                    "vm.set('expItemData.summaryUserLabel', rtnStr);"
                ]
            },
            "configAlternates": {
                "designer|commentHeader": "comment",
                "fn": "string",
                "implHandler": "code"
            },
            "name": "fnSetSummaryUserLabel",
            "designerId": "d9de383e-46f3-4f01-8ef5-ee56803b19cd"
        }
    ]
