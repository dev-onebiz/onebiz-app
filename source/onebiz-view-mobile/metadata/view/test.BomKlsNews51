                                            "codeClass": null,
                                            "userConfig": {
                                                "fn": "onCheckboxChange1",
                                                "implHandler": [
                                                    "\t\tvar me = this;",
                                                    "        var vm = me.getViewModel();",
                                                    "        var refs = me.getReferences();",
                                                    "",
                                                    "        var form = refs.form;",
                                                    "        var cnt = form.items.items[0].items.length;",
                                                    "        var all = refs.all.getChecked();",
                                                    "        ",
                                                    "        if(checkbox==refs.all){",
                                                    "            for(var i=0; i<cnt; i+=2){",
                                                    "                form.items.items[0].items.items[i].items.items[0].valueOf().setChecked(all);",
                                                    "",
                                                    "                if(form.items.items[0].items.items[i].items.length==1){",
                                                    "                    break;",
                                                    "                }",
                                                    "",
                                                    "                form.items.items[0].items.items[i].items.items[2].valueOf().setChecked(all);",
                                                    "            }",
                                                    "        }",
                                                    "       ",
                                                    "        else{",
                                                    "             if(newValue===false){",
                                                    "                refs.all.suspendEvents();",
                                                    "                refs.all.setChecked('false');",
                                                    "                refs.all.resumeEvents(true);",
                                                    "            }",
                                                    "            else{",
                                                    "                for(var i=0; i<cnt; i+=2){",
                                                    "                    if(form.items.items[0].items.items[i].items.items[0].valueOf().getChecked()===false){",
                                                    "                        return;",
                                                    "                    }",
                                                    "                    if(form.items.items[0].items.items[i].items.length==1){",
                                                    "                        break;",
                                                    "                    }",
                                                    "                    if(form.items.items[0].items.items[i].items.items[2].valueOf().getChecked()===false){",
                                                    "                        return;",
                                                    "                    }",
                                                    "                }",
                                                    "                refs.all.setChecked('true');",
                                                    "            }",
                                                    "        }"
                                                ],
                                                "name": "change",
                                                "scope": "me"
                                            },
