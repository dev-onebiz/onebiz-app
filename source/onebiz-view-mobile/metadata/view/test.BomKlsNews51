                                    "cn": [
                                        {
                                            "type": "viewcontrollereventbinding",
                                            "reference": {
                                                "name": "listeners",
                                                "type": "array"
                                            },
                                            "codeClass": null,
                                            "userConfig": {
                                                "fn": "onButtonTapClose",
                                                "implHandler": [
                                                    "    var me = this;",
                                                    "    var refs = me.getReferences();",
                                                    "    var form = refs.form;",
                                                    "    var view = me.getView();",
                                                    "",
                                                    "    var params = {};",
                                                    "    var cnt = form.items.items[0].items.length;",
                                                    "",
                                                    "    var idx = 0;",
                                                    "",
                                                    "    params.boKlsmKywdId = new Array();",
                                                    "    params.checked = new Array();",
                                                    "",
                                                    "    for(var i=0; i<cnt; i+=2){",
                                                    "        var rows = form.items.items[0].items.items[i].items.length;",
                                                    "",
                                                    "        params.boKlsmKywdId.push(form.items.items[0].items.items[i].items.items[0].getId().replace('k',''));",
                                                    "        params.checked.push(form.items.items[0].items.items[i].items.items[0].getChecked());",
                                                    "        ",
                                                    "        if(form.items.items[0].items.items[i].items.length==1) break;",
                                                    "        ",
                                                    "        params.boKlsmKywdId.push(form.items.items[0].items.items[i].items.items[2].getId().replace('k',''));",
                                                    "        params.checked.push(form.items.items[0].items.items[i].items.items[2].getChecked());",
                                                    "    }",
                                                    "",
                                                    "    Ext.Ajax.request({",
                                                    "            headers : {",
                                                    "                serviceId : 'BomKlsSvc.saveKlsKywd',",
                                                    "                viewId : me.getViewId()",
                                                    "            },",
                                                    "            jsonData : params,",
                                                    "            success : function(response) {",
                                                    "",
                                                    "            }",
                                                    "        });",
                                                    "    view.fireEvent('selected',view);",
                                                    "    view.close();",
                                                    "",
                                                    ""
                                                ],
                                                "name": "tap",
                                                "scope": "me"
                                            },
                                            "configAlternates": {
                                                "fn": "string",
                                                "implHandler": "code",
                                                "name": "string",
                                                "scope": "string"
                                            },
                                            "name": "onButtonTapClose",
                                            "designerId": "43394129-e089-4b0e-867b-ddf691ea7211"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "viewcontrollereventbinding",
                    "reference": {
                        "name": "listeners",
                        "type": "array"
                    },
                    "codeClass": null,
                    "userConfig": {
                        "fn": "onContainerPainted",
                        "implHandler": [
                            "var me = this,",
                            "    refs = me.getReferences(),",
                            "    values = {",
                            "        length : 0,",
                            "    };",
                            "var vm = me.getViewModel();",
                            "",
                            "var form = refs.form;",
                            "var cnt = form.items.items[0].items;",
                            "var all = refs.all.getChecked();",
                            "",
                            "var x = 0;",
                            "Ext.Ajax.request({",
                            "    headers : {",
                            "        serviceId : 'BomKlsSvc.findAllKlsKywd',",
                            "        //viewId : me.view.parent.id",
                            "    },",
                            "    jsonData : values,",
                            "    success : function(response) {",
                            "        var content = Ext.JSON.decode(response.responseText).content;",
                            "        for(var i=0; i<content.length; i+=2){",
                            "            refs.keyCtn.add({",
                            "",
                            "                xtype: 'container',",
                            "                width: '100%',",
                            "                layout: 'hbox',",
                            "                items: [",
                            "                    {",
                            "                        xtype: 'checkbox',",
                            "                        id : 'k' + content[i].boKlsmKywdId,",
                            "                        flex: 3,",
                            "                        label: content[i].keyword,",
                            "                        labelAlign: 'right',",
                            "                        labelWidth: '80%',",
                            "                        checked : (content[i].checked=='TRUE')? true : false,",
                            "                        listeners: {",
                            "                            change : 'onCheckboxChange',",
                            "                        },",
                            "                    },",
                            "                    {",
                            "                        xtype: 'spacer',",
                            "                        flex: 1",
                            "                    },",
                            "                    {",
                            "                        xtype: 'checkbox',",
                            "                        id : 'k' +  content[i+1].boKlsmKywdId,",
                            "                        flex: 3,",
                            "                        label: content[i+1].keyword,",
                            "                        labelAlign: 'right',",
                            "                        labelWidth: '80%',",
                            "                        checked : (content[i+1].checked=='TRUE')? true : false,",
                            "                        listeners: {",
                            "                            change : 'onCheckboxChange',",
                            "                        },",
                            "                    }",
                            "                ]",
                            "            });",
                            "            refs.keyCtn.add({",
                            "",
                            "                xtype: 'container',",
                            "                height: '5%',",
                            "                width: '100%',",
                            "                layout: 'hbox'",
                            "",
                            "            });",
                            "            if((content.length&1) && (i == content.length-3)){",
                            "                refs.keyCtn.add({",
                            "",
                            "                    xtype: 'container',",
                            "                    width: '100%',",
                            "                    layout: 'hbox',",
                            "                    items: [",
                            "                        {",
                            "                            xtype : 'checkbox',",
                            "                            id : 'k' +  content[i+2].boKlsmKywdId,",
                            "                            width : '42.85%',",
                            "                            label : content[i+2].keyword,",
                            "                            labelAlign: 'right',",
                            "                            labelWidth: '80%',",
                            "                            checked : (content[i+2].checked=='TRUE')? true : false,",
                            "                            listeners: {",
                            "                                change : 'onCheckboxChange',",
                            "                            },",
                            "                        },",
                            "",
                            "                    ]",
                            "                });",
                            "                refs.keyCtn.add({",
                            "",
                            "                    xtype: 'container',",
                            "                    height: '5%',",
                            "                    width: '100%',",
                            "                    layout: 'hbox'",
                            "",
                            "                });",
                            "                break;",
                            "            }",
                            "        }",
                            "        for(var i=0; i<cnt.length; i+=2){",
                            "            if(form.items.items[0].items.items[i].items.items[0].valueOf().getChecked()===false){",
                            "                x++;",
                            "            }",
                            "            if(form.items.items[0].items.items[i].items.length==1){",
                            "                break;",
                            "            }",
                            "            if(form.items.items[0].items.items[i].items.items[2].valueOf().getChecked()===false){",
                            "                x++;",
                            "            }",
                            "        }",
                            "        if(x===0){",
                            "            refs.all.setChecked('true');",
                            "        }",
                            "    }",
                            "});"
                        ],
                        "name": "painted",
                        "scope": "me"
                    },
                    "configAlternates": {
                        "fn": "string",
                        "implHandler": "code",
                        "name": "string",
                        "scope": "string"
                    },
                    "name": "onContainerPainted",
                    "designerId": "658bdc7f-0c0c-4278-9ad7-637e9bd990a8"
                }
            ]
        }
    ]
