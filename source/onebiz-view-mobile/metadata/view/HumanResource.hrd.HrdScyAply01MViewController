            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "나의활동 지수 데이터 조회"
                ],
                "fn": "onDashbrdSelect",
                "implHandler": [
                    " var me = this,",
                    "     vm = me.getViewModel(),",
                    "     refs = me.getReferences(),",
                    "     year = vm.get('year'),",
                    "     params = {",
                    "         schYear : year",
                    "     };",
                    "",
                    "// Service 호출",
                    "Ext.Ajax.request({",
                    "    headers : {",
                    "        viewId : this.getView().xtype, \t\t\t\t\t// userAlias",
                    "        serviceId : 'HrdScySvc.findAllHrdScyCtrb' \t// 나의활동지수",
                    "    },",
                    "    jsonData : params,",
                    "    scope : me,",
                    "    success : function(response, opts) {",
                    "        var result = Ext.JSON.decode(response.responseText); // 서버응답결과 JSON 변환",
                    "",
                    "        // 나의 활동지수",
                    "        if (result) {",
                    "            var scyMyInfo = result.scyMyInfo;",
                    "            // 직급별 순위",
                    "            var scyMyRank = result.scyMyRank;",
                    "            // 직급별 총 인원수",
                    "            var scyTotalRank = result.scyTotalRank;",
                    "",
                    "            vm.set('scyMyInfo', scyMyInfo);",
                    "            vm.set('scyMyRank', scyMyRank);",
                    "            vm.set('scyTotalRank', scyTotalRank);",
                    "",
                    "            refs.stnInfo.setTitle('나의활동지수(' + '<span style=\"color:#CB2B11\">' + year + '</span>' + ')');",
                    "",
                    "            // 활동횟수",
                    "            refs.actCnt.setHtml(scyMyInfo[0].actCnt);",
                    "            // 봉사시간",
                    "            if(Ext.isEmpty(scyMyInfo[0].admtTm)){",
                    "                scyMyInfo[0].admtTm = 0;",
                    "            }",
                    "            refs.admtTm.setHtml(scyMyInfo[0].admtTm);",
                    "            // 직급별 순위/총 인원수",
                    "            refs.rank.setHtml(scyMyRank[0].rank);",
                    "            refs.total.setHtml(scyTotalRank);",
                    "",
                    "        }",
                    "",
                    "    },",
                    "    failure : function(response, opts){",
                    "        // Service 실패 했을 경우 기능",
                    "        Ext.Msg.show({",
                    "            title : '실패',",
                    "            message : '나의활동지수 데이터 조회 도중 에러가 발생했습니다.',",
                    "            buttons : Ext.MessageBox.YES,",
                    "            fn: function(btn){}",
                    "        });",
                    "    }",
                    "});"
                ]
            },
