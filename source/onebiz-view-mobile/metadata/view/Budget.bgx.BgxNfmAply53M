                    "cn": [
                        {
                            "type": "viewcontrollereventbinding",
                            "reference": {
                                "name": "listeners",
                                "type": "array"
                            },
                            "codeClass": null,
                            "userConfig": {
                                "designer|commentHeader": [
                                    "확인"
                                ],
                                "fn": "onBtnConfirm",
                                "implHandler": [
                                    "var me = this,",
                                    "    vm = me.getViewModel(),",
                                    "    refs = me.getReferences(),",
                                    "    data = vm.get('extRctInfo');",
                                    "",
                                    "if (!data) {",
                                    "    data = {};",
                                    "}",
                                    "",
                                    "data.nfcmEvidKndcd = Constants.nfcmEvidKndcd.ETC_RCT; //기타영수증",
                                    "data.trnsDt = DateUtils.getDate(data.trnsDt);",
                                    "/* [요건] 1. 기타영수증은 default 시간값을 00 시로 함.",
                                    "     *       2. 승인금액 = 공급가액 이며, 부가세는 0원이다.",
                                    "     * */",
                                    "data.trnsHr = '000000';",
                                    "data.splyAmt = data.trnsAmt;",
                                    "data.stxat = 0;",
                                    "",
                                    "var form = refs.inputForm,",
                                    "    errMsg = '';",
                                    "",
                                    "if(!form.validate()) {",
                                    "    for(var i = 0; i < form.getFields().null.length; i++) {",
                                    "        var field = form.getFields().null[i];",
                                    "        if (!field.isValid()) {",
                                    "            var tmp = field.getErrorMessage();",
                                    "            if (tmp.indexOf('This field is required') != -1) {",
                                    "                errMsg += '- ' + field.up('container').down('displayfield').getHtml() + ' 을(를) 입력해주세요.<br>';",
                                    "            } else if (tmp == \"Value does not match the required format\") {",
                                    "                errMsg += '- ' + field.up('container').down('displayfield').getHtml() + ' 형식을 올바르게 입력해주세요.<br>';",
                                    "            } else {",
                                    "                errMsg += '- ' + field.up('container').items.items[0].getHtml() + ' : ' + tmp + '<br>';",
                                    "            }",
                                    "        }",
                                    "    }",
                                    "",
                                    "    Ext.Msg.show({",
                                    "        buttons :  {",
                                    "            yes : {itemId : Ext.MessageBox.YES, text : '확인'}",
                                    "        },",
                                    "        title : '알림',",
                                    "        message : errMsg,",
                                    "        alwaysOnTop : true,",
                                    "        fn : function(btn) {",
                                    "            return;",
                                    "        }",
                                    "    });",
                                    "//     return;",
                                    "} else {",
                                    "    var errMsg = '';",
                                    "    //부모 컴포넌트에서 입력된 마감일자 체크함.",
                                    "    if(!vm.get('pViewData.fndcDt')){",
                                    "        errMsg += '- 마감일자가 없습니다. 담당자에게 확인부탁드립니다.<br>';",
                                    "    }",
                                    "    if( data.trnsDt  <= vm.get('pViewData.fndcDt') ){",
                                    "        errMsg += '- 해당 승인일자는 마감일자가 지나 신청이 불가능합니다.<br>';",
                                    "    }",
                                    "    //year 공통컴포넌트 속성상 Date 형식으로 들어오는경우가 있어,String으로 변환",
                                    "    var bsnsYy = vm.get('pViewData.bsnsYy');",
                                    "    if(Ext.isDate(vm.get('pViewData.bsnsYy'))){",
                                    "      bsnsYy = vm.get('pViewData.bsnsYy').getFullYear().toString();",
                                    "    }",
                                    "",
                                    "    if( data.trnsDt.substr(0,4) != bsnsYy ){",
                                    "      errMsg += '- [ '+ bsnsYy +'년 ] '+'거래 내역을 신청하시기 바랍니다.<br>';",
                                    "    }",
                                    "",
                                    "    // 승인일자",
                                    "    var today = Ext.Date.format(new Date(),'Ymd');",
                                    "    if (data.trnsDt.length != 8) {",
                                    "        errMsg += '- 승인일자를 올바르게 입력해주세요.<br>';",
                                    "    } else if (today < data.trnsDt) {",
                                    "        // 미래일",
                                    "        errMsg += '- 승인일자를 올바르게 입력해주세요.<br>';",
                                    "    } else if (Number(data.trnsDt.substr(4,2)) < 1 || Number(data.trnsDt.substr(4,2)) > 12){",
                                    "        // 월",
                                    "        errMsg += '- 승인일자를 올바르게 입력해주세요.<br>';",
                                    "    } else if (Number(data.trnsDt.substr(6,2)) < 1 || Number(data.trnsDt.substr(6,2)) > new Date(data.trnsDt.substr(0,4), data.trnsDt.substr(4,2), 0).getDate()) {",
                                    "        // 일",
                                    "        errMsg += '- 승인일자를 올바르게 입력해주세요.<br>';",
                                    "    } else if (data.trnsDt < 20200701) {",
                                    "        /* 20.07.01 예산오픈으로 인한 분기처리 */",
                                    "        errMsg += '- 2020-07-01 이전은 [경비노트]-[기타영수증] 메뉴를 이용바랍니다.<br>';",
                                    "    }",
                                    "",
                                    "    // 승인금액 (1 ~ 9,999,999,999,999)",
                                    "    var trnsAmt = data.trnsAmt;",
                                    "    if (trnsAmt.indexOf('.') != -1 || trnsAmt <= 0 || trnsAmt > 9999999999999) {",
                                    "        errMsg += '- 승인금액을 올바르게 입력해주세요.';",
                                    "    }",
                                    "",
                                    "    if (!errMsg) {",
                                    "        me.getView().fireEvent('onConfirm', data);",
                                    "        me.getView().close();",
                                    "    } else {",
                                    "        Ext.Msg.show({",
                                    "            buttons :  {",
                                    "                yes : {itemId : Ext.MessageBox.YES, text : '확인'}",
                                    "            },",
                                    "            title : '알림',",
                                    "            message : errMsg,",
                                    "            alwaysOnTop : true,",
                                    "            fn : function(btn) {",
                                    "                return;",
                                    "            }",
                                    "        });",
                                    "    }",
                                    "}",
                                    ""
                                ],
