            "userConfig": {
                "fn": "fnReadAllPush",
                "implHandler": [
                    "var me = this;",
                    "var refs = me.getReferences();",
                    "",
                    "var pushList = [];",
                    "var records = refs.pushGrid.getJsonAllRecords();",
                    "for(var i = 0; i < records.length; i++){",
                    "    if(records[i].rvStcd != Constants.rvStcdType.RV_COMPLETE){",
                    "        pushList.push(records[i]);",
                    "    }",
                    "}",
                    "",
                    "if(pushList.length <= 0){",
                    "    Ext.Msg.alert('알림', '이미 모든 알림이 읽음 처리 되었습니다.');",
                    "    return;",
                    "}",
                    "",
                    "var values = {",
                    "    pushList : pushList",
                    "};",
                    "",
                    "// saveAllPushRvStcd",
                    "Ext.Ajax.request({",
                    "    headers : {",
                    "        serviceId : 'BomTasSvc.saveAllPushRvStcd',",
                    "        viewId : me.getViewId(),",
                    "        scope : me,",
                    "    },",
                    "    jsonData : values,",
                    "    success : function(response) {",
                    "        Ext.Msg.alert('알림', '모두 읽음 처리 되었습니다.');",
                    "        me.onSelect();",
                    "    }",
                    "});"
                ]
            },
            "configAlternates": {
                "fn": "string",
                "implHandler": "code"
            },
            "name": "fnReadAllPush",
            "designerId": "8ebbfdca-2843-4030-acc8-490d78a1c0da"
