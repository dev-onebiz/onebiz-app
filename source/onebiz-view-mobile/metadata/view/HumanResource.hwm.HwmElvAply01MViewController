            "codeClass": null,
            "userConfig": {
                "designer|params": [
                    "params"
                ],
                "fn": "search",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    params = params || {},",
                    "    store = vm.storeInfo.Store;",
                    "",
                    "    params.hrHrpmEmpId = SecurityUtils.getPrincipal().hrHrpmEmpId;",
                    "",
                    "",
                    "",
                    "var dateCompont = ['startDate',",
                    "                   'endDate'",
                    "                  ];",
                    "",
                    "if(refs[dateCompont[0]].getValue() > refs[dateCompont[1]].getValue()){",
                    "    Ext.Msg.alert('확인','시작일이 종료일보다 클 수 없습니다.');",
                    "    return;",
                    "",
                    "}",
                    "",
                    "for(var key in dateCompont ){",
                    "    var dateObj = refs[dateCompont[key]];",
                    "    var date = dateObj.getValue();",
                    "    var tempMonth = date.getMonth()+1 ;",
                    "    tempMonth += \"\";",
                    "    tempMonth = (tempMonth.length == 1 ? \"0\" :\"\") + tempMonth;",
                    "",
                    "",
                    "    var tempDate = date.getDate();",
                    "    tempDate += \"\";",
                    "    tempDate = (tempDate.length == 1 ? \"0\" :\"\") + tempDate;",
                    "",
                    "    params[dateCompont[key]] = date.getFullYear() +\"\" + tempMonth + \"\"+tempDate;",
                    "",
                    "}",
                    "",
                    "",
                    "if(params =={}){",
                    "    store.getProxy().extraParams.page = 1;",
                    "    var toolbar = refs.grid.getPlugins()[0];",
                    "    toolbar.setCurrentPage(1);",
                    "",
                    "}else{",
                    "store.getProxy().extraParams = params;",
                    "",
                    "}",
                    "",
                    "store.removeAll();",
                    "store.loadPage(1);",
                    "",
                    ""
                ]
            },
