        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|params": [
                    "config",
                    "docData"
                ],
                "fn": "settingValues",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences();",
                    "",
                    "/** [필독]",
                    "     *  AS_IS 공통 결재 로직",
                    "     *    - 신청서에 출력될 정보를 DOC_DATA 에 JSON 형식으로 저장하고",
                    "     *    , 추후 출력할땐 DOC_DATA에 저장된 데이터를 가지고 출력을 한다.",
                    "     *     단점 : 유지보수가 너무 힘들다 [ 데이터의 수정이 있어야할때 , JSON replace 를 해야한다.]",
                    "     *           계좌번호등 암호화가 필요한 중요정보에 대한 따로 처리가 필요함.",
                    "     *  TO_BE 공통 결재 로직",
                    "     *    - 기안시에는 DOC_DATA 에 JSON 형식으로 저장하되 [-> 추후 문제있을시 이력으로 사용]",
                    "     *     , 추후 출력할땐 업무단 SVC에서 데이터를 조회하여 출력이 되도록 한다.",
                    "     * */",
                    "//ApprovalBoxSvc 공통에서 command 로 구분함.",
                    "if (config.command === Constants.sanction.DRAFT) { // 기안(01) 시 설정",
                    "    vm.set('docData', docData);",
                    "} else {",
                    "    var comAprHistId = config.aprHistId;",
                    "    if (comAprHistId) {",
                    "        var params = {",
                    "            hrHrpmCompId : SecurityUtils.getPrincipal().hrHrpmCompId,",
                    "            comAprHistId : comAprHistId,",
                    "        };",
                    "        /*상세항목 조회*/",
                    "        Ext.Ajax.request({",
                    "            headers : {",
                    "                serviceId : 'HrdCrsSvc.findAllHrdCrsReptDetail',",
                    "                viewId : me.getViewId(),",
                    "                scope : me,",
                    "            },",
                    "            jsonData : params,",
                    "            success : function(response , me) {",
                    "                var res = Ext.JSON.decode(response.responseText);",
                    "                refs.frmDetail.setValues(res.result);",
                    "            }",
                    "        }, me);",
                    "    }",
                    "",
                    "}",
                    "",
                    ""
                ]
            },
            "configAlternates": {
                "designer|params": "typedarray",
                "fn": "string",
                "implHandler": "code"
            },
            "name": "settingValues",
            "designerId": "ab99f41e-46fd-4d05-b17e-08f213aa6374"
