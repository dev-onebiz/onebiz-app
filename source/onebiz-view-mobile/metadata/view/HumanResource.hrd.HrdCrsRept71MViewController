            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "내부함수 / 폼 컴포넌트 초기화"
                ],
                "designer|params": [
                    "form"
                ],
                "fn": "fnInitComponentForm",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    fields = form.getFields();",
                    "",
                    "for (var key in fields) {",
                    "    var item = fields[key];",
                    "",
                    "    if (item.isXType('displayfield')) {",
                    "        continue;",
                    "    }",
                    "",
                    "    item.setEditable(false);",
                    "    item.setReadOnly(true);",
                    "    //change 이벤트가 있는 아이템들 이벤트 삭제하기",
                    "    if (item && item.events.change) {",
                    "        item.suspendEvents(true);",
                    "    }",
                    "}",
                    "",
                    "//첨부파일 존재 시 downloadBtn 활성화",
                    "if(!Ext.isEmpty(refs.atchFileNm.getValue()) &&",
                    "   !Ext.isEmpty(refs.atchFileId.getValue()) &&",
                    "   !Ext.isEmpty(refs.atchFileParentId.getValue())){",
                    "    refs.downloadBtn.setDisabled(false);",
                    "}",
                    "else {",
                    "    refs.downloadBtn.setDisabled(true);",
                    "}"
                ]
            },
            "configAlternates": {
                "designer|commentHeader": "comment",
                "designer|params": "typedarray",
                "fn": "string",
                "implHandler": "code"
            },
            "name": "fnInitComponentForm",
