                    "// 결재선 [기안] 처리",
                    "ApprovalBoxSvc.draft({",
                    "    scope                 : me,",
                    "    edocCd                : vm.get('docCd'),\t\t\t\t \t // 전자문서관리에서 설정된 문서코드: 화면ID를 사용함",
                    "    docNm                 : vm.get('docNm'), \t\t\t\t\t\t\t // 문서명",
                    "    bizDvcd               : 'HRD', \t\t\t\t\t\t\t // 업무구분코드",
                    "    bizServiceId          : 'HrdCrsSvc.saveHrdCrsRept', \t // 연관 업무서비스ID",
                    "    aprHistId             : aprHistId,\t\t\t\t\t\t \t // 결재이력ID",
                    "    approvalLineRecords   : approvalLineGrid.getJsonAllRecords(), // 결재선 그리드 데이터",
                    "    record : me.getRecord(),",
                    "    docData               : {\t\t\t\t\t\t\t\t // 결재문서 데이터",
                    "        fieldValues       : vm.get('fieldValues'),",
                    "        beforechange      : null,",
                    "        afterchange       : vm.get('afterchange') \t\t\t // 결재문서 필드값",
                    "    },",
                    "",
                    "});",
                    ""
                ]
            },
