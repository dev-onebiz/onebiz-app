                "fn": "onSelect",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    values = {};",
                    "",
                    "var enableMask = Ext.isEmpty(runner) ? true : false; //로딩 마스크 여부",
                    "",
                    "// Service 호출",
                    "Ext.Ajax.request({",
                    "    headers : {",
                    "        viewId : me.getViewId(), // userAlias",
                    "        serviceId : 'HwmDaySvc.findAllHwmDayAply',",
                    "        enableMask : enableMask",
                    "    },",
                    "    jsonData : values,",
                    "    scope : me,",
                    "    success : function(response) {",
                    "        var result = Ext.JSON.decode(response.responseText); // 서버응답결과 JSON 변환",
                    "        var refs = this.getView().getReferences();",
                    "",
                    "        // Service 성공 했을 경우 기능",
                    "",
                    "        if(!result.empCriInfo || !result.gps || !result.pic){",
                    "            Ext.Msg.alert('알림', '서비스 배포가 필요합니다.<br>관리자에게 문의해주세요.');",
                    "            return false;",
                    "        }",
                    "",
                    "        // 모바일버전과 관리자사이트의 프로퍼티설정 중 모바일버전 정보가 상이할 경우, 출퇴근 불가",
                    "        if (Property.MOBILE_SERVER_VERSION > Property.MOBILE_VERSION) {",
                    "            Ext.Msg.alert('업데이트 알림', Ext.String.format('출퇴근 체크 기능 이용을 위해서<br />최신버전으로 앱 업데이트 바랍니다.<br /><br />신규버전: {0}<br />현재버전: {1}', Property.MOBILE_SERVER_VERSION, Property.MOBILE_VERSION));",
                    "            return false;",
                    "        }",
                    "",
                    "        if(!Ext.isEmpty(runner)){",
                    "            // Service 성공 했을 경우 기능",
                    "            vm.set('runner', null);",
                    "            vm.set('task', null);",
                    "            runner.stopAll();",
                    "        }",
                    "",
                    "        // 실시간 시각 구하기 - 서버 기준",
                    "        this.getServerDate(result.timestamp);",
                    "",
                    "        refs.atdTmdtInfo.setHidden(true); //출근일시 정보",
                    "",
                    "        //TODO : GPS, picture 쿼리 분리",
                    "        if(result.gps.length > 0){",
                    "            var pic = result.pic;",
                    "",
                    "            // 사원 사진",
                    "            var empPic = pic.imgSrc;",
                    "            vm.set('empPic', empPic);",
                    "            console.log(empPic);",
                    "                /*",
                    "                    사진 존재 : \"/down/2822\"",
                    "                    사진 없음 : \"/resources/images/HwmDay/check_photo_sample.png\"",
                    "                */",
                    "            if(empPic.indexOf('down') > -1){",
                    "                var getImgByHttp = Property.BASE_URL + empPic;",
                    "                refs.imgSrc.setSrc(getImgByHttp);",
                    "            } else {",
                    "                refs.imgSrc.setSrc(empPic);",
                    "            }",
                    "",
                    "            // 출퇴근 구분을 위한 actionNeed",
                    "//             var workInfo = result.gps[0];",
                    "//             vm.set('workInfo', workInfo);",
                    "            vm.set('actionNeed', result.actionNeed);",
                    "            switch (result.actionNeed) {",
                    "                    //출/퇴근 버튼 - 퇴근",
                    "//                 case vm.get('actionLeave'): //퇴근처리필요",
                    "//                     vm.set('officeIO', true); // 퇴근 버튼 활성화",
                    "//                     break;",
                    "//                     //출/퇴근 버튼 - 출근",
                    "                case vm.get('actionAttendence')://출근처리 필요",
                    "                    vm.set('officeIO', false); // 출근 버튼 활성화",
                    "                    refs.in.setDisabled(false);",
                    "                    break;",
                    "                default: //출근 버튼으로 보이나, 아무 동작하지 않을 것임.",
                    "                    vm.set('officeIO', true);",
                    "                    refs.in.setDisabled(true);",
                    "                    if(!Ext.isEmpty(result.gps[0].wrkStrdt) && !Ext.isEmpty(result.gps[0].wrkStrtm)){",
                    "                        //문구처리필요",
                    "                        var dtm = DateUtils.parseDate(result.gps[0].wrkStrdt) + ' ' + DateUtils.parseTime(result.gps[0].wrkStrtm.substr(0, 4));",
                    "                        refs.atdTmdtInfo.setHtml('<div style=\"width:100%; text-align: center; font-size: min(4vw, 16px); color:black;\">출근 ' + dtm + '</div>');",
                    "                        refs.atdTmdtInfo.setHidden(false);",
                    "                    }",
                    "                    break;",
                    "            }",
                    "",
                    "            refs.notExistGps.setHidden(true); // 정보가 없습니다 메시지 영역",
                    "            refs.startSpace.setHidden(true);",
                    "            refs.btnInOut.setHidden(false); // 출퇴근 버튼",
                    "",
                    "            // 근무지 위도/경도, 근무지 ID",
                    "            var workGpsInfo = result.gps;",
                    "            vm.set('workGpsVal', []);",
                    "            for(var i in workGpsInfo){",
                    "                vm.get('workGpsVal').push(workGpsInfo[i]);",
                    "            }",
                    "",
                    "            values = {",
                    "                crtDt : Ext.Date.format(new Date(),'Ymd'),",
                    "                hrHrpmEmpId : SecurityUtils.getPrincipal().hrHrpmEmpId,",
                    "                stcd : Constants.stcd.NORMAL",
                    "",
                    "            };",
                    "            // 근무일 기준 근무지 정보",
                    "            Ext.Ajax.request({",
                    "                headers: {",
                    "                    serviceId: 'HwmWplSvc.findAllHwmWplInfo',",
                    "                    viewId: me.getViewId(),",
                    "                    scope: me,",
                    "                    enableMask : enableMask",
                    "                },",
                    "                jsonData: values,",
                    "                success: function(res) {",
                    "                    var result = JSON.parse(res.responseText).page;",
                    "                    var msg = \"\";",
                    "",
                    "                    console.log(\"wkplcList Cnt : \" + result.length);",
                    "",
                    "                    if(!Ext.isEmpty(result) && (result.length != 1 || result[0].hrWrkmWkplcId != Constants.wkplcId.EMPTY_WKPLC)){ //근무지있음",
                    "                        vm.set(\"wkplcList\", result);",
                    "",
                    "                        // 근무일기준 근무지만 필터링",
                    "                        var oldGpsVal = vm.get('workGpsVal'),",
                    "                            newGpsVal = [];",
                    "",
                    "                        console.log(\"oldGpsVal Cnt : \" + oldGpsVal.length);",
                    "",
                    "                        for (var gpsVal in oldGpsVal) {",
                    "                            for (var wkplc in result) {",
                    "                                if (result[wkplc].hrWrkmWkplcId == oldGpsVal[gpsVal].hrWrkmWkplcId) {",
                    "                                    newGpsVal.push(oldGpsVal[gpsVal]);",
                    "                                    break;",
                    "                                }",
                    "                            }",
                    "                        }",
                    "                        console.log(\"newGpsVal Cnt : \" + newGpsVal.length);",
                    "",
                    "                        vm.set('workGpsVal', newGpsVal);",
                    "                    }",
                    "                }",
                    "            });",
                    "",
                    "            // 출장, 외근 여부 체크",
                    "            var isOnBtrOrOut = result.isOnBtrOrOut;",
                    "            vm.set('isOnBtrOrOut.isOnBtr', isOnBtrOrOut.isOnBtr); // isOnBtr 출장",
                    "            vm.set('isOnBtrOrOut.isOnOut', isOnBtrOrOut.isOnOut); // isOnOut 외근",
                    "",
                    "        }",
                    "",
                    "        // 근무기준 , 근무지 GPS 정보가 있으면 출퇴근 체크 불가",
                    "        if (result.empCriInfo.length < 1 || result.gps.length < 1) {",
                    "            var msgText = '';",
                    "            var SUFFIX = '관리자 문의 : 이경민 매니저 602-1742';",
                    "",
                    "            if (result.empCriInfo.length < 1) {",
                    "                msgText += '근태기준 정보가 없습니다.<br />';",
                    "            }",
                    "            if (result.gps.length < 1) {",
                    "                msgText += '허용된 근무지가 아닙니다.<br />';",
                    "            }",
                    "",
                    "            msgText += SUFFIX;",
                    "            refs.notExistGps.setHidden(false); // 정보가 없습니다 메시지 영역",
                    "            refs.atdTmdtInfo.setHidden(true); //출근일시 정보",
                    "            refs.btnInOut.setHidden(true); // 출퇴근 버튼",
                    "            refs.notExistGps.setHtml('<div style=\"text-align: center; font-size: middle; color:black;\">' + msgText + '</div>');",
                    "",
                    "        }",
                    "",
                    "    },",
                    "    failure : function(response, opts){",
                    "        // Service 실패 했을 경우 기능",
                    "        me.HANDLE_RESPONSE_FAILURE();",
                    "    }",
                    "});",
                    ""
                ]
            },
