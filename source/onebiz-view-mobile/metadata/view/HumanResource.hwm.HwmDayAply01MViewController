        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "출근 처리"
                ],
                "fn": "onInProgress",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences();",
                    "",
                    "// 이 함수가 끝날때 다시 활성화",
                    "refs.in.setDisabled(true);",
                    "",
                    "var isWorkZone = false;",
                    "",
                    "// 근무지 근처인지 체크",
                    "var workGpsInfo = vm.get('workGpsVal');",
                    "for(var i in workGpsInfo){",
                    "    var innerArea = this.measureDistance(vm.get('gps'), workGpsInfo[i].gpsLatdVal, workGpsInfo[i].gpsLotdVal, workGpsInfo[i].gpsLmDstnCnt);",
                    "    console.log('근무지와의 거리(measureDistance) : ' + vm.get('strKm'));",
                    "    if(innerArea){",
                    "        isWorkZone = true;",
                    "        vm.set('wkplcNm', workGpsInfo[i].wkplcNm); // 근무지명",
                    "        break;",
                    "    }",
                    "}",
                    "",
                    "// 실제 출/퇴근 근무지ID",
                    "var wkplcList = vm.get('wkplcList');",
                    "for (var j in wkplcList) {",
                    "    if (vm.get('wkplcNm') == wkplcList[j].wkplcNm) {",
                    "        vm.set('wkplcId',wkplcList[j].hrWrkmWkplcId);",
                    "    }",
                    "}",
                    "",
                    "if(!isWorkZone){",
                    "    if(vm.get('isOnBtrOrOut.isOnBtr') || vm.get('isOnBtrOrOut.isOnOut')){",
                    "        vm.set('wkplcNm', '-');",
                    "        // pass",
                    "    } else {",
                    "        me.distValidationMsg('in');",
                    "        return false;",
                    "    }",
                    "}",
                    "",
                    "var values = {",
                    "    goHome : false,",
                    "    userAgent : window.navigator.userAgent,",
                    "    appVersion : Property.MOBILE_VERSION,  //로그 앱버전 추가함 . update by jihyun",
                    "    // GPS 정보",
                    "    // toString(), String 등으로 문자열화 하면 소수점 끝 0이 사라진 채로 toString(), 따라서 toFixed로 대체",
                    "    latitude : (vm.get('gps.latitude')).toFixed(6),         // 위도",
                    "    longitude : (vm.get('gps.longitude')).toFixed(6),        // 경도",
                    "    altitude : vm.get('gps.altitude'),         // 고도, 높이",
                    "    accuracy : vm.get('gps.accuracy'),         // 정확성",
                    "    altitudeAccuracy : vm.get('gps.altitudeAccuracy'), // 위도 정확성",
                    "    heading : vm.get('gps.heading'),          // 방향",
                    "    speed : vm.get('gps.speed'),",
                    "    timestamp : vm.get('gps.timestamp'),",
                    "",
                    "    isWorkZone : isWorkZone, // 근무지 근처에 있는지 체크하는 boolean",
                    "    workZoneName : vm.get('wkplcNm'), // 근무지 명",
                    "    workZoneId : vm.get('wkplcId'), //해당 근무지 ID",
                    "    strKm : vm.get('strKm'), // 근무지와의 거리 ex) '18.852km;",
                    "    wkplcList : vm.get('wkplcList')",
                    "",
                    "};",
                    "",
                    "// Service 호출",
                    "Ext.Ajax.request({",
                    "    headers : {",
                    "        viewId : me.getViewId(), // userAlias",
                    "        serviceId : 'HwmDaySvc.saveHwmDayAply' // 조건 검사 후 출.퇴근 처리",
                    "    },",
                    "    jsonData : values,",
                    "    scope : me,",
                    "    success : function(response) {",
