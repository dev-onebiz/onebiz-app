                    "gps, lat, lon, gpsLmDstnCnt"
                ],
                "fn": "measureDistance",
                "implHandler": [
                    "Number.prototype.toRad = function() {",
                    "    return this * Math.PI / 100;",
                    "};",
                    "",
                    "lat = Number(lat);",
                    "lon = Number(lon);",
                    "",
                    "var lat1 = Number(gps.latitude);",
                    "var lon1 = Number(gps.longitude);",
                    "",
                    "if(!lat1 || !lon1){",
                    "    Ext.Msg.alert('GPS수신 실패', 'GPS 좌표를 수신할 수 없습니다.');",
                    "    return false;",
                    "}",
                    "",
                    "if(!gpsLmDstnCnt){",
                    "//     Ext.Msg.alert('근무지 정보 부재', '출퇴근 허용 거리정보가 없습니다. 관리자에게 문의바랍니다.');",
                    "//     return false;",
                    "    console.log('출퇴근 허용 거리정보가 없습니다. 500m로 설정합니다.');",
                    "    gpsLmDstnCnt = 500;",
                    "} else {",
                    "    gpsLmDstnCnt = Number(gpsLmDstnCnt);",
                    "    console.log('measureDistance 제한거리 : ' + String(gpsLmDstnCnt));",
                    "}",
                    "",
                    "var lat2 = lat;",
                    "var lon2 = lon;",
                    "",
                    "var R = 6371; // 지구 반지름 = 6371 km",
                    "",
                    "var x1 = lat2 - lat1;",
                    "var dLat = x1.toRad();",
                    "",
                    "var x2 = lon2 - lon1;",
                    "var dLon = x2.toRad();",
                    "",
                    "var a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +",
                    "    Math.cos(lat1.toRad()) * Math.cos(lat2.toRad()) *",
                    "    Math.sin(dLon / 2) * Math.sin(dLon / 2);",
                    "var c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));",
                    "var d = R * c;",
                    "",
                    "var strKm = d.toFixed(3); // '18.852'",
                    "",
                    "this.getViewModel().set('strKm', strKm + 'km');",
                    "",
                    "var innerArea = null;",
                    "var checkDistance = Number(strKm) * 1000; // \"18.350\" km -> 18350 m",
                    "// 출퇴근 체크 허용 거리 이내인지 체크",
                    "if(checkDistance > gpsLmDstnCnt){",
                    "    innerArea = false;",
                    "} else {",
                    "    innerArea = true;",
                    "}",
                    "",
                    "return innerArea;",
                    ""
                ]
