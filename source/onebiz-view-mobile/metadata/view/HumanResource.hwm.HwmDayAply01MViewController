                "fn": "getGPS",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    params = {",
                    "        scope : me,",
                    "        status : status // 'in':출근처리, 'out':퇴근처리",
                    "    };",
                    "",
                    "// getGPS 시작",
                    "Ext.Viewport.setMasked({",
                    "    xtype: 'loadmask',",
                    "    message: '',",
                    "    indicator: false,",
                    "    html : '<img src=\"resources/images/loading-bar.gif\"></img>'",
                    "});",
                    "",
                    "var successcb = function(result) {",
                    "    var me = result.params.scope,",
                    "        vm = me.getViewModel(),",
                    "        refs = me.getReferences(),",
                    "        gps = result.gps,",
                    "        status = result.params.status;",
                    "",
                    "    var latitude = gps.latitude,",
                    "        longitude = gps.longitude;",
                    "",
                    "    if(gps && latitude && longitude){",
                    "        vm.set('gps', gps);",
                    "        console.log('getGPS 위도 -> ' + latitude);",
                    "        console.log('getGPS 경도 -> ' + longitude);",
                    "",
                    "        // 출근",
                    "        if(status === 'in'){",
                    "            me.onInProgress();",
                    "        }",
                    "",
                    "        // 퇴근",
                    "        if(status === 'out'){",
                    "            me.onOutProgress();",
                    "        }",
                    "",
                    "        // log Test",
                    "        if(status === 'log'){",
                    "            me.onLogTestSave4();",
                    "        }",
                    "",
                    "    } else{",
                    "        Ext.Msg.alert('알림', 'GPS수신이 불가합니다. 재시도해주세요.');",
                    "    }",
                    "",
                    "    // getGPS 끝",
                    "    Ext.Viewport.setMasked(false);",
                    "",
                    "};",
                    "",
                    "var errorcb = function(error, params) {",
                    "    var me = params.scope,",
                    "        vm = me.getViewModel(),",
                    "        refs = me.getReferences(),",
                    "        status = params.status;",
                    "",
                    "    // TODO : DELETE // 로컬 Test 전용 좌표",
                    "    if(Property.PROFILE === 'L'){",
                    "        var values = {",
                    "            latitude : 35.1372056,",
                    "            longitude : 128.8577588, // 미음",
                    "//                                 latitude : 35.169393,",
                    "//                                 longitude : 129.176318 // 장산",
                    "        };",
                    "        vm.set('gps', values);",
                    "",
                    "        if(status === 'in')// 출근",
                    "            me.onInProgress();",
                    "        if(status === 'out')// 퇴근",
                    "            me.onOutProgress();",
                    "        if(status === 'log')",
                    "            me.onLogTestSave4();",
                    "    }",
                    "    // TODO : DELETE",
                    "",
                    "    if(Property.PROFILE !== 'L') {",
                    "        console.log('code: '    + error.code    + '\\n' + 'message: ' + error.message + '\\n');",
                    "        Ext.Msg.alert('안내', 'GPS수신이 원활하지 않습니다.');",
                    "    }",
                    "",
                    "    // getGPS 끝",
                    "    Ext.Viewport.setMasked(false);",
                    "};",
                    "",
                    "var opts = { maximumAge: 3000, timeout: 30 * 1000, enableHighAccuracy: true };",
                    "",
                    "Native.getGps(params, successcb, errorcb, opts);",
                    ""
                ]
            },
