            "userConfig": {
                "fn": "Initialize",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    config = component.initialConfig,",
                    "    aprHistId = config.aprHistId,",
                    "    command = config.command,",
                    "    docData = config.docData,",
                    "    record = config.record,",
                    "    afterchange = docData.afterchange,",
                    "    store = vm.storeInfo.wkplcAplDvcd;",
                    "",
                    "// 신청유형",
                    "var code = 'HWM019';",
                    "refs.wplcAplDvcd.setStore(me.getCode(code, store));",
                    "",
                    "vm.set('afterchange', afterchange);",
                    "vm.set('docData', docData);",
                    "vm.set('aprHistId', aprHistId);",
                    "vm.set('record', record);",
                    "vm.set('command', command);",
                    "",
                    "if (afterchange.aplDt != null) {",
                    "    refs.aplDt.setHtml(DateUtils.parseDate(afterchange.aplDt));",
                    "} else if (record.aplDtm != null) {",
                    "    refs.aplDt.setHtml(DateUtils.parseDate(record.aplDtm.substr(0,8)));",
                    "} else {",
                    "    refs.aplDt.setHtml(record.rgdt);",
                    "}",
                    "",
                    "refs.rqpr.setValue(afterchange.rqpr);",
                    "refs.hrWrkmEmpWkplcId.setValue(afterchange.hrWrkmEmpplcId);",
                    "refs.wplcAplDvcd.setValue(afterchange.wplcAplDvcd);",
                    "refs.aplDvcdNm.setValue(afterchange.aplDvcd == '01' ? '신청' : '취소신청');",
                    "refs.aplDvcd.setValue(afterchange.aplDvcd);",
                    "refs.stcd.setValue(afterchange.stcd);",
                    "refs.hrWrkmWkplcId.setValue(afterchange.hrWrkmplcId);",
                    "refs.wkplcNm.setValue(afterchange.wkplcNm);",
                    "refs.strdt.setValue(DateUtils.parseDate(afterchange.strdt));",
                    "refs.edt.setValue(DateUtils.parseDate(afterchange.edt));",
                    "refs.wkplcDvcd.setValue(afterchange.wkplcDvcd);",
                    "refs.aplHrWrkmWkplcId.setValue(afterchange.aplHrWrkmplcId);",
                    "refs.aplWkplcNm.setValue(afterchange.aplWkplcNm);",
                    "refs.aplStrdt.setValue(DateUtils.parseDate(afterchange.aplStrdt));",
                    "refs.aplEdt.setValue(DateUtils.parseDate(afterchange.aplEdt));",
                    "refs.aplWkplcDvcd.setValue(afterchange.aplWkplcDvcd);",
                    "refs.rmrkCntn.setValue(afterchange.aplCntn);",
                    "",
                    "// 근무지변경신청 화면에서 신청서 조회 (완료)",
                    "if (config.viewId != null && config.viewId == 'HwmWplAply01M') {",
                    "        command = Constants.sanction.COMPLETED_BOX;",
                    "}",
                    "",
                    "// 결재문서 초기화 설정",
                    "ApprovalBoxSvc.setup({",
                    "    command   : command,",
                    "    viewModel : vm,",
                    "    aprHistId : aprHistId,",
                    "    edocCd    : 'HwmWplAply71',",
                    "    scope     : me",
