        {
            "group": "(Custom Properties)",
            "name": "password",
            "type": "string"
        }
    ],
    "viewControllerInstanceId": "14f29780-5d69-4b02-9ec7-18febb569d41",
    "viewModelInstanceId": "b284605b-b4e8-4e57-b32a-5d128e6b631e",
    "cn": [
        {
            "type": "viewcontrollereventbinding",
            "reference": {
                "name": "listeners",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "초기화"
                ],
                "fn": "onContainerInitialize",
                "implHandler": [
                    "// Application launch 영역보다 먼저 실행되어 Ajax headers 설정을 함",
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    loginType = refs.loginType,",
                    "    loadingView = refs.loadingView,",
                    "    rememberUserId = refs.rememberUserId,",
                    "    fastRememberUserId = refs.fastRememberUserId,",
                    "    loginForm = refs.loginForm,",
                    "    userId = refs.userId,",
                    "    loginTypeCard = refs.loginTypeCard,",
                    "    loginUserId = localStorage.getItem('loginUserId'),",
                    "    loginTypeValue = localStorage.getItem('loginType'),",
                    "    initialConfig = component.initialConfig;",
                    "",
                    "var password = me.getView().down('#password');",
                    "",
                    "// 로컬스토리지의 사용자아이디가 존재하는 경우, 아이디 필드에 설정",
                    "if (loginUserId) {",
                    "    vm.set('loginUserId', loginUserId);",
                    "    rememberUserId.setChecked(true);",
                    "    userId.setValue(loginUserId);",
                    "}",
                    "else if (initialConfig.hasOwnProperty('userId')) {",
                    "    rememberUserId.setChecked(true);",
                    "    userId.setValue(initialConfig.userId);",
                    "}",
                    "",
                    "// 로그인타입선택",
                    "if (!loginTypeValue) {",
                    "    loginType.setValue(0);",
                    "}",
                    "else {",
                    "    loginType.setValue(1);",
                    "    loginTypeCard.setActiveItem(1);",
                    "    refs.btnIdLogin.setStyle('font-size:18px;olor:#666666;font-weight:normal');",
                    "    refs.btnFastLogin.setStyle('font-size:18px;color:#111111;font-weight:bold');",
                    "}",
                    "",
                    "// JWT 토큰 쿠키가 존재하는 경우에만 실행",
                    "if (WebUtils.getCookie(Property.JWT_TOKEN_NAME)) {",
                    "    console.log('Cookie OK!');",
                    "    me.initApplication().then(function(isInit) {",
                    "        // 어플리케이션 데이터가 정상처리 되었으면 HOME화면으`로 이동",
                    "        if (isInit) {",
                    "            me.REDIRECT(Property.ROUTE_HOME);",
                    "        }",
                    "    });",
                    "}",
                    "else {",
                    "    //loadingView.setHidden(true);",
                    "    // loginForm.setHidden(false);",
                    "",
                    "    // 인트로 추가",
                    "    if (!Property.INIT){",
                    "        setTimeout(function() {",
                    "            refs.intro.setHidden(true);",
                    "            Property.INIT = true;",
                    "        },3000);",
                    "    } else {",
                    "        refs.intro.setHidden(true);",
                    "    }",
                    "}",
                    "",
                    "// 패스워드 난독화에 사용",
                    "vm.set('pwKey', (new Date().getMilliseconds() % 128) + 128);",
                    "",
                    "// 프로퍼티 표시",
                    "var profileText = '';",
                    "if (Property.PROFILE === 'T') {",
                    "    profileText = '개발환경';",
                    "    password.setValue('aa12345^');",
                    "}",
                    "else if (Property.PROFILE === 'L') {",
                    "    profileText = '로컬환경';",
                    "    password.setValue('aa12345^');",
                    "}",
                    "refs.profile.setHtml(Ext.String.format('<div style=\"color:red;\">{0}</div>', profileText));",
                    "",
                    "",
                    "// 로그인버튼",
                    "if(!Ext.isEmpty(refs.userId.getValue()) && !Ext.isEmpty(password.getValue())) {",
                    "    refs.btnLogin.setDisabled(false);",
                    "}",
                    "// 빠른로그인",
                    "if(!Ext.isEmpty(refs.userId.getValue()) || !Ext.isEmpty(refs.fastUserId.getValue())) {",
                    "    refs.btnFastLogin.setHidden(false);",
                    "}",
                    "",
                    "Property.IS_LOGIN = false;",
                    "",
                    "// 메뉴 제거",
                    "if(Ext.Viewport.getMenus().bottom != null) {",
                    "    Ext.Viewport.removeMenu('bottom', false);",
                    "}",
                    "",
                    "// 메인화면 제거",
                    "var main = Ext.ComponentQuery.query(Property.ROUTE_HOME);",
                    "for(var i in main){",
                    "    main[i].destroy();",
                    "}"
                ],
                "name": "initialize",
                "scope": "me"
            },
            "configAlternates": {
                "designer|commentHeader": "comment",
                "fn": "string",
                "implHandler": "code",
                "name": "string",
                "scope": "string"
            },
            "name": "onContainerInitialize",
            "designerId": "107d5bfc-1b56-49af-8300-21e7622cac44"
        },
