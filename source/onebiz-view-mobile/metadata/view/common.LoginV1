                                                "reference": "btnLogin",
                                                "style": "background-color: #939393; color: #FFFFFF;",
                                                "text": "로그인"
                                            },
                                            "configAlternates": {
                                                "height": "auto",
                                                "itemId": "string",
                                                "layout|flex": "number",
