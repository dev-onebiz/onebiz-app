                                                                "fn": "onFastPasswordfieldChange",
                                                                "implHandler": [
                                                                    "var me = this;",
                                                                    "var refs = me.getReferences();",
                                                                    "var vm = me.getViewModel();",
                                                                    "var isProcessLogin = vm.get('isProcessLogin');",
                                                                    "",
                                                                    "if(Ext.isEmpty(refs.userId.getValue())){",
                                                                    "    refs.btnLogin.setDisabled(true);",
                                                                    "}",
                                                                    "else{",
                                                                    "    if(Ext.isEmpty(newValue)){",
                                                                    "        refs.btnLogin.setDisabled(true);",
                                                                    "    }",
                                                                    "    else{",
                                                                    "        refs.btnLogin.setDisabled(false);",
                                                                    "    }",
                                                                    "}",
                                                                    "",
                                                                    "me.fnPasswordFieldChange(field, newValue, oldValue, vm.get('fastPassword'));",
                                                                    "",
                                                                    "if(newValue.length >= 6  && !isProcessLogin){",
                                                                    "    me.onLoginTap();",
                                                                    "}"
                                                                ],
