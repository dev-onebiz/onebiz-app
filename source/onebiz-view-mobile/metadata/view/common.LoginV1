                                                            "    else{",
                                                            "        refs.btnLogin.setDisabled(false);",
                                                            "    }",
                                                            "}",
                                                            "",
                                                            "me.fnPasswordFieldChange(field, newValue, oldValue, vm.get('password'));"
                                                        ],
