                                                            "",
                                                            "if(Ext.isEmpty(newValue)){",
                                                            "    refs.btnLogin.setDisabled(true);",
                                                            "}",
                                                            "else{",
                                                            "",
                                                            "    if ((refs.loginType.getValue() === 0 && Ext.isEmpty(me.getView().down('#password').getValue()))",
                                                            "        || (refs.loginType.getValue() === 1 && Ext.isEmpty(me.getView().down('#fastPassword').getValue()))){",
                                                            "",
                                                            "        refs.btnLogin.setDisabled(true);",
                                                            "    }",
                                                            "    else{",
