                                            "name": "MyButton7",
                                            "designerId": "85e4f8db-9e9c-41b4-9f69-f01427844342",
                                            "cn": [
                                                {
                                                    "type": "viewcontrollereventbinding",
                                                    "reference": {
                                                        "name": "listeners",
                                                        "type": "array"
                                                    },
                                                    "codeClass": null,
                                                    "userConfig": {
                                                        "designer|commentHeader": [
                                                            "로그인"
                                                        ],
                                                        "fn": "onLoginTap",
                                                        "implHandler": [
                                                            "var me = this,",
                                                            "    vm = me.getViewModel(),",
                                                            "    refs = me.getReferences(),",
                                                            "    loginType = refs.loginType.getValue(),",
                                                            "    loginform = refs.loginform,",
                                                            "    fastLoginform = refs.fastLoginform,",
                                                            "    idErrMsg = refs.idErrMsg,",
                                                            "    fastErrMsg = refs.fastErrMsg,",
                                                            "    values = null,",
                                                            "    data = {},",
                                                            "    isProcessLogin = vm.get('isProcessLogin');",
                                                            "",
                                                            "",
                                                            "// 연타입력으로 인한 이벤트 중복호출 방어코드 추가",
                                                            "if (!isProcessLogin) {",
                                                            "    vm.set('isProcessLogin', true);",
                                                            "}",
                                                            "",
                                                            "var pwKey = vm.get('pwKey');",
                                                            "var originalPw = '';",
                                                            "var password = me.getView().down('#password').getValue();",
                                                            "var fastPassword = me.getView().down('#fastPassword').getValue();",
                                                            "",
                                                            "// ID로그인",
                                                            "if (loginType === 0) {",
                                                            "    values = loginform.getValues();",
                                                            "",
                                                            "    for(var i in password){",
                                                            "        originalPw += String.fromCharCode(password[i].charCodeAt() ^ pwKey);",
                                                            "    }",
                                                            "",
                                                            "    data = {",
                                                            "        loginType: 'ID',",
                                                            "        cmgrpCd : Property.CMGRP_CD,",
                                                            "        userId : values.userId,",
                                                            "        password : originalPw",
                                                            "    };",
                                                            "}",
                                                            "else {",
                                                            "    values = fastLoginform.getValues();",
                                                            "",
                                                            "    for(var i in fastPassword){",
                                                            "        originalPw += String.fromCharCode(fastPassword[i].toString().charCodeAt() ^ pwKey);",
                                                            "    }",
                                                            "",
                                                            "    data = {",
                                                            "        loginType: 'PASSCODE',",
                                                            "        cmgrpCd : Property.CMGRP_CD,",
                                                            "        userId : values.userId,",
                                                            "        password : originalPw",
                                                            "    };",
                                                            "}",
                                                            "",
                                                            "if(Ext.isEmpty(window.device) && 'P'!==Property.PROFILE){",
                                                            "    data.deviceUuid = 'empty';",
                                                            "}",
                                                            "else{",
                                                            "    data.deviceUuid = device.uuid;",
                                                            "}",
                                                            "",
                                                            "// 오류메시지제거",
                                                            "idErrMsg.setHtml(null);",
                                                            "fastErrMsg.setHtml(null);",
                                                            "",
                                                            "// [START] Device 모델명 (iOS, Android, etc)",
                                                            "var userAgent = window.navigator.userAgent,",
                                                            "    startIdx = userAgent.indexOf(\"(\"),",
                                                            "    endIdx = userAgent.indexOf(\")\"),",
                                                            "    mobileModelName = userAgent.substring(startIdx + 1, endIdx),",
                                                            "    modelNameList = null,",
                                                            "    modelName = null;",
                                                            "// Apple",
                                                            "if (mobileModelName.indexOf(\"iPhone\") > -1 || mobileModelName.indexOf(\"iPad\") > -1 || mobileModelName.indexOf(\"Mac OS X\") > -1) {",
                                                            "    //     if (mobileModelName.indexOf(\";\") > -1) {",
                                                            "    //         modelNameList = mobileModelName.split(\"; \");",
                                                            "    //         if (modelNameList.length > 0) {",
                                                            "    //             modelName = modelNameList[0].length > 50 ? modelNameList[0].substring(0, 50) : modelNameList[0];",
                                                            "    //         }",
                                                            "    //     }",
                                                            "    //     else {",
                                                            "    //         modelName = mobileModelName.length > 50 ? mobileModelName.substring(0, 50) : mobileModelName;",
                                                            "    //     }",
                                                            "    modelName = 'iPhone';",
                                                            "}",
                                                            "// Android",
                                                            "else if (mobileModelName.indexOf(\"Android\") > -1) {",
                                                            "    //     if (mobileModelName.indexOf(\";\") > -1) {",
                                                            "    //         modelNameList = mobileModelName.split(\"; \"); // SM-G900P Build/LRX21T : ANDROID Galaxy S5",
                                                            "    //         if (modelNameList.length > 2) {",
                                                            "    //             modelName = modelNameList[2].length > 50 ? modelNameList[2].substring(0, 50) : modelNameList[2]; // SM-G900P Build/LRX21",
                                                            "    //         }",
                                                            "    //     }",
                                                            "    //     else {",
                                                            "    //         modelName = mobileModelName.length > 50 ? mobileModelName.substring(0, 50) : mobileModelName;",
                                                            "    //     }",
                                                            "    modelName = 'Android';",
                                                            "}",
                                                            "else {",
                                                            "    modelName = mobileModelName.length > 50 ? mobileModelName.substring(0, 50) : mobileModelName;",
                                                            "}",
                                                            "// [END] Device 모델명",
                                                            "",
                                                            "// 푸시",
                                                            "if (Property.PUSH_TOKEN && modelName) {",
                                                            "    console.log('token: ' + Property.PUSH_TOKEN + '\\n model: ' + modelName);",
                                                            "    data.pushCtfKeyVal = Property.PUSH_TOKEN;\t// 푸시토큰",
                                                            "    data.pushDvcOsNm = modelName;\t\t\t\t// 모바일디바이스",
                                                            "}",
                                                            "",
                                                            "// 로그인거래",
                                                            "Ext.Viewport.setMasked({",
                                                            "    xtype: 'loadmask',",
                                                            "    message: '',",
                                                            "    indicator: false,",
                                                            "    html : '<img src=\"resources/images/loading-bar.gif\"></img>'",
                                                            "});",
                                                            "",
                                                            "// 패스워드 암호화 후 로그인 서비스 실행",
                                                            "SecurityUtils.encrypt(me, data.password)",
                                                            "    .then(function(encryptPassword){",
                                                            "    data.password = encryptPassword;",
                                                            "",
                                                            "    Ext.Ajax.request({",
                                                            "        headers: {",
                                                            "            viewId: me.getViewId(),",
                                                            "            serviceId: 'COMAPP0002R01M'",
                                                            "        },",
                                                            "        jsonData : data,",
                                                            "        scope : me,",
                                                            "        success : function(res) {",
                                                            "            Ext.Viewport.setMasked(false);",
                                                            "            // 어플리케이션 데이터 초기화",
                                                            "            var result = Ext.JSON.decode(res.responseText);",
                                                            "            me.INIT_APPLICATION_DATA(result);",
                                                            "            me.fnCheckingDevcAuth(res);",
                                                            "",
                                                            "        },",
                                                            "        failure: function(response, opts) {",
                                                            "            Ext.Viewport.setMasked(false);",
                                                            "            var me = this,",
                                                            "                vm = me.getViewModel(),",
                                                            "                refs = me.getReferences(),",
                                                            "                loginType = refs.loginType,",
                                                            "                password = me.getView().down('#password'),",
                                                            "                fastPassword = me.getView().down('#fastPassword'),",
                                                            "                idErrMsg = refs.idErrMsg,",
                                                            "                fastErrMsg = refs.fastErrMsg;",
                                                            "",
                                                            "            vm.set('isProcessLogin', false);",
                                                            "            password.setValue(null); // 입력된 비밀번호제거",
                                                            "            fastPassword.setValue(null);",
                                                            "",
                                                            "            if (loginType.getValue() === 0 ) {",
                                                            "                password.focus(true);",
                                                            "            }",
                                                            "            else {",
                                                            "                fastPassword.focus(true);",
                                                            "            }",
                                                            "",
                                                            "            // 권한오류인 경우, 오류메시지 표시하고 별도의 예외처리하지 않음",
                                                            "            if (response && response.status === 401) {",
                                                            "                var errMsg = '아이디 또는 비밀번호를 다시 확인하세요.<br />등록되지 않은 아이디이거나, 아이디 또는 비밀번호를 잘못 입력하셨습니다.';",
                                                            "",
                                                            "                if (response.hasOwnProperty('responseText')) {",
                                                            "                    var responseJson = Ext.JSON.decode(response.responseText);",
                                                            "                    if (responseJson.hasOwnProperty('moreInfo')) {",
                                                            "                        var moreInfo = responseJson.moreInfo;",
                                                            "                        for (var key in moreInfo) {",
                                                            "                            var msg = moreInfo[key];",
                                                            "                            if (msg) {",
                                                            "                                errMsg = msg;",
                                                            "                            }",
                                                            "                            break;",
                                                            "                        }",
                                                            "                    }",
                                                            "                }",
                                                            "",
                                                            "                if (loginType.getValue() === 0) {",
                                                            "                    idErrMsg.setHtml(errMsg);",
                                                            "                }",
                                                            "                else {",
                                                            "                    fastErrMsg.setHtml(errMsg);",
                                                            "                }",
                                                            "                return;",
                                                            "            }",
                                                            "",
                                                            "            // failure 를 직접구현하는 경우, 공통 실패응답처리 메소드를 호출한다.",
                                                            "            me.HANDLE_RESPONSE_FAILURE(response, opts);",
                                                            "        }",
                                                            "    });",
                                                            "",
                                                            "})",
                                                            ".catch(function(res){",
                                                            "",
                                                            "    Ext.Viewport.setMasked(false);",
                                                            "",
                                                            "    vm.set('isProcessLogin', false);",
                                                            "",
                                                            "    if(res.status == 0 || res.status == 404){",
                                                            "        Ext.Msg.alert(Property.SYSTEM_NAME, '서버와 연결이 원활하지 않습니다.<br />인터넷 연결 상태를 확인하고 다시 시도해주시길 바랍니다.');",
                                                            "    }",
                                                            "});",
                                                            "",
                                                            "",
                                                            "",
                                                            ""
                                                        ],
                                                        "name": "tap",
                                                        "scope": "me"
                                                    },
                                                    "configAlternates": {
                                                        "designer|commentHeader": "comment",
                                                        "fn": "string",
                                                        "implHandler": "code",
                                                        "name": "string",
                                                        "scope": "string"
                                                    },
                                                    "name": "onLoginTap",
                                                    "designerId": "972107d3-0bef-4247-8e29-58d88d10e5be"
                                                },
                                                {
                                                    "type": "viewcontrollereventbinding",
                                                    "reference": {
                                                        "name": "listeners",
                                                        "type": "array"
                                                    },
                                                    "codeClass": null,
                                                    "userConfig": {
                                                        "fn": "onBtnLoginDisabledChange",
                                                        "implHandler": [
                                                            "var me = this,",
                                                            "    refs = me.getReferences();",
                                                            "",
                                                            "if(value) {",
                                                            "    refs.btnLogin.setStyle('background-color: #939393; color: #FFFFFF;');",
                                                            "} else {",
                                                            "    refs.btnLogin.setStyle('background-color: #CB2B11; color: #FFFFFF;');",
                                                            "}"
                                                        ],
                                                        "name": "disabledchange",
                                                        "scope": "me"
                                                    },
                                                    "configAlternates": {
                                                        "fn": "string",
                                                        "implHandler": "code",
