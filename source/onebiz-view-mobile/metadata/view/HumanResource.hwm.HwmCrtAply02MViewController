            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "기타영수증 필수값 검증"
                ],
                "designer|params": [
                    "formData"
                ],
                "fn": "formValid",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    reNo = /[^\\d]/,",
                    "    errMsg = '';",
                    "",
                    "if(!formData.aplWrkStrdt){",
                    "    errMsg += '정정후 시작일을 입력 하여주세요<br>';",
                    "}",
                    "if(!formData.aplWrkStrtm){",
                    "    errMsg += '정정후 시작시간을 입력해주세요.<br>';",
                    "}",
                    "if(!formData.aplWrkEdt){",
                    "    errMsg += '정정후 종료일을 입력해주세요.<br>';",
                    "}",
                    "if(!formData.aplWrkEdtm){",
                    "    errMsg += '정정후 종료시간을 입력해주세요.<br>';",
                    "}",
                    "if(!formData.aplWkplcNm){",
                    "    errMsg += '정정후 근무지를 입력해주세요.<br>';",
                    "}",
                    "if(!formData.aplCntn){",
                    "    errMsg += '사유를 입력해주세요.<br>';",
                    "}",
                    "",
                    "",
                    "if(!vm.get('applyLine')){",
                    "    errMsg += '결재선을 선택해주세요.';",
                    "}",
                    "",
                    "if(errMsg != ''){",
                    "    return errMsg;",
                    "}",
                    "",
                    "// 날자관련 데이터 변환",
                    "var dateCompoList = ['aplWrkStrdt',",
                    "                     'aplWrkEdt'];",
                    "var dateData = new Object();",
                    "for(var key in dateCompoList ){",
                    "    var dateObj = refs[dateCompoList[key]];",
                    "    var date = dateObj.getValue();",
                    "    var tempMonth = date.getMonth()+1 ;",
                    "    tempMonth += \"\";",
                    "    tempMonth = (tempMonth.length == 1 ? \"0\" :\"\") + tempMonth;",
                    "    dateData[dateCompoList[key]] = date.getFullYear() +\"\" + tempMonth + \"\"+date.getDate();",
                    "}",
                    "",
                    "",
                    "// 시간관련 데이터 변환",
                    "var hourCompoList  = ['aplWrkStrtm',",
                    "                      'aplWrkEdtm'];",
                    "",
                    "for(var key in hourCompoList ){",
                    "    var timeObj = refs[hourCompoList[key]].getValue();",
                    "    var hh = timeObj.getHours()+\"\";",
                    "    var mi = timeObj.getMinutes()+\"\";",
                    "    hh = (hh.length == 1 ? '0' : \"\") + hh;",
                    "    mi = (mi.length == 1 ? '0' : \"\") + mi;",
                    "",
                    "    dateData[hourCompoList[key]] = hh + \"\" + mi +\"00\";",
                    "}",
                    "",
                    "",
                    "var st = dateData.hodStrdt+dateData.hodStrtm;",
                    "var ed =dateData.hodEdt+dateData.hodEdtm;",
                    "",
                    "st =st*1;",
                    "ed = ed*1;",
                    "",
                    "if(st > ed){",
                    "    errMsg += '시작일시는 종료일 보다 클 수 없습니다. <br>';",
                    "}",
                    "",
                    "",
                    "return errMsg;",
                    ""
                ]
            },
