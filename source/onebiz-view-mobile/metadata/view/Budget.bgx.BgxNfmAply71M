                "fn": "onContainerInitialize",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    config = component.config,",
                    "    command = config.command,",
                    "    aprHistId = config.aprHistId,",
                    "    docData = config.docData,",
                    "    applyInfo = docData.afterchange.applyInfo;",
                    "",
                    "vm.set('command', command);",
                    "vm.set('aprHistId', aprHistId);",
                    "vm.set('docData', docData);",
                    "vm.set('applyInfo', applyInfo);",
                    "vm.set('record', config.record);",
                    "",
                    "// 결재문서 초기화 설정",
                    "ApprovalBoxSvc.setup({",
                    "    command   : command,",
                    "    viewModel : vm,",
                    "    aprHistId : aprHistId,",
                    "    edocCd    : 'BgxNfmAply71',",
                    "    scope     : me",
                    "});",
                    "",
                    "// 구분",
                    "var aplKndcdNm = '',",
                    "    itemId = '';",
                    "switch(applyInfo.aplKndcd) {",
                    "    case Constants.aplKndcd.CARD :",
                    "        aplKndcdNm = '법인카드';",
                    "        itemId = 'BgxNfmAply71MItem01';",
                    "        break;",
                    "    case Constants.aplKndcd.CSH_RCT :",
                    "        aplKndcdNm = '현금영수증';",
                    "        itemId = 'BgxNfmAply71MItem02';",
                    "        break;",
                    "    case Constants.aplKndcd.ETC_RCT :",
                    "        aplKndcdNm = '기타영수증';",
                    "        itemId = 'BgxNfmAply71MItem04';",
                    "        break;",
                    "",
                    "}",
                    "",
                    "if(itemId) {",
                    "     me.settingValues(config, docData, itemId, aplKndcdNm);",
                    "} else {",
                    "    // 세금계산서, 여비정산서는 모바일에서 조회불가",
                    "    refs.aplKndcd.setHidden(false);",
                    "    refs.item_container.setHidden(true);",
                    "    refs.btnContainer.setHidden(true);",
                    "}"
                ],
