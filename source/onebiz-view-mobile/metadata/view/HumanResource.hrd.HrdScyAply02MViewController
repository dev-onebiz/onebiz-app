            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "신청취소 로직"
                ],
                "designer|params": [
                    "btn,text"
                ],
                "fn": "onCancel",
                "implHandler": [
                    "if(btn != 'yes') return false;",
                    "",
                    "        var me = this;",
                    "        var vm = me.getViewModel();",
                    "        var refs = me.getReferences();",
                    "        var data = vm.data.detail;",
                    "",
                    "        // Service 호출",
                    "        Ext.Ajax.request({",
                    "            headers : {",
                    "                viewId : this.getView().xtype, \t\t\t\t// userAlias",
                    "                serviceId : 'HrdScySvc.deleteHrdScyCtrbApl' // 신청자 row 삭제",
                    "            },",
                    "            jsonData : data,",
                    "            scope : me,",
                    "            success : function(response, opts) {",
                    "                var result = Ext.JSON.decode(response.responseText); // 서버응답결과 JSON 변환",
                    "",
                    "                if(result.isApply === 0){  // 기존에 신청하지 않은 사용자는 서버단에서 UPDATE 하지 않음",
                    "                  Ext.Msg.show({",
                    "                      title : '미신청',",
                    "                      message : '아직 신청하지 않으셨습니다.',",
                    "                      buttons : Ext.MessageBox.YES,",
                    "                      fn: function(btn){}",
                    "                  });",
                    "                  return false;",
                    "                }",
                    "",
                    "                if(result.getPointed == 1){ // 획득한 포인트가 있는 경우 삭제 불가",
                    "                  Ext.Msg.show({",
                    "                      title : '취소불가',",
                    "                      message : '포인트를 획득하여 취소할 수 없습니다.',",
                    "                      buttons : Ext.MessageBox.YES,",
                    "                      fn: function(btn){}",
                    "                  });",
                    "                  return false;",
                    "                }",
                    "",
                    "                // 취소 완료 시 목록으로",
                    "                Ext.Msg.show({",
                    "                    title : '신청 취소',",
                    "                    message : '신청 취소되었습니다.',",
                    "                    buttons : Ext.MessageBox.YES,",
                    "                    fn: function(btn){",
                    "                        if(btn === 'yes'){",
                    "                            me.goBack(me);",
                    "                        }",
                    "                    }",
                    "                });",
                    "            },",
                    "            failure : function(response, opts){",
                    "                // Service 실패 했을 경우 기능",
                    "                Ext.Msg.show({",
                    "                    title : '실패',",
                    "                    message : '취소 도중 에러가 발생했습니다.',",
                    "                    buttons : Ext.MessageBox.YES,",
                    "                    fn: function(btn){",
                    "                        if(btn === 'yes'){",
                    "                            me.goBack(me);",
                    "                        }",
                    "                    }",
                    "                });",
                    "            }",
                    "        });"
                ]
            },
