                ],
                "fn": "initView",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences();",
                    "",
                    "/*이전 탭 확인하여 버튼 숨김처리*/",
                    "var preView = vm.getData('detail').detail.preView;",
                    "",
                    "if(preView == 'tabScyInfo'){ // 이전 탭이 사회공헌활동 내역인 경우",
                    "    // 신청취소 버튼 숨기기",
                    "    refs.btnScyApl.setHidden(true);",
                    "}else{ \t\t\t\t\t\t  // 이전 탭이 사회공헌활동 신청인 경우",
                    "",
                    "    var now = DateUtils.encodeDate(new Date(), 'Ymd'); // 현재일자",
                    "",
                    "    /*신청상태를 확인하여 버튼 설정하기*/",
                    "",
                    "    var aplStatus = vm.getData('detail').detail.aplStatus; // 사회공헌활동 신청테이블에서 신청한 row 개수. (0:신청가능, 1 :신청완료)",
                    "    var csrDt = vm.getData('detail').detail.csrDt; \t\t// 사회공헌 종료일자",
                    "",
                    "    // 과거의 데이터인 경우",
                    "    if(Number(now) > Number(csrDt)){",
                    "        // 신청취소 버튼 숨기기",
                    "        refs.btnScyApl.setHidden(true);",
                    "        return;",
                    "    }",
                    "",
                    "    if(aplStatus == '0'){",
                    "        refs.btnScyApl.setStyle('background-color:#000000;color:white;');",
                    "        refs.btnScyApl.setHtml('사회공헌활동 신청');",
                    "    }else{",
                    "        refs.btnScyApl.setHtml('사회공헌활동 취소');",
                    "    }",
                    "}",
                    "",
                    ""
                ]
            },
