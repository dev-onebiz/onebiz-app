            "userConfig": {
                "designer|commentHeader": [
                    "utc to date string"
                ],
                "designer|params": [
                    "utc"
                ],
                "fn": "dateTo8Char",
                "implHandler": [
                    " if(utc){",
                    "     if (utc.toString().length > 8 && typeof (utc) != 'string') {",
                    "         var yy = utc.getFullYear().toString();",
                    "         var mm = (utc.getMonth() + 1).toString();",
                    "         if (mm.length < 2) {",
                    "             mm = '0' + mm;",
                    "         }",
                    "         var dd = utc.getDate().toString();",
                    "         if (dd.length < 2) {",
                    "             dd = '0' + dd;",
                    "         }",
                    "         return yy + mm + dd;",
                    "     }else if(utc.toString().length > 8){",
                    "         return utc.replace('-', '').replace('-', '').substr(0, 8);",
                    "     }else {",
                    "         return utc;",
                    "     }",
                    " }"
                ]
            },
