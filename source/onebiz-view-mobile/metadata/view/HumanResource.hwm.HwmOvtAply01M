                                    "",
                                    "aplDvcdNm = (record.data.aplDvcd == Constants.aplDvcd.CANCLE) ? \"<font color= 'red'>\" +aplDvcdNm+ \"</font>\" : aplDvcdNm;",
                                    "var result = '<div><span style=\"font-size:15px;font-weight:bold;width:100%;overflow: hidden;white-space:nowrap;text-overflow:ellipsis;display:inline-block;\">'+dateMMdd+' 연장근무 '+aplDvcdNm+'</span></div>';",
                                    "",
                                    "// 시간",
                                    "var AplOvtStrdt = record.data.aplOvtStrdt.substr(0,4) + '-' + record.data.aplOvtStrdt.substr(4,2) + '-' + record.data.aplOvtStrdt.substr(6,2);",
                                    "var AplOvtEdt = record.data.aplOvtEdt.substr(0,4) + '-' + record.data.aplOvtEdt.substr(4,2) + '-' + record.data.aplOvtEdt.substr(6,2);",
                                    "var AplOvtStrtm = record.data.aplOvtStrtm.substr(0,2) + ':' + record.data.aplOvtStrtm.substr(2,2);",
                                    "var AplOvtEdtm = record.data.aplOvtEdtm.substr(0,2) + ':' + record.data.aplOvtEdtm.substr(2,2);",
                                    "",
                                    "if(AplOvtStrdt != AplOvtEdt){",
                                    "    result += '<div style=\"font-size : 10px\">'+AplOvtStrdt+' '+AplOvtStrtm+' ~ '+AplOvtEdt + ' '+AplOvtEdtm+'</div>';",
                                    "}else{",
                                    "    result += '<div>'+AplOvtStrdt+' | '+AplOvtStrtm+'~'+AplOvtEdtm+'</div>';",
                                    "}",
                                    "",
                                    "cell.setStyle('padding:0px;');",
                                    "return result;",
                                    "",
                                    ""
                                ]
