                "fn": "initialize",
                "implHandler": [
                    "var me = this;",
                    "",
                    "Ext.Ajax.request({",
                    "    headers : {",
                    "        serviceId : 'COMAPR0001R01M',",
                    "        viewId : 'ApprovalLinePopup'",
                    "    },",
                    "    scope : me,",
                    "    success : function(response) {",
                    "        var me = this,",
                    "            refs = me.getReferences(),",
                    "            vm = me.getViewModel(),",
                    "            myApprLine = refs.myApprLine,",
                    "            store = vm.data.ApprovalLineStore,",
                    "            responseJson = Ext.JSON.decode(response.responseText),",
                    "            records = responseJson.result;",
                    "",
                    "        if (records && records.length > 0) {",
                    "            store.add(records);",
                    "            myApprLine.setValue(store.getAt(0).get('comAprLineId'));\t// 첫행선택",
                    "        }",
                    "    }",
                    "});"
                ],
