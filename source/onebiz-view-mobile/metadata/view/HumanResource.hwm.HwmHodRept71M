                "fn": "onContainerInitialize",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    approvalLineGrid = refs.approvalLineGrid, \t// 결재선",
                    "    afterchangeform = refs.frmDetail,",
                    "    initialConfig = component.config, \t\t\t// 화면초기데이터",
                    "    command = initialConfig.command,",
                    "    aprHistData = initialConfig.aprHistData, \t// 결재이력데이터",
                    "    // 결재함(ExpNteApr02)에서는 docData,",
                    "    // 휴일근무신청(HwmHodRept01)에서는 aprHistData.docData",
                    "    docData = (aprHistData) ? aprHistData.docData : initialConfig.docData, \t\t\t\t// 문서데이터",
                    "    afterchange = docData.afterchange,",
                    "    edocCd = 'HwmHodRept71', \t\t\t\t\t// 문서코드",
                    "    edocNm = '휴일근무 보고서',",
                    "    aprHistId = initialConfig.aprHistId, \t\t// 결재내역ID",
                    "    userId = SecurityUtils.getPrincipal().hrHrpmEmpId, // 사용자ID",
                    "    record = initialConfig.record; \t\t\t\t// 결재함 목록에서 선택한 레코드",
                    "",
                    "vm.set('docCd', edocCd);",
                    "vm.set('docNm', edocNm);",
                    "vm.set('aprHistId', aprHistId);",
                    "vm.set('afterchange', afterchange);",
                    "vm.set('record', record);",
                    "",
                    "var hodStrtm = afterchange.hodStrtm,",
                    "    hodEdtm = afterchange.hodEdtm,",
                    "    wrkStrtm = afterchange.wrkStrtm,",
                    "    wrkEdtm = afterchange.wrkEdtm;",
                    "afterchange.hodStrtm = DateUtils.encodeDate(DateUtils.getTimeToDate(hodStrtm),\"H:i\");",
                    "afterchange.hodEdtm = DateUtils.encodeDate(DateUtils.getTimeToDate(hodEdtm),\"H:i\");",
                    "afterchange.wrkStrtm = DateUtils.encodeDate(DateUtils.getTimeToDate(wrkStrtm),\"H:i:s\");",
                    "afterchange.wrkEdtm = DateUtils.encodeDate(DateUtils.getTimeToDate(wrkEdtm),\"H:i:s\");",
                    "",
                    "var aplHodDt = afterchange.aplHodDt,",
                    "    hodStrdt = afterchange.hodStrdt,",
                    "    hodEdt = afterchange.hodEdt,",
                    "    wrkStrdt = afterchange.wrkStrdt,",
                    "    wrkEdt = afterchange.wrkEdt;",
                    "afterchange.aplHodDt = DateUtils.parseDate(aplHodDt);",
                    "afterchange.hodStrdt = DateUtils.parseDate(hodStrdt);",
                    "afterchange.hodEdt = DateUtils.parseDate(hodEdt);",
                    "afterchange.wrkStrdt = DateUtils.parseDate(wrkStrdt);",
                    "afterchange.wrkEdt = DateUtils.parseDate(wrkEdt);",
                    "afterchange.aplDvcdNm = CodeUtils.getText('HWM009', afterchange.aplDvcd);",
                    "",
                    "me.fnInitComponentForm(afterchangeform);",
                    "",
                    "me.setAprHistId(aprHistId); // 결재이력아이디",
                    "me.setRecord(record); \t\t// 동시성 제어를 하기 위한 용도로 Config에 저장함",
                    "me.setCommand(command); \t// 결재처리 커맨드",
                    "",
                    "// 결재문서 초기화 설정",
                    "ApprovalBoxSvc.setup({",
                    "    command : command, \t\t// 결재선구분커맨드",
                    "    viewModel : vm,",
                    "    edocCd : edocCd, \t\t// 전자문서관리화면에 설정된 문서코드: 화면ID를 사용",
                    "    aprHistId : aprHistId, \t// 결재이력ID",
                    "    scope : me",
                    "});",
                    "",
                    "afterchangeform.setValues(afterchange);",
                    "",
                    "var rgdt = (aprHistData) ? record.apfAplDtm : record.fstRgDtti;\t\t// 휴일근무신청(apfAplDtm) , 결재함(fstRgDtti)",
                    "refs.rgdt.setHtml(rgdt.substr(0,10));",
                    "",
                    "refs.hodStrtm.el.select('.x-error-el').setStyle('margin','0px');",
                    "refs.hodEdtm.el.select('.x-error-el').setStyle('margin',\t'0px');",
                    "refs.hodStrtm.el.select('.x-error-el').setStyle('height','0px');",
                    "refs.hodEdtm.el.select('.x-error-el').setStyle('height',\t'0px');"
