                                        "fn": "onBtnAddExtenalUser",
                                        "implHandler": [
                                            "var me = this,",
                                            "    vm = me.getViewModel(),",
                                            "    refs = me.getReferences(),",
                                            "    cbxBsnsId = refs.extenal_bgBudcBsnsId,",
                                            "    store = refs.userGrid.getStore();",
                                            "",
                                            "if(store && store.data.length != 0) {",
                                            "    // 해당 사업부문의 계정과목에 인력이 있는경우에만 외부직원 추가",
                                            "    var data = {",
                                            "        bgBudcBsnsId : cbxBsnsId.getValue(),\t// 사업부문ID",
                                            "        bsnsYy : vm.get('expItemInputData.bsnsYy'),",
                                            "        dpnm : refs.dpnm.getValue(),\t\t\t\t\t\t\t// 부서",
                                            "        enpnm : refs.enpnm.getValue(),\t\t\t\t\t\t\t// 회사명",
                                            "        stcd : '01',",
                                            "        stfDvcd : Constants.stfDvcd.OUT,\t\t\t\t\t\t// 외부사용자",
                                            "        stfNm : refs.stfNm.getValue(),\t\t\t\t\t\t\t// 성명",
                                            "        stfNo : refs.stfNo.getValue(),\t\t\t\t\t\t\t// 연락처",
                                            "        xpnitKeyCd : Constants.xpnitKeyCd.BUSI_PROMOTION,",
                                            "        bgBudcXpnitYyId : store.data.items[0].data.bgBudcXpnitYyId\t\t// 연도별계정과목ID ",
                                            "    },",
                                            "    userCnt = refs.userCnt,",
                                            "    userList = {},",
                                            "    len = 0,",
                                            "    check = false;",
                                            "",
                                            "    // extenal form valid",
                                            "    var form = refs.extenalForm,",
                                            "        valid = form.validate();",
                                            "    if (!valid) {",
                                            "        var errMsg = '';",
                                            "",
                                            "        for(var i = 0; i < form.getFields().null.length; i++) {",
                                            "            var field = form.getFields().null[i];",
                                            "            if (!field.isValid()) {",
                                            "                var tmp = field.getErrorMessage();",
                                            "                if (tmp.indexOf('This field is required') != -1) {",
                                            "                    errMsg += '- ' + field.up('container').down('displayfield').getHtml() + ' 을(를) 입력해주세요.<br>';",
                                            "                } else if (tmp == \"Value does not match the required format\") {",
                                            "                    errMsg += '- ' + field.up('container').down('displayfield').getHtml() + ' 형식을 올바르게 입력해주세요.<br>';",
                                            "                } else {",
                                            "                    errMsg += '- ' + field.up('container').items.items[0].getHtml() + ' : ' + tmp + '<br>';",
                                            "                }",
                                            "            }",
                                            "        }",
                                            "",
                                            "        me.showAlert(errMsg);",
                                            "        return;",
                                            "    } else if (!cbxBsnsId.getValue()) {",
                                            "        errMsg = '- 사업부문을 입력해주세요. <br>';",
                                            "        me.showAlert(errMsg);",
                                            "        return;",
                                            "    }",
                                            "",
                                            "    var bsnsNm = '',\t\t\t\t\t\t\t// 사업부문NM",
                                            "        store = cbxBsnsId.getStore(),",
                                            "        items = store.data.items ;",
                                            "    for (var i in items) {",
                                            "        var tmp = items[i].data;",
                                            "        if (tmp.bgBudcBsnsId == cbxBsnsId.getValue()) {",
                                            "            bsnsNm = tmp.bsnsNm;",
                                            "        }",
                                            "    }",
                                            "    data.bsnsNm = bsnsNm;",
                                            "    data.empePsitNm = data.stfNo;\t\t\t\t// 외부직원일 경우, '직급' 대신 '연락처' 표기",
                                            "",
                                            "    for (var i in  vm.get('userList')) {",
                                            "        userList[i] = vm.get('userList')[i];\t// 추가된사용자 data",
                                            "        len++;",
                                            "",
                                            "        check = me.checkUser(data);\t\t\t\t// 중복체크",
                                            "        if (check) {",
                                            "            break;",
                                            "        }",
                                            "    }",
                                            "",
                                            "    if (!check) {",
                                            "        // set userData",
                                            "        userList[len] = data;",
                                            "        vm.set('userList', userList);",
                                            "",
                                            "        // add userForm",
                                            "        userCnt.add(Ext.create('BgxNfmAply52MItems', {",
                                            "            data : data",
                                            "        }));",
                                            "",
                                            "        // reset inputForm",
                                            "        form.reset();",
                                            "    }",
                                            "}"
                                        ],
