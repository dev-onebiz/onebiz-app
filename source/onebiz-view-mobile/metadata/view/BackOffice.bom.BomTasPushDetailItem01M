            "userConfig": {
                "fn": "onContainerInitialize",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    initConfig = component.config,",
                    "    record = initConfig.record;",
                    "",
                    "vm.set('detail', record);",
                    "",
                    "refs.title.setHtml(record.title);\t\t\t// 제목",
                    "refs.content.setHtml(record.content);\t\t// 내용",
                    "",
                    "var userAgent = navigator.userAgent.toLowerCase();",
                    "if(userAgent.indexOf('iphone') > -1){ //아이폰일 경우만 처리.",
                    "",
                    "    var anchorList = refs.content.el.dom.getElementsByTagName('a');",
                    "    var anchor = null;",
                    "    for(var i = 0; i < anchorList.length; i++){",
                    "        anchor = anchorList[i];",
                    "",
                    "        if(!Ext.isEmpty(anchor.getAttribute('href')) && anchor.getAttribute('target') == '_blank'){",
                    "            anchor.setAttribute('onclick', 'window.open(\"' + anchor.getAttribute('href') + '\", \"_system\")');",
                    "            anchor.setAttribute('href', null);",
                    "        }",
                    "    }",
                    "}",
                    "",
                    "// 포맷구분 (text, url)",
                    "if(record.fmtDvcd == Constants.pushFmtDvcd.TXT) {",
                    "    refs.btnUrl.setHidden(true);\t  //외부URL",
                    "    refs.btnInnerUrl.setHidden(true); //내부URL",
                    "} else if(record.fmtDvcd == Constants.pushFmtDvcd.OUTER_URL){",
                    "    refs.btnInnerUrl.setHidden(true);",
                    "",
                    "    if(!Ext.isEmpty(record.urlTxt)){",
                    "        refs.btnUrl.setHidden(false);",
                    "    }",
                    "",
                    "    //버튼명에 대한 내용이 있을 경우, 버튼명 설정",
                    "    if(!Ext.isEmpty(vm.get('detail.urlBtnNm'))){",
                    "        refs.btnUrl.setText(vm.get('detail.urlBtnNm'));",
                    "    }",
                    "} else {",
                    "    refs.btnUrl.setHidden(true);",
                    "",
                    "    if(!Ext.isEmpty(record.urlTxt)){",
                    "        refs.btnInnerUrl.setHidden(false);",
                    "    }",
                    "",
                    "    //버튼명에 대한 내용이 있을 경우, 버튼명 설정",
                    "    if(!Ext.isEmpty(vm.get('detail.urlBtnNm'))){",
                    "        refs.btnInnerUrl.setText(vm.get('detail.urlBtnNm'));",
                    "    }",
                    "}"
                ],
                "name": "initialize",
                "scope": "me"
            },
