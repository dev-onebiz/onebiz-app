                "fn": "openPage",
                "implHandler": [
                    "var me = this;",
                    "var refs = me.getReferences();",
                    "var vm = me.getViewModel();",
                    "",
                    "var principal = SecurityUtils.getPrincipal();",
                    "",
                    "var naviView = me.getView().up('navigationview');",
                    "",
                    "var param = {",
                    "    userId : principal.userId,",
                    "    chkNo  : params.chkNo,",
                    "    type   : params.type,",
                    "};",
                    "",
                    "// 체크리스트의 경우 검색 조건이 달라 파라미터 추가",
                    "if(params.type == 'check_list1'){",
                    "    param.isCkl = true;",
                    "}",
                    "",
                    "Ext.Ajax.request({",
                    "    headers: {",
                    "        viewId : me.getViewId(),",
                    "        serviceId : 'BomCplSvc.findAllSelfIspeCht'",
                    "    },",
                    "    jsonData : param,",
                    "    scope : me,",
                    "    success : function(response) {",
                    "        var res = Ext.JSON.decode(response.responseText);",
                    "        var content = res.page.content;",
                    "",
                    "        // 점검항목 없음",
                    "        // 확정",
                    "        // 최종완료",
                    "        // -> 화면 접근 불가능",
                    "        if(res.page != 'noResult'){",
                    "            // 확정 / 최종완료",
                    "            if(content[0].confirmYn == 'Y' || content[0].finishYn == 'Y'){",
                    "                // 바로 닫기",
                    "                Ext.Msg.alert('알림','확정되었습니다.');",
                    "//                 var toast = Ext.toast(\"확정되었습니다.\", 1000);",
                    "//                 toast.setBottom('50px');",
                    "            }",
                    "",
                    "            else{",
                    "                var start,end,now;",
                    "",
                    "                start = new Date(content[0].chkSdate).getFullYear();",
                    "                end   = new Date(content[0].chkEdate).getFullYear();",
                    "                now   = new Date().getFullYear();",
                    "                var yearYn = start <= now && now <= end ? true : false;",
                    "",
                    "                start = new Date(content[0].chkSdate).getMonth();",
                    "                end   = new Date(content[0].chkEdate).getMonth();",
                    "                now   = new Date().getMonth();",
                    "                var monthYn = start <= now && now <= end ? true : false;",
                    "",
                    "                start = new Date(content[0].chkSdate).getDate();",
                    "                end   = new Date(content[0].chkEdate).getDate();",
                    "                now   = new Date().getDate();",
                    "                var dateYn = start <= now && now <= end ? true : false;",
                    "",
                    "                me.PUSH_VIEW(naviView, {",
                    "                    menuId     : params.menuId,",
                    "                    title      : params.title,",
                    "                    type       : params.type,",
                    "                    chkNo      : params.chkNo,",
                    "                    isSubView  : true,",
                    "                    parentView : me.getView(),",
                    "",
                    "                });",
                    "            }",
                    "        }",
                    "    }",
                    "});"
                ]
            },
