                "fn": "setChkNo",
                "implHandler": [
                    "var me = this;",
                    "var result = '';",
                    "",
                    "var date = new Date();",
                    "",
                    "",
                    "",
                    "if(date.getMonth() >= 10){",
                    "    result += date.getFullYear();",
                    "    result += (date.getMonth());",
                    "}",
                    "else{",
                    "    if(date.getMonth() === 0){",
                    "        result += date.getFullYear() - 1;",
                    "    result += '12';",
                    "        ",
                    "    }",
                    "    else{",
                    "        result += date.getFullYear();",
                    "    result += '0' + (date.getMonth());",
                    "    }",
                    "}",
                    "",
                    "return result;"
                ]
            },
