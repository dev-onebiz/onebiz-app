        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "(부장 여부) -> 체크리스트 숨김/보임"
                ],
                "fn": "onSelectSicCklInit",
                "implHandler": [
                    "var me = this;",
                    "var refs = me.getReferences();",
                    "var vm = me.getViewModel();",
                    "",
                    "var principal = SecurityUtils.getPrincipal();",
                    "",
                    "var param = {",
                    "    BomCmplHomeInit : true,",
                    "    userId: principal.userId,",
                    "    chkNo: me.setChkNo(),",
                    "};",
                    "",
                    "// 자기점검 리스트 불러오기 [시작]",
                    "Ext.Ajax.request({",
                    "    headers: {",
                    "        viewId : me.getViewId(),",
                    "        serviceId : 'BomCplSvc.findAllProgressBoard'",
                    "    },",
                    "    jsonData : param,",
                    "    scope : me,",
                    "    success : function(response) {",
                    "        var res = Ext.JSON.decode(response.responseText);",
                    "        var content = res.page.content;",
                    "        var contentTimeOver = res.pageTimeOver.content;",
                    "",
                    "        if(contentTimeOver.length > 0){",
                    "            for(var i in contentTimeOver){",
                    "                if(contentTimeOver[i].type !== null){",
                    "                    var startdate = DateUtils.getDate(new Date(contentTimeOver[parseInt(i)].chkSdate));",
                    "                    var enddate = DateUtils.getDate(new Date(contentTimeOver[parseInt(i)].chkEdate));",
                    "                    var nowdate = DateUtils.getDate(new Date());",
                    "",
                    "                    if(startdate <= nowdate && nowdate <= enddate){",
                    "                        switch(contentTimeOver[i].chkType){",
                    "                            case 'check_list':",
                    "                                refs.timeoverContainer.setHidden(true);",
                    "                                refs.sicCmplContainer.setHidden(false);",
                    "                                refs.lineComponent1.setHidden(false);",
                    "                                break;",
                    "                            case 'check_list1':",
                    "                                refs.timeoverContainer.setHidden(true);",
                    "                                refs.cklCmplContainer.setHidden(false);",
                    "                                break;",
                    "                            case 'check_list2':",
                    "                                refs.timeoverContainer.setHidden(true);",
                    "                                refs.sicPsipContainer.setHidden(false);",
                    "                                refs.lineComponent2.setHidden(false);",
                    "                                break;",
                    "                            case 'check_list3':",
                    "                                refs.timeoverContainer.setHidden(true);",
                    "                                refs.sicPcscContainer.setHidden(false);",
                    "                                refs.lineComponent3.setHidden(false);",
                    "                                break;",
                    "                            case 'check_list4':",
                    "                                refs.timeoverContainer.setHidden(true);",
                    "                                refs.sicBzcsContainer.setHidden(false);",
                    "                                refs.lineComponent4.setHidden(false);",
                    "                                break;",
                    "",
                    "                        }",
                    "                    }",
                    "//                     else {",
                    "//                         refs.timeoverContainer.setHidden(false);",
                    "//                     }",
                    "                }",
                    "            }",
                    "",
                    "            // 점검 항목이 없으면 '점검기간지남' 표시",
                    "            for(var i in refs.sicCklContainer.items.items){",
                    "",
                    "                    refs.timeoverContainer.setHidden(false);",
                    "                if(!refs.sicCklContainer.items.items[i].getHidden()){",
                    "                    refs.timeoverContainer.setHidden(true);",
                    "                    break;",
                    "                }",
                    "            }",
                    "",
                    "",
                    "            // 사실상 for문에서 모두 걸러지지만",
                    "            // 부장이 아닌 직원에게 체크리스트가 보일 경우를 대비한 방어코드",
                    "",
                    "            // 책임자, 사원 -> 체크리스트 숨김",
                    "            if(Ext.isEmpty(content) || content[0].usrType !== '1'){",
                    "                refs.cklCmplContainer.setHidden(true);",
                    "                refs.lineComponent4.setHidden(true);",
                    "            }",
                    "        }",
                    "        else{",
                    "            refs.timeoverContainer.setHidden(false);",
                    "        }",
                    "",
                    "        // 자기점검 리스트 불러오기 [종료]",
                    "        refs.etcInfo.setMargin('20px 0 0 0');",
                    "",
                    "    }",
                    "});"
                ]
            },
            "configAlternates": {
                "fn": "string",
                "implHandler": "code",
                "designer|commentHeader": "comment"
            },
            "name": "onSelectSicCklInit",
            "designerId": "a59c163e-4946-4d00-b66c-bddb432f3a97"
        },
        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "점검 진행 여부 O|X|- 표시변경"
                ],
                "fn": "onSelectSicCkl",
                "implHandler": [
                    "var me = this;",
                    "var refs = me.getReferences();",
                    "var vm = me.getViewModel();",
                    "",
                    "var principal = SecurityUtils.getPrincipal();",
                    "",
                    "var param = {",
                    "    userId: principal.userId,",
                    "    chkNo: me.setChkNo(),",
                    "};",
                    "",
                    "Ext.Ajax.request({",
                    "    headers: {",
                    "        viewId : me.getViewId(),",
                    "        serviceId : 'BomCplSvc.findAllProgressBoard'",
                    "    },",
                    "    jsonData : param,",
                    "    scope : me,",
                    "    success : function(response) {",
                    "        var res = Ext.JSON.decode(response.responseText);",
                    "        var content = res.page.content;",
                    "",
                    "        var me = this;",
                    "        var refs = me.getReferences();",
                    "",
                    "        // 조회 데이터",
                    "        for(var i in content){",
                    "            // 화면의 ox-",
                    "            for(var j in refs.sicCklContainer.items.items){",
                    "                // 내부에 컨텐츠가 있는지..구분자가 아닌 경우에 비교 진행",
                    "                if(!Ext.isEmpty(refs.sicCklContainer.items.items[j].items.items)){",
                    "",
                    "                    /*",
                    "                        기본 - 아이콘",
                    "                        -> 등록된 문제 없음 / 기간 외 -> -로 유지되며 해당 점검에 접근 불가",
                    "                    */",
                    "                    if(content[i].chkType == refs.sicCklContainer.items.items[j].items.items[1].items.items[1].reference){",
                    "",
                    "                        // 확정 된 경우 -> 접근 불가 + 토스트 띄움",
                    "                        if(!Ext.isEmpty(content[i].confirm)){",
                    "                            refs.sicCklContainer.items.items[j].items.items[1].items.items[1].setSrc('resources/images/icon-cmpl-check.png');",
                    "                        }",
                    "",
                    "                        /*",
                    "                            'Y' -> 'O'",
                    "                            진행한 경우 O로 변경됨",
                    "                            주|부문제로 구분된 경우 모든 문제에 대답한 경우 O로 변경됨",
                    "                        */",
                    "                        else if(content[i].done == 'Y'){",
                    "                            if(content[i].chkType == 'check_list1'){",
                    "                                break;",
                    "                            }",
                    "                            refs.sicCklContainer.items.items[j].items.items[1].items.items[1].setSrc('resources/images/icon-cmpl-circle.png');",
                    "",
                    "                        }",
                    "                        /*",
                    "                            'N' -> 'X'",
                    "                            아직 점검을 진행하지 않은 경우",
                    "                            주|부문제로 구분된 경우 // 주문제 오답 -> 부문제 대답 불가 => 모든 문제에 대답 불가 -> X 표시",
                    "                        */",
                    "                        else{",
                    "                            refs.sicCklContainer.items.items[j].items.items[1].items.items[1].setSrc('resources/images/icon-cmpl-minus.png');",
                    "                        }",
                    "                    }",
                    "                }",
                    "            }",
                    "        }",
                    "    }",
                    "});"
                ]
            },
            "configAlternates": {
                "fn": "string",
                "implHandler": "code",
                "designer|commentHeader": "comment"
            },
            "name": "onSelectSicCkl",
            "designerId": "9c4ee711-2ea0-406d-9bf4-37c1e3bb0565"
        }
    ]
