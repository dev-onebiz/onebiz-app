                "fn": "onSelectCodeList",
                "implHandler": [
                    "var me = this;",
                    "var D = new Ext.Deferred();",
                    "",
                    "Ext.Ajax.request({",
                    "    headers: {",
                    "        viewId : me.getViewId(),",
                    "        serviceId : 'BomMtgSvc.findOneCodelist'",
                    "    },",
                    "    jsonData : {",
                    "        codeDvcd : codeDvcd,",
                    "        stcd : Constants.stcd.NORMAL,",
                    "    },",
                    "    scope : me,",
                    "    success : function(response) {",
                    "",
                    "        var res = Ext.JSON.decode(response.responseText);",
                    "",
                    "        var me = this;",
                    "        var vm = me.getViewModel();",
                    "",
                    "        ComboboxUtils.makeCustomCbx(component, res.result);",
                    "        if(Ext.isEmpty(vm.get('content'))){",
                    "            // 비었으면 기본 장소",
                    "            component.setValue(mtgRoomDvcd);",
                    "        }",
                    "        else{",
                    "            // 안 비었으면 값에 대해 설정",
                    "            component.setValue(vm.get('content').mtgRoomDvcd);",
                    "        }",
                    "",
                    "",
                    "        D.resolve(res.result); // 성공",
                    "",
                    "",
                    "    },",
                    "    failure : function(res, scope) {",
                    "        D.reject(); // 실패",
                    "    }",
                    "",
                    "});",
                    "",
                    "return D.promise;",
                    ""
                ]
            },
