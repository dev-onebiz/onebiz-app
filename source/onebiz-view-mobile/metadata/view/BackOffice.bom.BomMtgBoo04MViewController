        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "fn": "onChange",
                "implHandler": [
                    "var me = this;",
                    "var refs = me.getReferences();",
                    "",
                    "// 현재일시",
                    "var today = Ext.Date.format(new Date(), 'Ymd');",
                    "var nowTime = Ext.Date.format(new Date(), 'His');",
                    "// 회의 시작일시",
                    "var mtgBooStrdt = Ext.Date.format(refs.mtgBooStrdt.getValue(), 'Ymd');",
                    "var mtgBooStrtm = Ext.Date.format(refs.mtgBooStrtm.getValue(), 'His');",
                    "",
                    "// 현재 일시에서 각 1일, 30분을 더한 일시",
                    "var day1AddDate = '';",
                    "var min30AddDate = '';",
                    "",
                    "// 회의의 시작 일시가 모두 입력되었을 경우만 확인",
                    "if (!Ext.isEmpty(mtgBooStrdt) && !Ext.isEmpty(mtgBooStrtm)) {",
                    "    // 현재 날짜에서 하루 더한 날짜(Ymd)",
                    "    day1AddDate = DateUtils.reassignDate('D', DateUtils.parseTimestampToDate(today + nowTime), 1);",
                    "    // 현재 시간에서 30분 더한 시간(His)",
                    "    min30AddDate = DateUtils.reassignTime('I', DateUtils.parseTimestampToDate(today + nowTime), 30);",
                    "",
                    "    // 현재 일시부터 회의까지 남은 일시가 하루 미만일 경우",
                    "    if (day1AddDate + nowTime > mtgBooStrdt + mtgBooStrtm) {",
                    "        // 1일 전 체크박스 비활성화",
                    "        refs.dd1BefLemeYn.setDisabled(true);",
                    "        refs.dd1BefLemeYn.setBoxLabel('<font style=\"color:#aaa\">1일 전</font>');",
                    "",
                    "        // 체크상태 해제",
                    "        refs.dd1BefLemeYn.setChecked(false);",
                    "    }",
                    "    else {",
                    "        // 1일 전 체크박스 활성화",
                    "        refs.dd1BefLemeYn.setDisabled(false);",
                    "        refs.dd1BefLemeYn.setBoxLabel('<font style=\"color:#000\">1일 전</font>');",
                    "    }",
                    "",
                    "    // 현재 일시부터 회의까지 남은 일시가 30분 미만일 경우",
                    "    if (today + min30AddDate > mtgBooStrdt + mtgBooStrtm) {",
                    "        // 30분 전 체크박스 비활성화",
                    "        refs.min30BefLemeYn.setDisabled(true);",
                    "        refs.min30BefLemeYn.setBoxLabel('<font style=\"color:#aaa\">30분</font>');",
                    "        // 체크상태 해제",
                    "        refs.min30BefLemeYn.setChecked(false);",
                    "",
                    "        // 예약 후 체크박스 비활성화",
                    "        refs.booAftLemeYn.setDisabled(true);",
                    "        refs.booAftLemeYn.setBoxLabel('<font style=\"color:#aaa\">예약 후</font>');",
                    "",
                    "        // 체크상태 해제",
                    "        refs.booAftLemeYn.setChecked(false);",
                    "    }",
                    "    else {",
                    "        // 30분 전 체크박스 활성화",
                    "        refs.min30BefLemeYn.setDisabled(false);",
                    "        refs.min30BefLemeYn.setBoxLabel('<font style=\"color:#000\">30분</font>');",
                    "",
                    "        // 예약 후 체크박스 활성화",
                    "        refs.booAftLemeYn.setDisabled(false);",
                    "        refs.booAftLemeYn.setBoxLabel('<font style=\"color:#000\">예약 후</font>');",
                    "    }",
                    "}"
                ]
            },
            "configAlternates": {
                "fn": "string",
                "implHandler": "code"
            },
            "name": "onChange",
            "designerId": "6c5bf43a-99c8-4946-a6ad-bdd3a8b8a58c"
        },
        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|params": [
                    "crud",
                    "info"
                ],
                "fn": "fnCardInit",
                "implHandler": [
                    "var me = this;",
                    "var refs = me.getReferences();",
                    "var vm = me.getViewModel();",
                    "",
                    "var principal = SecurityUtils.getPrincipal();",
                    "",
                    "vm.set('crud', crud);",
                    "",
                    "// 현재 날짜 및 시간",
                    "var today = Ext.Date.format(new Date(), 'Ymd');",
                    "var nowTime = Ext.Date.format(new Date(), 'His');",
                    "",
                    "// 예약 복사 버튼 숨김여부",
                    "var btnCopyHidden = '';",
                    "// 예약 취소 버튼 숨김여부",
                    "var btnCancelHidden = '';",
                    "// 예약(수정) 버튼 숨김여부",
                    "var btnBookHidden = '';",
                    "",
                    "// 원래 회의내용 저장",
                    "vm.set('info', info);",
                    "",
                    "//신규인 경우",
                    "if (vm.get('crud') == Constants.crudState.CREATE) {",
                    "    info.mtgBooStrdt = info.paramDay; //날짜 데이터 넣어주기",
                    "",
                    "    //기본 설정 데이터 넣어주기",
                    "    refs.mtgBooStrdt.setValue(new Date(info.paramDay.split('-').join('/')));",
                    "",
                    "    var result = principal.hrHrpmEmpId + \" / \"+ principal.dpnm + \" / \" + principal.empeNm +\" / \" + principal.empePsitNm;",
                    "    refs.rqpr.setValue(result);",
                    "",
                    "    // 시작날짜 자동 설정",
                    "    var setHour = '';",
                    "    var setMin = '';",
                    "    if (Ext.Date.format(new Date(), 'i') <= 30) {",
                    "        setHour = Ext.Date.format(new Date(), 'H');",
                    "        setMin = '30';",
                    "    }",
                    "    else {",
                    "        setHour = String(Number(Ext.Date.format(new Date(), 'H')) + 1);",
                    "        setMin = '00';",
                    "    }",
                    "",
                    "    if(vm.data.info.schDay == DateUtils.getDate(new Date())){",
                    "        refs.mtgBooStrtm.setValue(setHour+':'+setMin);",
                    "    }",
                    "    else{",
                    "        refs.mtgBooStrtm.setValue('09:00');",
                    "    }",
                    "",
                    "    //버튼 설정",
                    "    refs.btnCancel.setHidden(true);",
                    "    refs.btnCopy.setHidden(true);",
                    "    refs.btnBook.setText('예약');",
                    "    refs.btnBook.setHidden(false);",
                    "",
                    "}",
                    "//변경인 경우",
                    "else if (vm.get('crud') == Constants.crudState.UPDATE) {",
                    "",
                    "    // 회의 날짜가 오늘 이전일 경우",
                    "    if (info.mtgBooStrdt < today) {",
                    "        // 예약 복사 버튼 숨김여부",
                    "        btnCopyHidden = false;",
                    "        // 예약 취소 버튼 숨김여부",
                    "        btnCancelHidden = true;",
                    "        // 예약(수정) 버튼 숨김여부",
                    "        btnBookHidden = true;",
                    "    }",
                    "    // 회의 날짜가 오늘 이후일 경우",
                    "    else if (info.mtgBooStrdt > today) {",
                    "        // 예약 복사 버튼 숨김여부",
                    "        btnCopyHidden = false;",
                    "        // 예약 취소 버튼 숨김여부",
                    "        btnCancelHidden = false;",
                    "        // 예약(수정) 버튼 숨김여부",
                    "        btnBookHidden = false;",
                    "    }",
                    "    // 회의 날짜가 오늘일 경우",
                    "    else {",
                    "        // 이미 종료된 회의일 경우",
                    "        if (info.mtgBooEdtm < nowTime) {",
                    "            // 예약 복사 버튼 숨김여부",
                    "            btnCopyHidden = false;",
                    "            // 예약 취소 버튼 숨김여부",
                    "            btnCancelHidden = true;",
                    "            // 예약(수정) 버튼 숨김여부",
                    "            btnBookHidden = true;",
                    "        }",
                    "        // 현재 진행중인 회의일 경우",
                    "        else if (info.mtgBooStrtm <= nowTime && nowTime <= info.mtgBooEdtm) {",
                    "            // 예약 복사 버튼 숨김여부",
                    "            btnCopyHidden = false;",
                    "            // 예약 취소 버튼 숨김여부",
                    "            btnCancelHidden = true;",
                    "            // 예약(수정) 버튼 숨김여부",
                    "            btnBookHidden = true;",
                    "        }",
                    "        // 나중에 시작될 회의일 경우",
                    "        else if (info.mtgBooStrtm > nowTime) {",
                    "            // 예약 복사 버튼 숨김여부",
                    "            btnCopyHidden = false;",
                    "            // 예약 취소 버튼 숨김여부",
                    "            btnCancelHidden = false;",
                    "            // 예약(수정) 버튼 숨김여부",
                    "            btnBookHidden = false;",
                    "        }",
                    "    }",
                    "",
                    "    // 현재 사용자가 회의 담당자나 등록자가 아닐 경우",
                    "    if (info.mtgCgpEmpeNo != principal.hrHrpmEmpId",
                    "        && info.fstRgpr != principal.hrHrpmEmpId) {",
                    "        // 예약 복사 버튼 숨김여부",
                    "        btnCopyHidden = true;",
                    "        // 예약 취소 버튼 숨김여부",
                    "        btnCancelHidden = true;",
                    "        // 예약(수정) 버튼 숨김여부",
                    "        btnBookHidden = true;",
                    "    }",
                    "",
                    "    // 현재 수정기능을 사용하지 않으므로 무조건 히든 처리함, 수정 기능 다시 사용할 때 확인 필요함",
                    "    btnBookHidden = true;",
                    "",
                    "    // 회의 시작 10분 전 ~ 회의 시작 직전 까지 취소 가능",
                    "    if(!btnCancelHidden){",
                    "        var startDt = vm.data.info.mtgBooStrdt;",
                    "        startDt = startDt.substr(0,4) + '/' + startDt.substr(4,2) + '/' + startDt.substr(6,2);",
                    "        var startTm = vm.data.info.mtgBooStrtm;",
                    "        startTm = startTm.substr(0,2) + ':'+startTm.substr(2,2);",
                    "        var startDtTm = new Date(startDt+' '+startTm);",
                    "        var startDtTmBefore10 = new Date(startDtTm.setMinutes(startDtTm.getMinutes() - 10));",
                    "        if(new Date() >= startDtTmBefore10){",
                    "            btnCancelHidden = true;",
                    "        }",
                    "    }",
                    "",
                    "    // 회의취소 및 수정 버튼 숨김, 문구 설정",
                    "    refs.btnCopy.setHidden(btnCopyHidden);",
                    "    refs.btnCancel.setHidden(btnCancelHidden);",
                    "    refs.btnBook.setHidden(btnBookHidden);",
                    "",
                    "    // 일자",
                    "    var mtgBooStrdt = info.mtgBooStrdt;",
                    "    mtgBooStrdt = mtgBooStrdt.substr(0,4) + '/' + mtgBooStrdt.substr(4,2) + '/' + mtgBooStrdt.substr(6,2);",
                    "    refs.mtgBooStrdt.setValue(new Date(mtgBooStrdt));",
                    "",
                    "    // 시작 시간",
                    "    var mtgBooStrtm = info.startTime;",
                    "    //     refs.mtgBooStrtm.setValue(new Date('0/0' + mtgBooStrtm));",
                    "    refs.mtgBooStrtm.setValue(mtgBooStrtm);",
                    "",
                    "    // 종료 시간",
                    "    var mtgBooEdtm = info.endTime;",
                    "    //     refs.mtgBooEdtm.setValue(new Date('0/0' + mtgBooEdtm));",
                    "    refs.mtgBooEdtm.setValue(mtgBooEdtm);",
                    "",
                    "    // 회의명",
                    "    refs.mtgNm.setValue(info.mtgNm);",
                    "",
                    "    // 담당자",
                    "    var rqpr = info.mtgCgpEmpeNo + '/' + info.dpnm + '/' + info.empeRealNm + '/' + info.empePsitNm;",
                    "    refs.rqpr.setValue(rqpr);",
                    "",
                    "    // 체크박스",
                    "    if(info.booAftLemeYn == '1'){",
                    "        refs.booAftLemeYn.setChecked(true);",
                    "    }",
                    "    if(info.min30BefLemeYn == '1'){",
                    "        refs.min30BefLemeYn.setChecked(true);",
                    "    }",
                    "    if(info.dd1BefLemeYn == '1'){",
                    "        refs.dd1BefLemeYn.setChecked(true);",
                    "    }",
                    "",
                    "    //참석자 넣어주기",
                    "    Ext.Ajax.request({",
                    "        headers: {",
                    "            viewId : me.getViewId(),",
                    "            serviceId : 'BomMtgSvc.findAllAtndList'",
                    "        },",
                    "        jsonData : info,",
                    "        scope : me,",
                    "        success : function(response) {",
                    "            var res = Ext.JSON.decode(response.responseText);",
                    "            var content = res.atndList;",
                    "",
                    "            vm.set('cardItem.gridData', []);",
                    "",
                    "            for(var i in content){",
                    "                vm.get('cardItem.gridData').push(content[i]);",
                    "",
                    "                vm.get('cardItem.gridData')[i].formattedEmpeNm =",
                    "                    Ext.String.format('{0}({1})', content[i].empeNm, content[i].dpnm);",
                    "",
                    "                vm.get('cardItem.gridData')[i].stfDvcd = '01';",
                    "                vm.get('cardItem.gridData')[i].stfDvcdNm = '내부직원';",
                    "",
                    "",
                    "            }",
                    "            vm.set('hrHromJasPrjStore', vm.get('cardItem.gridData')); // 중요",
                    "            vm.set('originalJasPrjStore', vm.get('cardItem.gridData')); // 취소 시 원래의 참석자에게 보내기 위함",
                    "            vm.set('cardItem.hrHromJasPrjList', vm.get('cardItem.gridData'));",
                    "",
                    "",
                    "        }",
                    "    });",
                    "",
                    "    // 현재 사용자가 회의 담당자나 등록자가 아닐 경우",
                    "    // 시간과 관계 없이 무조건 비활성화",
                    "    if (info.mtgCgpEmpeNo != principal.hrHrpmEmpId",
                    "        && info.fstRgpr != principal.hrHrpmEmpId) {",
                    "        // 입력 비활성화",
                    "        refs.frmDetail.setDisabled(true);",
                    "        refs.btnFindUser.setDisabled(true);",
                    "        refs.btnFindUserAtnd.setDisabled(true);",
                    "        refs.booAftLemeYn.setDisabled(true);",
                    "        refs.booAftLemeYn.setBoxLabel('<font style=\"color:#aaa\">예약 후</font>');",
                    "        refs.dd1BefLemeYn.setDisabled(true);",
                    "        refs.dd1BefLemeYn.setBoxLabel('<font style=\"color:#aaa\">1일 전</font>');",
                    "        refs.min30BefLemeYn.setDisabled(true);",
                    "        refs.min30BefLemeYn.setBoxLabel('<font style=\"color:#aaa\">30분</font>');",
                    "    }",
                    "}",
                    ""
                ]
            },
            "configAlternates": {
                "designer|params": "typedarray",
                "fn": "string",
                "implHandler": "code"
            },
            "name": "fnCardInit",
            "designerId": "b07013c8-734a-4d1b-a8d2-743019c0a445"
        }
    ]
}