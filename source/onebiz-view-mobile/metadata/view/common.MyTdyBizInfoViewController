                "fn": "formatting",
                "implHandler": [
                    "var result = null;",
                    "",
                    "switch(type){",
                    "    case \"DATE\" :",
                    "        if(Array.isArray(value)){",
                    "            result = value[0].substring(4, 6) + '.' + value[0].substring(6, 8) + ' ~ ' + value[1].substring(4, 6) + '.' + value[1].substring(6, 8);",
                    "        }",
                    "        else{",
                    "            result = value.substring(4, 6) + '.' + value.substring(6, 8);",
                    "        }",
                    "        ",
                    "        break;",
                    "    case \"TIME\" :",
                    "        result = value[0].substring(0, 2) + ':' + value[0].substring(2, 4) + ' ~ ' + value[1].substring(0, 2) + ':' + value[1].substring(2, 4);",
                    "        break;",
                    "    default :",
                    "}",
                    "",
                    "return result;"
                ]
            },
