                "designer|params": [
                    "formData"
                ],
                "fn": "formValid",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    reNo = /[^\\d]/,",
                    "    errMsg = '';",
                    "",
                    "// aplVctDt",
                    "// aplVctCnt",
                    "// aplVctDt",
                    "",
                    "// vctDvcd1",
                    "// vctDtlDvcd1",
                    "// aplVctStrdt1",
                    "// aplVctStrtm1",
                    "// aplVctEdt1",
                    "// aplVctEdtm1",
                    "",
                    "// vctDvcd2",
                    "// vctDtlDvcd2",
                    "// aplVctStrdt2",
                    "// aplVctStrtm2",
                    "// aplVctEdt2",
                    "// aplVctEdtm2",
                    "",
                    "// aplCntn",
                    "",
                    "if(!formData.aplVctDt){",
                    "    errMsg += '휴가기간을 입력해주세요.<br>';",
                    "}",
                    "if(formData.aplVctCnt === 0){",
                    "    errMsg += '휴가일수를 다시 확인해주세요.<br>';",
                    "}",
                    "if(!formData.vctDvcd1){",
                    "    errMsg += '휴가구분을 입력해주세요.<br>';",
                    "}",
                    "if(!formData.vctDtlDvcd1){",
                    "    errMsg += '상세구분을 입력해주세요.<br>';",
                    "}",
                    "if(vm.get('useForm2')){",
                    "    if(!formData.vctDvcd2){",
                    "        errMsg += '오후반차 휴가구분을 입력해주세요.<br>';",
                    "    }",
                    "}",
                    "if(formData.aplCntn){",
                    "    if(formData.aplCntn.length > 65){",
                    "        errMsg += '사유의 길이를 확인해주세요.<br>';",
                    "    }",
                    "}",
                    "if(!vm.get('applyLine')){",
                    "    errMsg += '결재선을 선택해주세요.<br>';",
                    "}",
                    "",
                    "return errMsg;",
                    ""
                ]
            },
