                    "",
                    "// Service 호출",
                    "Ext.Ajax.request({",
                    "    headers : {",
                    "        viewId : this.getView().xtype, // userAlias",
                    "        serviceId : 'HwmVctSvc.findAllHwmVctDetail'",
