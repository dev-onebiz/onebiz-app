                "fn": "onClickDraft",
                "implHandler": [
                    "        var me               = this,",
                    "            vm               = me.getViewModel(),",
                    "            refs             = me.getReferences(),",
                    "            approvalLineGrid = refs.approvalLineGrid,",
                    "            aprHistId        = null,",
                    "            docNm = '휴가 신청서';",
                    "",
                    "        var params = {",
                    "            applyInfo : vm.get('afterchange')",
                    "        };",
                    "",
                    "        // Service 호출",
                    "        Ext.Ajax.request({",
                    "            headers : {",
                    "                viewId : this.getView().xtype, // userAlias",
                    "                serviceId : 'HwmVctSvc.validateVctBfrSave'",
                    "            },",
                    "            jsonData : params,",
                    "            scope : me,",
                    "            success : function(response) {",
                    "                var result = Ext.JSON.decode(response.responseText); // 서버응답결과 JSON 변환",
                    "",
                    "                // Service 성공 했을 경우 기능",
                    "                console.log('validataion Service success');",
                    "",
                    "                if(result.result){",
                    "",
                    "                    // 결재선 [기안] 처리",
                    "                    ApprovalBoxSvc.draft({",
                    "                        scope                 : me,",
                    "                        edocCd                : 'HwmVctAply71',\t\t\t\t \t // 전자문서관리에서 설정된 문서코드: 화면ID를 사용함",
                    "                        docNm                 : docNm, \t\t\t\t\t\t\t // 문서명",
                    "                        bizDvcd               : 'Hwm', \t\t\t\t\t\t\t // 업무구분코드",
                    "                        bizServiceId          : 'HwmVctSvc.saveHwmVctAply', \t // 연관 업무서비스ID",
                    "                        aprHistId             : null,\t\t\t\t\t\t \t // 결재이력ID",
                    "                        approvalLineRecords   : approvalLineGrid.getJsonAllRecords(), // 결재선 그리드 데이터",
                    "                        docData               : {\t\t\t\t\t\t\t\t // 결재문서 데이터",
                    "                            fieldValues       : vm.get('fieldValues'),",
                    "                            beforechange      : null,",
                    "                            afterchange       : vm.get('afterchange') \t\t\t // 결재문서 필드값",
                    "                        },",
                    "",
                    "                    });",
                    "                }",
                    "",
                    "",
                    "",
                    "            }",
                    "        });",
                    "",
                    "",
                    "",
                    "",
                    ""
                ]
            },
