                    "",
                    "    var codeStore = Ext.StoreMgr.get('CodeStore'), items = codeStore.getData().items;",
                    "    var cbData = [];",
                    "    var isFound = false;",
                    "    var result = '';",
                    "",
                    "    for (var i = 0, l = items.length; i < l; i++) {",
                    "      if (code === items[i].data.code) {",
                    "        var children = items[i].data.children;",
                    "        for (var j = 0, l2 = children.length; j < l2; j++) {",
                    "          var item = children[j];",
                    "          if (text == item.text) {",
                    "            result = item.value;",
                    "            isFound = true;",
                    "            break;",
                    "          }",
                    "        }",
                    "        if (isFound) {",
                    "          break;",
                    "        }",
                    "      }",
                    "    }",
                    "    return result;",
                    "  "
                ]
