            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "신청서 작성에 필요한 CodeList 한번에 불러오기"
                ],
                "fn": "fnCodeSetting",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    D = new Ext.Deferred();",
                    "",
                    "Ext.Ajax.request({",
                    "    headers : {",
                    "        serviceId : 'BgxNfmSvc.findAllExpItemCodeList',",
                    "        viewId : me.getViewId(),",
                    "    },",
                    "    jsonData : {",
                    "        noPaging : 'dummpyForNoPaging',",
                    "        codeDvcdLists : [\"XPNIT\",\"BSNS\",\"XPNS\"],",
                    "        bgDvcd1 : Constants.bgDvcd1.EXPN",
                    "    },",
                    "    success : function(response, component) {",
                    "        var res = Ext.JSON.decode(response.responseText);",
                    "        vm.set('codeList', res.codeList);",
                    "        D.resolve(res.codeList); // 성공",
                    "    },",
                    "    failure : function(res, vm) {",
                    "        me.getView().unmask();",
                    "        D.reject(res.result); // 실패",
                    "    }",
                    "});",
                    "",
                    "return D.promise;"
                ]
            },
            "configAlternates": {
                "designer|commentHeader": "comment",
                "fn": "string",
                "implHandler": "code"
            },
            "name": "fnCodeSetting",
            "designerId": "4bc63eec-17fb-4e50-abb5-9acadd8e97dd"
        },
        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|params": [
                    "config, docData, itemId, aplKndcdNm"
                ],
                "fn": "settingValues",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences();",
                    "",
                    "/** [필독] 예산 집행 결재 공통 로직",
                    "     *  AS_IS 공통 결재 로직",
                    "     *    - 신청서에 출력될 정보를 DOC_DATA 에 JSON 형식으로 저장하고",
                    "     *    , 추후 출력할땐 DOC_DATA에 저장된 데이터를 가지고 출력을 한다.",
                    "     *     단점 : 유지보수가 너무 힘들다 [ 데이터의 수정이 있어야할때 , JSON replace 를 해야한다.]",
                    "     *           계좌번호등 암호화가 필요한 중요정보에 대한 따로 처리가 필요함.",
                    "     *  TO_BE 공통 결재 로직",
                    "     *    - 기안시에는 DOC_DATA 에 JSON 형식으로 저장하되 [-> 추후 문제있을시 이력으로 사용]",
                    "     *     , 추후 출력할땐 업무단 SVC에서 데이터를 조회하여 출력이 되도록 한다.",
                    "     * */",
                    "",
                    "//ApprovalBoxSvc 공통에서 command 로 구분함.",
                    "if (config.command != Constants.sanction.DRAFT ) {",
                    "    var comAprHistId = config.aprHistId ;",
                    "    if(comAprHistId){",
                    "        /*상세항목 조회*/",
                    "        Ext.Ajax.request({",
                    "            headers : {",
                    "                serviceId : 'BgxNfmSvc.findAllBgmExpNfcDtl',",
                    "                viewId : me.getViewId()",
                    "            },",
                    "            jsonData : {",
                    "                selectBgmExpNfcRecord : {",
                    "                    comAprHistId : config.aprHistId",
                    "                }",
                    "            },",
                    "            success : function(response) {",
                    "                var res = Ext.JSON.decode(response.responseText),",
                    "                    applyInfo = res.content.applyInfo;",
                    "",
                    "                if (applyInfo) {",
                    "                    vm.set('applyInfo', applyInfo);",
                    "                    vm.set('expItemData', applyInfo);",
                    "                    vm.set('expItemData.aplKndcdNm', aplKndcdNm);",
                    "                    if (applyInfo) {",
                    "                        vm.set('applyInfo.aplDt', DateUtils.parseDate(applyInfo.aplDt));",
                    "",
                    "                        //분개 내용 (모바일 미표시)",
                    "                        var txt = '- 분개내역은 PC에서 확인하시기 바랍니다.';",
                    "                        if (applyInfo.expItemInfo.length > 1) {",
                    "                            txt += '<br> - 다건의 결의서가 있습니다. 상세내역은 PC에서 확인하시기 바랍니다.';",
                    "                        };",
                    "",
                    "                        var expItemData = applyInfo.expItemInfo[0];",
                    "",
                    "                        //신청 내용",
                    "//                         me.fnCodeSetting().then(function() {",
                    "                            refs.item_container.add(Ext.create(itemId, {",
                    "                                codeList : vm.get('codeList'),",
                    "                                applyInfo : vm.get('applyInfo'),",
                    "                                readOnlyFlag : true,",
                    "                                expItemData : expItemData,",
                    "                                command : config.command,",
                    "                                record : config.record,",
                    "                                aprHistId : config.aprHistId,",
                    "                                edocCd : 'BgxNfmAply71',",
                    "                                infoText : txt",
                    "                            }));",
                    "//                         });",
                    "                    }",
                    "                }",
                    "            }",
                    "        },me);",
                    "    }",
                    "",
                    "}"
                ]
            },
