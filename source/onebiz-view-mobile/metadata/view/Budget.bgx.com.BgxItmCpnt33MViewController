            "userConfig": {
                "designer|commentHeader": [
                    "집행대상자 label 생성"
                ],
                "fn": "fnRefreshSummaryUserLabel",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    expItemInputData = Ext.clone(vm.get('expItemInputData')),",
                    "    userRecords = expItemInputData.expItemUserInfo,",
                    "    splyAmt = expItemInputData.splyAmt,  //공급가액",
                    "    innerEmpeCnt = 0,",
                    "    outerEmpeCnt = 0,",
                    "    rtnStr = '',",
                    "    defaultStr = '공급가액',",
                    "    xpnitKeyCd = refs.xpnitKeyCd.getValue(),",
                    "    xpnitSelectionRecord = vm.get('xpnitSelectionRecord');",
                    "",
                    "if(xpnitKeyCd && xpnitSelectionRecord){",
                    "    if(xpnitSelectionRecord.stxYn == Constants.yesNo.NO ){",
                    "        /* [요건] 선택된 계정과목이 부가세 처리여부가 '부(0)'라면 , 1인당 공급가액 계산시 , 거래금액으로 처리함.[주의! 계산시에만 사용됨.] */",
                    "        splyAmt = expItemInputData.trnsAmt;",
                    "        defaultStr = '승인금액';",
                    "    }",
                    "}",
                    "",
                    "if (userRecords) {",
                    "    var flag = false,       //대표회사명 하나만 저장하기 위한 플래그",
                    "        diffCompFlag = false,   //외부업체 다수 존재하는지 확인하기위한 플래그",
                    "        outerCompNm = \"\";   //외부업체명",
                    "",
                    "    for (var i = 0; i < userRecords.length; i++) {",
                    "        var record = userRecords[i];",
                    "        if (record.stfDvcd == Constants.stfDvcd.IN) {",
                    "            innerEmpeCnt++;",
                    "        } else {",
                    "            outerEmpeCnt++;",
                    "",
                    "            if(!flag) {",
                    "                outerCompNm = record.enpnm;   //업체명",
                    "                flag = true;",
                    "            } else {",
                    "                if(outerCompNm != record.enpnm) {  //업체명이 여러개인지 확인",
                    "                  diffCompFlag = true;",
                    "                }",
                    "            }",
                    "        }",
                    "    }",
                    "    // 집행대상라벨",
                    "    var amtByUser = (innerEmpeCnt == 0 ? 0 : Math.floor(splyAmt / innerEmpeCnt));",
                    "//     rtnStr = Ext.String.format('<span style = \"line-height : 20px;\">집행대상 ( 총 <span style =\"color : red;\">{0}</span>명 ) <br>'",
                    "//                                + '[ 내부직원 {1} 명 / 외부직원 {2} 명 ] <br>'",
                    "//                                + '<span style = \"color :gray;\" >[{3} 기준 1인당 {4}원]</span></span>',",
                    "//                                userRecords.length, innerEmpeCnt, outerEmpeCnt, defaultStr ,",
                    "//                                amtByUser.toString().replace(/\\B(?=(\\d{3})+(?!\\d))/g,\",\"));",
                    "    ",
                    "    rtnStr = Ext.String.format('<span style = \"line-height : 20px;\">집행대상 ( 총 <span style =\"color : red;\">{0}</span>명 ) <br>'",
                    "                               + '[ 내부직원 {1} 명 / 외부직원 {2} 명 ] <br>',",
                    "                               userRecords.length, innerEmpeCnt, outerEmpeCnt);",
                    "",
                    "    // 외부직원이 한명 이상일때 (업무추진비) 적요란에 업체명 추가",
                    "    if (outerEmpeCnt > 0) {",
                    "        // 외부업체가 2개이상일때는 (대표업체명 외)로 저장",
                    "        outerCompNm = (diffCompFlag) ? \"(\" + outerCompNm + \" 외)\" : \"(\" +outerCompNm + \")\";",
                    "        vm.set('outerCompNm', outerCompNm);",
                    "    }",
                    "} else {",
                    "    rtnStr = '집행대상자를 추가하여 주십시오.';",
                    "}",
                    "vm.set('expItemInputData.summaryUserLabel', rtnStr);",
                    "vm.set('expItemData.summaryUserLabel', rtnStr);",
                    "refs.txtSummaryUserLabel.setHtml(rtnStr);"
                ]
            },
