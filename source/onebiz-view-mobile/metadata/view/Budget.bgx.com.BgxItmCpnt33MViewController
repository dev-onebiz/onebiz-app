                "fn": "fnSelectBcncAcnoInfo",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    D = new Ext.Deferred();",
                    "",
                    "Ext.Ajax.request({",
                    "    headers : {",
                    "        serviceId : 'BgxNfmSvc.findAllBcncAcnoInfo',",
                    "        viewId : me.getViewId(),",
                    "    },",
                    "    jsonData : item ,",
                    "    success : function(response, component) {",
                    "        var res = Ext.JSON.decode(response.responseText);",
                    "",
                    "        D.resolve(res.bcncAcnoInfo); // 성공",
                    "    },",
                    "    failure : function(res, vm) {",
                    "        D.reject(res.result); // 실패",
                    "    }",
                    "});",
                    "",
                    "return D.promise;"
                ]
            },
