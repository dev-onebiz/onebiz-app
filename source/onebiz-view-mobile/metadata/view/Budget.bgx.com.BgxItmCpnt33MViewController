        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "fn": "fnMakeXpnitList",
                "implHandler": [
                    "var me = this;",
                    "var vm = me.getViewModel();",
                    "var refs = me.getReferences();",
                    "var expItemInputData = vm.get('expItemInputData');",
                    "var expItemUserInfo = expItemInputData.expItemUserInfo; //사용자추가List",
                    "var expItemDrctInfo = expItemInputData.expItemDrctInfo; //직접추가List",
                    "var expItemXpnitInfo = []; //계정과목리스트(result)",
                    "var oriExpItemXpnitInfo = vm.get('expItemInputData.expItemXpnitInfo');",
                    "",
                    "//[START] 계정과목 리스트 - 부가정보 설정",
                    "// 1. 사용자추가 데이터 가공",
                    "if(!Ext.isEmpty(expItemUserInfo)){",
                    "    // 1-1. 내부직원(Constants.stfDvcd.IN)만 내부사원List(innerEmpList)에 넣어주기",
                    "    var innerEmpList = []; //사원별 계정과목리스트",
                    "    var outerEmpList = [];",
                    "    for(var i in expItemUserInfo){",
                    "        if(expItemUserInfo[i].stfDvcd == Constants.stfDvcd.IN) { //내부사원일 경우",
                    "            innerEmpList.push(expItemUserInfo[i]);",
                    "        }",
                    "        else{",
                    "            outerEmpList.push(expItemUserInfo[i]);",
                    "        }",
                    "    }",
                    "    // 1-2. 사업부문-부서별로 계정과목 리스트에 넣어주기",
                    "    var deptIdXpnitList = []; //부서ID+계정과목ID 리스트",
                    "    var userXpnitNm = vm.get('expItemInputData.xpnitKeyNm');",
                    "    var userStxYn = vm.get('expItemInputData.stxYn');",
                    "    for(var i in innerEmpList) {",
                    "        var bgExpiNfcApfXpnitId = innerEmpList[i].hrHrpmDeptId + innerEmpList[i].bgBudcXpnitYyId + 'A'; //부서ID + 계정과목ID + 구분코드(사용자or직접)",
                    "",
                    "        if(deptIdXpnitList.indexOf(bgExpiNfcApfXpnitId) > -1) {",
                    "            //이미 등록된 부서 정보일 경우, 대상자 수만 UP",
                    "            var idx = deptIdXpnitList.indexOf(bgExpiNfcApfXpnitId);",
                    "            expItemXpnitInfo[idx].userCnt += 1; //대상자수 카운트",
                    "            expItemXpnitInfo[idx].userList.push(innerEmpList[i]); //대상자 더하기",
                    "",
                    "            innerEmpList[i].bgExpiNfcApfXpnitId = expItemXpnitInfo[idx].bgExpiNfcApfXpnitId;",
                    "            continue;",
                    "        }",
                    "",
                    "        deptIdXpnitList.push(bgExpiNfcApfXpnitId); //부서ID + 연도별계정과목ID 정보",
                    "        expItemXpnitInfo.push({",
                    "            bgExpiNfcApfXpnitId : bgExpiNfcApfXpnitId, //임시ID(user와 xpnit 맵핑에 사용)",
                    "            bgBudcBsnsId : innerEmpList[i].bgBudcBsnsId, //사업부문ID",
                    "            bgBudcXpnitYyId : innerEmpList[i].bgBudcXpnitYyId, //계정과목ID",
                    "            bsnsNm : innerEmpList[i].bsnsNm, //사업부문명",
                    "            bsnsYy : innerEmpList[i].bsnsYy, //사업연도",
                    "            dpnm : innerEmpList[i].dpnm, //부서명",
                    "            enpnm : innerEmpList[i].enpnm, //회사명",
                    "            aplDeptId : innerEmpList[i].hrHrpmDeptId, //부서ID",
                    "            xpnitKeyCd : innerEmpList[i].xpnitKeyCd, //계정과목코드",
                    "            xpnitKeyNm : userXpnitNm, //계정과목명",
                    "            stxYn : userStxYn,",
                    "            dvcd : 'A', //구분(사용자 : A, 직접 : B)",
                    "            userCnt : 1, //대상자수",
                    "            userList : [innerEmpList[i]] //대상자",
                    "        }); //계정과목 정보",
                    "",
                    "        innerEmpList[i].bgExpiNfcApfXpnitId = expItemXpnitInfo[expItemXpnitInfo.length - 1].bgExpiNfcApfXpnitId;",
                    "",
                    "        //작성된 적요 내용 넣어주기",
                    "        for(var j in oriExpItemXpnitInfo){",
                    "            if(oriExpItemXpnitInfo[j].bgExpiNfcApfXpnitId == expItemXpnitInfo[expItemXpnitInfo.length - 1].bgExpiNfcApfXpnitId){",
                    "                expItemXpnitInfo[expItemXpnitInfo.length - 1].aplRscn = oriExpItemXpnitInfo[j].aplRscn;",
                    "                expItemXpnitInfo[expItemXpnitInfo.length - 1].aplRscnHint = oriExpItemXpnitInfo[j].aplRscnHint;",
                    "                expItemXpnitInfo[expItemXpnitInfo.length - 1].xpnitCntn = oriExpItemXpnitInfo[j].xpnitCntn;",
                    "                break;",
                    "            }",
                    "        }",
                    "",
                    "    }",
                    "",
                    "    //외부사원에 xpnitId 넣어주기(조회 시에 계정과목과 맵핑하기 위해 사용)",
                    "    for(var i in outerEmpList){",
                    "        outerEmpList[i].bgExpiNfcApfXpnitId = expItemXpnitInfo[expItemXpnitInfo.length - 1].bgExpiNfcApfXpnitId; //계정과목ID를 물려줌(데이터 조회 시 사용)",
                    "        expItemXpnitInfo[expItemXpnitInfo.length - 1].userList.push(outerEmpList[i]); //대상자 추가(외부직원은 집행대상이 아니기에 userCnt는 변화X)",
                    "    }",
                    "}",
                    "",
                    "// 2. 직접추가 데이터 가공",
                    "if(!Ext.isEmpty(expItemDrctInfo)){",
                    "    for(var i = 0; i < expItemDrctInfo.length; i++){",
                    "",
                    "        expItemXpnitInfo.push({",
                    "            bgExpiNfcApfXpnitId : expItemDrctInfo[i].hrHrpmDeptId + expItemDrctInfo[i].bgBudcXpnitYyId + 'B', //임시ID(user와 xpnit 맵핑에 사용) : 부서ID + 계정과목ID + 구분코드(사용자or직접)",
                    "            bgBudcBsnsId : expItemDrctInfo[i].bgBudcBsnsId, //사업부문ID",
                    "            bgBudcXpnitYyId : expItemDrctInfo[i].bgBudcXpnitYyId, //계정과목ID",
                    "            bsnsNm : expItemDrctInfo[i].bsnsNm, //사업부문명",
                    "            bsnsYy : expItemDrctInfo[i].bsnsYy, //사업연도",
                    "            dpnm : expItemDrctInfo[i].dpnm, //부서명",
                    "            enpnm : expItemDrctInfo[i].enpnm, //회사명",
                    "            aplDeptId : expItemDrctInfo[i].hrHrpmDeptId, //부서ID",
                    "            xpnitKeyCd : expItemDrctInfo[i].xpnitKeyCd, //계정과목코드",
                    "            xpnitKeyNm : expItemDrctInfo[i].xpnitKeyNm, //계정과목명",
                    "            stxYn : expItemDrctInfo[i].stxYn,",
                    "            dvcd : 'B', //구분(사용자 : A, 직접 : B)",
                    "            userCnt : parseInt(expItemDrctInfo[i].userCnt) //대상자수",
                    "        });",
                    "",
                    "        expItemDrctInfo[i].bgExpiNfcApfXpnitId = expItemXpnitInfo[expItemXpnitInfo.length - 1].bgExpiNfcApfXpnitId;",
                    "",
                    "        //작성된 적요 내용 넣어주기",
                    "        for(var j in oriExpItemXpnitInfo){",
                    "            if(oriExpItemXpnitInfo[j].bgExpiNfcApfXpnitId == expItemXpnitInfo[expItemXpnitInfo.length - 1].bgExpiNfcApfXpnitId){",
                    "                expItemXpnitInfo[expItemXpnitInfo.length - 1].aplRscn = oriExpItemXpnitInfo[j].aplRscn;",
                    "                expItemXpnitInfo[expItemXpnitInfo.length - 1].aplRscnHint = oriExpItemXpnitInfo[j].aplRscnHint;",
                    "                expItemXpnitInfo[expItemXpnitInfo.length - 1].xpnitCntn = oriExpItemXpnitInfo[j].xpnitCntn;",
                    "                break;",
                    "            }",
                    "        }",
                    "",
                    "    }",
                    "}",
                    "",
                    "var xpnitCodeList = vm.get('codeList.xpnitCodeList');",
                    "for(var i = 0; i < expItemXpnitInfo.length; i++) {",
                    "    ",
                    "    //계정과목이 변경된 경우, 지출에 대한 적요가 입력되어 있다면 그것을 넣어준다",
                    "    if(Ext.isEmpty(expItemXpnitInfo[i].aplRscn) && !Ext.isEmpty(expItemInputData.aplRscn)){",
                    "        expItemXpnitInfo[i].aplRscn = expItemInputData.aplRscn;",
                    "    }",
                    "",
                    "    if(!Ext.isEmpty(expItemXpnitInfo[i].aplRscnHint)){ //이미 입력되어 있으면 skip",
                    "        continue;",
                    "    }",
                    "",
                    "    for(var j = 0; j < xpnitCodeList.length; j++){",
                    "        if(xpnitCodeList[j].xpnitKeyCd == expItemXpnitInfo[i].xpnitKeyCd){ //적요예시 넣어주기",
                    "            expItemXpnitInfo[i].aplRscnHint = xpnitCodeList[j].aplRscnHint;",
                    "            expItemXpnitInfo[i].xpnitCntn = xpnitCodeList[j].xpnitCntn;",
                    "            break;",
                    "        }",
                    "    }",
                    "}",
                    "",
                    "// 3. 지출건 공급가액/부가세/거래금액 추출",
                    "var splyAmt = 0; //지출 공급가액",
                    "var stxat = 0; //지출 부가세",
                    "var trnsAmt = 0; //지출 거래금액",
                    "if(expItemInputData.nfcmEvidKndcd == Constants.nfcmEvidKndcd.TXINV",
                    "   || expItemInputData.nfcmEvidKndcd == Constants.nfcmEvidKndcd.TAXFREE_TXINV){",
                    "    //세금계산서 및 일반계산서의 경우 컬럼명이 달라 다른 증빙과 통일",
                    "    splyAmt = parseInt(expItemInputData.spricAmt);",
                    "    stxat = parseInt(expItemInputData.txAmt);",
                    "    trnsAmt = parseInt(expItemInputData.sumAmt);",
                    "} else {",
                    "    splyAmt = parseInt(expItemInputData.splyAmt);",
                    "    stxat = parseInt(expItemInputData.stxat);",
                    "    trnsAmt = parseInt(expItemInputData.trnsAmt);",
                    "}",
                    "if(vm.get('expItemInputData.stxYn') == Constants.yesNo.NO){",
                    "    //부가세여부가 '부'일 경우, 공급가액 + 세액",
                    "    splyAmt += stxat;",
                    "    stxat = 0;",
                    "}",
                    "",
                    "// 4. 금액 배분",
                    "var totUserCnt = 0; //총 사용자 수",
                    "for(var i in expItemXpnitInfo){",
                    "    totUserCnt += expItemXpnitInfo[i].userCnt;",
                    "}",
                    "",
                    "var xpnitInfo = null; //계정정보",
                    "var stackSplAmt = 0; //누적처리금액(마지막 계정 처리를 위해 사용)",
                    "for(var i in expItemXpnitInfo){",
                    "",
                    "    xpnitInfo = expItemXpnitInfo[i];",
                    "",
                    "    if(i == expItemXpnitInfo.length - 1){ //마지막 계정",
                    "        xpnitInfo.aplSplyAmt = splyAmt - stackSplAmt; //공급가액",
                    "        xpnitInfo.aplStxat = 0; //세액",
