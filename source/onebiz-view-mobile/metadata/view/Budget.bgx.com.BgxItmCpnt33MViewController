                    "",
                    "for(var i = expItemXpnitInfo.length - 1; i >= 0; i--){",
                    "    if(expItemXpnitInfo[i].stxYn == Constants.yesNo.YES){",
                    "        expItemXpnitInfo[i].aplStxat = stxat; //세액(마지막 계정에 몰빵)",
                    "        expItemXpnitInfo[i].aplAmt = expItemXpnitInfo[i].aplSplyAmt + expItemXpnitInfo[i].aplStxat;",
