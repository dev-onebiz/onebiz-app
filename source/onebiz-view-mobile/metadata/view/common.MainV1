                        "fn": "onNavigationviewPop",
                        "implHandler": [
                            "var me = this,",
                            "    vm = me.getViewModel(),",
                            "    refs = me.getReferences(),",
                            "    bar = navigationview.getNavigationBar();",
                            "",
                            "if(bar.backButtonStack.length == 2) {",
                            "    refs.mainTitleLogo.setHidden(false);",
                            "}",
                            "",
                            "// 연수보고 재조회",
                            "if(navigationview.items && navigationview.items.length && (navigationview.items.items[navigationview.items.length-1].id.indexOf('HrdCrsInfo01M') != -1)) {",
