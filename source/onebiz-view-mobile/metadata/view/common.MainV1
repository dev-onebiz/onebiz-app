                                            "cn": [
                                                {
                                                    "type": "viewcontrollereventbinding",
                                                    "reference": {
                                                        "name": "listeners",
                                                        "type": "array"
                                                    },
                                                    "codeClass": null,
                                                    "userConfig": {
                                                        "designer|commentHeader": [
                                                            "공지사항"
                                                        ],
                                                        "fn": "onNoticeInfo",
                                                        "implHandler": [
                                                            "var me = this,",
                                                            "    vm = me.getViewModel(),",
                                                            "    refs = me.getReferences(),",
                                                            "    selectedData = vm.get('noticeInfo');",
                                                            "",
                                                            "var naviView = refs.NaviView;",
                                                            "",
                                                            "if (selectedData == null) {",
                                                            "    ",
                                                            "    me.PUSH_VIEW(naviView, {",
                                                            "        menuId : 'NoticeBoardManagementM'",
                                                            "    });",
                                                            "    ",
                                                            "    return;",
                                                            "}",
                                                            "",
                                                            "var win = Ext.create('NoticeBoardManagementDetailPopupM', {",
                                                            "    title   : '공지사항 상세보기',",
                                                            "    records : selectedData",
                                                            "});",
                                                            "",
                                                            "me.mon(win, 'onPrevious', function(v){",
                                                            "",
                                                            "    v.close();",
                                                            "",
                                                            "    me.PUSH_VIEW(naviView, {",
                                                            "        menuId : 'NoticeBoardManagementM'",
                                                            "    });",
                                                            "});",
                                                            "",
                                                            "win.show();"
                                                        ],
                                                        "name": "tap",
                                                        "scope": "me"
                                                    },
                                                    "configAlternates": {
