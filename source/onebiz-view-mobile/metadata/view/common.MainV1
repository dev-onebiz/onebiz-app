        },
        {
            "type": "viewcontrollereventbinding",
            "reference": {
                "name": "listeners",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "초기화"
                ],
                "fn": "onContainerInitialize",
                "implHandler": [
                    "// 메인화면 설정",
                    "var me = this,",
                    "    refs = me.getReferences(),",
                    "    lblUserInfo1 = refs.lblUserInfo1,",
                    "    lblUserInfo2 = refs.lblUserInfo2,",
                    "    principal = SecurityUtils.getPrincipal();",
                    "",
                    "lblUserInfo1.setHtml(Ext.String.format('BNK시스템 | {0}', principal.dpnm)); // 부서명",
                    "if(Constants.managerEmpeRsbCds.indexOf(principal.empeRsbCd) > -1){",
                    "    lblUserInfo2.setHtml(Ext.String.format('{0} {1}', principal.empeNm, principal.empeRsbNm)); // 이름 직책",
                    "} else {",
                    "    lblUserInfo2.setHtml(Ext.String.format('{0} {1}', principal.empeNm, principal.empePsitNm)); // 이름 직급",
                    "}",
                    "",
                    "// 모바일버전과 관리자사이트의 프로퍼티설정 중 모바일버전 정보가 상이할 경우, 업데이트 메시지 표시",
                    "if (Property.MOBILE_SERVER_VERSION > Property.MOBILE_VERSION) {",
                    "//     Ext.Msg.alert('업데이트 알림', Ext.String.format('새로운 버전의 업데이트가 가능합니다.<br />메뉴: 환경설정/버전정보/버전 클릭!<br /><br />신규버전: {0}<br />현재버전: {1}', Property.MOBILE_SERVER_VERSION, Property.MOBILE_VERSION));",
                    "    Ext.Msg.confirm(\"안내\", Ext.String.format('<div style=\"font-size : 15px; font-weight: bold\">현재버전 {0}<br />최신버전 {1}</div><br /><br />업데이트하시겠습니까?', Property.MOBILE_VERSION, Property.MOBILE_SERVER_VERSION), function(buttonId) {",
                    "        if (buttonId == 'yes') {",
                    "            //cordova.InAppBrowser.open(Property.UPDATE_URL, '_blank', 'location=yes');",
                    "            location.href = Property.UPDATE_URL;",
                    "        }",
                    "    }, me);",
                    "}",
                    "",
                    "// 스크롤 이벤트",
                    "// refs.body.getScrollable().setListeners('scrollend', function(scroll, x, y, eOpts) {",
                    "// //    console.log('y : ' + y);",
                    "//     if(y <= 43) {",
                    "//        refs.mainMsg.setStyle(Ext.String.format('transition:all 0.5s;font-size:min({0}vmin,{1}px);color:#111111;font-weight:600;', 8, 36));",
                    "//        refs.subMsg.setStyle(Ext.String.format('transition:all 0.5s;font-size:min({0}vmin,{1}px);color:#111111;', 5, 18));",
