                                "designer|uiInterfaceName": "btnlogout",
                                "style": "color: #CB2B11;font-size:14px;font-weight:bold",
                                "text": "로그아웃",
                                "ui": "btnlogout"
                            },
                            "configAlternates": {
                                "designer|displayName": "string",
                                "layout|flex": "number",
                                "text": "string",
                                "style": "string",
                                "width": "auto",
                                "docked": "string",
                                "margin": "auto",
                                "designer|uiInterfaceName": "string",
                                "ui": "string"
                            },
                            "name": "MyButton19",
                            "designerId": "92b548e0-627e-425f-9f73-8e802a0c3c74",
                            "cn": [
                                {
                                    "type": "viewcontrollereventbinding",
                                    "reference": {
                                        "name": "listeners",
                                        "type": "array"
                                    },
                                    "codeClass": null,
                                    "userConfig": {
                                        "designer|commentHeader": [
                                            "로그아웃"
                                        ],
                                        "fn": "onBtnLogoutTap",
                                        "implHandler": [
                                            "var me = this;",
                                            "",
                                            "Ext.Msg.confirm(Property.SYSTEM_NAME, '로그아웃하시겠습니까?', function(choice) {",
                                            "    var me = this;",
                                            "    if (choice === 'yes') {",
                                            "        Ext.Ajax.request({",
                                            "            headers: {",
                                            "                viewId: me.getViewId(),",
                                            "                serviceId: 'COMAPP0002R02M'",
                                            "            },",
                                            "            scope : me,",
                                            "            success : function(res) {",
                                            "                if (Property.IS_DEBUG) console.log('로그아웃 성공');",
                                            "            },",
                                            "            failure: function(response, opts) {",
                                            "                if (Property.IS_DEBUG) console.log('로그아웃 실패');",
                                            "            }",
                                            "        });",
                                            "",
                                            "        // 토큰정보 삭제",
                                            "        localStorage.removeItem(Property.JWT_TOKEN_NAME);",
                                            "        WebUtils.setCookie(Property.JWT_TOKEN_NAME, null, -1);",
                                            "",
                                            "        // 로그인화면으로 이동",
                                            "        me.REDIRECT('LoginV1');",
                                            "",
                                            "        var homes = Ext.ComponentQuery.query('#' + Property.ROUTE_HOME);",
                                            "        if (homes.length !== 0) {",
                                            "            homes[0].destroy();",
                                            "        }",
                                            "    }",
                                            "}, me);"
                                        ],
                                        "name": "tap",
                                        "scope": "me"
                                    },
                                    "configAlternates": {
                                        "fn": "string",
                                        "implHandler": "code",
                                        "name": "string",
                                        "scope": "string",
                                        "designer|commentHeader": "comment"
                                    },
                                    "name": "onBtnLogoutTap",
                                    "designerId": "c77df809-4cdd-490f-9829-2737eb600c24"
                                }
                            ]
                        }
                    ]
