                                                                        ],
                                                                        "fn": "onBtnHwmDayAply01M",
                                                                        "implHandler": [
                                                                            "var me = this,",
                                                                            "    refs = me.getReferences(),",
                                                                            "    vm = me.getViewModel(),",
                                                                            "    naviView = refs.NaviView,",
                                                                            "    principal = SecurityUtils.getPrincipal();",
                                                                            "",
                                                                            "var menuId = '';",
                                                                            "var title = '';",
                                                                            "if(vm.get('wrkChkDvcdNm') == Constants.workCheckDvcdNm.OVT_CHECK){ //근무확인",
                                                                            "    menuId = 'HwmOvtChck01M';",
                                                                            "    title = '근무확인';",
                                                                            "}",
                                                                            "else{ //출퇴근체크",
                                                                            "    title = '출퇴근체크';",
                                                                            "    menuId = 'HwmDayAply03M';",
                                                                            "",
                                                                            "    //     for(var i in principal.roles){",
                                                                            "    //         if(principal.roles[i] === 'ROLE_TEST'){",
                                                                            "    //             menuId = 'HwmDayAply02M';",
                                                                            "    //         }",
                                                                            "    //     }",
                                                                            "}",
                                                                            "",
                                                                            "me.PUSH_VIEW(naviView, {",
                                                                            "    menuId : menuId,",
                                                                            "    title: title,",
                                                                            "});"
                                                                        ],
                                                                        "name": "tap",
                                                                        "scope": "me"
                                                                    },
