                            },
                            "name": "MyTreeList",
                            "designerId": "b730d119-2096-46e0-b4f1-d604c60a3869",
                            "cn": [
                                {
                                    "type": "viewcontrollereventbinding",
                                    "reference": {
                                        "name": "listeners",
                                        "type": "array"
                                    },
                                    "codeClass": null,
                                    "userConfig": {
                                        "fn": "onMytreelistItemClick",
                                        "implHandler": [
                                            "var me = this;",
                                            "",
                                            "if (info.select) {",
                                            "    // 사우회앱 스키마콜",
                                            "    if (info.node.data.menuId == 'bfslink') {",
                                            "        var ios_scheme = 'bfslink://action',\t\t\t\t\t\t// 사우회엡 스키마",
                                            "            android_scheme = 'kr.co.bnksys.bfs',\t\t\t\t\t// 사우회앱 안드로이드 패키지",
                                            "            url = 'https://bfs.bnksys.co.kr/app/distribution.html',\t// 사우회앱 다운로드 url",
                                            "            scheme = '',",
                                            "            jwtToken = localStorage.getItem(Property.JWT_TOKEN_NAME),",
                                            "            principal = SecurityUtils.getPrincipal(),",
                                            "            params = '?TOKEN=' + jwtToken + '&PARAM=';",
                                            "        var jsonData = '{' +",
                                            "            'cmgrp_cd : \\\"' + principal.cmgrpCd + '\\\", ' +",
                                            "            'cmgrp_id : \\\"' + principal.cmgrpId + '\", ' +",
                                            "            'comp_emladr : \\\"' + principal.compEmladr + '\\\", ' +",
                                            "            'dpnm : \\\"' + principal.dpnm + '\\\", ' +",
                                            "            'empe_psit_cd : \\\"' + principal.empePsitCd + '\\\", ' +",
                                            "            'empe_psit_nm : \\\"' + principal.empePsitNm + '\\\", ' +",
                                            "            'etco_dt : \\\"' + principal.etcoDt + '\\\", ' +",
                                            "            'hr_hrpm_dept_id : \\\"' + principal.hrHrpmDeptId + '\\\", ' +",
                                            "            'user_id : \\\"' + principal.userId + '\\\", ' +",
                                            "            'user_nm : \\\"' + principal.userNm + '\\\"' +",
                                            "        '}';",
                                            "",
                                            "        params = params + jsonData + '&SECRET=BNK_' + principal.sysCd;",
                                            "",
                                            "        if (Ext.os.is.Android) {",
                                            "            scheme = android_scheme;",
                                            "        } else {",
                                            "            scheme = ios_scheme;",
                                            "        }",
                                            "",
                                            "        appAvailability.check(",
                                            "            scheme,",
                                            "            function() {",
                                            "                ios_scheme = ios_scheme + params;",
                                            "                window.open(ios_scheme, '_system');",
                                            "            },",
                                            "            function() {",
                                            "                window.open(url, '_system');",
                                            "            }",
                                            "        );",
                                            "    } else {",
                                            "        // me.toggleMenu(0);",
                                            "        var title = info.node.data.text;",
                                            "//         me.showView(info.node.data.menuId , info.node.data.text);",
                                            "        me.showView(info.node.data.menuId , title.replace('- ', ''));",
                                            "    }",
                                            "}"
                                        ],
                                        "name": "itemclick",
                                        "scope": "me"
                                    },
                                    "configAlternates": {
                                        "fn": "string",
                                        "implHandler": "code",
                                        "name": "string",
                                        "scope": "string"
                                    },
                                    "name": "onMytreelistItemClick",
                                    "designerId": "186055f7-5dbb-467c-ade3-96d1b297a8a4"
                                },
                                {
                                    "type": "viewcontrollereventbinding",
                                    "reference": {
