                                                                    "var vm = me.getViewModel();",
                                                                    "",
                                                                    "component.element.on('tap', function(){",
                                                                    "",
                                                                    "   var myTdyBizInfo = vm.get('myTdyBizInfo');",
                                                                    "",
                                                                    "   if(myTdyBizInfo.vctInfoCnt < 1 && myTdyBizInfo.mtgInfoCnt < 1){",
                                                                    "//        var toast = Ext.toast(\"조회할 금일업무정보가 없습니다.\", 2000);",
                                                                    "//        toast.setBottom('50px');",
                                                                    "       Ext.Msg.alert('안내', '조회할 금일업무정보가 없습니다.');",
                                                                    "       return;",
                                                                    "   }",
                                                                    "",
                                                                    "   var win = Ext.create('MyTdyBizInfo', {",
                                                                    "       myTdyBizInfo : vm.get('myTdyBizInfo')",
                                                                    "   });",
                                                                    "",
                                                                    "   win.show();",
                                                                    "});",
                                                                    ""
                                                                ],
