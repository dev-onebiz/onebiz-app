        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "폼 renderer"
                ],
                "designer|params": [
                    "data"
                ],
                "fn": "formRenderer",
                "implHandler": [
                    "if(data){",
                    "    data.apvlDtText = DateUtils.parseDate(data.apvlDt);",
                    "",
                    "    if(data.apvlHr && data.stlmDvcd === '01'){ // 법인카드는 승인시간까지 붙이고, 기타영수증은 승인일자만 사용",
                    "        data.apvlHrText = data.apvlHr.substring(0, 2) + ':' + data.apvlHr.substring(2, 4) + ':' + data.apvlHr.substring(4, 6);",
                    "        data.apvlDtText = data.apvlDtText + ' ' + data.apvlHrText;",
                    "    }",
                    "",
                    "    if(data.cdno){",
                    "        data.cdnoText = data.cdno.substring(0, 4)+'-'+data.cdno.substring(4, 8)+'-'+data.cdno.substring(8, 12)+'-'+data.cdno.substring(12, 16); // 카드번호",
                    "    }",
                    "",
                    "    if(data.trnsAmtWc) data.trnsAmtWcText = this.curr(data.trnsAmtWc);",
                    "    if(data.stxat) data.stxatText = this.curr(data.stxat);",
                    "    else if(typeof data.stxat === 'number' && data.stxat === 0){",
                    "        data.stxatText = '0 원';",
                    "    }",
                    "",
                    "    if(data.apvlAmtDom) data.apvlAmtDomText = this.curr(data.apvlAmtDom);",
                    "",
                    "    // 과세유형이 간이인 경우",
                    "    if(data.mcTaxtnTypeDvcd === '12'){ // 과세유형 === 간이",
                    "        data.stxatText = '0 원'; // 부가세 = 0 원",
                    "        data.stxat = 0;",
                    "        data.trnsAmtWcText = data.apvlAmtDomText; // 공급가액 = 승인금액",
                    "        data.trnsAmtWc = data.apvlAmtDom;",
                    "    }",
                    "",
                    "    if(data.mcBzno){",
                    "        if(String(data.mcBzno).length === 10){",
                    "            data.mcBznoText = data.mcBzno.substring(0,3) + \"-\" + data.mcBzno.substring(3, 5) + \"-\" + data.mcBzno.substring(5, 10);",
                    "        }else if(String(data.mcBzno).length === 13){",
                    "            data.mcBznoText = data.mcBzno.substring(0,6) + \"-\" + data.mcBzno.substring(6, 13);",
                    "        }else{",
                    "            data.mcBznoText = data.mcBzno;",
                    "        }",
                    "    }",
                    "",
                    "    if(data.canYn) data.canYnText = CodeUtils.getText('NTE008', data.canYn);",
                    "",
                    "    // 사용분류 text 로 변환",
                    "    if(data.accItemCd) data.accItemCdText = CodeUtils.getText('NTE011', data.accItemCd);",
                    "    // 결제방법",
                    "    if(data.stlmDvcd) data.stlmDvcdText = CodeUtils.getText('NTE014', data.stlmDvcd);",
                    "",
                    "}",
                    "",
                    ""
                ]
            },
