        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|params": [
                    "value",
                    "record",
                    "dataIndex",
                    "cell",
                    "column"
                ],
                "fn": "gridRenderer",
                "implHandler": [
                    "switch(dataIndex) {",
                    "    case 'jasPrj': // 사용부문",
                    "        var me = this,",
                    "            vm = me.getViewModel(),",
                    "            prjStoreItems = vm.get('prjStore').data.items,",
                    "            userInfoList = vm.get('cardItem.userInfoList'),",
                    "            result = '',",
                    "            i = 0,",
                    "            item = null;",
                    "",
                    "         // 결재처리중인 경우 수정 못하도록",
                    "        if (vm.get('cardItem.isAply')) {",
                    "            column.setEditor(false);",
                    "        }",
                    "",
                    "        if (!value) {",
                    "            if ('02' !== record.data.stfDvcd) {",
                    "                record.data.jasPrj = null;",
                    "                return ' - 선 택 - ';",
                    "            }",
                    "            return '';",
                    "        }",
                    "",
                    "        // 사용부문이 존재하지 않는 경우를 결재처리로 판단하여 렌더링 처리진행함",
                    "        if (prjStoreItems && prjStoreItems.length > 0) {",
                    "            for (i in prjStoreItems) {",
                    "                item = prjStoreItems[i].data;",
                    "                if (value === item.value) {",
                    "                    result = item.text;",
                    "                    record.hrHromJasPrjText = item.text;",
                    "                    break;",
                    "                }",
                    "            }",
                    "            // 결재처리시 사용부문이력값을 사용하기 위해 jasPrjText 값으로 저장함",
                    "            for (i in userInfoList) {",
                    "                item = userInfoList[i];",
                    "                if (record.data.hrHrpmEmpId === item.hrHrpmEmpId) {",
                    "                    item.jasPrjText = result;",
                    "                    item.jasActgCd = value;",
                    "                    break;",
                    "                }",
                    "            }",
                    "        }",
                    "        else {",
                    "            // 사용부문이력값을 렌더링값으로 사용",
                    "            result = record.data.jasPrjText;",
                    "        }",
                    "",
                    "        // 외부직원일 경우, 선택불가 메시지 표시한다. 그리드의 boforeedit 와 같은 이벤트가 없어 이와 같은 코드 작성함",
                    "        if ('02' === record.data.stfDvcd) {",
                    "            Ext.Msg.alert('안내', '내부직원만 사용부문 설정이 가능합니다.');",
                    "            return null;",
                    "        }",
                    "",
                    "        return result;",
                    "}"
                ]
            },
            "configAlternates": {
                "designer|params": "typedarray",
                "fn": "string",
                "implHandler": "code"
            },
            "name": "gridRenderer",
            "designerId": "df022ba6-c379-4286-b0c5-5f772976165b"
        },
