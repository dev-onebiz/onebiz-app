                    "value"
                ],
                "fn": "curr",
                "implHandler": [
                    "if (value) {",
                    "    var str = String(value);",
                    "    var result = str.replace(/(\\d)(?=(?:\\d{3})+(?!\\d))/g, '$1,');",
                    "    result += ' 원';",
                    "",
                    "    return result",
                    "} else {",
                    "    return '0';",
                    "}",
