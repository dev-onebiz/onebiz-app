                                    "cn": [
                                        {
                                            "type": "viewcontrollereventbinding",
                                            "reference": {
                                                "name": "listeners",
                                                "type": "array"
                                            },
                                            "codeClass": null,
                                            "userConfig": {
                                                "designer|commentHeader": [
                                                    "일괄결재 모드 토글 이벤트"
                                                ],
                                                "fn": "onTglSanModeChange",
                                                "implHandler": [
                                                    "debugger;",
                                                    "var me = this,",
                                                    "    refs = me.getReferences(),",
                                                    "    vm = me.getViewModel(),",
                                                    "    modeSan = vm.get('modeSan');",
                                                    "    ",
                                                    "if(newValue){ // 일괄결재 모드 ON",
                                                    "    modeSan = true;",
                                                    "}else{ // 일괄결재 모드 OFF",
                                                    "    modeSan = false;",
                                                    "}",
                                                    "vm.set('modeSan', modeSan);"
                                                ],
                                                "name": "change",
                                                "scope": "me"
                                            },
                                            "configAlternates": {
                                                "designer|commentHeader": "comment",
                                                "fn": "string",
                                                "implHandler": "code",
                                                "name": "string",
                                                "scope": "string"
                                            },
                                            "name": "onTglSanModeChange",
                                            "designerId": "a0396fe1-19e6-4a27-8f12-92467eb5173b"
                                        }
                                    ]
                                },
                                {
                                    "type": "Ext.Button",
                                    "reference": {
                                        "name": "items",
                                        "type": "array"
                                    },
                                    "codeClass": null,
                                    "userConfig": {
                                        "docked": null,
                                        "text": "조회"
                                    },
                                    "configAlternates": {
                                        "text": "string",
                                        "docked": "string",
                                        "style": "string"
                                    },
                                    "name": "MyButton",
                                    "designerId": "906e41f3-a742-4d40-a933-033482f0c900",
                                    "cn": [
                                        {
                                            "type": "viewcontrollereventbinding",
                                            "reference": {
                                                "name": "listeners",
                                                "type": "array"
                                            },
                                            "codeClass": null,
                                            "userConfig": {
                                                "designer|commentHeader": [
                                                    "조회버튼"
                                                ],
                                                "fn": "onBtnSearchTap",
                                                "implHandler": [
                                                    "var me = this,",
                                                    "    searchYear = me.getViewModel().get('searchYear'),",
                                                    "    searchVwIdStore = me.getViewModel().storeInfo.SearchVwIdStore, // 검색조건 : 결재문서명 데이터",
                                                    "    vm = me.getViewModel(),",
                                                    "    command = vm.getData().command,",
                                                    "    data = {",
                                                    "        command : command,",
                                                    "        searchYear : searchYear",
                                                    "    };",
                                                    "",
                                                    "if(command == Constants.sanction.DEPT_COMPLETED_BOX){ // 부서완료함인 경우 부서구분 포함",
                                                    "    data.dpDvcdNm = '부서';",
                                                    "}",
                                                    "",
                                                    "searchVwIdStore.removeAll();",
                                                    "Ext.Ajax.request({",
                                                    "    headers : {",
                                                    "        //serviceId : 'ApprovalBoxSvc.findOneEdocCodeList'",
                                                    "        serviceId : 'COMAPR0001R03M'",
                                                    "    },",
                                                    "    jsonData:data,",
                                                    "    success : function(response, scope) {",
                                                    "        //         var code = [ {",
                                                    "        //           code : 'EdocMgnt',",
                                                    "        //           text : Constants.comboBoxText.defaultText,",
                                                    "        //           value : ''",
                                                    "        //         } ];",
                                                    "",
                                                    "        /*기존소스 주석*/",
                                                    "        /*var res = JSON.parse(response.responseText);",
                                                    "        for (var i in res.result) {",
                                                    "            var record = {",
                                                    "//                 code : 'EdocMgnt',",
                                                    "                text : res.result[i].edocNm,",
                                                    "                value : res.result[i].edocCd",
                                                    "            };",
                                                    "            //           code.push(record);",
                                                    "            searchVwIdStore.add(record);",
                                                    "        }*/",
                                                    "",
                                                    "        // 결재 조회 조건을 리스트에 있는 것들만으로 전달",
                                                    "        var res = JSON.parse(response.responseText);",
                                                    "        var edocCodeList = res.edocCodeList;",
                                                    "",
                                                    "        for (var i in edocCodeList) {",
                                                    "            var record = {",
                                                    "                text : edocCodeList[i].edocNm,",
                                                    "                value : edocCodeList[i].edocCd",
                                                    "            };",
                                                    "            searchVwIdStore.add(record);",
                                                    "        }",
                                                    "",
                                                    "",
                                                    "        // 팝업창 생성 및 데이터전달",
                                                    "        var win = Ext.create('BNK.view.Budget.exp.ExpNteApr03M', {",
                                                    "            searchYear : searchYear,",
                                                    "            searchVwIdStore : searchVwIdStore,",
                                                    "            command : command",
                                                    "        });",
                                                    "",
                                                    "        // 팝업창에서 이벤트 호출시 실행되는 함수",
                                                    "        me.mon(win, 'search', function(data, popup) {",
                                                    "            var me = this,",
                                                    "                vm = me.getViewModel(),",
                                                    "                vwNm = '전체문서';",
                                                    "",
                                                    "            // 팝업창 닫기",
                                                    "            popup.close();",
                                                    "",
                                                    "            // 결재문서명",
                                                    "            if (data.vwId) {",
                                                    "                var items = vm.storeInfo.SearchVwIdStore.getData().items;",
                                                    "                for (var i in items) {",
                                                    "                    var item = items[i].data;",
                                                    "                    if (data.vwId === item.value) {",
                                                    "                        vwNm = item.text;",
                                                    "                        break;",
                                                    "                    }",
                                                    "                }",
                                                    "            }",
                                                    "",
                                                    "            vm.set('searchYear', data.searchYear);  // 기준연도",
                                                    "            vm.set('vwId', data.vwId);\t   \t\t\t// 결재문서아이디",
                                                    "            vm.set('vwNm', vwNm);\t\t   \t\t\t// 결재문서명",
                                                    "            vm.set('rqprId', data.rqprId); \t\t\t// 사번",
                                                    "",
                                                    "            me.onSelect(); // 조회",
                                                    "        }, me);",
                                                    "",
                                                    "        win.show(); // 팝업창표시",
                                                    "    }",
                                                    "});"
                                                ],
                                                "name": "tap",
                                                "scope": "me"
                                            },
                                            "configAlternates": {
                                                "fn": "string",
                                                "implHandler": "code",
                                                "name": "string",
