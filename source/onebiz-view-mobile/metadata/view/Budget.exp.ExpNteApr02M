                                "width": 50
                            },
                            "configAlternates": {
                                "hidden": "binding",
                                "docked": "string",
                                "reference": "string",
                                "width": "auto"
                            },
                            "name": "MyCheckColumn1",
                            "designerId": "fafa8ba9-ed0b-422f-b5a6-74fb84c7961c",
                            "cn": [
                                {
                                    "type": "viewcontrollereventbinding",
                                    "reference": {
                                        "name": "listeners",
                                        "type": "array"
                                    },
                                    "codeClass": null,
                                    "userConfig": {
                                        "designer|commentHeader": [
                                            "그리드 체크박스(일괄결재를 위한 row 선택) 이벤트"
                                        ],
                                        "fn": "onCbxChange",
                                        "implHandler": [
                                            "var me = this,",
                                            "    vm = me.getViewModel(),",
                                            "    cellChecked = checkcell.getValue(),",
                                            "    selectCnt = vm.get('selectCnt'),",
                                            "    aprHistId = record.id,",
                                            "    vwId = record.data.vwId;",
                                            "",
                                            "// 모바일 결재여부판단 (mobYn)",
                                            "if(record.data.mobYn == 'N') {",
                                            "    Ext.Msg.alert('알림', '해당 문서는 모바일에서 결재할 수 없습니다.');",
                                            "    return;",
                                            "}",
                                            "",
                                            "// 일괄결재 가능한 최대 개수 확인",
                                            "if(selectCnt == 10 && !cellChecked == true){",
                                            "    Ext.Msg.alert('알림', '일괄결재는 최대 10건까지 가능합니다.');",
                                            "    return;",
                                            "}",
                                            "",
                                            "// 세금계산서, 여비정산서는 모바일에서 결재불가. 해당 경우 제외하기",
                                            "if(vwId == 'BgxNfmAply71'){",
                                            "   Ext.Ajax.request({",
                                            "        headers : {",
                                            "            serviceId : 'COMAPR0001R04M'",
                                            "        },",
                                            "        jsonData:{",
                                            "            aprHistId : aprHistId",
                                            "        },",
                                            "        success : function(response, scope) {",
                                            "            var res = Ext.JSON.decode(Ext.JSON.decode(response.responseText).result);",
                                            "            var aplKndCd = res.docData.afterchange.applyInfo.aplKndcd;",
                                            "",
                                            "            if(aplKndCd == Constants.aplKndcd.TXINV || aplKndCd == Constants.aplKndcd.XPNS){ // 세금계산서, 여비정산서인 경우",
                                            "                Ext.Msg.alert('알림', '해당 문서는 모바일에서 결재할 수 없습니다.');",
                                            "                return;",
                                            "            }",
                                            "",
                                            "            // 체크박스 체크 처리",
                                            "            checkcell.setValue(!cellChecked);",
                                            "            // 체크된 record 상태값 처리",
                                            "            record.set('checked', !cellChecked);",
                                            "",
                                            "            // 선택문서 개수 처리",
                                            "            if(cellChecked){",
                                            "                vm.set('selectCnt', selectCnt - 1);",
                                            "            }else{",
                                            "                vm.set('selectCnt', selectCnt + 1);",
                                            "            }",
                                            "        },",
                                            "        failure : function(response){",
                                            "            Ext.Msg.alert('오류', '결재 정보를 가져오는데 실패했습니다.');",
                                            "            return;",
                                            "        }",
                                            "    });",
                                            "}else{",
                                            "    // 체크박스 체크 처리",
                                            "    checkcell.setValue(!cellChecked);",
                                            "    // 체크된 record 상태값 처리",
                                            "    record.set('checked', !cellChecked);",
                                            "",
                                            "    // 선택문서 개수 처리",
                                            "    if(cellChecked){",
                                            "        vm.set('selectCnt', selectCnt - 1);",
                                            "    }else{",
                                            "        vm.set('selectCnt', selectCnt + 1);",
                                            "    }",
                                            "}"
                                        ],
                                        "name": "checkchange",
                                        "scope": "me"
                                    },
                                    "configAlternates": {
                                        "designer|commentHeader": "comment",
                                        "fn": "string",
                                        "implHandler": "code",
                                        "name": "string",
                                        "scope": "string"
                                    },
                                    "name": "onCbxChange",
                                    "designerId": "6474b230-bd50-4605-944d-d9ed1191d4d8"
                                }
                            ]
                        },
