                        },
                        {
                            "type": "Ext.grid.plugin.PagingToolbar",
                            "reference": {
                                "name": "plugins",
                                "type": "array"
                            },
                            "codeClass": null,
                            "name": "MyPagingToolbar1",
                            "designerId": "cb069f0e-86d5-41fd-8c13-2bd3b9149836"
                        },
                        {
                            "type": "viewcontrollereventbinding",
                            "reference": {
                                "name": "listeners",
                                "type": "array"
                            },
                            "codeClass": null,
                            "userConfig": {
                                "fn": "onGridSelect",
                                "implHandler": [
                                    "var me = this,",
                                    "    vm = me.getViewModel(),",
                                    "    record = selected[0].data;",
                                    "",
                                    "var refs = me.getReferences(),",
                                    "    gridExpNteApr = refs.gridExpNteApr;",
                                    "",
                                    "// 선택한 결재선 레코드. 동시성제어에 사용",
                                    "vm.set('record', record);",
                                    "",
                                    "// 결재이력데이터조회",
                                    "Ext.Ajax.request({",
                                    "    headers : {",
                                    "        serviceId : 'COMAPR0001R04M',",
                                    "        viewId : 'ExpNteApr02M'",
                                    "    },",
                                    "    scope : me,",
                                    "    jsonData : {",
                                    "        aprHistId : record.id // 결재이력아이디",
                                    "    },",
                                    "    success : function(response) {",
                                    "        var me = this,",
                                    "            refs = me.getReferences(),",
                                    "            vm = me.getViewModel(),",
                                    "            command = vm.get('command'),",
                                    "            responseJson = Ext.JSON.decode(Ext.JSON.decode(response.responseText).result);",
                                    "",
                                    "        if (!responseJson) {",
                                    "            Ext.Msg.alert('안내', '결재이력데이터가 존재하지 않습니다.');",
                                    "            return;",
                                    "        }",
                                    "",
                                    "        vm.set('responseJson', responseJson);",
                                    "",
                                    "        var edocCd = responseJson.edocCd;",
                                    "        /* 2020.10.16  BNK시스템/계장/지민영   bizDvcd 더이상 사용하지 않음",
                                    "         if(responseJson.bizDvcd == 'HWM' && edocCd.substring(edocCd.length-2, edocCd.length) == '72'){ */",
                                    "        if (edocCd.substring(0,3) == 'Hwm' && (edocCd.substring(edocCd.length-2, edocCd.length) == '72'",
                                    "                                               || edocCd.substring(edocCd.length-2, edocCd.length) == '74')) {",
                                    "            // 연장근무, 휴일근무 보고서를 사용하지 않을 경우에는 73으로 변경",
                                    "            edocCd = edocCd.substring(0, edocCd.length-2) + '71'; // TODO: 각 근태취소신청서 화면 따로만들지 않고 처리.. 개선 필요.",
                                    "        } else if(edocCd == 'ExpNteDoc71'){",
                                    "            edocCd = 'ExpNteAply71'; // TODO: 지출결의서 취소신청서는 ExpNteAply71을 보도록 처리함",
                                    "            /*             2020.09.16\tBNK시스템/계장/지민영   (웹동기화) 연장근무보고 결재팝업(HwmOvtRept71) 추가로 인한 분기삭제",
                                    "         } else if(edocCd == 'HwmOvtRept71'){",
                                    "             edocCd = 'HwmOvtAply71'; */",
                                    "            /*             2020.10.14\tBNK시스템/계장/지민영   (웹동기화) 휴일근무보고 결재팝업(HwmHodRept71) 추가로 인한 분기삭제",
                                    "         } else if(edocCd == 'HwmHodRept71'){",
                                    "             edocCd = 'HwmHodAply71'; */",
                                    "        }",
                                    "",
                                    "        var aprViewId = edocCd + 'M';\t// 모바일일경우, 화면이름에 M을 붙여처리함",
                                    "        //         var aprViewId = responseJson.edocCd + 'M';\t// 모바일일경우, 화면이름에 M을 붙여처리함",
                                    "",
                                    "        // 모바일 결재여부판단 (mobYn)",
                                    "        if(record.mobYn == 'N') {",
                                    "            aprViewId = 'ApprovalEmptyPopupM';",
                                    "        }",
                                    "",
                                    "        var classname = me.GET_CLASS_NAME(aprViewId);",
                                    "        if (!classname) {",
                                    "            //             Ext.Msg.alert('안내', Ext.String.format('{0}에 해당하는 파일이 존재하지 않습니다.', aprViewId));",
                                    "            Ext.Msg.alert('안내', Ext.String.format('{0}에 해당하는 파일이 존재하지 않습니다.', responseJson.docNm));",
                                    "            return;",
                                    "        }",
                                    "",
                                    "        // 부서완료함(97)과 담당자완료함(98)은 완료함(94)과 동일한 기능을 하도록 설정",
                                    "        var commandArr = ['97', '98'];",
                                    "        if(commandArr.includes(command)){",
                                    "            command = '94';",
                                    "        }",
                                    "",
                                    "        // 과거데이터와 호환성을 위한처리 추가",
                                    "        var aprHistId = responseJson.aprHistId,",
                                    "            docData = responseJson.docData;",
                                    "        if (!docData) {",
                                    "            docData = {};",
                                    "            if (responseJson.fieldValues)  docData.fieldValues  = responseJson.fieldValues;",
                                    "            if (responseJson.afterchange)  docData.afterchange  = responseJson.afterchange;",
                                    "            if (responseJson.beforechange) docData.beforechange = responseJson.beforechange;",
                                    "        }",
                                    "        if (!aprHistId) {",
                                    "            aprHistId = vm.get('record').id;",
                                    "        }",
                                    "        // end of 과거데이터와 호환성을 위한처리 추가",
                                    "",
                                    "        var win = Ext.create(aprViewId, {",
                                    "            command : command,",
                                    "            aprHistId : aprHistId,",
                                    "            docData : docData,",
                                    "            record : vm.get('record')",
                                    "        });",
                                    "",
                                    "        me.mon(win, 'complete', function(popup) {",
                                    "            popup.close(); //팝업창닫기",
                                    "            me.onSelect();",
                                    "        }, me);",
                                    "",
                                    "        win.show();",
                                    "    }",
                                    "});",
                                    "",
                                    ""
                                ],
                                "name": "select",
                                "scope": "me"
                            },
                            "configAlternates": {
                                "fn": "string",
                                "implHandler": "code",
                                "name": "string",
                                "scope": "string"
                            },
                            "name": "onGridSelect",
                            "designerId": "087a3d4a-c57d-43cb-a456-564afe5921f9"
                        }
                    ]
                }
            ]
        },
        {
            "type": "viewcontrollereventbinding",
            "reference": {
                "name": "listeners",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "fn": "initialize",
                "implHandler": [
                    "var me = this,",
                    "    config = component.initialConfig,",
                    "    vm = me.getViewModel(),",
                    "    searchVwIdStore = me.getViewModel().storeInfo.SearchVwIdStore;",
                    "",
                    "vm.set('searchYear', new Date().getFullYear());",
                    "vm.set('command', config.command);",
                    "// 일괄결재 모드 초기화",
                    "vm.set('modeSan', false);",
                    "// 선택된 결재 문서 개수 초기화",
                    "vm.set('selectCnt', 0);",
                    "",
                    "// 조회",
                    "me.onSelect();",
                    "",
                    "/*",
                    "// 검색조건 : 결재문서명 코드조회",
                    "me.GET_CODELIST({",
                    "    codeDvcd : 'EDOC_MGNT'",
                    "}, me).then(function(result) {",
                    "    var me = result.scope,",
                    "        data = result.data,",
                    "        vm = me.getViewModel(),",
                    "        searchVwIdStore = vm.storeInfo.SearchVwIdStore;",
                    "",
                    "    searchVwIdStore.removeAll();",
                    "    searchVwIdStore.add(data);",
                    "",
                    "    // 조회",
                    "    me.onSelect();",
                    "});",
                    "*/"
                ],
                "name": "initialize",
                "scope": "me"
            },
            "configAlternates": {
                "fn": "string",
                "implHandler": "code",
                "name": "string",
                "scope": "string"
            },
            "name": "initialize",
            "designerId": "43d7743a-6fbc-4e76-b5b2-e0b7ab105378"
        },
        {
            "type": "Ext.Button",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "bottom": 80,
                "designer|uiInterfaceName": "action round",
                "height": 70,
                "hidden": [
                    "{!modeSan}"
                ],
                "right": "3%",
                "style": "position : absolute; background : #f5f5f5 0% 0% no-repeat padding-box; box-shadow:0px 6px 12px rgba(9,38,95,0.2);text-align:center;font-size:13px;",
                "text": [
                    "{selectCnt}/10</br>결재"
                ],
                "ui": "action round",
                "width": 70
            },
            "configAlternates": {
                "text": "binding",
                "hidden": "binding",
                "bottom": "auto",
                "designer|uiInterfaceName": "string",
                "height": "auto",
                "right": "auto",
                "style": "string",
                "ui": "string",
                "width": "auto"
            },
            "name": "MyButton5",
            "designerId": "bd604048-7c76-4828-b63c-62087c96ce2f",
            "cn": [
                {
                    "type": "viewcontrollereventbinding",
                    "reference": {
                        "name": "listeners",
                        "type": "array"
                    },
                    "codeClass": null,
                    "userConfig": {
                        "designer|commentHeader": [
                            "일괄결재 버튼 클릭 이벤트"
                        ],
                        "fn": "onBtnSanTap",
                        "implHandler": [
                            "var me = this,",
                            "    refs = me.getReferences(),",
                            "    vm = me.getViewModel(),",
                            "    grid = refs.gridExpNteApr,",
                            "    batchType = Constants.sanction.SANCTION,",
                            "    command = vm.get('command'),",
                            "    selectCnt = vm.get('selectCnt');",
                            "",
                            "// 선택한 결재가 없는 경우",
                            "if(selectCnt == 0){",
                            "   Ext.Msg.alert('알림', '선택한 결재가 없습니다.');",
                            "   return;",
                            "}",
                            "",
                            "// 일괄결재 의사 묻기",
                            "Ext.Msg.confirm('일괄결재', '선택한 ' + selectCnt + '건을 일괄결재 하시겠습니까?', function(btn) {",
                            "    if (btn == 'yes') {",
                            "        // 결재함에 따른 분류",
                            "        if(command == Constants.sanction.PENDING_BOX) { // 미결함",
                            "            command = Constants.sanction.SANCTION;    //결재",
                            "        } else if(command == Constants.sanction.RECEIPT_BOX){ // 담당자접수함",
                            "            command = Constants.sanction.DRAFT;       //기안",
                            "        }",
                            "",
                            "        // 체크한 결재 리스트 생성하기",
                            "        var selectedRowList = [];",
                            "        var data = grid.getJsonAllRecords();",
                            "        for(var i in data){",
                            "            if(data[i].checked){",
                            "                selectedRowList.push(data[i]);",
                            "            }",
                            "        }",
                            "",
                            "        // 일괄결재",
                            "        Ext.Ajax.request({",
                            "            headers : {",
                            "                serviceId \t: 'ApprovalBoxSvc.saveComAprHistBatch',",
                            "                viewId \t\t: 'ExpNteApr02M'",
                            "            },",
                            "            scope : me,",
                            "            jsonData : {",
                            "              aprHistList \t: selectedRowList,\t//체크한 결재리스트",
                            "              command \t\t: command,      \t//boxCommand",
                            "              batchType \t: batchType\t\t\t//일괄결재 or 일괄확인",
                            "            },",
                            "            success : function(response) {",
                            "                var me = this,",
                            "                    refs = me.getReferences(),",
                            "                    vm = me.getViewModel(),",
                            "                    command = vm.get('command'),",
                            "                    responseJson = Ext.JSON.decode(response.responseText);",
                            "",
                            "                if(responseJson.success){",
                            "                    Ext.Msg.alert('완료', '일괄결재 처리 완료했습니다.');",
                            "                }",
                            "                me.onSelect();",
                            "            },",
                            "            failure : function(response, opts) {",
                            "                Ext.Msg.alert('오류', '일괄결재 도중 오류가 발생했습니다.');",
                            "            }",
                            "        });",
                            "    }",
                            "});",
                            "",
                            ""
                        ],
                        "name": "tap",
                        "scope": "me"
                    },
                    "configAlternates": {
                        "designer|commentHeader": "comment",
                        "fn": "string",
                        "implHandler": "code",
                        "name": "string",
                        "scope": "string"
                    },
                    "name": "onBtnSanTap",
                    "designerId": "64565e5e-8485-4d83-8236-d624890d1000"
                }
            ]
        }
    ]
}