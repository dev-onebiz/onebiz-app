            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "상세조회"
                ],
                "designer|params": [
                    "boTasmTrsId"
                ],
                "fn": "onSelect",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    param = {",
                    "        id : boTasmTrsId",
                    "    };",
                    "",
                    "Ext.Ajax.request({",
                    "    headers: {",
                    "        viewId : me.getViewId(),",
                    "        serviceId : 'BomTasSvc.findOneBomTasdPush'",
                    "    },",
                    "    jsonData : param,",
                    "    scope : me,",
                    "    success : function(response) {",
                    "        var res = Ext.JSON.decode(response.responseText);",
                    "",
                    "        if (res.result && res.result.msgDvcd) {",
                    "            var code = 'TAS004',\t\t\t\t\t\t\t// 메시지구분 코드",
                    "                codeStore = Ext.StoreMgr.get('CodeStore'),",
                    "                items = codeStore.getData().items,",
                    "                result = res.result,",
                    "                msgDvcd = result.msgDvcd,",
                    "                msgDvnm = '';",
                    "",
                    "            // msgDvcd",
                    "            for (var i = 0, l = items.length; i < l; i++) {",
                    "                if (code === items[i].data.code) {",
                    "                    var children = items[i].data.children;",
                    "                    for (var j = 0, l2 = children.length; j < l2; j++) {",
                    "                        var text = children[j].text,",
                    "                            value = children[j].value;",
                    "                        if (value === msgDvcd) {",
                    "                            msgDvnm = text;",
                    "                        }",
                    "                    }",
                    "                }",
                    "            }",
                    "",
                    "            var contentHtml = document.createElement('div');",
                    "            contentHtml.innerHTML = result.content;",
                    "",
                    "            var imgList = contentHtml.getElementsByTagName('img'); //img태그 collection",
                    "            for(var i = 0; i < imgList.length; i++) {",
                    "                //서버주소 + 상대주소",
                    "                imgList[i].setAttribute('src', Property.BASE_URL + imgList[i].getAttribute('src'));",
                    "            }",
                    "",
                    "            result.content = contentHtml.innerHTML;",
                    "",
                    "            vm.set('detail', result);",
                    "            var fmtDvcdClass = '';\t\t\t\t\t// 포맷구분",
                    "            switch (result.fmtDvcd) {",
                    "                case Constants.pushFmtDvcd.TXT :\t\t// text",
                    "                case Constants.pushFmtDvcd.OUTER_URL : \t// outerUrl",
                    "                case Constants.pushFmtDvcd.INNER_URL : \t//innerUrl",
                    "                    fmtDvcdClass = 'BomTasPushDetailItem01M';",
                    "                    break;",
                    "                case Constants.pushFmtDvcd.IMG : \t\t// image",
                    "                    fmtDvcdClass = 'BomTasPushDetailItem02M';",
                    "                    break;",
                    "            }",
                    "",
                    "            if (Ext.isEmpty(fmtDvcdClass)) {",
                    "                return;",
                    "            }",
                    "            // 컴포넌트추가",
                    "            refs.cpnt.add(Ext.create(fmtDvcdClass, {",
                    "                record : result",
                    "            }));",
                    "",
                    "",
                    "            // 읽음처리 (수신상태, 일자, 시간)",
                    "            Property.BO_TASM_TRS_ID = null;",
                    "            Ext.Ajax.request({",
                    "                headers: {",
                    "                    viewId : me.getViewId(),",
                    "                    serviceId : 'BomTasSvc.saveOnePushRvStcd'",
                    "                },",
                    "                jsonData : param,",
                    "                scope : me,",
                    "                success : function(response) {",
                    "                    var res = Ext.JSON.decode(response.responseText);",
                    "                }",
                    "            });",
                    "        }",
                    "    }",
                    "});"
                ]
            },
