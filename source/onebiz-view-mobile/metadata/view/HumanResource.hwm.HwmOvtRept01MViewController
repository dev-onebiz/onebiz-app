        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "신청취소 저장함수"
                ],
                "fn": "onApfCancelSave",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    grid = refs.grid,",
                    "    selectedData = grid.getSelection().data;",
                    "",
                    "//VALIDATION AREA",
                    "if (selectedData.apfAplDvcd == Constants.wrkAplDvcd.CANCEL) {",
                    "    Ext.Msg.alert(\"안내\", \"정상 신청서만 신청취소이 가능합니다.\");",
                    "    return false;",
                    "}",
                    "if (selectedData.hrWrkmOvtReptId && selectedData.reptAplDvcd != Constants.wrkAplDvcd.CANCEL) {",
                    "    Ext.Msg.alert(\"안내\", \"해당건에 대해서 연장근무 보고서가 '진행/완료' 된 신청서가 있습니다. <br> 연장근무 보고서 회수/취소 후 다시 신청바랍니다.\");",
                    "    return false;",
                    "}",
                    "if (selectedData.apfAplStcd != Constants.aplStcd.COMPLETED_APPLY) {",
                    "    Ext.Msg.alert(\"안내\", \"신청상태가 \\'완료(신청)\\'인 신청서만 신청취소이 가능합니다.<br><br>신청상태가 \\'진행(신청)\\'인 경우에는 결재함에서 회수 하시기 바랍니다.\");",
                    "    return false;",
                    "}",
                    "//END VALIDATION AREA",
                    "",
                    "selectedData.stcd = Constants.stcd.OUTSTANDING; //상태 - 결재로 변경",
                    "selectedData.aplStcd = Constants.aplStcd.COMPLETED_APPLY; //신청상태 - 완료",
                    "selectedData.aplDvcd = Constants.wrkAplDvcd.CANCEL; //신청구분 - 취소",
                    "",
                    "Ext.Ajax.request({",
                    "    headers : {",
                    "        serviceId : 'HwmOvtSvc.findAllHwmOvtAply',",
                    "        viewId : me.getViewId(),",
                    "        scope : me",
                    "    },",
                    "    jsonData : selectedData,",
                    "    success : function(res) {",
                    "        if (res.errMsg) {",
                    "            Ext.Msg.alert(\"안내\", res.errMsg);",
                    "            return;",
                    "        }",
                    "",
                    "        Ext.Msg.confirm('알림', '<b>※유의사항<br> 신청취소시 결재 없이 바로 취소 됩니다.</b> <br><br> 정말로 취소하시겠습니까? <br>', function(btn) {",
                    "            if (btn == 'yes') {",
                    "                var result = {",
                    "                    newRecords : [],",
                    "                    modifiedRecords : [],",
