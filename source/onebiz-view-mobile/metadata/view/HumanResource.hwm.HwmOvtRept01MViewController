                    "            xtype: 'button',",
                    "            disabled: true,",
                    "            itemId: 'btnReApply',",
                    "            ui: 'action',",
                    "            margin: 5,",
                    "            text: '재기안',",
                    "            scope : me,",
                    "            handler : 'onApfData'",
                    "        },",
                    "        {",
                    "            xtype: 'button',",
                    "            disabled: true,",
                    "            itemId: 'btnCancel',",
                    "            ui: 'action',",
                    "            margin: 5,",
                    "            text: '신청취소',",
                    "            scope : me,",
                    "            handler : 'onApfData'",
                    "        },",
                    "        {",
                    "            xtype: 'button',",
                    "            disabled: true,",
                    "            itemId: 'btnReptWrite',",
                    "            ui: 'action',",
                    "            margin: '5 5 10 5',",
                    "            text: '보고',",
                    "            scope : me,",
                    "            handler : 'onReptData'",
                    "        },",
                    "        {",
                    "            xtype: 'button',",
                    "            disabled: true,",
                    "            itemId: 'btnReptCancel',",
                    "            ui: 'action',",
                    "            margin: '5 5 10 5',",
                    "            text: '보고취소',",
                    "            scope : me,",
                    "            handler : 'onReptData'",
                    "        },",
                    "        {",
                    "            xtype: 'button',",
                    "            disabled: true,",
                    "            itemId: 'actAprHistApfData',",
                    "            ui: 'action',",
                    "            margin: '5 5 10 5',",
                    "            text: '신청서 보기',",
                    "            scope : me,",
                    "            handler : 'onClickActColumn'",
                    "        },",
                    "        {",
                    "            xtype: 'button',",
                    "            disabled: true,",
                    "            itemId: 'actAprHistReptData',",
                    "            ui: 'action',",
                    "            margin: '5 5 10 5',",
                    "            text: '보고서 보기',",
                    "            scope : me,",
                    "            handler : 'onClickActColumn'",
                    "        }",
                    "    ]",
                    "});"
                ]
            },
