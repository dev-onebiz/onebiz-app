        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "메뉴"
                ],
                "designer|params": [
                    "component, eOpts"
                ],
                "fn": "onActionSheetShow",
                "implHandler": [
                    "var me = component.config.scope,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences();",
                    "",
                    "// 열린화면이 연장근무인지 유효성체크",
                    "var home = Ext.ComponentQuery.query(Property.ROUTE_HOME);",
                    "if (home.length <= 0 || document.getElementsByClassName(\"x-navigationview-body-el\")[0].lastChild.id.indexOf('HwmOvtRept01M') == -1) {\t\t// 로그인화면이거나 연장근무신청화면이 아닌경우",
                    "    console.log('연장근무화면아님');",
                    "    Ext.Viewport.removeMenu('bottom', false);",
                    "} else {",
                    "    // 신청서가 선택되었는지 체크",
                    "    if (refs.grid && refs.grid.getSelection()) {",
                    "        // 하나만 선택되었는지 체크",
                    "        if (refs.grid.getSelectionCount() > 1) {",
                    "            Ext.Msg.alert('알림', '하나만 선택할 수 있습니다.');",
                    "            component.hide();",
                    "        }",
                    "",
                    "        var record = refs.grid.getSelection().data,",
                    "            items = component.getItems(),",
                    "            btnReApply = items.get('btnReApply'),\t\t// 재기안",
                    "            btnCancel = items.get('btnCancel'),\t\t\t// 신청취소",
                    "            btnReptWrite = items.get('btnReptWrite'),\t// 보고",
                    "            btnReptCancel = items.get('btnReptCancel'),\t// 보고취소",
                    "            actAprHistApfData = items.get('actAprHistApfData'),\t\t// 신청서보기",
                    "            actAprHistReptData = items.get('actAprHistReptData');\t// 보고서보기",
                    "",
                    "        //재기안",
                    "        if (record.apfAplDvcd == Constants.wrkAplDvcd.CANCEL) {",
                    "          btnReApply.setDisabled(true);",
                    "        } else {",
                    "          btnReApply.setDisabled(false);",
                    "        }",
                    "        //신청취소",
                    "        if (record.apfAplDvcd == Constants.wrkAplDvcd.CANCEL) {",
                    "          btnCancel.setDisabled(true);",
                    "        } else if (record.hrWrkmOvtReptId && record.reptAplDvcd != Constants.wrkAplDvcd.CANCEL) {",
                    "          btnCancel.setDisabled(true);",
                    "        } else if (record.apfAplStcd != Constants.aplStcd.COMPLETED_APPLY) {",
                    "          btnCancel.setDisabled(true);",
                    "        } else {",
                    "          btnCancel.setDisabled(false);",
                    "        }",
                    "        //보고취소",
                    "        if (!record.hrWrkmOvtReptId) {",
                    "          btnReptCancel.setDisabled(true);",
                    "        } else if (record.reptAplDvcd == Constants.wrkAplDvcd.CANCEL) {",
                    "          btnReptCancel.setDisabled(true);",
                    "        } else if (record.hrHrpmEmpId != SecurityUtils.getPrincipal().hrHrpmEmpId) {",
                    "          btnReptCancel.setDisabled(true);",
                    "        } else if (record.reptAplStcd != Constants.aplStcd.COMPLETED_APPLY) {",
                    "          btnReptCancel.setDisabled(true);",
                    "        } else {",
                    "          btnReptCancel.setDisabled(false);",
                    "        }",
                    "        //보고",
                    "        if (record.apfAplDvcd == Constants.wrkAplDvcd.CANCEL) {",
                    "          btnReptWrite.setDisabled(true);",
                    "        } else if (record.apfAplStcd != Constants.aplStcd.COMPLETED_APPLY) {",
                    "          btnReptWrite.setDisabled(true);",
                    "        } else if (record.hrWrkmOvtReptId) {",
                    "          if (record.reptAplDvcd == Constants.wrkAplDvcd.APPLY) {",
                    "            if ((record.reptAplStcd == Constants.aplStcd.COMPLETED_APPLY || record.reptAplStcd == Constants.aplStcd.PROGRESS_APPLY)) {",
                    "              btnReptWrite.setDisabled(true);",
                    "            } else {",
                    "              btnReptWrite.setDisabled(false);",
                    "            }",
                    "          } else {",
                    "            btnReptWrite.setDisabled(false);",
                    "          }",
                    "        } else {",
                    "          btnReptWrite.setDisabled(false);",
                    "        }",
                    "        // 신청서 보기",
                    "        if (record.comAprHistApfId && record.comAprHistApfId != -1) {",
                    "            actAprHistApfData.setDisabled(false);",
                    "        }",
                    "        // 보고서 보기",
                    "        if (record.comAprHistReptId && record.comAprHistReptId != -1) {",
                    "            actAprHistReptData.setDisabled(false);",
                    "        }",
                    "    } else {",
                    "        // 행이 선택되지 않았을경우 예외처리",
                    "        var items = component.getItems(),",
                    "            btnReApply = items.get('btnReApply'),\t\t// 재기안",
                    "            btnCancel = items.get('btnCancel'),\t\t\t// 신청취소",
                    "            btnReptWrite = items.get('btnReptWrite'),\t// 보고",
                    "            btnReptCancel = items.get('btnReptCancel'),\t// 보고취소",
                    "            actAprHistApfData = items.get('actAprHistApfData'),\t\t// 신청서보기",
                    "            actAprHistReptData = items.get('actAprHistReptData');\t// 보고서보기",
                    "",
                    "        btnReApply.setDisabled(true);",
                    "        btnCancel.setDisabled(true);",
                    "        btnReptWrite.setDisabled(true);",
                    "        btnReptCancel.setDisabled(true);",
                    "        actAprHistApfData.setDisabled(true);",
                    "        actAprHistReptData.setDisabled(true);",
                    "    }",
                    "",
                    "}"
                ]
            },
            "configAlternates": {
                "fn": "string",
                "implHandler": "code",
                "designer|params": "typedarray",
                "designer|commentHeader": "comment"
            },
            "name": "onActionSheetShow",
            "designerId": "1fa93190-1b46-4a8f-b7e8-9f0d95ca897c"
