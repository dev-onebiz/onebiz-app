                "designer|commentHeader": [
                    "보고 / 보고취소"
                ],
                "designer|params": [
                    "button"
                ],
                "fn": "onReptData",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    grid = refs.grid,",
                    "    itemId = button.config.itemId,",
                    "    selectedData = grid.getSelection().data,",
                    "    naviView = me.getView().up('navigationview');",
                    "",
                    "/* 유효성 체크 */",
                    "switch (itemId) {",
                    "    case 'btnReptCancel':",
                    "        /** 보고취소 저장 함수 호출 */",
                    "        me.onReptCancelSave();",
                    "        break;",
                    "    case 'btnReptWrite':",
                    "        if (selectedData.apfAplDvcd == Constants.wrkAplDvcd.CANCEL) {",
                    "            Ext.Msg.alert(\"안내\", \"정상 신청서만 보고가 가능합니다.\");",
                    "            return false;",
                    "        }",
                    "        if (selectedData.apfAplStcd != Constants.aplStcd.COMPLETED_APPLY) {",
                    "            Ext.Msg.alert(\"안내\", \"신청상태가 \\'완료(신청)\\'인 신청서만 보고서 작성이 가능합니다.\");",
                    "            return false;",
                    "        }",
                    "        if (selectedData.hrWrkmOvtReptId) {",
                    "            if (selectedData.reptAplDvcd == Constants.wrkAplDvcd.APPLY) {",
                    "                if ((selectedData.reptAplStcd == Constants.aplStcd.COMPLETED_APPLY || selectedData.reptAplStcd == Constants.aplStcd.PROGRESS_APPLY)) {",
                    "                    Ext.Msg.alert(\"안내\", \"이미 해당 신청서에 대해서 진행/완료된 보고서가 있습니다.\");",
                    "                    return false;",
                    "                }",
                    "            }",
                    "        }",
                    "        /* 화면이동 */",
                    "        me.PUSH_VIEW(naviView, {",
                    "            menuId  : 'HwmOvtRept02M',",
                    "            title   : '연장근무보고신청',",
                    "            records : selectedData,",
                    "            isSubView : true,",
                    "            parentView : me.getView()",
                    "        });",
                    "        break;",
                    "}",
                    "",
                    "me.menu.hide();\t\t// 메뉴 닫기"
                ]
            },
