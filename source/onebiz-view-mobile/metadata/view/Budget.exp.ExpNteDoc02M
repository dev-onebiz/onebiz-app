                        {
                            "type": "Ext.Button",
                            "reference": {
                                "name": "items",
                                "type": "array"
                            },
                            "codeClass": null,
                            "userConfig": {
                                "designer|displayName": "결재정보 버튼",
                                "layout|flex": 1,
                                "text": "결재정보"
                            },
                            "configAlternates": {
                                "layout|flex": "number",
                                "text": "string",
                                "designer|displayName": "string"
                            },
                            "name": "MyButton28",
                            "designerId": "d2027da2-4a7a-4296-a4cb-3f5f9c46fcb5",
                            "cn": [
                                {
                                    "type": "viewcontrollereventbinding",
                                    "reference": {
                                        "name": "listeners",
                                        "type": "array"
                                    },
                                    "codeClass": null,
                                    "userConfig": {
                                        "designer|commentHeader": [
                                            "결재정보 버튼 탭 이벤트"
                                        ],
                                        "fn": "onAplyInfo",
                                        "implHandler": [
                                            "var me = this,",
                                            "    vm = me.getViewModel(),",
                                            "    record = vm.get('popupData'),",
                                            "    aprHistId = record[0].comAprHistId,",
                                            "    edocCd = record[0].stlmDvcd === '01' ? 'ExpNteAply71' : 'ExpNteRcpt71';",
                                            "",
                                            "// 선택한 결재선 레코드. 동시성제어에 사용",
                                            "vm.set('record', record);",
                                            "",
                                            "// 결재이력데이터조회",
                                            "Ext.Ajax.request({",
                                            "    headers : {",
                                            "        serviceId : 'COMAPR0001R04M',",
                                            "        viewId : 'ExpNteApr02M'",
                                            "    },",
                                            "    scope : me,",
                                            "    jsonData : {",
                                            "        aprHistId : aprHistId // 결재이력아이디",
                                            "    },",
                                            "    success : function(response) {",
                                            "        var me = this,",
                                            "            refs = me.getReferences(),",
                                            "            vm = me.getViewModel(),",
                                            "            command = vm.get('command'),",
                                            "            responseJson = Ext.JSON.decode(Ext.JSON.decode(response.responseText).result);",
                                            "",
                                            "        if (!responseJson) {",
                                            "            Ext.Msg.alert('안내', '결재이력데이터가 존재하지 않습니다.');",
                                            "            return;",
                                            "        }",
                                            "",
                                            "        vm.set('responseJson', responseJson);",
                                            "",
                                            "        var aprViewId = responseJson.edocCd + 'M',\t// 모바일일경우, 화면이름에 M을 붙여처리함",
                                            "            classname = me.GET_CLASS_NAME(aprViewId);",
                                            "        if (!classname) {",
                                            "            Ext.Msg.alert('안내', Ext.String.format('{0}에 해당하는 파일이 존재하지 않습니다.', aprViewId));",
                                            "            return;",
                                            "        }",
                                            "",
                                            "        // 부서완료함(97)과 담당자완료함(98)은 완료함(94)과 동일한 기능을 하도록 설정",
                                            "        var commandArr = ['97', '98'];",
                                            "        if(commandArr.includes(command)){",
                                            "            command = '94';",
                                            "        }",
                                            "",
                                            "        // 과거데이터와 호환성을 위한처리 추가",
                                            "        var aprHistId = responseJson.aprHistId,",
                                            "            docData = responseJson.docData;",
                                            "        if (!docData) {",
                                            "            docData = {};",
                                            "            if (responseJson.fieldValues)  docData.fieldValues  = responseJson.fieldValues;",
                                            "            if (responseJson.afterchange)  docData.afterchange  = responseJson.afterchange;",
                                            "            if (responseJson.beforechange) docData.beforechange = responseJson.beforechange;",
                                            "        }",
                                            "",
                                            "        var win = Ext.create(aprViewId, {",
                                            "            command : command,",
                                            "            aprHistId : aprHistId,",
                                            "            docData : docData,",
                                            "            record : vm.get('record'),",
                                            "            onlyGrid : true",
                                            "        });",
                                            "",
                                            "        me.mon(win, 'complete', function(popup) {",
                                            "            popup.close(); //팝업창닫기",
                                            "            me.onSelect();",
                                            "        }, me);",
                                            "",
                                            "        win.show();",
                                            "    }",
                                            "});",
                                            "",
                                            "",
                                            "",
                                            "",
                                            "// var me = this,",
                                            "//     vm = me.getViewModel(),",
                                            "//     popupData = vm.get('popupData'),",
                                            "//     win = Ext.create('ExpNteDoc51M', {",
                                            "//         popupData : popupData",
                                            "//     });",
                                            "",
                                            "// me.mon(win, 'complete', function() {",
                                            "//     var me = this;",
                                            "// }, me);",
                                            "",
                                            "// win.show();",
                                            ""
                                        ],
                                        "name": "tap",
                                        "scope": "me"
                                    },
                                    "configAlternates": {
                                        "fn": "string",
                                        "implHandler": "code",
                                        "name": "string",
                                        "scope": "string",
                                        "designer|commentHeader": "comment"
                                    },
                                    "name": "onAplyInfo",
                                    "designerId": "d220ca94-8cc4-44ac-ad28-ce286a940ebc"
                                }
                            ]
                        }
                    ]
