        {
            "type": "viewcontrollereventbinding",
            "reference": {
                "name": "listeners",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "fn": "Initialize",
                "implHandler": [
                    "return false; // 사용안하는 화면 (71로 대체함)",
                    "",
                    "var me = this;",
                    "var vm = me.getViewModel();",
                    "var refs = me.getReferences();",
                    "var items = component.datas;",
                    "var apvlAmtDomTotal = 0;",
                    "",
                    "items = this.recoveryFormRender(items);",
                    "",
                    "for(var i in items){",
                    "    items[i].isAply = true; // 결재 화면으로 사용하는 Items에서는 readOnly 처리하기 위해 사용하는 플래그",
                    "    items[i].rgdt = items[i].aplDt; // 신청일자",
                    "    items[i].hrHromJasPrjText = items[i].prjNm; // 사용부문 text",
                    "}",
                    "",
                    "/* 단건만 오기 때문에 0으로 고정 */",
                    "var aplDt = items[0].aplDt;",
                    "aplDt = aplDt.substr(0, 4) + '-' + aplDt.substr(4, 2) + '-' + aplDt.substr(6, 2);",
                    "",
                    "var stlmDvcdCode = items[0].stlmDvcd,",
                    "    stlmDvcd = (stlmDvcdCode === '01') ? '법인카드' : '기타영수증';",
                    "refs.item_container.getViewModel().set('stlmDvcd', stlmDvcd);",
                    "",
                    "if(stlmDvcdCode === '01'){ // 법인카드인 경우 영수증 버튼 hidden",
                    "    refs.btnReceipt.setHidden(true);",
                    "} else {// 기타영수증인 경우",
                    "    refs.item_container.getViewModel().set('etcRcpt', true);",
                    "}",
                    "",
                    "refs.item_container.getViewModel().set('record.rgdt', aplDt); // 상신일 전달을 위한 vm // 현황 화면 외 다른화면과의 호환성을 가지기 위함",
                    "refs.item_container.getViewModel().set('records', items);",
                    "refs.item_container.getViewModel().set('doc', true);",
                    "",
                    "for(var i in items){",
                    "    apvlAmtDomTotal += Number(items[i].apvlAmtDom);",
                    "}",
                    "var str = String(apvlAmtDomTotal);",
                    "apvlAmtDomTotal = str.replace(/(\\d)(?=(?:\\d{3})+(?!\\d))/g, '$1,');",
                    "",
                    "vm.set('cardCnt', items.length);",
                    "vm.set('apvlAmtDomTotal', apvlAmtDomTotal);",
                    "vm.set('popupData', items);",
                    "",
                    "refs.item_container.controller.addForm();",
                    "",
                    "var edocCd = (stlmDvcdCode === '01') ? 'ExpNteAply71' : 'ExpNteRcpt71';",
                    "// 결재문서 초기화 설정",
                    "ApprovalBoxSvc.setup({",
                    "    command   : '01',",
                    "    viewModel : vm,",
                    "    edocCd    : edocCd,",
                    "    scope     : me",
                    "});",
                    "",
                    ""
                ],
                "name": "initialize",
                "scope": "me"
            },
            "configAlternates": {
                "fn": "string",
                "implHandler": "code",
                "name": "string",
                "scope": "string"
            },
            "name": "Initialize",
            "designerId": "2901e102-19c2-474b-853b-27362e42c75f"
        }
    ]
}