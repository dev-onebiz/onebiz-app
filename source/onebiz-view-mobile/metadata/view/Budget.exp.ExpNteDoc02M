                                        ],
                                        "fn": "onOpenReceipt",
                                        "implHandler": [
                                            "var me = this,",
                                            "    vm = me.getViewModel(),",
                                            "    popupData = vm.get('popupData'),",
                                            "    win = Ext.create('ExpNteDoc52M', {",
                                            "        popupData : popupData",
                                            "    });",
                                            "",
                                            "me.mon(win, 'complete', function() {",
                                            "    var me = this;",
                                            "}, me);",
