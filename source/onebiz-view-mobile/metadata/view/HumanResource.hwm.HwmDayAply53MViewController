                "fn": "getGPS",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    params = {",
                    "        scope : me",
                    "    };",
                    "",
                    "// 이미 위치조회 실행 중일 경우, 중복 실행 차단",
                    "if(vm.get('data.isSearching')){",
                    "    return;",
                    "}",
                    "",
                    "vm.set('gps', null);",
                    "vm.set('data.isSearching', true);",
                    "",
                    "var successcb = function(pos) {",
                    "    try{",
                    "",
                    "        var gps = pos.coords;",
                    "",
                    "        var latitude = gps.latitude,\t// 위도",
                    "            longitude = gps.longitude;\t// 경도",
                    "",
                    "        var eachDist = ''; // 문구",
                    "",
                    "        if(gps && latitude && longitude) {",
                    "",
                    "            vm.set('gps', gps);",
                    "",
                    "            // 근무지와 현재위치의 거리 계산",
                    "            var workZoneGps = vm.get('workZoneGps');",
                    "            for(var i in workZoneGps){",
                    "                var location = workZoneGps[i].wkplcNm;",
                    "                eachDist += me.measureDistance(gps, Number(workZoneGps[i].gpsLatdVal), Number(workZoneGps[i].gpsLotdVal), location);",
                    "                eachDist += '<br>';",
                    "            }",
                    "",
                    "            clearInterval(vm.get('timerId'));",
                    "            vm.set('timerId', null);",
                    "            vm.set('data.isSearching', false);",
                    "            refs.nowLocation.setHtml(eachDist);",
                    "",
                    "            // 지도에 마크",
                    "            Native.addMapMarker('googleMapPanel', '현재위치', gps.latitude, gps.longitude);",
                    "        }",
                    "        else {",
                    "            eachDist = 'GPS 위도/경도 조회 실패.';",
                    "",
                    "            clearInterval(vm.get('timerId'));",
                    "            vm.set('timerId', null);",
                    "            vm.set('data.isSearching', false);",
                    "            refs.nowLocation.setHtml(eachDist);",
                    "        }",
                    "",
                    "    } catch(e){",
                    "        console.log('Success the getGPS method. But can\\'t execute inner process. => '+ e);",
                    "    }",
                    "",
                    "};",
                    "",
                    "var errorcb = function(pos) {",
                    "",
                    "    //화면이 닫혔을 경우 대비 try~catch",
                    "    try{",
                    "        clearInterval(vm.get('timerId'));",
                    "        vm.set('timerId', null);",
                    "        vm.set('data.isSearching', false);",
                    "        refs.nowLocation.setHtml('not found position : ' + pos.code + ' - ' + me.getErrMsg(pos.code));",
                    "    } catch(e){",
                    "        console.log('Fail the getGPS method. And can\\'t execute inner process. => '+ e);",
                    "    }",
                    "",
                    "    // 로컬일 경우, 테스트 위치 정보",
                    "    try{",
                    "        // TODO : DELETE // 로컬 Test 전용 좌표",
                    "        if(Property.PROFILE === 'L'){",
                    "",
                    "            var gps = {",
                    "                latitude : 35.1372056,",
                    "                longitude : 128.8577588, // 미음",
                    "                //                 latitude : 35.169393,",
                    "                //                 longitude : 129.176318 // 장산",
                    "            };",
                    "",
                    "            var latitude = gps.latitude;   //위도",
                    "            var longitude = gps.longitude; //경도",
                    "",
                    "            var eachDist = 'Local<br>';",
                    "",
                    "            if(gps && latitude && longitude){",
                    "                var workZoneGps = vm.get('workZoneGps');",
                    "                for(var i in workZoneGps){",
                    "                    var location = workZoneGps[i].wkplcNm + '(' + workZoneGps[i].wkplcDvnm + ')';",
                    "                    eachDist += me.measureDistance(gps, Number(workZoneGps[i].gpsLatdVal), Number(workZoneGps[i].gpsLotdVal), location);",
                    "                    eachDist += '<br>';",
                    "                }",
                    "                refs.nowLocation.setHtml(eachDist);",
                    "            }",
                    "        }",
                    "        // TODO : DELETE",
                    "    } catch(e){",
                    "        console.log('Can\\'t read local coordinate. => '+ e);",
                    "    }",
                    "",
                    "};",
                    "",
                    "var opts = {",
                    "    enableHighAccuracy : false, //정확성 향상 모드",
                    "    timeout : 10 * 1000 //10초",
                    "};",
                    "",
                    "vm.set('loadingCnt', 10);",
                    "",
                    "var timerId = setInterval(function(){",
                    "    if(vm.get('loadingCnt') > 0){",
                    "        vm.set('loadingCnt', vm.get('loadingCnt') - 1);",
                    "    }",
                    "",
                    "    refs.nowLocation.setHtml('위치정보 로딩 중...' + vm.get('loadingCnt'));",
                    "    ",
                    "}, 1000);",
                    "",
                    "vm.set('timerId', timerId);",
                    "",
