                        "cell": "object"
                    },
                    "name": "MyColumn7",
                    "designerId": "880a702f-1569-4010-bca7-84050a70b698",
                    "customConfigs": [
                        {
                            "group": "(Custom Properties)",
                            "name": "flex",
                            "type": "string"
                        }
                    ],
                    "cn": [
                        {
                            "type": "fixedfunction",
                            "reference": {
                                "name": "items",
                                "type": "array"
                            },
                            "codeClass": null,
                            "userConfig": {
                                "designer|params": [
                                    "value",
                                    "record",
                                    "dataIndex",
                                    "cell",
                                    "column"
                                ],
                                "fn": "renderer",
                                "implHandler": [
                                    "var value1 = CodeUtils.getText('INB030', value);",
                                    "var value2 = record.data.apvlAmtDom;",
                                    "var str = String(value2);",
                                    "value2 = str.replace(/(\\d)(?=(?:\\d{3})+(?!\\d))/g, '$1,');",
                                    "value2 += ' 원';",
                                    "var color = 'black';",
                                    "if(value == '11')",
                                    "    {",
                                    "        color = 'blue';",
                                    "    }",
                                    "else if(value == '20' || value == '21' || value == '22')",
                                    "    {",
                                    "        color = 'red';",
                                    "    }",
                                    "",
                                    "var view = this.up('grid'),",
                                    "    tpl = view.lookupTpl('signTpl3');",
                                    "",
                                    "var result = tpl.apply({",
                                    "    color : color,",
                                    "    value1: value1,",
                                    "    value2 : value2",
                                    "});",
                                    "",
                                    "return result;"
                                ]
                            },
                            "configAlternates": {
                                "designer|params": "typedarray",
                                "fn": "string",
                                "implHandler": "code"
                            },
                            "name": "renderer",
                            "designerId": "b58bfc2f-a9fe-42c5-983f-0b63aa6938ba"
                        }
                    ]
