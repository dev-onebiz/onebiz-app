                    "cn": [
                        {
                            "type": "fixedfunction",
                            "reference": {
                                "name": "items",
                                "type": "array"
                            },
                            "codeClass": null,
                            "userConfig": {
                                "designer|params": [
                                    "value",
                                    "record",
                                    "dataIndex",
                                    "cell",
                                    "column"
                                ],
                                "fn": "renderer",
                                "implHandler": [
                                    "                        var value1 = record.data.mcNm;",
                                    "                        var value2 = DateUtils.parseDate(value);",
                                    "                        var text = 'bold';",
                                    "                        var grid = this.up('grid'),",
                                    "                            tpl = grid.lookupTpl('signTpl2');",
                                    "",
                                    "                        var result = tpl.apply({",
                                    "                            value1 : value1,",
                                    "                            value2 : value2",
                                    "                        });",
                                    "",
                                    "                        return result;"
                                ]
