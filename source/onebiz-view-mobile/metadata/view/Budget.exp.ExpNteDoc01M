                            "//     success : function(response) {",
                            "//         var me = this,",
                            "//             refs = me.getReferences(),",
                            "//             vm = me.getViewModel(),",
                            "//             responseJson = Ext.JSON.decode(response.responseText),",
                            "//             records = responseJson.result;",
                            "",
                            "//         if (records && records.length > 0) {",
                            "//             var msg = '';",
                            "//             for(var i=0;i<records.length;i++)",
                            "//             {",
                            "//                 msg += records[i].mcNm + ',';",
                            "//             }",
                            "//             console.log(msg);",
                            "//             Ext.Msg.alert('알림', msg);",
                            "//         }",
                            "//     }",
                            "// });",
                            "",
                            ""
                        ],
                        "name": "select"
                    },
                    "configAlternates": {
                        "fn": "string",
                        "name": "string",
                        "implHandler": "code"
                    },
                    "name": "onMygrid1Select",
                    "designerId": "70dcafae-c68c-4698-b018-a3eab2c4a2c2"
                },
                {
                    "type": "viewcontrollereventbinding",
                    "reference": {
                        "name": "listeners",
                        "type": "array"
                    },
                    "codeClass": null,
                    "userConfig": {
                        "designer|commentHeader": [
                            "Cell Click Event"
                        ],
                        "fn": "onRowSelect",
                        "implHandler": [
                            "var me = this,",
                            "    vm = me.getViewModel(),",
                            "    refs = me.getReferences(),",
                            "    grid = refs.grid,",
                            "    selectedRecords = [];",
                            "",
                            "for(var i in selected){",
                            "    selectedRecords[i] = selected[i].data;",
                            "}",
                            "",
                            "// if(selectedRecords.length > 1){",
                            "//     Ext.Msg.alert('다건 불가');",
                            "//     return false;",
                            "// }",
                            "",
                            "// debugger // selectedRecords",
                            "",
                            "// var naviView = me.getView().up('navigationview');",
                            "",
                            "// me.PUSH_VIEW(naviView, {",
                            "//     menuId  : 'ExpNteDoc02M', /* 지출결의서 현황 상세 */",
                            "//     title   : '지출결의서 현황 상세보기',",
                            "//     datas : selectedRecords,",
                            "// });",
                            "",
                            "",
                            "",
                            "/////////////////////////////////////////////////////////////////////////////////////////////",
                            "/////////////////////////////////////////////////////////////////////////////////////////////",
                            "/////////////////////////////////////////////////////////////////////////////////////////////",
                            "",
                            "",
                            "",
                            "var me = this,",
                            "    vm = me.getViewModel(),",
                            "    record = selectedRecords[0];",
                            "",
                            "// 선택한 결재선 레코드. 동시성제어에 사용",
                            "vm.set('record', record);",
                            "",
                            "// 결재이력데이터조회",
                            "Ext.Ajax.request({",
                            "    headers : {",
                            "        serviceId : 'COMAPR0001R04M',",
                            "        viewId : 'ExpNteApr02M'",
                            "    },",
                            "    scope : me,",
                            "    jsonData : {",
                            "        aprHistId : record.id // 결재이력아이디",
                            "    },",
                            "    success : function(response) {",
                            "        var me = this,",
                            "            refs = me.getReferences(),",
                            "            vm = me.getViewModel(),",
                            "            command = vm.get('command'),",
                            "            responseJson = Ext.JSON.decode(Ext.JSON.decode(response.responseText).result);",
                            "",
                            "        if (!responseJson) {",
                            "            Ext.Msg.alert('안내', '결재이력데이터가 존재하지 않습니다.');",
                            "            return;",
                            "        }",
                            "",
                            "        vm.set('responseJson', responseJson);",
                            "        ",
                            "        // TODO: 지출결의서 취소신청서 (ExpNteDoc71)은 ExpNteAply71 화면을 호출하도록 함.",
                            "        var edocCd = responseJson.edocCd == 'ExpNteDoc71' ? 'ExpNteAply71' : responseJson.edocCd;",
                            "        var aprViewId = edocCd + 'M',\t// 모바일일경우, 화면이름에 M을 붙여처리함",
                            "            classname = me.GET_CLASS_NAME(aprViewId);",
                            "        if (!classname) {",
                            "            Ext.Msg.alert('안내', Ext.String.format('{0}에 해당하는 파일이 존재하지 않습니다.', aprViewId));",
                            "            return;",
                            "        }",
                            "",
                            "        // 부서완료함(97)과 담당자완료함(98)은 완료함(94)과 동일한 기능을 하도록 설정",
                            "        var commandArr = ['97', '98'];",
                            "        if(commandArr.includes(command)){",
                            "            command = '94';",
                            "        }",
                            "",
                            "        // 과거데이터와 호환성을 위한처리 추가",
                            "        var aprHistId = responseJson.aprHistId,",
                            "            docData = responseJson.docData;",
                            "        if (!docData) {",
                            "            docData = {};",
                            "            if (responseJson.fieldValues)  docData.fieldValues  = responseJson.fieldValues;",
                            "            if (responseJson.afterchange)  docData.afterchange  = responseJson.afterchange;",
                            "            if (responseJson.beforechange) docData.beforechange = responseJson.beforechange;",
                            "        }",
                            "        if (!aprHistId) {",
                            "            aprHistId = vm.get('record').id;",
                            "        }",
                            "        // end of 과거데이터와 호환성을 위한처리 추가",
                            "",
                            "",
                            "        command = 94; // 결재선 그리드를 표현하기 위해 필요한 command, 완료함(94) 기준으로 보이도록 함",
                            "        var win = Ext.create(aprViewId, {",
                            "            command : command,",
                            "            aprHistId : aprHistId,",
                            "            docData : docData,",
                            "            record : vm.get('record'),",
                            "            fromDoc : true",
                            "        });",
                            "",
                            "        me.mon(win, 'complete', function(popup) {",
                            "            popup.close(); //팝업창닫기",
                            "            me.onSelect();",
                            "        }, me);",
                            "",
                            "        win.show();",
                            "    }",
                            "});",
                            "",
                            "",
                            "",
                            ""
                        ],
                        "name": "select",
                        "scope": "me"
                    },
                    "configAlternates": {
                        "fn": "string",
                        "implHandler": "code",
                        "name": "string",
                        "scope": "string",
                        "designer|commentHeader": "comment"
                    },
                    "name": "onRowSelect",
                    "designerId": "501e2f61-2ccf-49f8-81fa-f4eec7c6a7db"
                }
            ]
        },
        {
            "type": "viewcontrollereventbinding",
            "reference": {
                "name": "listeners",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "화면초기화"
                ],
                "fn": "initialize",
                "implHandler": [
                    "var me = this;",
                    "var refs = me.getReferences();",
                    "var grid = refs.grid;",
                    "var cbxAplSt = refs.cbxAplSt;",
                    "",
                    "grid.el.select('.x-headercontainer').setStyle('height',\t'0px');",
                    "cbxAplSt.setValue('진행');",
                    "",
                    "var params = {",
                    "    aplStcd:'10'",
                    "};",
                    "me.search(params);",
                    ""
                ],
                "name": "initialize",
                "scope": "me"
            },
            "configAlternates": {
