                    "userConfig": {
                        "fn": "onMygrid1Select",
                        "implHandler": [
                            "// var me = this,",
                            "//     grid = this.lookup('grid'),",
                            "//     records = grid.getSelections();",
                            "// var params = {bgExpmNteApfId:records[0].data.bgExpmNteApfId};",
                            "",
                            "// Ext.Ajax.request({",
                            "//     headers : {",
