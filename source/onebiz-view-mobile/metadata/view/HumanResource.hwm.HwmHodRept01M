                                "implHandler": [
                                    "var result =\"\",",
                                    "    isRept = record.data.hrWrkmHodReptId,",
                                    "    aplDvcd = (isRept) ? record.data.reptAplDvcd : record.data.apfAplDvcd;",
                                    "// 신청일시",
                                    "var dtDataTemp = (isRept && aplDvcd == Constants.aplDvcd.APPLY) ? record.data.reptAplDtm.replace(/-/g,\"\") : record.data.apfAplDtm.replace(/-/g,\"\"),",
                                    "    dateYyMMdd = dtDataTemp.substr(0,4) + '-' + dtDataTemp.substr(4,2) + '-' + dtDataTemp.substr(6,2);",
                                    "var str = String(result);",
                                    "result = str.replace(/(\\d)(?=(?:\\d{3})+(?!\\d))/g, '$1,');",
                                    "result = '<div style=\"font-size:15px;font-weight:bold\">'+dateYyMMdd+'</div>';",
                                    "",
                                    "// 신청상태",
                                    "var aplStcdNm = CodeUtils.getText('INB031', ((isRept && aplDvcd == Constants.aplDvcd.APPLY) ? record.data.reptAplStcd : record.data.apfAplStcd)); //코드값 -> 코드명",
