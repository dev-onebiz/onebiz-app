                                ],
                                "fn": "renderer",
                                "implHandler": [
                                    "// 일자",
                                    "var dtDataTemp = record.data.aplHodDt.replace(/-/g,\"\"),",
                                    "    dateMMdd = dtDataTemp.substr(4,2) + '월 ' +dtDataTemp.substr(6,2) + '일',",
                                    "    dateYyMMdd =dtDataTemp.substr(0,4) + '-' + dtDataTemp.substr(4,2) + '-' +dtDataTemp.substr(6,2);",
                                    "// 신청구분",
                                    "var isRept = (record.data.comAprHistReptId && record.data.comAprHistReptId != -1) ? true : false;",
                                    "var aplDvcd = (isRept) ? record.data.reptAplDvcd : record.data.apfAplDvcd;",
                                    "var aplDvcdNm = (aplDvcd == Constants.aplDvcd.CANCEL) ? '<font color=\"red\">' : '';",
                                    "aplDvcdNm += (isRept) ? '보고' : '';",
                                    "aplDvcdNm += CodeUtils.getText('HWM009', aplDvcd);",
                                    "aplDvcdNm += (aplDvcd == Constants.aplDvcd.CANCEL) ? '</font>' : '';",
                                    "var result = '<div><span style=\"font-size:15px;font-weight:bold;width:100%;overflow: hidden;white-space:nowrap;text-overflow:ellipsis;display:inline-block;\">'+dateMMdd+' 휴일근무 '+aplDvcdNm+'</span></div>';",
                                    "// 시간",
                                    "var AplHodStrdt = record.data.aplHodStrdt.substr(0,4) + '-' + record.data.aplHodStrdt.substr(4,2) + '-' + record.data.aplHodStrdt.substr(6,2);",
                                    "var AplHodEdt = record.data.aplHodEdt.substr(0,4) + '-' + record.data.aplHodEdt.substr(4,2) + '-' + record.data.aplHodEdt.substr(6,2);",
                                    "var AplHodStrtm = record.data.aplHodStrtm.substr(0,2) + ':' + record.data.aplHodStrtm.substr(2,2);",
                                    "var AplHodEdtm = record.data.aplHodEdtm.substr(0,2) + ':' + record.data.aplHodEdtm.substr(2,2);",
                                    "",
                                    "",
                                    "if(AplHodStrdt != AplHodEdt){",
                                    "    result += '<div style=\"font-size : 10px\">'+AplHodStrdt+' '+AplHodStrtm+' ~ '+AplHodEdt + ' '+AplHodEdtm+'</div>';",
                                    "}else{",
                                    "    result += '<div>'+AplHodStrdt+' | '+AplHodStrtm+'~'+AplHodEdtm+'</div>';",
                                    "}",
                                    "",
                                    "cell.setStyle('padding:0px;');",
                                    "return result;"
                                ]
                            },
