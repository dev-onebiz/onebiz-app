            "userConfig": {
                "fn": "onSelect",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    store = me.getStore('ApprovalBoxStore'),",
                    "    refs = me.getReferences(),",
                    "    command = vm.get('command'),",
                    "    dpDvcdNm = null,",
                    "    selectCnt = vm.get('selectCnt'),",
                    "    tglSanMode = refs.tglSanMode;\t// 일괄결재 모드 토글",
                    "",
                    "// 부서완료함일 경우 부서구분명을 추가한다.",
                    "if(command == '97'){",
                    "    dpDvcdNm = '부서';",
                    "}",
                    "",
                    "// 검색조건 설정후 1페이지부터 조회",
                    "store.getProxy().extraParams = {",
                    "    command \t: command,",
                    "    searchYear \t: vm.get('searchYear'),",
                    "    vwId    \t: vm.get('vwId'),",
                    "    rqprId  \t: vm.get('rqprId'),",
                    "    docNo   \t: vm.get('docNo'),",
                    "    dpDvcdNm\t: dpDvcdNm",
                    "};",
                    "store.removeAll();",
                    "store.loadPage(1);",
                    "",
                    "// (일괄결재)선택된 문서 개수 초기화",
                    "vm.set('selectCnt', 0);",
                    "",
                    "// 미결함, 담당부서함인 경우 일괄결재 모드 툴바 활성화",
                    "if(command == Constants.sanction.PENDING_BOX || command == Constants.sanction.RECEIPT_BOX){",
                    "    tglSanMode.setHidden(false);",
                    "}",
                    "",
                    "// 문서 제목 최대길이 동적 설정",
                    "me.setTitleWidth();"
                ]
            },
            "configAlternates": {
                "fn": "string",
                "implHandler": "code"
            },
