            "userConfig": {
                "designer|commentHeader": [
                    "해상도에 맞게 툴바 문서 제목 최대길이 변경하기"
                ],
                "fn": "setTitleWidth",
                "implHandler": [
                    "var me = this,",
                    "    refs = me.getReferences(),",
                    "    tbrLbExpTitle = refs.tbrLbExpTitle;",
                    "",
                    "// 현재 화면의 해상도 가져오기",
                    "var viewSize = Ext.getBody().getViewSize();",
                    "var width = viewSize.width;",
                    "var rWidth = 0;",
                    "",
                    "if(width != undefined && width > 0){",
                    "    rWidth = width - 120;",
                    "}",
                    "",
                    "var style = \"max-width:\" + rWidth + \"px;\";",
                    "",
                    "// 제목 스타일 설정",
                    "tbrLbExpTitle.setStyle(style);"
                ]
            },
            "configAlternates": {
                "designer|commentHeader": "comment",
