            "codeClass": null,
            "userConfig": {
                "fn": "onSave",
                "implHandler": [
                    "var me = this;",
                    "var refs = me.getReferences();",
                    "var vm = me.getViewModel();",
                    "",
                    "var principal = SecurityUtils.getPrincipal();",
                    "",
                    "var changeQstNo      = [];",
                    "var changeAnswer     = [];",
                    "var changeAnswerText = [];",
                    "",
                    "for(var i in vm.get('hiddenContainer')){",
                    "    changeQstNo.push(vm.get('initContent')[i].qstNo);",
                    "    // 객관식 답",
                    "    if(vm.get('hiddenContainer')[i] === false){",
                    "        changeAnswer.push(vm.get('newValue')[i]);",
                    "    }",
                    "    else{",
                    "        changeAnswer.push(null);",
                    "    }",
                    "    // 주관식 답",
                    "    if(vm.get('hiddenContainer')[i] === false){",
                    "        changeAnswerText.push(vm.get('newTextValue')[i]);",
                    "    }",
                    "    else{",
                    "        changeAnswerText.push(null);",
                    "    }",
                    "}",
                    "",
                    "var param = {",
                    "    qstNo              : changeQstNo,",
                    "    answer             : changeAnswer,",
                    "    answerText         : changeAnswerText,",
                    "    selectInsertUpdate : '03',",
                    "    isCkl              : true,",
                    "    chk_stat           : '1',",
                    "    answerYn           : 'Y',",
                    "    userId             : principal.userId,",
                    "    type               : vm.get('type'),",
                    "    chkNo              : vm.get('chkNo'),",
                    "    confirmYn          : 'Y'",
                    "};",
                    "",
                    "Ext.Ajax.request({",
                    "    headers: {",
                    "        viewId : me.getViewId(),",
                    "        serviceId : 'BomCplSvc.saveAllSelfIspeCht'",
                    "    },",
                    "    jsonData : param,",
                    "    scope : me,",
                    "    success : function(response) {",
                    "",
                    "        //         Ext.Msg.alert('알림','정상적으로 제출되었습니다.');",
                    "",
                    "        me.getView().up().down('BomCmplHomeM').controller.onSelectSicCkl();",
                    "",
                    "        // 법규준수 홈으로",
                    "        vm.getView().up().pop();",
                    "    }",
                    "});"
                ]
            },
            "configAlternates": {
                "fn": "string",
                "implHandler": "code"
            },
            "name": "onSave",
            "designerId": "8f8332eb-ed54-4cdf-8dad-9759c5783e9a"
        }
