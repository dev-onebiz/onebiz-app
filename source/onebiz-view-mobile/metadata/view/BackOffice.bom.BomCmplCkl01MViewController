                "fn": "setTextSubmitButton",
                "implHandler": [
                    "var me = this;",
                    "var refs = me.getReferences();",
                    "var vm = me.getViewModel();",
                    "",
                    "vm.set('qstNum',0);",
                    "vm.set('ansNum',0);",
                    "",
                    "for( var i in hiddenContainer ){",
                    "    // 숨겨져 있으면 포함 안함",
                    "    if(hiddenContainer[i] === false){",
                    "        vm.set('qstNum',vm.get('qstNum') + 1);",
                    "        if(newValue[i] !== null){",
                    "            vm.set('ansNum',vm.get('ansNum') + 1);",
                    "        }",
                    "    }",
                    "}",
                    "",
                    "refs.btnSubmit.setText(vm.get('submitText') + ' ( ' + vm.get('ansNum') + ' / ' + vm.get('qstNum') + ' )');",
