                "fn": "initApplication",
                "implHandler": [
                    "var D = new Ext.Deferred();",
                    "",
                    "var me = this,",
                    "    principal = SecurityUtils.getPrincipal(), // 사용자정보",
                    "    jwtToken = WebUtils.getCookie(Property.JWT_TOKEN_NAME) || sessionStorage.getItem(Property.JWT_TOKEN_NAME),",
                    "    csrfToken = WebUtils.getCookie(Property.XSRF_TOKEN_NAME) || sessionStorage.getItem(Property.XSRF_TOKEN_NAME),",
                    "    url = Property.API_URL;",
                    "",
                    "if ('F' === Property.PROFILE) {",
                    "    url = './testdata/COMAPP0002R03.json';",
                    "}",
                    "",
                    "// TODO 자동로그인 처리할 것!",
                    "Ext.Ajax.request({",
                    "    headers: {",
                    "        viewId: me.getViewId(),",
                    "        serviceId: 'COMAPP0002R03M',",
                    "        'X-Requested-With' : 'XMLHttpRequest',",
                    "        'Authorization'    : 'Bearer ' + jwtToken,",
                    "        'X-XSRF-TOKEN'     : csrfToken,",
                    "        'cmgrpCd'          : Property.CMGRP_CD,",
                    "        'sysCd'            : Property.SYS_CD,",
                    "        'profile'          : Property.PROFILE,",
                    "        'device'           : Property.DEVICE,",
                    "        'protocol'         : Property.PROTOCOL,",
                    "        'dataType'         : Property.DATA_TYPE,",
                    "        'cmgrpId'          : principal && principal.hasOwnProperty('comCmmCmgrpId') ? principal.comCmmCmgrpId : null,",
                    "        'sysId'            : principal && principal.hasOwnProperty('comCmmSystemId') ? principal.comCmmSystemId : null",
                    "    },",
                    "    url : url,",
                    "    method : 'POST',",
                    "    scope : me,",
                    "    success : function(res) {",
                    "        var me = this,",
                    "            result = Ext.JSON.decode(res.responseText);",
                    "",
                    "        if (Property.IS_DEBUG) console.log('로그인결과: ', result);",
                    "",
                    "        // 파일처리인경우, 쿠키를 저장하는 처리 추가함",
                    "        if ('F' === Property.PROFILE) {",
                    "            if (result.hasOwnProperty(Property.JWT_TOKEN_NAME)) {",
                    "                WebUtils.setCookie(Property.JWT_TOKEN_NAME, result[Property.JWT_TOKEN_NAME]);",
                    "            }",
                    "        }",
                    "",
                    "        // 어플리케이션 데이터 초기화",
                    "        me.INIT_APPLICATION_DATA(result);",
                    "",
                    "        D.resolve(true);",
                    "    },",
                    "    failure : function(response, opts) {",
                    "",
                    "        if (response.status === 0) {",
                    "            Ext.Msg.alert(Property.SYSTEM_NAME, '서버와 연결이 원활하지 않습니다.<br />인터넷 연결 상태를 확인하고 다시 시도해주시길 바랍니다.');",
                    "        }",
                    "",
                    "        var me = this,",
                    "            refs = me.getReferences(),",
                    "//             loadingView = refs.loadingView,",
                    "//             loginForm = refs.loginForm;",
                    "            loadingView = refs.intro,",
                    "            loginForm = refs.loginForm;",
                    "",
                    "        loadingView.setHidden(true);",
                    "        loginForm.setHidden(false);",
                    "",
                    "        D.reject(false);",
                    "    }",
                    "});",
                    "",
                    "return D.promise;"
                ]
            },
