                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "비밀번호 난독화",
                    "@param obj - 객체",
                    "       newValue - 신규 입력값",
                    "       oldValue - 기존 입력값",
                    "       vmPwList - 비밀번호 저장 리스트"
                ],
                "designer|params": [
                    "obj, newValue, oldValue, vmPwList"
                ],
                "fn": "fnPasswordFieldChange",
                "implHandler": [
                    "// arr.splice(index, 0, value);    -> push",
                    "// arr.splice(index, count);       -> pop",
                    "",
                    "// String.fromCharCode(33);\t\t   -> 아스키코드 => 문자",
                    "// '!'.charCodeAt();\t\t\t   ->      문자 => 아스키코드",
                    "",
                    "// '!'.charCodeAt().toString(2);   -> 코드 : 10진수 -> 2진수",
                    "",
                    "var me = this;",
                    "var vm = me.getViewModel();",
                    "",
                    "//빈 값일 경우, 비밀번호 리스트를 초기화해줌",
                    "if(Ext.isEmpty(newValue)){",
                    "    vmPwList.splice(0, vmPwList.length);",
                    "    return;",
                    "}",
                    "",
                    "var pwKey = vm.get('pwKey'); //난독화 키(2진수)",
                    "",
                    "var input = Ext.Array.toArray(newValue);",
                    "var tmp = null;",
                    "for(var i in input){",
                    "    tmp = input[i];",
                    "    if(!(input[i].charCodeAt() & 0x80)){ //암호화 되지 않은 데이터",
                    "        input[i] = String.fromCharCode(tmp.charCodeAt() ^ pwKey);",
                    "    }",
                    "}",
                    "",
                    "var changeString = '';",
                    "for(var i in input){",
                    "    changeString += input[i];",
                    "}",
                    "",
                    "//변환값으로 obj value를 세팅해 줌 - event suspend 함",
                    "obj.suspendEvent('change');",
                    "obj.setValue(changeString);",
                    "obj.resumeEvent('change');"
                ]
            },
