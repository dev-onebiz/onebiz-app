        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "뷰 초기화"
                ],
                "fn": "initView",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    approvalLineGrid = refs.approvalLineGrid;",
                    "",
                    "var docData = vm.get('docData'),",
                    "    gridScheduleInfoItems = vm.get('gridScheduleInfoItems'),",
                    "    applyItemList = vm.get('applyItemList'),",
                    "    hrWrkmBtrApfId = vm.get('hrWrkmBtrApfId'),",
                    "    afterchange = vm.get('afterchange'),",
                    "    aprHistId = vm.get('aprHistId'),",
                    "    record = vm.get('record'),",
                    "    command = vm.get('command'),",
                    "    aplDvcdLbl = CodeUtils.getText('HWM009', afterchange.aplDvcd),  // 신청구분",
                    "    btrDvcdLbl = CodeUtils.getText('HWM016', afterchange.btrDvcd),  // 출장구분",
                    "    btrPeriod = Number(afterchange.btrPeriod),\t\t\t\t\t\t// 출장일수",
                    "    atchFileId = vm.get('atchFileId'),\t\t\t\t\t\t\t\t// 첨부파일 ID",
                    "    atchFileNm = vm.get('atchFileNm'),\t\t\t\t\t\t\t\t// 첨부파일명",
                    "    atchFileParentId = vm.get('atchFileParentId'),",
                    "    totalAmt = 0,\t\t\t\t\t\t\t\t\t\t\t\t\t// 총 금액",
                    "    viewOption = record.viewOption;\t\t\t\t\t\t\t\t\t// 출장보고서에서 넘어온 경우 닫기 버튼만 생성하기 위함",
                    "",
                    "// 뷰 초기화",
                    "refs.rgdt.setHtml(record.rgdt);",
                    "refs.headTitle.setHtml(record.docNm);",
                    "refs.aplDvcdLbl.setValue(aplDvcdLbl);",
                    "refs.btrDvcdLbl.setValue(btrDvcdLbl);",
                    "refs.btrPeriod.setValue(btrPeriod + '일');",
                    "refs.atchFileId.setValue(atchFileId);",
                    "refs.atchFileNm.setValue(atchFileNm);",
                    "refs.atchFileParentId.setValue(atchFileParentId);",
                    "",
                    "// 첨부파일 유무에 따라 disabled 처리",
                    "if(!atchFileId){",
                    "    refs.btnDown.setDisabled(true);",
                    "}",
                    "// 첨부파일 유무에 따라 파일명 처리",
                    "if(!atchFileNm){",
                    "    refs.atchFileNm.setValue(\"첨부파일 없음\");",
                    "}else{",
                    "    refs.atchFileNm.setValue(atchFileNm);",
                    "}",
                    "",
                    "// 출장기간/장소 그리드 그리기",
                    "var gridScheduleInfoStore = vm.storeInfo.gridScheduleInfoStore;",
                    "refs.gridScheduleInfo.setStore(gridScheduleInfoStore);",
                    "gridScheduleInfoStore.loadData(gridScheduleInfoItems);",
                    "",
                    "// 출장자 제목 정보 추가하기",
                    "var sectionBtrEmps = refs.sectionBtrEmps;",
                    "var applyItemListCnt = 0;",
                    "",
                    "// 출장자 사용금액 정보 뷰 그리기",
                    "for(var i in applyItemList){",
                    "    applyItemListCnt++;",
                    "    var row = applyItemList[i];",
                    "    var rowTotal = 0;",
                    "    for(var j in row){",
                    "        totalAmt += row[j].subtlAmt;",
                    "        rowTotal += row[j].subtlAmt;",
                    "    }",
                    "",
                    "    // 출장자 사용금액 컨테이너뷰 추가하기",
                    "    refs.btrItems.add({",
                    "        xtype : 'HwmBtrAply71MContainer'",
                    "    });",
                    "",
                    "    var btrItemsRefs = refs.btrItems.getItems().items[i].innerItems;",
                    "    var gridApplyItemStore = Ext.create('Ext.data.Store');",
                    "",
                    "    // 출장자 정보",
                    "    btrItemsRefs[0].setHtml('<div style=\"font-weight:bold\">출장자 ' + row[0].hrHrpmEmpId + \"/\" + row[0].empeNm + '</div>');",
                    "    btrItemsRefs[1].setHtml('소계 : ' + me.moneyFormat(rowTotal) + \"원\");",
                    "",
                    "    // 출장자 사용금액 그리드 그리기",
                    "    btrItemsRefs[2].setStore(gridApplyItemStore);",
                    "",
                    "    gridApplyItemStore.removeAll();",
                    "    gridApplyItemStore.loadData(row);",
                    "}",
                    "",
                    "sectionBtrEmps.setHtml('출장자 (총 ' + applyItemListCnt + '명)');",
                    "",
                    "// 출장자 총 합계",
                    "refs.totalAmt.setHtml('총 합계 : ' + me.moneyFormat(totalAmt) + \"원\");"
                ]
            },
