                                    "var AplElvEdt = record.data.aplElvEdt;",
                                    "var AplElvStrtm = record.data.aplElvStrtm;",
                                    "var AplElvEdtm = record.data.aplElvEdtm;",
                                    "",
                                    "",
                                    "",
                                    "if(AplElvStrdt != AplElvEdt){",
                                    "",
                                    "    result += '<div style=\"font-size : 10px\">'+AplElvStrdt+' '+AplElvStrtm+' ~ '+AplElvEdt + ' '+AplElvEdtm+'</div>';",
                                    "}else{",
                                    "    result += '<div>'+AplElvStrdt+' | '+AplElvStrtm+'~'+AplElvEdtm+'</div>';",
                                    "}",
                                    "",
                                    "",
                                    "",
                                    "",
                                    "cell.setStyle('padding:0px;');",
                                    "return result;",
                                    ""
                                ]
                            },
