                    "        viewId : me.getViewId(),",
                    "        serviceId : 'BomCplSvc.findAllSelfIspeCht'",
                    "    },",
                    "    jsonData : param,",
                    "    scope : me,",
                    "    success : function(response) {",
                    "        var res = Ext.JSON.decode(response.responseText);",
                    "        var content = res.page.content;",
                    "        vm.set('initContent',content);",
                    "",
                    "        var oldValue = []; // 기존 답변",
                    "        var oldTextValue = []; // 기존 답변",
