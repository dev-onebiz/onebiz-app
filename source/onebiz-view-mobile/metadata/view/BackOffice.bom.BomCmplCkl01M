                            "codeClass": null,
                            "userConfig": {
                                "fn": "onButtonTapSave",
                                "implHandler": [
                                    "var me = this;",
                                    "var refs = me.getReferences();",
                                    "var vm = me.getViewModel();",
                                    "",
                                    "var principal = SecurityUtils.getPrincipal();",
                                    "",
                                    "// 화면에 보이는 모든 문항에 대답",
                                    "if(vm.get('qstNum') > vm.get('ansNum')){",
                                    "    Ext.Msg.alert('알림','모든 항목을 선택하시오');",
                                    "}",
                                    "else{",
                                    "    var param = {",
                                    "        selectInsertUpdate : '01',",
                                    "        isCkl              : true,",
                                    "        userId             : principal.userId,",
                                    "        chkNo              : vm.get('chkNo'),",
                                    "        type               : vm.get('type'),",
                                    "    };",
                                    "",
                                    "    Ext.Ajax.request({",
                                    "        headers: {",
                                    "            viewId : me.getViewId(),",
                                    "            serviceId : 'BomCplSvc.saveAllSelfIspeCht'",
                                    "        },",
                                    "        jsonData : param,",
                                    "        scope : me,",
                                    "        success : function(response) {",
                                    "            var me = this;",
                                    "            var refs = me.getReferences();",
                                    "            var vm = me.getViewModel();",
                                    "",
                                    "            var res = Ext.JSON.decode(response.responseText);",
                                    "            var content = res.page.content;",
                                    "            vm.set('answerContent',content);",
                                    "",
                                    "            var incorrectAnswer = [];",
                                    "",
                                    "            // 틀린문제 찾기",
                                    "            for(var i in vm.get('hiddenContainer')){",
                                    "                // 보이는 문제에 대해서만 (주문제 부문제 그냥 문제 상관 없이 가능)",
                                    "                if(vm.get('hiddenContainer')[i] === false){",
                                    "                    //주 문제인 경우 // qstAnswer 와 비교",
                                    "                    if(vm.get('initContent')[i].rn2 !== null && vm.get('initContent')[i].rn2 == '0'){",
                                    "                        if(vm.get('newValue')[i] != vm.get('answerContent')[i].qstAnswer){",
                                    "                            incorrectAnswer.push(vm.get('initContent')[i].rn1+'');",
                                    "                        }",
                                    "                    }",
                                    "                    // 주 문제가 아닌 경우 // qstAnswer 와 비교",
                                    "                    else{",
                                    "                        if(vm.get('newValue')[i] != vm.get('answerContent')[i].qstAnswer){",
                                    "                            // 그냥 문제인 경우",
                                    "                            if(vm.get('initContent')[i].rn2 === null){",
                                    "                                incorrectAnswer.push(vm.get('initContent')[i].rn);",
                                    "                            }",
                                    "                            // 부 문제인 경우",
                                    "                            else{",
                                    "                                incorrectAnswer.push(vm.get('initContent')[i].rn1 + '-' + vm.get('initContent')[i].rn2);",
                                    "                            }",
                                    "",
                                    "                        }",
                                    "                    }",
                                    "                }",
                                    "            }",
                                    "",
                                    "            // 주관식 답 변경 내용 vm에 저장",
                                    "            var newTextValue = [];",
                                    "            for(var i in vm.get('newTextValue')){",
                                    "                var textValue = refs.cklContent.items.items[i].items.items[4].items.items[1].getValue();",
                                    "                newTextValue.push(textValue);",
                                    "            }",
                                    "            vm.set('newTextValue',newTextValue);",
                                    "",
                                    "            // 틀린문제 있으면",
                                    "            if(incorrectAnswer.length > 0){",
                                    "                var incorrectMsg = '';",
                                    "                for( var i in incorrectAnswer){",
                                    "                    incorrectMsg += incorrectAnswer[i] + '번';",
                                    "                    if(i != incorrectAnswer.length - 1){",
                                    "                        incorrectMsg += ', ';",
                                    "                    }",
                                    "                }",
                                    "                incorrectMsg += '은 부적절한 답변입니다.<br>등록하시겠습니까?';",
                                    "                Ext.Msg.confirm('알림', incorrectMsg, function(btn) {",
                                    "                    if (btn == 'yes') {",
                                    "                        me.onSave();",
                                    "                    } else {",
                                    "                        return false;",
                                    "                    }",
                                    "                });",
                                    "            }",
                                    "            else{",
                                    "                var isSameData = true;",
                                    "                for(var k in vm.get('hiddenContainer')){",
                                    "                    if(vm.get('hiddenContainer')[k] == false){",
                                    "                        if(vm.get('oldValue')[k] != vm.get('newValue')[k]){",
                                    "                            isSameData = false;",
                                    "                            break;",
                                    "                        }",
                                    "                        if(vm.get('oldTextValue')[k] != vm.get('newTextValue')[k]){",
                                    "                            isSameData = false;",
                                    "                            break;",
                                    "                        }",
                                    "                    }",
                                    "                }",
                                    "                if(isSameData){",
                                    "                    // 모두 일치하면",
                                    "                    Ext.Msg.alert('알림','변경된 정보가 없습니다.');",
                                    "                }",
                                    "                else{",
                                    "                    // 변경된 답변이 있으면 저장 진행",
                                    "                    var incorrectMsg = '등록하시겠습니까?';",
                                    "                    Ext.Msg.confirm('알림', incorrectMsg, function(btn) {",
                                    "                        if (btn == 'yes') {",
                                    "                            me.onSave();",
                                    "                        } else {",
                                    "                            return false;",
                                    "                        }",
                                    "                    });",
                                    "                }",
                                    "",
                                    "",
                                    "            }",
                                    "        }",
                                    "    });",
                                    "}"
                                ],
                                "name": "tap",
                                "scope": "me"
                            },
                            "configAlternates": {
                                "fn": "string",
                                "implHandler": "code",
                                "name": "string",
                                "scope": "string"
                            },
                            "name": "onButtonTapSave",
                            "designerId": "41fa6cc5-0fc3-4dce-9687-1f084d8ace03"
                        }
                    ]
                }
            ]
        },
