                                {
                                    "type": "viewcontrollereventbinding",
                                    "reference": {
                                        "name": "listeners",
                                        "type": "array"
                                    },
                                    "codeClass": null,
                                    "userConfig": {
                                        "fn": "onTapNoticeInfo",
                                        "implHandler": [
                                            "var me = this,",
                                            "    vm = me.getViewModel(),",
                                            "    refs = me.getReferences(),",
                                            "    selectedData = vm.get('noticeInfoCmpl');",
                                            "",
                                            "if (selectedData === null) {",
                                            "    return;",
                                            "}",
                                            "if(Ext.isEmpty(selectedData.subject)) return;",
                                            "",
                                            "var win = Ext.create('NoticeBoardManagementDetailPopupM', {",
                                            "    title   : '공지사항 상세보기',",
                                            "    records : selectedData",
                                            "});",
                                            "win.show();"
                                        ],
                                        "name": "tap",
                                        "scope": "me"
                                    },
                                    "configAlternates": {
                                        "fn": "string",
                                        "implHandler": "code",
                                        "name": "string",
                                        "scope": "string"
                                    },
                                    "name": "onTapNoticeInfo",
                                    "designerId": "abc79cfe-041e-44f3-913d-29c24f4470f5"
                                }
                            ]
                        }
                    ]
                }
