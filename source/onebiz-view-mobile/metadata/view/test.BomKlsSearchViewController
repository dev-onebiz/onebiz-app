            "userConfig": {
                "fn": "onPrintSearch",
                "implHandler": [
                    "var me = this;",
                    "var vm = me.getViewModel();",
                    "var refs = me.getReferences();",
                    "var values = {",
                    "    searchText : refs.searchForm.getValue(),",
                    "    length : 0,",
                    "};",
                    "if(vm.get('start')==true) return;",
                    "",
                    "vm.set('start',true);",
                    "vm.set('searchText',refs.searchForm.getValue());",
                    "Ext.Ajax.request({",
                    "    headers : {",
                    "        serviceId : 'BomKlsSvc.findAllKlsSearch',",
                    "        viewId : me.view.parent.id",
                    "    },",
                    "    jsonData : values,",
                    "    success : function(response) {",
                    "        var trnd = Ext.JSON.decode(response.responseText).trnd;",
                    "        var rept = Ext.JSON.decode(response.responseText).rept;",
                    "        var news = Ext.JSON.decode(response.responseText).news;",
                    "        var it   = Ext.JSON.decode(response.responseText).it;",
                    "        var finc = Ext.JSON.decode(response.responseText).finc;",
                    "",
                    "        var trndTotal = Ext.JSON.decode(response.responseText).trndTotal;",
                    "        var reptTotal = Ext.JSON.decode(response.responseText).reptTotal;",
                    "        var newsTotal = Ext.JSON.decode(response.responseText).newsTotal;",
                    "        var itTotal   = Ext.JSON.decode(response.responseText).itTotal;",
                    "        var fincTotal = Ext.JSON.decode(response.responseText).fincTotal;",
                    "",
                    "        refs.trndText.setHtml('동향 <span style=\"color:#CB2B11;\">' + trndTotal.toLocaleString('ko-KR') + '</span>건');",
                    "        refs.reptText.setHtml('보고서 <span style=\"color:#CB2B11;\">' + reptTotal.toLocaleString('ko-KR') + '</span>건');",
                    "        refs.newsText.setHtml('뉴스 <span style=\"color:#CB2B11;\">' + newsTotal.toLocaleString('ko-KR') + '</span>건');",
                    "        refs.itText.setHtml('IT 용어 <span style=\"color:#CB2B11;\">' + itTotal.toLocaleString('ko-KR') + '</span>건');",
                    "        refs.fincText.setHtml('금융 용어 <span style=\"color:#CB2B11;\">' + fincTotal.toLocaleString('ko-KR') + '</span>건');",
                    "",
                    "        if(trndTotal==0){",
                    "            refs.trndCtn.setHidden(true);",
                    "        }",
                    "        else {",
                    "            refs.trndCtn.setHidden(false);",
                    "            me.onTrndPrint(trnd,trndTotal);",
                    "        }",
                    "",
                    "        if(reptTotal==0){",
                    "            refs.reptCtn.setHidden(true);",
                    "        }",
                    "        else{",
                    "            refs.reptCtn.setHidden(false);",
                    "            me.onReptPrint(rept,reptTotal);",
                    "        }",
                    "",
                    "        if(newsTotal==0) {",
                    "            refs.newsCtn.setHidden(true);",
                    "        }",
                    "        else{",
                    "            refs.newsCtn.setHidden(false);",
                    "            me.onNewsPrint(news,newsTotal);",
                    "        }",
                    "",
                    "        if(itTotal==0){",
                    "            refs.itCtn.setHidden(true);",
                    "        }",
                    "        else{",
                    "            refs.itCtn.setHidden(false);",
                    "            me.onItPrint(it,itTotal);",
                    "",
                    "        }",
                    "        if(fincTotal==0){",
                    "            refs.fincCtn.setHidden(true);",
                    "        }",
                    "        else{",
                    "            refs.fincCtn.setHidden(false);",
                    "            me.onFincPrint(finc,fincTotal);",
                    "        }",
                    "",
                    "        if(trndTotal==0&&reptTotal==0&&newsTotal==0&&itTotal==0&&fincTotal==0){",
                    "            refs.subCtn2.add({",
                    "                xtype : 'container',",
                    "                width : '90%',",
                    "                height : 350,",
                    "                layout: {",
                    "                     type: 'vbox',",
                    "                     align: 'center'",
                    "                },",
                    "                items :[",
                    "                    {",
                    "                        xtype : 'displayfield',",
                    "                        width : '100%',",
                    "                        style : 'text-align:left;font:normal normal bold 14px/27px SF Compact Display; color:#333333;',",
                    "                        html : '검색결과 <span style=\"color:#CB2B11;\">0</span>건'",
                    "                    },",
                    "                    {",
                    "                        xtype : 'image',",
                    "                          src : 'resources/images/kls/icon_64_onebiz@2x.png',",
                    "                        margin : '44 0 0 0',",
                    "                        width : 64,",
                    "                        height : 64,",
                    "                    },",
                    "                    {",
                    "                        xtype : 'displayfield',",
                    "                        style : 'font:normal normal normal 16px/24px SF Compact Display; color:#6E6F6F',",
                    "                        html : '검색 결과가 존재하지 않아요',",
                    "                        margin : '0 0 14 0',",
                    "                    },",
                    "                    {",
                    "                        xtype : 'button',",
                    "                        width : '100%',",
                    "                        height : 48,",
                    "                        text: '메인으로',",
                    "                        listeners : { tap : 'onToMain'},",
                    "                        style : 'background:#939393 0% 0% no-repeat padding-box; border-radius: 4px;font:normal normal bold 18px/27px SF Compact Display; color:#FFFFFF;',",
                    "                    }",
                    "                ]",
                    "            });",
                    "        }",
                    "        vm.set('start',false);",
                    "    }",
                    "});",
                    ""
                ]
            },
            "configAlternates": {
                "fn": "string",
                "implHandler": "code"
            },
