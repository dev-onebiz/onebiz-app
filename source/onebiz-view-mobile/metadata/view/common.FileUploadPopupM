                                "fn": "onFilefieldChange",
                                "implHandler": [
                                    "var me = this,",
                                    "    vm = me.getViewModel(),",
                                    "    refs = me.getReferences(),",
                                    "    file = field.getFiles()[0];\t\t\t\t\t// 파일필드정보",
                                    "",
                                    "// 유효성 검증",
                                    "if (!file) {",
                                    "    return;",
                                    "}",
                                    "",
                                    "var fileExt = file.name.split('.')[1],",
                                    "    mb = 1 * 1024 * 1024,\t// 1MB",
                                    "    allowExt = ['zip', 'pdf', 'doc', 'hwp', 'txt', 'jpg', 'png', 'bmp', 'xls', 'ppt'],\t\t// 허용 확장자",
                                    "    isUpload = false;",
                                    "",
                                    "for (var i in allowExt) {",
                                    "    if (fileExt.indexOf(allowExt[i]) != -1) {",
                                    "        isUpload = true;",
                                    "    }",
                                    "}",
                                    "",
                                    "if (file.size > mb || !isUpload) {",
                                    "    Ext.Msg.show({",
                                    "        title : '알림',",
                                    "        message : '해당 파일은 첨부할 수 없습니다.',",
                                    "        buttons : {",
                                    "            yes : {itemId : Ext.MessageBox.YES, text : '확인'}",
                                    "        },",
                                    "        alwaysOnTop : true,",
                                    "        fn : function() {",
                                    "            field.reset();",
                                    "        }",
                                    "    });",
                                    "} else {",
                                    "    var  fileMap = {",
                                    "    //         type : file.type,\t\t\t\t\t\t// 타입",
                                    "            fileSize : file.size+'',\t\t\t\t// 크기",
                                    "            fileExt : file.name.split('.')[1],\t\t// 확장자",
                                    "            orgnFileNm : file.name.split('.')[0]\t// 이름",
                                    "        };",
                                    "",
                                    "    var reader = new FileReader();",
                                    "    reader.onload = function () {",
                                    "    //     console.log(reader.result);",
                                    "",
                                    "        // 로딩바",
                                    "        me.getView().setMasked({",
                                    "            xtype: 'loadmask',",
                                    "            message: '',",
                                    "            indicator: false,",
                                    "            html : '<img src=\"resources/images/loading-bar.gif\"></img>'",
                                    "        });",
                                    "",
                                    "        Ext.Ajax.request({",
                                    "            headers : {",
                                    "                serviceId : 'COMFIL0010C01.singleFileUploadFromMB',",
                                    "                viewId : 'FileUploadPopupM'",
                                    "            },",
                                    "            jsonData : {",
                                    "                fileId      : null,",
                                    "                encrypt     : false,    // 암복호화 여부",
                                    "                maxFileSize : 0, \t\t// 파일용량제한",
                                    "                file : fileMap,",
                                    "                data : reader.result",
                                    "            },",
                                    "            success : function(response, scope) {",
                                    "                var res = Ext.JSON.decode(response.responseText),",
                                    "                    data = res.result.details,",
                                    "                    parentId = res.result.id;",
                                    "",
                                    "                me.getView().setMasked(false);",
                                    "",
                                    "                vm.set('fileId', data.id);",
                                    "                vm.set('parentId', parentId);",
                                    "                vm.set('fileNm', data.orgnFileNm + \".\" + data.fileExt);",
                                    "                vm.set('fileSize', data.fileSize);",
                                    "                //필드에 업로드파일경로 설정",
                                    "                field.setValue(newValue);",
                                    "            }",
                                    "    });",
                                    "",
                                    "    };",
                                    "    // reader.readAsText(file);",
                                    "    reader.readAsDataURL(file);",
                                    "}"
                                ],
