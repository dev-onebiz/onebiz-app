                                ],
                                "fn": "onBtnAplyLineTap",
                                "implHandler": [
                                    "var me = this;",
                                    "    var vm = me.getViewModel();",
                                    "    var refs = me.getReferences();",
                                    "    var data = vm.data.detail;",
                                    "    var aplStatus = data.aplStatus; // 신청 row 개수 (0:신청가능, 1:신청완료)",
                                    "",
                                    "    if(aplStatus == '0'){ // 신청 로직",
                                    "        if ( me.dateTo8Char(new Date()) > data.cltEdt ){",
                                    "          Ext.Msg.show({",
                                    "              title : '신청불가',",
                                    "              message : '모집기간이 종료되었습니다.',",
                                    "              buttons : Ext.MessageBox.YES,",
                                    "              fn: function(btn){}",
                                    "          });",
                                    "          return false;",
                                    "        } else if ( data.cltStrdt > me.dateTo8Char(new Date()) ) {",
                                    "          Ext.Msg.show({",
                                    "              title : '신청불가',",
                                    "              message : '모집기간이 아닙니다.',",
                                    "              buttons : Ext.MessageBox.YES,",
                                    "              fn: function(btn){}",
                                    "          });",
                                    "          return false;",
                                    "        }",
                                    "",
                                    "        data.hrHrdmCsrId = data.id;",
                                    "        data.csrAplStcd = '01'; // 최초 신청 시 신청상태 = 신청",
                                    "        data.stcd = Constants.stcd.NORMAL; // 최초 신청 시 상태 = 정상",
                                    "        if(data.csrAmt){",
                                    "          for(var i in data.csrAmt){",
                                    "            data.csrAmt = data.csrAmt.replace(',', '');  // , 빼기",
                                    "          }",
                                    "        }",
                                    "",
                                    "        // Service 호출",
                                    "        Ext.Ajax.request({",
                                    "            headers : {",
                                    "                viewId : this.getView().xtype, // userAlias",
                                    "                serviceId : 'HrdScySvc.insertHrdScyCtrbApl'",
                                    "            },",
                                    "            jsonData : data,",
                                    "            scope : me,",
                                    "            success : function(response, opts) {",
                                    "                var result = Ext.JSON.decode(response.responseText); // 서버응답결과 JSON 변환",
                                    "",
                                    "                if(result.isApply === 1){",
                                    "                  Ext.Msg.show({",
                                    "                      title : '중복 신청',",
                                    "                      message : '이미 신청을 하셨습니다.',",
                                    "                      buttons : Ext.MessageBox.YES,",
                                    "                      fn: function(btn){",
                                    "                          if(btn === 'yes'){",
                                    "                             me.goBack(me);",
                                    "                          }",
                                    "                      }",
                                    "                  });",
                                    "                } else {",
                                    "                    Ext.Msg.show({",
                                    "                      title : '신청 완료',",
                                    "                      message : '정상 신청 되었습니다.',",
                                    "                      buttons : Ext.MessageBox.YES,",
                                    "                      fn: function(btn){",
                                    "                          if(btn === 'yes'){",
                                    "                              me.goBack(me);",
                                    "                          }",
                                    "                      }",
                                    "                  });",
                                    "                }",
                                    "            },",
                                    "            failure : function(response, opts){",
                                    "                // Service 실패 했을 경우 기능",
                                    "                Ext.Msg.show({",
                                    "                    title : '실패',",
                                    "                    message : '신청 도중 에러가 발생했습니다.',",
                                    "                    buttons : Ext.MessageBox.YES,",
                                    "                    fn: function(btn){",
                                    "                        if(btn === 'yes'){",
                                    "                            me.goBack(me);",
                                    "                        }",
                                    "                    }",
                                    "                });",
                                    "            }",
                                    "        });",
                                    "",
                                    "    }else{ // 신청 취소 로직",
                                    "        Ext.Msg.confirm('신청취소', '정말로 취소 하시겠습니까?', me.onCancel, me);",
                                    "    }"
                                ],
