                "designer|commentHeader": [
                    "Harversine Formula"
                ],
                "designer|params": [
                    "gps, lat, lon, location"
                ],
                "fn": "measureDistance",
                "implHandler": [
                    "Number.prototype.toRad = function() {",
                    "    return this * Math.PI / 100;",
                    "};",
                    "",
                    "var lat1 = Number(gps.latitude);",
                    "var lon1 = Number(gps.longitude);",
                    "",
                    "var lat2 = Number(lat);",
                    "var lon2 = Number(lon);",
                    "",
                    "if(!lat1 || !lon1){",
                    "    Ext.Msg.alert('GPS수신 실패', 'GPS 좌표를 수신할 수 없습니다.');",
                    "    return false;",
                    "}",
                    "",
                    "var R = 6371; // 지구 반지름 = 6371 km",
                    "",
                    "var x1 = lat2 - lat1;",
                    "var dLat = x1.toRad();",
                    "",
                    "var x2 = lon2 - lon1;",
                    "var dLon = x2.toRad();",
                    "",
                    "var a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +",
                    "        Math.cos(lat1.toRad()) * Math.cos(lat2.toRad()) *",
                    "        Math.sin(dLon / 2) * Math.sin(dLon / 2);",
                    "var c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));",
                    "var d = R * c;",
                    "",
                    "var km = String(Math.floor(d)); // '18'",
                    "var strKm = d.toFixed(3); // '18.852'",
                    "",
                    "var m_tmp = (Number(strKm) - Number(km)) * 1000;",
                    "var m = String(Math.floor(m_tmp));",
                    "",
                    "var result = '';",
                    "if(km == '0'){",
                    "    result = location + ' 근무지와의 거리 : ' + m +'m';",
                    "} else {",
                    "    result = location + ' 근무지와의 거리 : ' + km + 'km' + ' ' + m +'m';",
                    "}",
                    "",
                    "return result;",
                    ""
                ]
            },
