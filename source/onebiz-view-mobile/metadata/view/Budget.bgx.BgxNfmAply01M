                "fn": "onContainerInitialize",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    cbxAplStcd = refs.aplStcd,",
                    "    cbxAplKndcd = refs.aplKndcd,",
                    "    store = cbxAplStcd.getStore(),",
                    "    date = new Date(),",
                    "    dateContainer = refs.dateStartEndContainer,",
                    "    dateRefs = dateContainer.getReferences(),",
                    "    strdt = dateRefs.strdt,",
                    "    edt = dateRefs.edt;",
                    "",
                    "// 신청상태 초기화",
                    "store.getAt(0).set('text', '전 체');",
                    "store.getAt(0).set('value', '99');",
                    "cbxAplStcd.setValue('99');",
                    "",
                    "store = cbxAplKndcd.getStore();",
                    "// 신청분류 초기화",
                    "store.getAt(0).set('text', '전 체');",
                    "store.getAt(0).set('value', '99');",
                    "cbxAplKndcd.setValue('99');",
                    "",
                    "// 조회기간 초기화",
                    "edt.setValue(DateUtils.parseDate(date));",
                    "date.setMonth(date.getMonth() - 1);",
                    "strdt.setValue(DateUtils.parseDate(date));",
                    "",
                    "refs.grid_container.refs.grid.el.select('.x-headercontainer').setStyle('height',\t'0px');",
