        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "서버 시간에 맞게 화면 시간 표시"
                ],
                "designer|params": [
                    "timestamp"
                ],
                "fn": "getServerDate",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences();",
                    "",
                    "var year = timestamp.substr(0, 4); //년도",
                    "var month = parseInt(timestamp.substr(4, 2)) - 1; //월",
                    "var day = timestamp.substr(6, 2); //일",
                    "var hour = timestamp.substr(8, 2); //시간",
                    "var minute = timestamp.substr(10, 2); //분",
                    "var second = timestamp.substr(12, 2); //초",
                    "",
                    "",
                    "if(!vm.get('runner')){",
                    "",
                    "    var runner = new Ext.util.TaskRunner(),",
                    "        cnt = 0;",
                    "",
                    "    var task = {",
                    "",
                    "        run : function(){",
                    "            var date = new Date(year, month, day, hour, minute, second++),",
                    "                dayOfTheWeek = date.getDay(),",
                    "                week = ['일', '월', '화', '수', '목', '금', '토'],",
                    "                strDay = String(week[dayOfTheWeek]),",
                    "",
                    "                fullDate = date.getFullYear()  + '.' +",
                    "                (date.getMonth() < 9 ? '0' : '') + (date.getMonth() + 1)  + '.' +",
                    "                (date.getDate() < 10 ? '0' : '') + date.getDate() +",
                    "                '(' + strDay + ')',",
                    "",
                    "                nowTime = (date.getHours() < 10 ? '0' : '') + date.getHours() + \":\" +",
                    "                (date.getMinutes() < 10 ? '0' : '') + date.getMinutes() + \":\"+",
                    "                (date.getSeconds() < 10 ? '0' : '') + date.getSeconds();",
                    "",
                    "            try{",
                    "                if (cnt < 60) {",
                    "                    me.getReferences().monitorDate.setHtml(fullDate);",
                    "                    me.getReferences().monitorTime.setHtml(nowTime);",
                    "                    cnt++;",
                    "                } else {",
                    "                    me.onSelect(runner);",
                    "                }",
                    "            } catch(e){",
                    "                runner.stopAll();",
                    "                console.log('timer stop');",
                    "            }",
                    "",
                    "        },",
                    "",
                    "        interval : 1000",
                    "",
                    "    };",
                    "",
                    "    //TASK RUNNER SETTING",
                    "    vm.set('runner', runner);",
                    "    vm.set('task', task);",
                    "",
                    "    //TASK RUNNER START",
                    "    runner.start(task);",
                    "",
                    "}",
                    ""
                ]
            },
            "configAlternates": {
                "designer|commentHeader": "comment",
                "designer|params": "typedarray",
                "fn": "string",
                "implHandler": "code"
            },
