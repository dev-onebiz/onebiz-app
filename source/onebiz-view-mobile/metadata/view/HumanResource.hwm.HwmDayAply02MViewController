                "fn": "getGPS",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    params = {",
                    "        scope : me,",
                    "        status : status // 'in':출근처리, 'out':퇴근처리",
                    "    };",
                    "",
                    "if(status === 'in' || status === 'out'){",
                    "    // getGPS 시작",
                    "    Ext.Viewport.setMasked({",
                    "        xtype: 'loadmask',",
                    "        message: '',",
                    "        indicator: false,",
                    "        html : '<img src=\"resources/images/loading-bar.gif\"></img>'",
                    "    });",
                    "}",
                    "",
                    "var successcb = function(result) {",
                    "    var me = result.params.scope,",
                    "        vm = me.getViewModel(),",
                    "        refs = me.getReferences(),",
                    "        gps = result.gps,",
                    "        status = result.params.status;",
                    "",
                    "    var latitude = gps.latitude,",
                    "        longitude = gps.longitude;",
                    "",
                    "    if(gps && latitude && longitude){",
                    "        vm.set('gps', gps);",
                    "",
                    "        // 출근",
                    "        if(status === 'in'){",
                    "            me.onInProgress();",
                    "        }",
                    "",
                    "        // 퇴근",
                    "        if(status === 'out'){",
                    "            me.onOutProgress();",
                    "        }",
                    "",
                    "        // api 호출 timeout = 1000ms -> 1회 호출 시 계산 시간포함 1000+? 초 소요",
                    "        // 출근 화면 열리면 1.2초*5회 -> 총 6초 동안 gps 검색",
                    "        // -> '안'/'밖'/'gps문제' 등의 문구 표시",
                    "        if(status === 'test1'){",
                    "",
                    "            /* ** API에서 값을 가져온 후 실행됨 ** */",
                    "",
                    "            //GPS 인식 성공 여부에 대한 배열",
                    "            //인식 O",
                    "            var isSuccessArr = vm.get('isSuccess');",
                    "            isSuccessArr.push(true);",
                    "            vm.set('isSuccess',isSuccessArr);",
                    "",
                    "            //출근가능 위치인지 체크",
                    "            var workGpsInfo = vm.get('workGpsVal');",
                    "            var isWorkZone = false;",
                    "            for(var i in workGpsInfo){",
                    "                var innerArea = me.measureDistance(gps, workGpsInfo[i].gpsLatdVal, workGpsInfo[i].gpsLotdVal, workGpsInfo[i].gpsLmDstnCnt);",
                    "                console.log('근무지와의 거리(measureDistance) : ' + vm.get('strKm'));",
                    "                if(innerArea){",
                    "                    isWorkZone = true;",
                    "                    vm.set('wkplcNm', workGpsInfo[i].wkplcNm); // 근무지명",
                    "                    break;",
                    "                }",
                    "            }",
                    "",
                    "            var isArriveArr = vm.get('isArrive'); //출근가능 위치 여부에 대한 배열",
                    "            isArriveArr.push(isWorkZone);",
                    "            vm.set('isArrive',isArriveArr);",
                    "",
                    "",
                    "            //             // gps api호출 성공률 50% 미만인 경우",
                    "            //             // 디바이스 자체의 문제일 수 있다는 문구",
                    "            //             // 문제 예) 위치 켜기, 데이터 꼈다켜기 등",
                    "",
                    "            //             // 1) 인식성공에 대한 카운트",
                    "            //             var totalSuccess = 0;",
                    "            //             for(var i in isSuccessArr){",
                    "            //                 if(isSuccessArr[i] === true)",
                    "            //                     totalSuccess += 1;",
                    "            //             }",
                    "",
                    "            //             // 2) 인식률이 낮을 경우 안내문구 표시",
                    "            //             if(totalSuccess / parseFloat(isSuccessArr.length) < 0.5){",
                    "            //                 refs.getGpsInfo.setHtml('디바이스 위치 기능 활성화 필요');",
                    "            //                 vm.set('gpsMsgChanged',true);",
                    "            //             }",
                    "",
                    "            // GPS 정상 작동 시 문구 없음",
                    "            // -> 범위 내외 여부 문구 수정",
                    "            var totalArrive = 0;",
                    "            if(isArriveArr.length > 0){",
                    "                for(var i in isArriveArr){",
                    "                    if(isArriveArr[i] === true)",
                    "                        totalArrive += 1;",
                    "                }",
                    "                if(totalArrive / parseFloat(isArriveArr.length) < 0.5){",
                    "                    refs.getGpsInfo.setHtml('허용거리초과');",
                    "                    vm.set('gpsMsgChanged',true);",
                    "                }",
                    "                else{",
                    "                    if(refs.in.getHidden() !== true){",
                    "                        refs.getGpsInfo.setHtml('출근가능');",
                    "                        vm.set('gpsMsgChanged',true);",
                    "                    }",
                    "                    else{",
                    "                        refs.getGpsInfo.setHtml('퇴근가능');",
                    "                        vm.set('gpsMsgChanged',true);",
                    "                    }",
                    "                }",
                    "            }",
                    "        }",
                    "    } else{",
                    "        refs.getGpsInfo.setHtml('디바이스 위치 기능 활성화 필요');",
                    "        vm.set('gpsMsgChanged',true);",
                    "    }",
                    "",
                    "    //     getGPS 끝",
                    "    Ext.Viewport.setMasked(false);",
                    "",
                    "};",
                    "",
                    "var errorcb = function(error, params) {",
                    "    var me = params.scope,",
                    "        vm = me.getViewModel(),",
                    "        refs = me.getReferences(),",
                    "        status = params.status;",
                    "",
                    "    if(status === 'test1'){",
                    "",
                    "        //GPS 인식 성공 여부에 대한 배열",
                    "        //인식 X",
                    "        var isSuccessArr = vm.get('isSuccess');",
                    "        isSuccessArr.push(false);",
                    "        vm.set('isSuccess',isSuccessArr);",
                    "",
                    "        // 이미 저장된 거리 정보 확인 배열 만듦 // 없으면 오류",
                    "        var isArriveArr = vm.get('isArrive'); //출근가능 위치 여부에 대한 배열",
                    "",
                    "        // gps인식율에 따른 문구 수정",
                    "",
                    "        // 5회를 진행했다면 종료",
                    "        // 6회 이상 호출 및 무한반복을 고려하여 '>='",
                    "",
