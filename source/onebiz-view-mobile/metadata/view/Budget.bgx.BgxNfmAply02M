                                            "            switch (btn) {",
                                            "                case 'yes':",
                                            "                    //화면 초기화 & 코드리스트 재 조회",
                                            "                    vm.set('prevBsnsYy', newDate.getFullYear().toString());",
                                            "                    refs.item_container.removeAll();",
                                            "                    vm.set('applyInfo.aplKndcd', '');",
                                            "                    refs.aplKndcd.setValue(0);",
                                            "                    vm.set('codeList', null);",
                                            "                    me.fnCodeSetting();",
                                            "                    break;",
                                            "                default:",
                                            "                    datefield.suspendEvents(true);",
                                            "                    datefield.setValue(new Date(vm.get('prevBsnsYy'), 1, 1));\t// 연도만 필요하므로 월,일은 임의로 설정",
                                            "                    datefield.resumeEvents(true);",
                                            "                    return false;",
                                            "                    break;",
                                            "            }",
                                            "        });",
                                            "    }",
                                            "}",
                                            "",
