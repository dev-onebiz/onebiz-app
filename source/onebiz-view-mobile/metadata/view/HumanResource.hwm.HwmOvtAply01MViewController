                "fn": "onClickActColumn",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    itemId = component.config.itemId; // 신청서 or 보고서",
                    "",
                    "var colName, className;",
                    "var record = component.config.scope.view.refs.grid.getSelection().data;",
                    "if (itemId == 'actAprHistData') {",
                    "    colName = 'comAprHistId';",
                    "    className = 'HwmOvtAply73M';",
                    "} else {",
                    "    return false;",
                    "}",
                    "",
                    "if (!record[colName] || record[colName] == -1) {",
                    "    Ext.Msg.alert('확인', Messages.getMessage('E9303', [ '신청' ]));",
                    "    return;",
                    "}",
                    "",
                    "Ext.Ajax.request({",
                    "    headers : {",
                    "        serviceId : 'COMAPR0001R04',",
                    "        viewId : me.getViewId(),",
                    "        scope : me",
                    "    },",
                    "    jsonData : {",
                    "        aprHistId : record[colName]        // 결재이력ID",
                    "    },",
                    "    success : function(response) {",
                    "        var res = Ext.JSON.decode(response.responseText),",
                    "            command = Constants.sanction.COMPLETED_BOX; // 아무 동작도 하지 않아야 하므로 완료.",
                    "",
                    "        me.menu.hide();\t\t//메뉴닫기",
                    "",
                    "        var win = Ext.create(className, {",
                    "            command : command,",
                    "            aprHistId : res.aprHistId,",
                    "            aprHistData : Ext.decode(res.result),",
                    "            record : record",
                    "        });",
                    "        // 재조회",
                    "        me.mon(win, 'close', function(view) {",
                    "            me.onSelect(); // 재조회",
                    "        }, me);",
                    "        win.show();",
                    "",
                    "    }",
                    "});"
                ]
            },
