                                    "codeClass": null,
                                    "userConfig": {
                                        "fn": "onBtnWriteTap",
                                        "implHandler": [
                                            "var me = this;",
                                            "var vm = me.getViewModel();",
                                            "var refs = me.getReferences();",
                                            "var grid = refs.grid;",
                                            "var records = grid.getStore().data.items;",
                                            "var trueRecords = []; // 선택한 row 들",
                                            "",
                                            "var k = 0;",
                                            "var l = 0;",
                                            "for(var i in records){",
                                            "    var record = records[i].data;",
                                            "    if (record.selected === true){",
                                            "            trueRecords[k] = record;",
                                            "            trueRecords[k].stlmDvcd = '01'; //법인카드: 01, 기타영수증 09",
                                            "            k++;",
                                            "    }",
                                            "}",
                                            "",
                                            "if(trueRecords.length <= 0){",
                                            "    Ext.Msg.alert('알림', '법인카드 승인내역을 선택하십시오.');",
                                            "    return false;",
                                            "}",
                                            "if(trueRecords.length > 1){",
                                            "    Ext.Msg.alert('알림', '하나만 작성할 수 있습니다.');",
                                            "    return false;",
                                            "}",
                                            "",
                                            "var fndcDt = trueRecords[0].fndcDt;",
                                            "var apvlDt = trueRecords[0].apvlDt;",
                                            "if(fndcDt && apvlDt){ // 마감일 & 승인일자 IS NOT NULL",
                                            "    var parseFndcDt = DateUtils.parseDate(fndcDt);",
                                            "    if(apvlDt <= fndcDt){",
                                            "        Ext.Msg.alert('알림', '마감일자(' + parseFndcDt + ')가 지났습니다.<br>지출결의서를 작성할 수 없습니다.');",
                                            "        return false;",
                                            "    }",
                                            "}",
                                            "",
                                            "if(apvlDt >= 20200701) {",
                                            "    /* 20.07.01 예산오픈으로 인한 분기처리 */",
                                            "    Ext.Msg.alert('알림', '2020-07-01 부터는 [경비신청]-[결의서 작성] 메뉴를 이용바랍니다.');",
                                            "    return false;",
                                            "}",
                                            "",
