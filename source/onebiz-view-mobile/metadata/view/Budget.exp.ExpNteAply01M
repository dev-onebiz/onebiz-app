                                ],
                                "fn": "renderer",
                                "implHandler": [
                                    "var result = record.data.apvlAmtDom;",
                                    "var str = String(result);",
                                    "result = str.replace(/(\\d)(?=(?:\\d{3})+(?!\\d))/g, '$1,');",
                                    "result += ' 원';",
                                    "if(record.data.canYn == 'N')",
                                    "{",
                                    "    result = '<div style=\"font-size:15px;font-weight:bold;color:blue\">'+result+'</div>';",
                                    "}",
                                    "else",
                                    "{",
                                    "    result = '<div style=\"font-size:15px;font-weight:bold;color:red\">'+result+'</div>';",
                                    "}",
                                    "var aprno = record.data.aprno;",
                                    "var result2 = '';",
                                    "if(record.data.canYn == 'N')",
                                    "{",
                                    "    result2 = '<span>정상 | ' + aprno +'</span>';",
                                    "",
                                    "}",
                                    "else",
                                    "{",
                                    "    result2 = '<span style=\"color:red\">취소 | ' + aprno + '</span>';",
                                    "}",
                                    "result += '<div>'+result2+'</div>';",
                                    "return result;"
                                ]
