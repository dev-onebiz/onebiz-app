        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|params": [
                    "index"
                ],
                "fn": "toggleMenu",
                "implHandler": [
                    "var me = this,",
                    "    v = me.getView(),",
                    "    refs = me.getReferences();",
                    "",
                    "if (index == 1) {",
                    "        Ext.Ajax.request({",
                    "            headers: {",
                    "                viewId : me.getViewId(),",
                    "                serviceId : 'BomTasSvc.findAllPushRvStcd'",
                    "            },",
                    "            scope: me,",
                    "            success: function(response) {",
                    "                var res = Ext.JSON.decode(response.responseText);",
                    "                if (res.total > 0) {",
                    "                    refs.btnPushBox.setIconCls('icon-side-bell-badge');",
                    "                    v.setActiveItem(index);",
                    "                } else {",
                    "                    refs.btnPushBox.setIconCls('icon-side-bell');",
                    "                    v.setActiveItem(index);",
                    "                }",
                    "            }",
                    "        });",
                    "} else {",
                    "    v.setActiveItem(index);",
                    "}"
                ]
            },
            "configAlternates": {
                "designer|params": "typedarray",
                "fn": "string",
                "implHandler": "code"
            },
