            "codeClass": null,
            "userConfig": {
                "fn": "onChangeComplianceIcon",
                "implHandler": [
                    "var me = this;",
                    "var refs = me.getReferences();",
                    "var vm = me.getViewModel();",
                    "",
                    "var param = {",
                    "    changeMainpageIcon : true,",
                    "};",
                    "",
                    "Ext.Ajax.request({",
                    "    headers: {",
                    "        viewId : me.getViewId(),",
                    "        serviceId : 'BomCplSvc.findAllProgressBoard'",
                    "    },",
                    "    jsonData : param,",
                    "    scope : me,",
                    "    success: function(response) {",
                    "        var res = Ext.JSON.decode(response.responseText);",
                    "",
                    "        // new 아이콘",
                    "        if(res.count > 0){",
                    "            refs.complianceIcon.setIconCls('icon-main-07-new');",
                    "        }",
                    "        else{",
                    "            refs.complianceIcon.setIconCls('icon-main-07');",
                    "        }",
                    "    }",
                    "});"
                ]
            },
            "configAlternates": {
                "fn": "string",
                "implHandler": "code"
            },
            "name": "onChangeComplianceIcon",
