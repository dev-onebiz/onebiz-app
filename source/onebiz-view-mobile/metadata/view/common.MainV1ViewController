        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "fn": "callMainSvc",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences();",
                    "",
                    "// 메인서비스 호출",
                    "Ext.Ajax.request(",
                    "    {",
                    "        headers: {",
                    "            viewId: me.getViewId(),",
                    "            serviceId: 'MainSvc.findAllMainUserInfo'",
                    "        },",
                    "        scope : me,",
                    "        success : function(res) {",
                    "            var result = Ext.JSON.decode(res.responseText);",
                    "",
                    "            //출근 or 근무확인에 대한 확인값",
                    "            if (result.wrkChkDvcdNm) {",
                    "                vm.set('wrkChkDvcdNm', result.wrkChkDvcdNm);",
                    "            }",
                    "",
                    "            // 개인화 메시지",
                    "            if (result.mainMsgInfo) {",
                    "                var msgInfo = result.mainMsgInfo;",
                    "",
                    "                refs.mainMsg.setHtml(msgInfo.mainMsg);\t// 메인메시지",
                    "                refs.subMsg.setHtml(msgInfo.subMsg);\t// 서브메시지",
                    "",
                    "//                 refs.emptyMainMsg.setHtml(msgInfo.mainMsg);\t// 메인메시지",
                    "//                 refs.emptySubMsg.setHtml(msgInfo.subMsg);\t// 서브메시지",
                    "",
                    "                if(msgInfo.msgDvcd) {\t\t\t\t\t// 이모티콘구분",
                    "                     switch(msgInfo.msgDvcd) {",
                    "                        case Constants.msgDvcd.REPT_MSG :\t\t// 결근, 보고 안내",
                    "                            refs.topImg.setSrc('resources/images/icon-maintop-01.png');",
                    "//                             refs.emptyTopImg.setSrc('resources/images/icon-maintop-01.png');",
                    "                            break;",
                    "                        case Constants.msgDvcd.BRDY_MSG :\t\t// 생일축하",
                    "                            refs.topImg.setSrc('resources/images/icon-maintop-02.png');",
                    "//                             refs.emptyTopImg.setSrc('resources/images/icon-maintop-02.png');",
                    "                            break;",
                    "                        case Constants.msgDvcd.ETCO_MSG :\t\t// 입사축하",
                    "                            refs.topImg.setSrc('resources/images/icon-maintop-03.png');",
                    "//                             refs.emptyTopImg.setSrc('resources/images/icon-maintop-03.png');",
                    "                            break;",
                    "                        case Constants.msgDvcd.TIME_MSG :\t\t// 시간대별",
                    "                            refs.topImg.setSrc('resources/images/icon-maintop-04.png');",
                    "//                             refs.emptyTopImg.setSrc('resources/images/icon-maintop-04.png');",
                    "                            break;",
                    "                        default :",
                    "                            refs.topImg.setSrc('resources/images/icon-maintop-05.png');",
                    "//                             refs.emptyTopImg.setSrc('resources/images/icon-maintop-05.png');",
                    "                            break;",
                    "                    }",
                    "                }",
                    "",
                    "            }",
                    "",
                    "            // 비밀번호만료 알림",
                    "            var principal = SecurityUtils.getPrincipal();",
                    "            if (7 >= principal.remainPwChDt) {",
                    "                // 비밀번호 만료일까지 7일 이하일 경우, 비밀번호 변경 메시지 표시",
                    "                // 비밀번호만료일이 yyyy-mm-dd 입니다. 비밀번호를 변경해주세요",
                    "                refs.mainMsg.setHtml('알림');",
                    "                refs.subMsg.setHtml(Ext.String.format('비밀번호만료일 : <b>{0}</b> <br> 메뉴 : <b>환경설정-비밀번호변경</b>', principal.pwExpiredDt));",
                    "//                 refs.emptyMainMsg.setHtml('알림');",
                    "//                 refs.emptySubMsg.setHtml(Ext.String.format('비밀번호만료일 : <b>{0}</b> <br> 메뉴 : <b>환경설정-비밀번호변경</b>', principal.pwExpiredDt));",
                    "                refs.topImg.setSrc('resources/images/icon-maintop-01.png');",
                    "//                 refs.emptyTopImg.setSrc('resources/images/icon-maintop-01.png');",
                    "            }",
                    "",
                    "            // 근무지정",
                    "            if (result.wplInfo) {",
                    "                var wplInfo = result.wplInfo;",
                    "",
                    "                vm.set('wplInfo', wplInfo);",
                    "                refs.wplInfo.setHtml('현재근무지 : ' + wplInfo.wkplcNm);\t\t\t // 주 근무지명",
                    "                refs.todayInfo.setHtml(Ext.Date.format(new Date(), 'm.d(D)'));\t// 오늘 날짜",
                    "",
                    "            }",
                    "",
                    "            // 결재함정보",
                    "            if (result.aprInfo) {",
                    "                var aprInfo = result.aprInfo;",
                    "",
                    "                vm.set('aprInfo', aprInfo);",
                    "                refs.pendingBoxInfo.setHtml(aprInfo.pendingBoxCnt);\t\t// 미결함",
                    "                refs.progressBoxInfo.setHtml(aprInfo.progressBoxCnt);\t//진행함",
                    "",
                    "                if(aprInfo.pendingBoxCnt > 0){",
                    "                    refs.btnAprInfo.setIconCls('icon-main-05-new');",
                    "                }",
                    "                else{",
                    "                    refs.btnAprInfo.setIconCls('icon-main-05');",
                    "                }",
                    "            }",
                    "",
                    "            // 연수정보",
                    "            if (result.stnInfo) {",
                    "                var stnInfo = result.stnInfo;",
                    "",
                    "                vm.set('stnInfo', stnInfo);",
                    "                refs.stnNdpsPnt.setHtml(stnInfo.lowCrsPnt);",
                    "                refs.stnCmpPnt.setHtml(stnInfo.cmpCrsPnt);",
                    "",
                    "                if(!Ext.isEmpty(stnInfo.strdt) && !Ext.isEmpty(stnInfo.edt)){",
                    "                    var stnInfoTxt = refs.stnInfo.getText() + \" (\" + stnInfo.strdt.substring(0, 4) + \"-\" + stnInfo.strdt.substring(4, 6) + \" ~ \" + stnInfo.edt.substring(0, 4) + \"-\" + stnInfo.edt.substring(4, 6) + \")\";",
                    "                    refs.stnInfo.setText(stnInfoTxt);",
                    "                }",
                    "            }",
                    "",
                    "            // 월근태정보",
                    "            if (result.monthTotalGrid) {",
                    "                var monthTotalGrid = result.monthTotalGrid;",
                    "",
                    "                vm.set('monthTotalGrid', monthTotalGrid);",
                    "                refs.mthInfo.setHtml(new Date().getMonth()+1 + '월 근태정보');",
                    "                refs.ovtInfo.setHtml(monthTotalGrid.ovtDds);\t// 연장",
                    "                refs.hodInfo.setHtml(monthTotalGrid.hodDds);\t// 휴일",
                    "                refs.btrInfo.setHtml(monthTotalGrid.btrDds);\t// 출장",
                    "                refs.vctInfo.setHtml(monthTotalGrid.vctDds);\t// 휴가",
                    "            }",
                    "",
                    "            // 경비신청(법인카드)정보",
                    "            var cardInfo = result.cardInfo;",
                    "            var params = {",
                    "                    codeDvcd : 'CARD',",
                    "                    hrHrpmEmpId : SecurityUtils.getPrincipal().hrHrpmEmpId",
                    "                };",
                    "",
                    "            me.GET_CODELIST(params, me).then(function(result) {",
                    "                if(result.data.length > 0) {",
                    "                    // 등록된 카드가 있을경우",
                    "                    if (cardInfo != null) {",
                    "                        vm.set('cardInfo', cardInfo);",
                    "                        refs.cardInfo.setHtml(cardInfo);",
                    "                        refs.cardInfoContainer.setHidden(false);",
                    "                        refs.cardEmptyContainer.setHidden(true);",
                    "",
                    "                        if(cardInfo > 0){",
                    "                            refs.btnBgxInfo.setIconCls('icon-main-03-new');",
                    "                        }",
                    "                        else{",
                    "                            refs.btnBgxInfo.setIconCls('icon-main-03');",
                    "                        }",
                    "                    }",
                    "                } else {",
                    "                    vm.set('cardInfo', null);",
                    "                    refs.cardInfoContainer.setHidden(true);",
                    "                    refs.cardEmptyContainer.setHidden(false);",
                    "",
                    "                    refs.btnBgxInfo.setIconCls('icon-main-03');",
                    "                }",
                    "            });",
                    "",
                    "            // 법규준수정보",
                    "            if(result.cmplInfo > 0){",
                    "                refs.complianceIcon.setIconCls('icon-main-07-new');",
                    "            }",
                    "            else{",
                    "                refs.complianceIcon.setIconCls('icon-main-07');",
                    "            }",
                    "",
                    "",
                    "            // 공지사항",
                    "            var noticeInfo = result.noticeInfo;",
                    "            if(noticeInfo.subject) {",
                    "                vm.set('noticeInfo', noticeInfo);",
                    "                refs.noticeInfo.setHtml(noticeInfo.subject);\t// 제목표시",
                    "            } else {",
                    "                vm.set('noticeInfo', null);",
                    "                refs.noticeInfo.setHtml('최신 공지사항이 없습니다.');",
                    "            }",
                    "",
                    "            //painted 이벤트가 간헐적으로 잡히지 않아, 공지사항 세팅 시 높이 재설정하도록 추가해줌.",
                    "            //같은 내용이 noticeInfo의 container painted이벤트리스너에 존재함.",
                    "//             refs.emptyNoticeCnt.setHeight(refs.noticeInfo.up('container').el.getHeight());",
                    "",
                    "            //주간업무보고",
                    "            if(result.bwwInfo > 0){",
                    "                refs.bomWekWorkIcon.setIconCls('icon-main-11-new');",
                    "            }",
                    "            else{",
                    "                refs.bomWekWorkIcon.setIconCls('icon-main-11');",
                    "            }",
                    "",
                    "            var unReadData = null;",
                    "            // [푸시] 메뉴아이콘 뱃지",
                    "            Ext.Ajax.request({",
                    "                headers: {",
                    "                    viewId : me.getViewId(),",
                    "                    serviceId : 'BomTasSvc.findAllPushRvStcd'",
                    "                },",
                    "                scope: me,",
                    "                async : false,",
                    "                success: function(response) {",
                    "                    var res = Ext.JSON.decode(response.responseText);",
                    "                    if (res.total > 0) {",
                    "                        // 안읽은메시지",
                    "//                         refs.btnMenu.setStyle('background:url(\"resources/images/icon-com-notice.png\") no-repeat;background-position:37px 10px;');",
                    "                        refs.btnMenu.setIconCls('icon-com-menu-badge');",
                    "                        unReadData = res.page.content[0];",
                    "                    } else {",
                    "//                         refs.btnMenu.setStyle('background:none');",
                    "                        refs.btnMenu.setIconCls('icon-com-menu');",
                    "                    }",
                    "                }",
                    "            });",
                    "",
                    "            // 푸시상세팝업 호출",
                    "            var win = null;",
                    "            if (Property.BO_TASM_TRS_ID && Property.MSG_CHK_ACT_DVCD) {",
                    "                if (Property.MSG_CHK_ACT_DVCD == Constants.msgChkActDvcd.NORMAL) {",
                    "                    // 일반",
                    "                    win = Ext.create('BomTasPushDetailPopupM', {boTasmTrsId : Property.BO_TASM_TRS_ID});",
                    "                    me.mon(win, 'redirect', function(viewId) {",
                    "                        me.onRedirectPage(viewId);",
                    "                    }, me);",
                    "                } else if (Property.MSG_CHK_ACT_DVCD == Constants.msgChkActDvcd.APPROVAL) {",
                    "                    // 결재",
                    "                    win = Ext.create('BomTasPushDetailPopupM', {boTasmTrsId : Property.BO_TASM_TRS_ID});",
                    "                }",
                    "",
                    "                win.show();",
                    "",
                    "            } else if (unReadData != null) {",
                    "                if (unReadData.msgChkActDvcd == Constants.msgChkActDvcd.NORMAL) {",
                    "                    // 일반",
                    "                    win = Ext.create('BomTasPushDetailPopupM', {boTasmTrsId : unReadData.boTasmTrsId});",
                    "                    me.mon(win, 'redirect', function(viewId) {",
                    "                        me.onRedirectPage(viewId);",
                    "                    }, me);",
                    "                } else if (unReadData.msgChkActDvcd == Constants.msgChkActDvcd.APPROVAL) {",
                    "                    // 결재",
                    "                    win = Ext.create('BomTasPushDetailPopupM', {boTasmTrsId : unReadData.boTasmTrsId});",
                    "                }",
                    "",
                    "                win.show();",
                    "",
                    "            }",
                    "",
                    "            if(result.myTdyBizInfo){",
                    "",
                    "                vm.set('myTdyBizInfo', result.myTdyBizInfo);",
                    "",
                    "                refs.vctInfoCnt.setHtml(result.myTdyBizInfo.vctInfoCnt);",
                    "                refs.mtgInfoCnt.setHtml(result.myTdyBizInfo.mtgInfoCnt);",
                    "            }",
                    "",
                    "        }",
                    "});",
                    ""
                ]
            },
            "configAlternates": {
                "fn": "string",
                "implHandler": "code"
            },
            "name": "callMainSvc",
            "designerId": "4b4dc3d1-c4f0-4844-8e43-36903a6e40c8"
