                        "fn": "onGridSelect",
                        "implHandler": [
                            "var me = this,",
                            "    vm = me.getViewModel(),",
                            "    refs = me.getReferences(),",
                            "    grid = refs.grid,",
                            "    selectRecords = [],",
                            "    parentCrtl = me.view.parent.controller,",
                            "    naviView = me.getView().up('navigationview');",
                            "",
                            "for(var i in selected){",
                            "    selectRecords[i] = selected[i].data;",
                            "}",
                            "",
                            "var values = {",
                            "    /* 신청 정보가 여러개 일 순 없으므로 , 단건기준으로 작성함. */",
                            "    selectBgmExpNfcRecord : selectRecords[0]",
                            "};",
                            "vm.set('selectRecord', selectRecords[0]); \t// 상세조회결과에서 단건필터링을 위해서 저장 (웹에서 다건 작성시 aplSno로 구분)",
                            "",
                            "/*상세항목 조회*/",
                            "Ext.Ajax.request({",
                            "    headers : {",
                            "        serviceId : 'BgxNfmSvc.findAllBgmExpNfcDtl',",
                            "        viewId : me.view.parent.id",
                            "    },",
                            "    jsonData : values,",
                            "    success : function(response) {",
                            "        var res = Ext.JSON.decode(response.responseText),",
                            "            applyInfo = res.content.applyInfo,",
                            "            expItemInfo = applyInfo.expItemInfo,",
                            "            result = [];",
                            "",
                            "        for (var i in expItemInfo) {",
                            "            if (expItemInfo[i].aplSno == selectRecords[0].aplSno) {",
                            "                result.push(expItemInfo[i]);",
                            "            }",
                            "        }",
                            "        res.content.applyInfo.expItemInfo = result;",
                            "",
                            "        parentCrtl.fnChangeApplyForm(res.content, true);",
                            "    }",
                            "});"
                        ],
