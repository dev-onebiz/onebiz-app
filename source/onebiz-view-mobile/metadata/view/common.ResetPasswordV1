                                            "임시비밀번호보내기"
                                        ],
                                        "fn": "onResetPassword",
                                        "implHandler": [
                                            "var me = this,",
                                            "    refs = me.getReferences(),",
                                            "    form = refs.form,",
                                            "    values = form.getValues(),",
                                            "    emailRegEx = /^(\")?(?:[^\\.\"\\s])(?:(?:[\\.])?(?:[\\w\\-!#$%&'*+/=?^_`{|}~]))*\\1@(\\w[\\-\\w]*\\.){1,5}([A-Za-z]){2,6}$/;",
                                            "",
                                            "if (!(values.userId && values.email && emailRegEx.test(values.email))) {",
                                            "    Ext.Msg.alert('안내', '아이디, 이메일 주소를 입력하지 않았거나,<br />이메일 형식이 잘 못 되었습니다.');",
                                            "    return;",
                                            "}",
                                            "",
                                            "Ext.Ajax.request({",
                                            "    headers : {",
                                            "        serviceId : 'COMAPP0002U02M',",
                                            "        viewId : 'ResetPassword',",
                                            "    },",
                                            "    scope: me,",
                                            "    jsonData : {",
                                            "        sysCd : Property.SYS_CD,",
                                            "        cmgrpCd : Property.CMGRP_CD,",
                                            "        userId : values.userId,",
                                            "        compEmladr : values.email",
                                            "    },",
                                            "    success : function(res) {",
                                            "        var me = this;",
                                            "",
                                            "        Ext.Msg.show({",
                                            "            title: '비밀번호 재설정',",
                                            "            message: '이메일 주소로 임시비밀번호를 발송했습니다.<br />임시비밀번호로 로그인을 진행해주세요.',",
                                            "            scope: me,",
                                            "            fn : function(btn) {",
                                            "                if (btn == 'ok') {",
                                            "                    var me = this,",
                                            "                        refs = me.getReferences(),",
                                            "                        userId = refs.userId,",
                                            "                        email = refs.email,",
                                            "                        userIdValue = userId.getValue();",
                                            "",
                                            "                    userId.setValue('');",
                                            "                    email.setValue('');",
                                            "",
                                            "                    me.REDIRECT('LoginV1', {",
                                            "                        userId: userIdValue",
                                            "                    });",
                                            "                }",
                                            "            }",
                                            "        });",
                                            "    },",
                                            "    failure : function(res, me) {",
                                            "        var errMsg = '임시비밀번호 발행시 오류가 발생하였습니다.<br />관리자에게 문의바랍니다.';",
                                            "        if (res.status == 500) {",
                                            "            var responseJson = Ext.JSON.decode(res.responseText);",
                                            "            if (responseJson.hasOwnProperty('errMsg')) {",
                                            "                errMsg = responseJson.errMsg;",
                                            "            }",
                                            "",
                                            "            Ext.Msg.alert('비밀번호 재설정오류', errMsg);",
                                            "        }",
                                            "    }",
                                            "});"
                                        ],
