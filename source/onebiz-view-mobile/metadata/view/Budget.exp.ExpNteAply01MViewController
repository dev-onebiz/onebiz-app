            "codeClass": null,
            "userConfig": {
                "fn": "setGridTotal",
                "implHandler": [
                    "var me = this;",
                    "var refs = me.getReferences();",
                    "var grid = refs.grid;",
                    "var lblTotalCnt = refs.lblTotalCnt;",
                    "var records = grid.getStore().data.items;",
                    "var totalAmt = 0;",
                    "var totalCnt = 0;",
                    "",
                    "for (var i in records) {",
                    "    var record = records[i].data;",
                    "    if (record.selected === true) {",
                    "        if(record.canYn === 'N'){ // 정상건",
                    "            record.apvlAmtDom = String(record.apvlAmtDom).replace(/,/gi, '').replace(/ 원/gi, '').replace(/-/gi, '');",
                    "            totalAmt += Number(record.apvlAmtDom);",
                    "            totalCnt++;",
                    "        } else { // 취소건인 경우",
                    "            var cancelApvlAmtDom = String(record.apvlAmtDom).replace(/,/gi, '').replace(/ 원/gi, '').replace(/-/gi, '');",
                    "            totalAmt -= Number(cancelApvlAmtDom);",
                    "            totalCnt++;",
                    "        }",
                    "    }",
                    "}",
                    "",
                    "var strAmt = String(totalAmt);",
                    "var moneyAmt = strAmt.replace(/(\\d)(?=(?:\\d{3})+(?!\\d))/g, '$1,');",
                    "lblTotalCnt.setValue('<div style=\"width:100%;font-size:14px;\"><span style=\"display:inline-block;text-align:left;width:20%\">총</span><span style=\"display:inline-block;text-align:right;width:80%\">' + totalCnt + '건</span></div><div style=\"width:100%;font-size:14px;\">합계 <span style=\"text-align:right\">' + moneyAmt + '<span>원</div>');",
                    "",
                    ""
                ]
            },
