        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "내부함수 / 신청취소 시 유효성 검증"
                ],
                "fn": "fnValidateWhenCancelApply",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    grid = refs.grid,",
                    "    items = grid.getSelection().data;",
                    "",
                    "// 기본 체크",
                    "if (grid.getSelectionCount() == 0) {",
                    "    // E8008 : 선택된 {0} 없습니다.",
                    "    return Messages.getMessage('E8008', [ '행이' ]);",
                    "}",
                    "//end 기본 체크",
                    "",
                    "// 체크",
                    "//  - 자기 데이터가 아닌 것 체크(모바일은 본인만 가능)",
                    "if (items.hrHrpmEmpId != SecurityUtils.getPrincipal().hrHrpmEmpId) {",
                    "    // E8006 : {0} {1} 불가능 합니다",
                    "    return Messages.getMessage('E8006', [ '타인의 신청에 대해', '신청취소가' ]);",
                    "}",
                    "//  - end 자기 데이터가 아닌 것 체크",
                    "",
