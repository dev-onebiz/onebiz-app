        },
        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "신청서 / 보고서 보기"
                ],
                "designer|params": [
                    "component"
                ],
                "fn": "onClickActColumn",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    itemId = component.config.itemId; // 신청서 or 보고서",
                    "",
                    "var colName, className;",
                    "var record = component.config.scope.view.refs.grid.getSelection().data;",
                    "if (itemId == 'actAprHistApfData') {",
                    "    colName = 'comAprHistApfId';",
                    "    if (record.sttnAplStcd != Constants.sttnAplStcd.CANCELED) {",
                    "        className = 'HrdCrsAply71M';",
                    "    } else {",
                    "        className = 'HrdCrsInfo71M';",
                    "    }",
                    "",
                    "} else if (itemId == 'actAprHistReptData') {",
                    "    colName = 'comAprHistReptId';",
                    "    className = 'HrdCrsRept71M';",
                    "} else {",
                    "    return false;",
                    "}",
                    "",
                    "if (!record[colName] || record[colName] == -1) {",
                    "    Ext.Msg.alert('확인', Messages.getMessage('E9303', [ '신청/보고서' ]));",
                    "    return;",
                    "}",
                    "",
                    "Ext.Ajax.request({",
                    "    headers : {",
                    "        serviceId : 'COMAPR0001R04',",
                    "        viewId : me.getViewId(),",
                    "        scope : me",
                    "    },",
                    "    jsonData : {",
                    "        aprHistId : record[colName]",
                    "        // 결재이력ID",
                    "    },",
                    "    success : function(response, scope) {",
                    "        var res = Ext.JSON.decode(response.responseText),",
                    "            command = Constants.sanction.COMPLETED_BOX; // 아무 동작도 하지 않아야 하므로 완료.",
                    "",
                    "        me.menu.hide();\t\t// 메뉴닫기",
                    "",
                    "        var win = Ext.create(className, {",
                    "            command : command,",
                    "            aprHistId : res.aprHistId,",
                    "            aprHistData : Ext.decode(res.result),",
                    "            record : record",
                    "        });",
                    "        // 재조회",
                    "        me.mon(win, 'close', function(view) {",
                    "            me.onSelect(); // 재조회",
                    "        }, me);",
                    "        win.show();",
                    "",
                    "    }",
                    "});",
                    ""
                ]
            },
            "configAlternates": {
                "designer|commentHeader": "comment",
                "designer|params": "typedarray",
                "fn": "string",
                "implHandler": "code"
            },
            "name": "onClickActColumn",
            "designerId": "60091baf-668e-40a3-819e-ee9486268e18"
        },
        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "보고 / 보고취소"
                ],
                "designer|params": [
                    "button"
                ],
                "fn": "onReptData",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    grid = refs.grid,",
                    "    itemId = button.config.itemId,",
                    "    selectedData = grid.getSelection().data,",
                    "    naviView = me.getView().up('navigationview');",
                    "",
                    "/* 유효성 체크 */",
                    "//한 건만 보고/보고취소 가능",
                    "if (grid.getSelectionCount() > 1) {",
                    "    Ext.Msg.alert('알림', '보고취소는 한 건만 가능합니다.');",
                    "    return;",
                    "}",
                    "//본인것만 보고/보고취소 가능",
                    "if (selectedData.hrHrpmEmpId != SecurityUtils.getPrincipal().hrHrpmEmpId) {",
                    "    Ext.Msg.alert('알림', '보고취소는 본인 것만 가능합니다.');",
                    "    return;",
                    "}",
                    "switch (itemId) {",
                    "    case 'btnReptCancel':",
                    "        /** 보고취소 저장 함수 호출 */",
                    "        me.onReptCancelSave();",
                    "        break;",
                    "    case 'btnReptWrite':",
                    "        //설문조사 회차가 있고, 편집가능여부가 여",
                    "        if (!Ext.isEmpty(selectedData.boSvymTmrdId)) {",
                    "            if (selectedData.editYn != Constants.yesNo.NO) {",
                    "                Ext.Msg.alert('알림', '해당과정은 설문조사 완료 후 연수보고 작성이 가능합니다.<br>※설문조사는 웹에서 가능합니다.(모바일 구현 中)');",
                    "                return;",
                    "            }",
                    "        }",
                    "        //보고필수여부가 [부]인 경우 보고서 쓰지 않음",
                    "        if (!Ext.isEmpty(selectedData.reptNdpsYn) && selectedData.reptNdpsYn == Constants.yesNo.NO) {",
                    "            Ext.Msg.alert('알림', '해당과정은 보고서를 작성하지 않으셔도 됩니다.');",
                    "            return;",
                    "        }",
                    "        /* 화면이동 */",
                    "        me.PUSH_VIEW(naviView, {",
                    "            menuId  : 'HrdCrsRept02M',",
                    "            title   : '연수과정보고',",
                    "            records : grid.getSelected().items,",
                    "            isSubView : true,",
                    "            parentView : me.getView()",
                    "        });",
                    "        break;",
                    "}",
                    "",
                    "me.menu.hide();\t\t// 메뉴 닫기"
                ]
            },
            "configAlternates": {
                "designer|commentHeader": "comment",
                "designer|params": "typedarray",
                "fn": "string",
                "implHandler": "code"
            },
