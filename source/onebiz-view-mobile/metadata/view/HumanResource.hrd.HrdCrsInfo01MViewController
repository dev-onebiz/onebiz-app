        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "메뉴"
                ],
                "designer|params": [
                    "component, eOpts"
                ],
                "fn": "onActionSheetShow",
                "implHandler": [
                    "var me = component.config.scope,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences();",
                    "",
                    "// 열린화면이 연수보고인지 유효성체크",
                    "var home = Ext.ComponentQuery.query(Property.ROUTE_HOME);",
                    "if (home.length <= 0 || document.getElementsByClassName(\"x-navigationview-body-el\")[0].lastChild.id.indexOf('HrdCrsInfo01M') == -1) {\t\t// 로그인화면이거나 휴일근무신청화면이 아닌경우",
                    "    console.log('연수보고화면아님');",
                    "    Ext.Viewport.removeMenu('bottom', false);",
                    "} else {",
                    "    // 신청서가 선택되었는지 체크",
                    "    if (refs.grid && refs.grid.getSelection()) {",
                    "        // 하나만 선택되었는지 체크",
                    "        if (refs.grid.getSelectionCount() > 1) {",
                    "            Ext.Msg.alert('알림', '하나만 선택할 수 있습니다.');",
                    "            component.hide();",
                    "        }",
                    "",
                    "        var record = refs.grid.getSelection().data,",
                    "            items = component.getItems(),",
                    "            btnCancelApply = items.get('btnCancelApply'),\t\t\t// 신청취소",
                    "            btnReptWrite = items.get('btnReptWrite'),\t// 보고",
                    "            btnReptCancel = items.get('btnReptCancel'),\t// 보고취소",
                    "            actAprHistApfData = items.get('actAprHistApfData'),\t\t// 신청서보기",
                    "            actAprHistReptData = items.get('actAprHistReptData');\t// 보고서보기",
                    "",
                    "        if (record.stcd == Constants.stcd.DELETE) {",
                    "            btnCancelApply.setDisabled(true);",
                    "            btnReptWrite.setDisabled(true);",
                    "            btnReptCancel.setDisabled(true);",
                    "        } else {",
                    "            //신청취소 AREA",
                    "            //신청상태가 취소이면 Disabled",
                    "            if (record.sttnAplStcd == Constants.sttnAplStcd.CANCELED) {",
                    "                btnCancelApply.setDisabled(true);",
                    "            } else {",
                    "                btnCancelApply.setDisabled(false);",
                    "            }",
                    "",
                    "            //보고 AREA",
                    "            //신청상태가 완료가 아니면 Disabled",
                    "            if (record.sttnAplStcd != Constants.sttnAplStcd.COMPLETED) {",
                    "                btnReptWrite.setDisabled(true);",
                    "            }",
                    "            //보고 ID를 가지고 있을때 Disabled",
                    "            else if (record.hrHrdmStnEmpReptId) {",
                    "                //보고상태가 완료, 진행일 경우",
                    "                if ((record.reptAplStcd == Constants.aplStcd.COMPLETED_APPLY || record.reptAplStcd == Constants.aplStcd.PROGRESS_APPLY)) {",
                    "                    btnReptWrite.setDisabled(true);",
                    "                }",
                    "                //보고상태가 완료, 진행이 아닌경우",
                    "                else {",
                    "                    btnReptWrite.setDisabled(false);",
                    "                }",
                    "                if (record.hrHrpmEmpId != SecurityUtils.getPrincipal().hrHrpmEmpId) {",
                    "                    btnReptWrite.setDisabled(true);",
                    "                }",
                    "            } else {",
                    "                btnReptWrite.setDisabled(false);",
                    "                if (record.hrHrpmEmpId != SecurityUtils.getPrincipal().hrHrpmEmpId) {",
                    "                    btnReptWrite.setDisabled(true);",
                    "                }",
                    "            }",
                    "            //보고취소 AREA",
                    "            if (!record.hrHrdmStnEmpReptId) {",
                    "                btnReptCancel.setDisabled(true);",
                    "            } else if (record.hrHrpmEmpId != SecurityUtils.getPrincipal().hrHrpmEmpId) {",
                    "                btnReptCancel.setDisabled(true);",
                    "            } else if (record.reptAplStcd != Constants.aplStcd.COMPLETED_APPLY) {",
                    "                btnReptCancel.setDisabled(true);",
                    "            } else {",
                    "                btnReptCancel.setDisabled(false);",
                    "            }",
                    "        }",
                    "",
                    "        // 신청서 보기",
                    "        if (record.comAprHistApfId && record.comAprHistApfId != -1) {",
                    "            actAprHistApfData.setDisabled(false);",
                    "        } else {",
                    "            actAprHistApfData.setDisabled(true);",
                    "        }",
                    "        // 보고서 보기",
                    "        if (record.comAprHistReptId && record.comAprHistReptId != -1) {",
                    "            actAprHistReptData.setDisabled(false);",
                    "        } else {",
                    "            actAprHistReptData.setDisabled(true);",
                    "        }",
                    "    } else {",
                    "        // 행이 선택되지 않았을경우 예외처리",
                    "        var items = component.getItems(),",
                    "            btnCancelApply = items.get('btnCancelApply'),\t\t\t// 신청취소",
                    "            btnReptWrite = items.get('btnReptWrite'),\t// 보고",
                    "            btnReptCancel = items.get('btnReptCancel'),\t// 보고취소",
                    "            actAprHistApfData = items.get('actAprHistApfData'),\t\t// 신청서보기",
                    "            actAprHistReptData = items.get('actAprHistReptData');\t// 보고서보기",
                    "",
                    "        btnCancelApply.setDisabled(true);",
                    "        btnReptWrite.setDisabled(true);",
                    "        btnReptCancel.setDisabled(true);",
                    "        actAprHistApfData.setDisabled(true);",
                    "        actAprHistReptData.setDisabled(true);",
                    "    }",
                    "",
                    "}"
                ]
            },
            "configAlternates": {
                "designer|commentHeader": "comment",
                "designer|params": "typedarray",
                "fn": "string",
                "implHandler": "code"
            },
            "name": "onActionSheetShow",
            "designerId": "ec38f80e-f599-45e7-9296-9628da91c752"
        },
        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "신청취소"
                ],
                "fn": "onCancelApply",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    grid = refs.grid,",
                    "    items = grid.getSelection().data;",
                    "",
                    "//VALIDATION",
                    "var msg = me.fnValidateWhenCancelApply();",
                    "if (msg) {",
                    "    me.menu.hide();\t// 메뉴닫기",
