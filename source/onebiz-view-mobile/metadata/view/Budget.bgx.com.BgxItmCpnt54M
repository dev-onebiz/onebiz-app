        {
            "type": "viewcontrollereventbinding",
            "reference": {
                "name": "listeners",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "초기화"
                ],
                "fn": "onContainerInitialize",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    config = component.config;",
                    "",
                    "if (config && config.param) {",
                    "    var pViewData = config.param,",
                    "        expItemInputData = pViewData.expItemInputData;",
                    "",
                    "    if (!pViewData || !pViewData.expItemInputData) {",
                    "        me.onBtnClose();",
                    "    }",
                    "",
                    "    vm.set('expItemInputData', expItemInputData);",
                    "    vm.set('readOnlyFlag', pViewData.readOnlyFlag);",
                    "",
                    "    // 사용자",
                    "    if (pViewData.expItemInputData.expItemUserInfo) {",
                    "        var userInfos = pViewData.expItemInputData.expItemUserInfo,",
                    "            userList = [],",
                    "            innerEmpeCnt = 0,",
                    "            outerEmpeCnt = 0,",
                    "            param = {",
                    "                codeDvcdLists : ['BSNS_ASN'] //예산과목(배정받은 것)",
                    "            };",
                    "",
                    "        me.fnSelectAssignedCodeList(param, true).then(function(codeList){",
                    "            var bsnsCodeList = codeList.bsnsCodeAsnList;",
                    "",
                    "            for(var i in userInfos) {",
                    "                var bsnsNm = '',",
                    "                    bsnsId = userInfos[i].bgBudcBsnsId;",
                    "",
                    "                // 사업부문",
                    "                for (var j in bsnsCodeList) {",
                    "                    if (bsnsCodeList[j].bgBudcBsnsId == bsnsId) {",
                    "                        bsnsNm = bsnsCodeList[j].bsnsNm;",
                    "                    }",
                    "                }",
                    "                userInfos[i].bsnsNm = bsnsNm;",
                    "",
                    "                userList.push(userInfos[i]);",
                    "                refs.userCnt.add(Ext.create('BgxNfmAply52MItems', {",
                    "                    data : userInfos[i],",
                    "                    readOnlyFlag : vm.get('readOnlyFlag')",
                    "                }));",
                    "                switch (userInfos[i].stfDvcd) {",
                    "                    case Constants.stfDvcd.IN :",
                    "                        innerEmpeCnt++;",
                    "                        break;",
                    "                    case Constants.stfDvcd.OUT :",
                    "                        outerEmpeCnt++;",
                    "                        break;",
                    "                }",
                    "            }",
                    "",
                    "            // 계정과목",
                    "            if (expItemInputData.xpnitKeyNm) {",
                    "                refs.xpnitKeyNm.setValue(expItemInputData.xpnitKeyNm);",
                    "            }",
                    "",
                    "            vm.set('userList', userList);",
                    "            vm.set('tct', userInfos.length);",
                    "            vm.set('innerEmpeCnt', innerEmpeCnt);",
                    "            vm.set('outerEmpeCnt', outerEmpeCnt);",
                    "        });",
                    "    } else {",
                    "        vm.set('tct', 0);",
                    "        vm.set('innerEmpeCnt', 0);",
                    "        vm.set('outerEmpeCnt', 0);",
                    "    }",
                    "",
                    "}"
                ],
                "name": "initialize",
                "scope": "me"
