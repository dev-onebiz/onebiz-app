                            "",
                            "// del userData",
                            "var userList = {},",
                            "    data = item.getViewModel().data.data,",
                            "    len = 0;",
                            "for(var i in vm.get('userList')) {",
                            "    var tmp = vm.get('userList')[i];",
                            "    if (!(tmp.bgBudcBsnsId == data.bgBudcBsnsId && tmp.bsnsNm == data.bsnsNm && tmp.bsnsYy == data.bsnsYy && tmp.dpnm == data.dpnm && tmp.enpnm == data.enpnm && tmp.stfNm == data.stfNm && tmp.stfNo == data.stfNo)) {",
                            "        userList[len] = tmp;",
                            "        len++;",
                            "    }",
                            "}",
                            "vm.set('userList', userList);",
                            "",
                            "// 집계",
                            "vm.set('tct', Number(vm.get('tct'))-1);",
                            "switch (data.stfDvcd) {",
                            "    case Constants.stfDvcd.IN :",
                            "        vm.set('innerEmpeCnt', Number(vm.get('innerEmpeCnt'))-1);",
                            "        break;",
                            "    case Constants.stfDvcd.OUT :",
