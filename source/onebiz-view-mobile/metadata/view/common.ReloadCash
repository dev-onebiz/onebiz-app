                            "name": "MyButton6",
                            "designerId": "08e034b3-8e38-4d15-a737-c2c9465bcbfc",
                            "cn": [
                                {
                                    "type": "viewcontrollereventbinding",
                                    "reference": {
                                        "name": "listeners",
                                        "type": "array"
                                    },
                                    "codeClass": null,
                                    "userConfig": {
                                        "fn": "onReload",
                                        "implHandler": [
                                            "var me = this,",
                                            "    values = me.lookup('form').getValues(),",
                                            "    cacheDvcd = [];",
                                            "",
                                            "for (var key in values) {",
                                            "    if (values[key]) {",
                                            "        cacheDvcd.push(key);",
                                            "    }",
                                            "}",
                                            "",
                                            "me.resetMessage(); // 화면초기화",
                                            "",
                                            "Ext.Ajax.request({",
                                            "    headers: {",
                                            "        viewId: 'ReloadCash',",
                                            "        serviceId : 'ReloadCash'",
                                            "    },",
                                            "    jsonData : {",
                                            "        cacheDvcd: cacheDvcd",
                                            "    },",
                                            "    scope: me,",
                                            "    success: function(response) {",
                                            "        var me = this,",
                                            "            refs = me.getReferences(),",
                                            "            form = refs.form,",
                                            "            msgService = refs.msgService,",
                                            "            msgCode = refs.msgCode,",
                                            "            msgMessage = refs.msgMessage,",
                                            "            msgProperty = refs.msgProperty,",
                                            "            msgServicePolicy = refs.msgServicePolicy,",
                                            "            msgError = refs.msgError,",
                                            "            responseJson = Ext.JSON.decode(response.responseText),",
                                            "            result = responseJson.result;",
                                            "",
                                            "        if (result.hasOwnProperty('service')) {",
                                            "            if ('SUCCESS' === result.service) {",
                                            "                msgService.setValue(result.service);",
                                            "            }",
                                            "            else {",
                                            "                msgError.setHtml(msgError.getHtml() + '<br/>서비스갱신오류: ' + result.service);",
                                            "            }",
                                            "        }",
                                            "        if (result.hasOwnProperty('code')) {",
                                            "            if ('SUCCESS' === result.code) {",
                                            "                msgCode.setValue(result.code);",
                                            "            }",
                                            "            else {",
                                            "                msgError.setHtml(msgError.getHtml() + '<br/>코드 갱신오류: ' + result.code);",
                                            "            }",
                                            "        }",
                                            "        if (result.hasOwnProperty('message')) {",
                                            "            if ('SUCCESS' === result.message) {",
                                            "                msgMessage.setValue(result.message);",
                                            "            }",
                                            "            else {",
                                            "                msgError.setHtml(msgError.getHtml() + '<br/>메시지 갱신오류: ' + result.message);",
                                            "            }",
                                            "        }",
                                            "        if (result.hasOwnProperty('property')) {",
                                            "            if ('SUCCESS' === result.property) {",
                                            "                msgProperty.setValue(result.property);",
                                            "            }",
                                            "            else {",
                                            "                msgError.setHtml(msgError.getHtml() + '<br/>프로퍼티 갱신오류: ' + result.property);",
                                            "            }",
                                            "        }",
                                            "        if (result.hasOwnProperty('servicePolicy')) {",
                                            "            if ('SUCCESS' === result.servicePolicy) {",
                                            "                msgServicePolicy.setValue(result.servicePolicy);",
                                            "            }",
                                            "            else {",
                                            "                msgError.setHtml(msgError.getHtml() + '<br/>화면정책 갱신오류: ' + result.servicePolicy);",
                                            "            }",
                                            "        }",
                                            "    }",
                                            "});"
                                        ],
                                        "name": "tap",
                                        "scope": "me"
                                    },
                                    "configAlternates": {
                                        "fn": "string",
                                        "implHandler": "code",
                                        "name": "string",
                                        "scope": "string"
                                    },
                                    "name": "onReload",
                                    "designerId": "85e186e2-abc2-4782-a504-9597aef5c46f"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}