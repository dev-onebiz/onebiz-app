            "userConfig": {
                "fn": "initialize",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    gridDown = refs.gridDown;",
                    "",
                    "me.GET_CODELIST({stcd : \"01\" , codeDvcd : 'DEPTLV'})",
                    "    .then(function(records) {",
                    "    var store = me.getViewModel().get('DeptStore');",
                    "    store.add({text : \"- 전  체 -\", value : 999});",
                    "    store.add(records.data);",
                    "    refs.searchDept.setValue(SecurityUtils.getPrincipal().hrHrpmDeptId);",
                    "    me.onSelect(false);",
                    "",
                    "});",
                    "if(component.extenalEmpHidden){",
                    "    refs.tab.remove(refs.extenalEmp);",
                    "}",
                    "// 업무추진비 아닐 때, 외부직원 탭 막기 NTE011",
                    "var accItemCd = component.initialConfig.accItemCd;",
                    "if(accItemCd === '09'){ // 업무추진비",
                    "    refs.extenalEmp.setDisabled(false);",
                    "    refs.addBtn.setDisabled(false);",
                    "    refs.modifyBtn.setDisabled(false);",
                    "    refs.delBtn.setDisabled(false);",
                    "    refs.resetBtn.setDisabled(false);",
                    "",
                    "    refs.dpnm.setDisabled(false);",
                    "    refs.empePsitNm.setDisabled(false);",
                    "    refs.empeNo.setDisabled(false);",
                    "    refs.empeNm.setDisabled(false);",
                    "",
                    "} else {",
                    "    refs.extenalEmp.setDisabled(true);",
                    "    refs.addBtn.setDisabled(true);",
                    "    refs.modifyBtn.setDisabled(true);",
                    "    refs.delBtn.setDisabled(false);",
                    "    refs.resetBtn.setDisabled(true);",
                    "",
                    "    refs.dpnm.setDisabled(true);",
                    "    refs.empePsitNm.setDisabled(true);",
                    "    refs.empeNo.setDisabled(true);",
                    "    refs.empeNm.setDisabled(true);",
                    "}",
                    "",
                    "var gridData = component.initialConfig.gridData;",
                    "for(var i in gridData){",
                    "    this.getStore('SelectEmpStore').add(gridData[i]);",
                    "}",
                    ""
                ],
                "name": "initialize",
                "scope": "me"
            },
