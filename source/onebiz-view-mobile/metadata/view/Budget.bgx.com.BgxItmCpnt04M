                "fn": "onContainerInitialize",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    config = component.config;",
                    "",
                    "if(config) {",
                    "    vm.set('codeList', config.codeList);",
                    "    vm.set('applyInfo', config.applyInfo);",
                    "    vm.set('readOnlyFlag', config.readOnlyFlag);",
                    "    vm.set('expItemData', config.expItemData);",
                    "    vm.set('expItemData.trnsYy', config.expItemData.trnsDt.substr(0,4));",
                    "",
                    "    var expItemData = config.expItemData;",
                    "    if(expItemData) {",
                    "        refs.trnsDt.setValue(DateUtils.parseDate(expItemData.trnsDt) + ' ' + expItemData.trnsHr.substr(0,2) + ':' + expItemData.trnsHr.substr(2,2) + ':' + expItemData.trnsHr.substr(4,2));",
                    "//         refs.mcNm.setValue(expItemData.mcNm);",
                    "        refs.trnsAmt.setValue(FormatUtils.moneyFormat(expItemData.trnsAmt)+'원');",
                    "",
                    "        // 적요일자 자동기입",
                    "        var trnsDt = config.expItemData.trnsDt;",
                    "        var aplRscnText = trnsDt.substr(4, 2) + '/' + trnsDt.substr(6, 2);",
                    "        refs.common_input_container.getReferences().aplRscn.setValue(aplRscnText);",
                    "    }",
                    "",
                    "    me.setExpItemInputData();",
                    "}"
