            "userConfig": {
                "fn": "initialize",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences();",
                    "",
                    "var conferenceData = component.initialConfig;",
                    "",
                    "if(conferenceData.mtgDt) conferenceData.mtgDt = conferenceData.mtgDt.replace(/-/gi, '');;",
                    "if(conferenceData.mtgHr) conferenceData.mtgHr = conferenceData.mtgHr.replace(/:/gi, '');",
                    "",
                    "if(conferenceData.mtgDt) conferenceData.mtgDt = DateUtils.parseDate(conferenceData.mtgDt);",
                    "if(conferenceData.mtgHr) conferenceData.mtgHr = conferenceData.mtgHr.substring(0, 2)  + ':' + conferenceData.mtgHr.substring(2, 4);",
                    "vm.set('conference', conferenceData);",
                    "",
                    "refs.mtgDt.setValue(conferenceData.mtgDt);",
                    "refs.mtgHr.setValue(conferenceData.mtgHr);",
                    "",
                    "// 현황, 결재함의 경우 readOnly",
                    "if(conferenceData.conferenceView === true){",
                    "    refs.mtgDt.setHidden(true);",
                    "    refs.mtgHr.setHidden(true);",
                    "    refs.mtgPlcCntn.setReadOnly(true);",
                    "    refs.mtgTitCntn.setReadOnly(true);",
                    "    refs.mtgPtcpPrsn.setReadOnly(true);",
                    "    refs.mtgCntn.setReadOnly(true);",
                    "    refs.btnComplete.setHidden(true);",
                    "}",
                    "",
                    "if(conferenceData){",
                    "    refs.mtgPlcCntn.setValue(conferenceData.mtgPlcCntn);",
                    "    refs.mtgTitCntn.setValue(conferenceData.mtgTitCntn);",
                    "    refs.mtgPtcpPrsn.setValue(conferenceData.mtgPtcpPrsn);",
                    "    refs.mtgCntn.setValue(conferenceData.mtgCntn);",
                    "}",
                    "",
                    "",
                    ""
                ],
                "name": "initialize",
                "scope": "me"
            },
