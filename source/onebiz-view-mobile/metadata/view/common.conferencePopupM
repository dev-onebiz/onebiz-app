                                "fn": "onButtonTapOK",
                                "implHandler": [
                                    "var me = this,",
                                    "    refs  = me.getReferences(),",
                                    "    result = new Object(),",
                                    "    obj = new Object(),",
                                    "    validationMsg = '';",
                                    "",
                                    "for(var key in refs){",
                                    "    // 작성하지 않은 요소는 메시지로 표시",
                                    "    if(!refs[key].getValue() && key != 'btnComplete'){",
                                    "        validationMsg += refs[key].getLabel() + ' 을(를) 입력해주세요.<br>';",
                                    "    } else {",
                                    "        obj[key] = refs[key].getValue();",
                                    "    }",
                                    "}",
                                    "",
                                    "if(validationMsg.length > 0){",
                                    "    Ext.Msg.alert('필수값을 입력해주세요.', validationMsg);",
                                    "    return false;",
                                    "} else {",
                                    "    obj.success = true;",
                                    "}",
                                    "",
                                    "me.getView().fireEvent('selected', obj);",
                                    "me.getView().close();"
                                ],
