                                                "fn": "onButtonTap",
                                                "implHandler": [
                                                    "var me = this;",
                                                    "var vm = me.getViewModel();",
                                                    "var refs = me.getReferences();",
                                                    "if(refs.searchForm.getValue()==null || refs.searchForm.getValue()==''){",
                                                    "    refs.rankCtn.setHidden(false);\t// 많이보는 TOP5 컨텐츠 ",
                                                    "    refs.tbspacer.setHidden(false); // TOP5 - 최신소식 영역구분 바 ",
                                                    "    refs.recent.setHidden(false);\t// 최신소식 DisplayField",
                                                    "    refs.searchResult.setHidden(true); // 검색결과 Text",
                                                    "}",
                                                    "else {",
                                                    "    refs.rankCtn.setHidden(true);",
                                                    "    refs.tbspacer.setHidden(true);",
                                                    "    refs.recent.setHidden(true);",
                                                    "    refs.searchResult.setHidden(false);",
                                                    "}",
                                                    "",
                                                    "while (refs.cttCtn.items.items[2] != undefined)",
                                                    "      refs.cttCtn.items.items[2].destroy();",
                                                    "vm.initialConfig.view.config.searchText = refs.searchForm.getValue();",
                                                    "me.onPrintMgz();"
                                                ],
                                                "name": "tap",
                                                "scope": "me"
                                            },
