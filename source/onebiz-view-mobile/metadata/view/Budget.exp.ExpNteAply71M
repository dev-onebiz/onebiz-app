            "userConfig": {
                "fn": "Initialize",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    aprHistId = component.initialConfig.aprHistId,",
                    "    record = component.initialConfig.record,",
                    "    command = component.command,",
                    "    docData = component.docData,",
                    "    afterchange = docData.afterchange,",
                    "    items = afterchange.items,",
                    "    aplTct = afterchange.aplTct, // 건수",
                    "    aplTotSmamt = afterchange.aplTotSmamt, // render 합계금액",
                    "    str = String(aplTotSmamt),",
                    "    aplTotSmamtRender = str.replace(/(\\d)(?=(?:\\d{3})+(?!\\d))/g, '$1,'),",
                    "    fromDoc = component.initialConfig.fromDoc;",
                    "",
                    "if(fromDoc){",
                    "    var dd = record.aplDt;",
                    "    var aplDtRender = DateUtils.parseDate(dd); // 상신일 (기안한 날짜)",
                    "    refs.item_container.getViewModel().set('aplDt', aplDtRender);",
                    "} else {",
                    "    refs.item_container.getViewModel().set('aplDt', record.rgdt);",
                    "}",
                    "",
                    "items = me.recoveryFormRender(items);",
                    "",
                    "for(var i in items){",
                    "    items[i].isAply = true; // 결재 화면으로 사용하는 Items에서는 readOnly 처리하기 위해 사용하는 플래그",
                    "}",
                    "",
                    "var data = {",
                    "    aplTct : aplTct,",
                    "    aplTotSmamtRender : aplTotSmamtRender",
                    "};",
                    "",
                    "vm.set('data', data);",
                    "vm.set('records', items);",
                    "vm.set('afterchange', afterchange);",
                    "vm.set('docData', docData);",
                    "vm.set('aplTct', aplTct); // 건수",
                    "vm.set('aplTotSmamtRender', aplTotSmamtRender); // render 합계금액",
                    "",
                    "vm.set('aprHistId', aprHistId);",
                    "vm.set('record', record);",
                    "",
                    "refs.item_container.getViewModel().set('records', items);",
                    "refs.item_container.getViewModel().set('record', record);",
                    "refs.item_container.getViewModel().set('command', command);",
                    "refs.item_container.getViewModel().set('aprHistId', aprHistId);",
                    "refs.item_container.getViewModel().set('stlmDvcd', '법인카드');",
                    "refs.item_container.getViewModel().set('aply71', true);",
                    "",
                    "// 영수증 수 만큼 폼 반복 생성",
                    "refs.item_container.controller.addForm();",
                    "",
                    "// 결재문서 초기화 설정",
                    "ApprovalBoxSvc.setup({",
                    "    command   : command,",
                    "    viewModel : vm,",
                    "    aprHistId : aprHistId,",
                    "    edocCd    : 'ExpNteAply71',",
                    "    scope     : me",
                    "});"
                ],
                "name": "initialize",
                "scope": "me"
            },
