                "fn": "initialize",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences();",
                    "",
                    "var noticeData = component.initialConfig.records;",
                    "",
                    "//<이미지 태그 관련 로직>",
                    "//서버에서 전달해주는 상대주소를 사용 시, 현재 웹 주소에서 경로를 찾는 문제가 있어",
                    "//Property에 저장된 서버 주소를 결합하여 이미지를 찾도록 수정",
                    "var contentHtml = document.createElement('div');",
                    "contentHtml.innerHTML = noticeData.content;",
                    "",
                    "var imgList = contentHtml.getElementsByTagName('img'); //img태그 collection",
                    "for(var i = 0; i < imgList.length; i++) {",
                    "    //서버주소 + 상대주소",
                    "    imgList[i].setAttribute('src', Property.BASE_URL + imgList[i].getAttribute('src'));",
                    "}",
                    "",
                    "refs.title.setHtml(noticeData.title);",
                    "refs.regDt.setHtml(noticeData.regDt);",
                    "refs.content.setHtml(contentHtml);",
                    ""
                ],
                "name": "initialize",
                "scope": "me"
            },
