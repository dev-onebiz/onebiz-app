            },
            "codeClass": null,
            "userConfig": {
                "designer|params": [
                    "sicInfo",
                    "newValue",
                    "items",
                    "hiddenContainer"
                ],
                "fn": "setHiddenQuestContainer",
                "implHandler": [
                    "var me = this;",
                    "var vm = me.getViewModel();",
                    "",
                    "var canShowSubQuest = false;",
                    "// 부번호를 등록한 경우",
                    "// 요구 답변에 대해서 다른 답변인 경우 숨긴다.",
                    "for(var i in sicInfo){",
                    "    // 주번호에 대해서",
                    "    if(sicInfo[i].items[0].rn2 !== null && sicInfo[i].items[0].rn2 == '0'){",
                    "        // 부번호를 보여주는 조건",
                    "        if(newValue[i] == sicInfo[i].items[0].qstAnswer2 || sicInfo[i].items[0].qstAnswer2 === null){",
                    "            canShowSubQuest = true;",
                    "        }",
                    "        // 부번호를 숨기는 조건",
                    "        else{",
                    "            canShowSubQuest = false;",
                    "        }",
                    "    }",
                    "",
                    "    // 부번호에 hidden 여부 설정",
                    "    if(sicInfo[i].items[0].rn2 !== null && sicInfo[i].items[0].rn2 != '0'){",
                    "        if(canShowSubQuest){",
                    "            hiddenContainer[i] = false;",
                    "        }",
                    "        else{",
                    "            hiddenContainer[i] = true;",
                    "        }",
                    "    }",
                    "",
                    "    // 실제 hidden 값 변경",
                    "    // 주 번호의 내부로 찾아감",
                    "    if(sicInfo[i].items[0].rn2 !== null && sicInfo[i].items[0].rn2 == '0'){",
                    "        // 부 번호의 개수 만큼 반복",
                    "        for( var j in items){",
                    "            if(items[j].items.items.length > 0 && items[j].items.items[0].rn2 == '0' && sicInfo[i].items[0].qstNo == items[j].items.items[0].qstNo){",
                    "                for(var k = 4; k < items[j].items.items.length; k++){",
                    "                    if(canShowSubQuest){",
                    "                        items[j].items.items[k].setHidden(false);",
                    "                    }",
                    "                    else{",
                    "                        items[j].items.items[k].setHidden(true);",
                    "                    }",
                    "",
                    "                }",
                    "            }",
                    "        }",
                    "    }",
                    "}",
                    "vm.set('hiddenContainer',hiddenContainer);"
                ]
            },
            "configAlternates": {
