        {
            "type": "viewcontrollereventbinding",
            "reference": {
                "name": "listeners",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "fn": "onBomKlsDictPainted",
                "implHandler": [
                    "var me = this;",
                    "var vm = me.getViewModel();",
                    "var refs = me.getReferences();",
                    "var ctn = refs.termCtn;",
                    "",
                    "var termDvcd = vm.initialConfig.view.config.termDvcd;",
                    "if(termDvcd=='01'){",
                    "  refs.itSource.setHidden(false);",
                    "  refs.intro.setHtml('<div style=\"display:flex;align-items:center;\"><img src=\"/resources/images/kls/icon_25_study@2x.png\" style=\"width:25px;height:25px;margin-right:7px;\">하루에 하나씩 익혀볼까요?</div>');",
                    "} ",
                    "else{",
                    "    refs.fincSource.setHidden(false);",
                    "    refs.intro.setHtml('<div style=\"display:flex; align-items:center;\"><img src=\"/resources/images/kls/icon_25_study@2x.png\" style=\"width:25px;height:25px;margin-right:7px;\">금융 기초 지식을 탄탄하게!</div>');",
                    "}",
                    "ctn.bodyElement.on('scroll',function(){",
                    "    me.onScrollEvent();",
                    "});",
                    "if(vm.initialConfig.view.config.searchText!=undefined){\t\t// BomKlsSearch 화면에서 더보기를 통해 올 경우 검색창에 setValue",
                    "    refs.searchForm.setValue(vm.initialConfig.view.config.searchText);",
                    "}",
                    "me.onSelect();"
                ],
                "name": "painted",
                "scope": "me"
            },
            "configAlternates": {
                "fn": "string",
                "implHandler": "code",
                "name": "string",
                "scope": "string"
            },
            "name": "onBomKlsDictPainted",
            "designerId": "9ad66a99-bfc7-4b98-8fbc-a97aa91ef1de"
