            "codeClass": null,
            "userConfig": {
                "designer|params": [
                    "crud",
                    "selectedRecord"
                ],
                "fn": "fnCardInit",
                "implHandler": [
                    "var me = this;",
                    "var refs = me.getReferences();",
                    "var vm = me.getViewModel();",
                    "",
                    "var principal = SecurityUtils.getPrincipal();",
                    "",
                    "vm.set('crud', crud);",
                    "",
                    "",
                    "//신규인 경우",
                    "if (vm.get('crud') == Constants.crudState.CREATE) {",
                    "",
                    "    refs.btnCancel.setHidden(true);",
                    "    refs.btnClose.setHidden(false);",
                    "    refs.btnFindAllUser.setHidden(false);",
                    "    refs.btnFindUserAtnd.setHidden(false);",
                    "    refs.btnDeleteUser.setHidden(true);",
                    "",
                    "    vm.set('record.priority',3);",
                    "",
                    "}",
                    "//변경인 경우",
                    "else if (vm.get('crud') == Constants.crudState.UPDATE) {",
                    "    vm.set('selectedRecord',selectedRecord);",
                    "    vm.set('selectedRecord.boTasmTrsId',selectedRecord.id);",
                    "",
                    "",
                    "    refs.btnCancel.setHidden(false);",
                    "    refs.btnClose.setHidden(true);",
                    "    refs.btnFindAllUser.setHidden(true);",
                    "    refs.btnFindUserAtnd.setHidden(true);",
                    "    refs.btnDeleteUser.setHidden(false);",
                    "",
                    "",
                    "",
                    "    Ext.Ajax.request({",
                    "        headers : {",
                    "          serviceId : 'BomTasSvc.findAllBomTasmTrsDtl',",
                    "          viewId : me.getViewId(),",
                    "          scope : me",
                    "        },",
                    "        jsonData : selectedRecord,",
                    "        scope : me,",
                    "        success : function(response) {",
                    "            var res = Ext.JSON.decode(response.responseText);",
                    "            res.result[0].content = res.result[0].content.replace(/<br\\s*\\/?>/gi,'\\n');",
                    "            vm.set('record', res.result[0]);",
                    "        }",
                    "      });",
                    "",
                    "    Ext.Ajax.request({",
                    "        headers : {",
                    "          serviceId : 'BomTasSvc.findAllBomTasiTrs',",
                    "          viewId : me.getViewId(),",
                    "          scope : me",
                    "        },",
                    "        jsonData : vm.get('selectedRecord'),",
                    "        scope : me,",
                    "        success : function(response) {",
                    "            var res = Ext.JSON.decode(response.responseText);",
                    "            var content = res.result;",
                    "",
                    "            vm.set('cardItem.gridData', []);",
                    "",
                    "            for(var i in content){",
                    "                vm.get('cardItem.gridData').push(content[i]);",
                    "",
                    "                vm.get('cardItem.gridData')[i].formattedEmpeNm =",
                    "                    Ext.String.format('{0}({1})', content[i].rcvrNm, content[i].dpnm);",
                    "",
                    "                vm.get('cardItem.gridData')[i].stfDvcd = '01';",
                    "                vm.get('cardItem.gridData')[i].stfDvcdNm = '내부직원';",
                    "",
                    "",
                    "            }",
                    "            vm.set('hrHromJasPrjStore', vm.get('cardItem.gridData')); // 중요",
                    "            vm.set('cardItem.hrHromJasPrjList', vm.get('cardItem.gridData'));",
                    "",
                    "        }",
                    "      });",
                    "",
                    "",
                    "",
                    "",
                    "}",
                    ""
                ]
            },
