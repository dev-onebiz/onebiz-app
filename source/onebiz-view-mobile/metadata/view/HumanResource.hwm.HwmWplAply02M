                ],
                "fn": "Initialize",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences();",
                    "",
                    "// 안내팝업",
                    "var win = Ext.create('InfoPopupM');",
                    "win.getReferences().message.setHtml('<b>1. 근무지 변경 신청</b><br />'",
                    "        + '<span style=\"margin-left: 10px;\">가. 본인 근무지가 변경될 경우 신청 必.</span><br />'",
                    "        + '<span style=\"margin-left: 10px;\">나. 신청 유형을 근무지 변경으로 선택 후 근무지 변경 정보를 입력.</span><br />'",
                    "        + '<span style=\"margin-left: 10px;\">다. 현재 및 변경 근무지에서 근무하게 될 기간, 변경 사유 입력.</span><br />'",
                    "        + '<br />'",
                    "        + '<b>2. 근무일정 변경 신청</b><br />'",
                    "        + '<span style=\"margin-left: 10px;\">가. 동일 근무지에서 근무일정 변경이 발생할 경우 신청 必.</span><br />'",
                    "        + '<span style=\"margin-left: 10px;\">나. 신청 유형을 근무일정 변경으로 선택 후 근무일정 변경 정보를 입력.</span><br />'",
                    "        + '<br />'",
                    "        + '<b>3. 기타</b><br />'",
                    "        + '<span style=\"margin-left: 10px;\">가. 근무지 변경을 하지 않을 경우 출.퇴근 체크가 원활하게 되지 않으니 신청 必.</span><br />'",
                    "        + '<span style=\"margin-left: 10px;\">나. 직원당 하나의 근무지만 설정 원칙. </span><br />'",
                    "        + '<span style=\"margin-left: 10px;\">다. 추가 근무지 필요시 소속 부서장(팀장) 보고 후 인사담당자 연락 요망</span><br />'",
                    "        );",
                    "win.show();",
                    "",
                    "// 초기화",
                    "var items = component.records,",
                    "    aplTotSmamt = 0;",
                    "",
                    "me.setParentView(component.parentView);",
                    "",
                    "var componentList = [",
                    "    'hrHrpmEmpId'",
                    "    ,'hrWrkmWkplcId'",
                    "    ,'wkplcNm'",
                    "    ,'wkplcDvcd'\t// 근무지구분",
                    "    ,'stcd'\t\t\t// 근무지상태구분",
                    "    ,'strdt'",
                    "    ,'edt'",
                    "    ,'rmrkCntn'",
                    "    ,'hrWrkmEmpWkplcApfId'",
                    "    ,'comAprHistId'",
                    "    ,'aplDtm'",
                    "    ,'aplStcd'\t\t// 신청상태구분",
                    "];",
                    "",
                    "if(items.length == 0){",
                    "    // 신청자",
                    "    var principal = SecurityUtils.getPrincipal();",
                    "    var ovwUsr = principal.hrHrpmEmpId+\" / \"+ principal.dpnm + \" / \" + principal.empeNm +\" / \" + principal.empePsitNm;",
                    "    refs.rqpr.setValue(ovwUsr);",
                    "",
                    "    refs.hrHrpmEmpId.setValue(principal.hrHrpmEmpId);",
                    "    refs.dpnm.setValue(principal.dpnm);",
                    "    refs.empeNm.setValue(principal.empeNm);",
                    "    refs.empePsitNm.setValue(principal.empePsitNm);",
                    "",
                    "    // 사원 조회",
                    "    if (SecurityUtils.hasRole(['ROLE_HR_DLDR','ROLE_HR_GAFR'])) {",
                    "        refs.btnFindUser.setHidden(false);",
                    "    } else {",
                    "        refs.btnFindUser.setHidden(true);",
                    "    }",
                    "",
                    "    // 신청유형",
                    "    var code = 'HWM019',",
                    "        wplcAplDvcdStore = vm.storeInfo.wplcAplDvcd,",
                    "        aplDvcdStore = vm.storeInfo.aplDvcd;",
                    "    refs.wplcAplDvcd.setStore(me.getCode(code, wplcAplDvcdStore));",
                    "    refs.wplcAplDvcd.setValue(Constants.wplcAplDvcd.WK_PLC);",
                    "",
                    "    refs.stcd.setValue(Constants.stcd.NORMAL);\t\t\t\t// 근무지상태",
                    "",
                    "    me.onSelect();",
                    "",
                    "    // 신청구분",
                    "    code = 'HWM009';",
                    "    refs.aplDvcd.setStore(me.getCode(code, aplDvcdStore));",
                    "    refs.aplDvcd.setValue(Constants.wrkAplDvcd.APPLY);",
                    "",
                    "    vm.check = \"\";",
                    "    var date = new Date();",
                    "    var nHour = date.getHours();",
                    "    nHour = nHour  < 10 ? '0'+nHour :  nHour;",
                    "    var nMin = date.getMinutes();",
                    "    nMin = nMin  < 10 ? '0'+nMin :  nMin;",
                    "    var nSec = date.getSeconds();",
                    "    nSec = nSec  < 10 ? '0'+nSec :  nSec;",
                    "    refs.aplDt.setValue(Ext.Date.format(date,'Ymd'));\t\t// 신청일자",
                    "    refs.aplTm.setValue(nHour+\"\"+nMin+\"\"+nSec);\t\t\t\t// 신청시간",
                    "",
                    "}",
                    "",
                    "ApprovalBoxSvc.setup({",
                    "    command   : Constants.sanction.DRAFT,",
                    "    viewModel : vm,",
                    "    edocCd    : 'HwmWplAply71',",
                    "    scope     : me",
                    "});"
                ],
