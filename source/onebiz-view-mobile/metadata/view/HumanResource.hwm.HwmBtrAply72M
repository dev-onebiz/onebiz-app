                                                            "var btrStrtmFmt = DateUtils.parseTime(btrStrtm.substring(0, btrStrtm.length-2));// 출장출발시간",
                                                            "var btrEdtmFmt = DateUtils.parseTime(btrEdtm.substring(0,btrEdtm.length-2));\t\t// 출장도착시간",
