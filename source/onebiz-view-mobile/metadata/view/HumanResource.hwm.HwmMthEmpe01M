                                                    "codeClass": null,
                                                    "userConfig": {
                                                        "designer|params": [
                                                            "value",
                                                            "record",
                                                            "dataIndex",
                                                            "cell",
                                                            "column"
                                                        ],
                                                        "fn": "renderer",
                                                        "implHandler": [
                                                            "var week = new Array('일','월','화','수','목','금','토');",
                                                            "var data =record.data ;",
                                                            "",
                                                            "var nowDate = new Date();",
                                                            "nowDate.setYear(data.wrkDt.substr(0,4));",
                                                            "nowDate.setMonth(data.wrkDt.substr(4,2)*1 -1);",
                                                            "nowDate.setDate( data.wrkDt.substr(6,2));",
                                                            "",
                                                            "var day = nowDate.getDay();",
                                                            "var color = (day === 0 ? 'red' : (day == 6 ? 'blue' : 'black'));",
                                                            "color = (data.hldYn == 1 && data.rmrkCntn !== null ? 'red' : color );",
                                                            "",
                                                            "var result = '<div style=\"width: 30%; height : 100%; display:table-cell;padding:0px;\" ><div style=\"font-size:30px\">'+nowDate.getDate()+'일</div>' +",
                                                            "             '<span><font color=\"'+color+'\">('+week[nowDate.getDay()] +')</font>' +",
                                                            "            ((data.rmrkCntn !== null && data.rmrkCntn !== undefined) ? '<font color=\"'+color+'\">' +data.rmrkCntn +'</font></span></div>':\"\" )+'</span></div>';",
                                                            "",
                                                            "// var result = '<div style=\"float:left;width: 30%; height : 100%;\" ><span style=\"font-size:30px\">'+nowDate.getDate()+'일</span>' +",
                                                            "//              ' <br><span><font color=\"'+color+'\">('+week[nowDate.getDay()] +')</font>' +",
                                                            "//             ((data.rmrkCntn !== null && data.rmrkCntn !== undefined) ? '<font color=\"'+color+'\">' +data.rmrkCntn +'</font>':\"\" )+'</span></div>';",
                                                            "var chulgun = (data.wrkStrtm === null ? \"\" : \"출근 : \" + data.wrkStrtm.substring(0,2) + \"시 \" + data.wrkStrtm.substring(2,4) + \"분\");",
                                                            "// var tueGun = (data.wrkEdtm === null ? \"\" : \"퇴근 : \" + data.wrkEdtm.substring(0,2) + \"시 \" + data.wrkEdtm.substring(2,4) + \"분\");",
                                                            "",
                                                            "var ovtChk = (Ext.isEmpty(data.ovtChk) ? \"\" : \"<span style='height:100%;'>근무확인 : </span><br><span>\" + data.ovtChk + \"</span>\");",
                                                            "",
                                                            "// 근무지 정보 추가",
                                                            "var wkplcNm = (data.wkplcNm == null) ? \"\" : \"근무지 : \" + data.wkplcNm;",
                                                            "",
                                                            "// result += '<div style=\"width: 40%;\"><span>'+chulgun+'</span> ' + '<br><span>'+tueGun+'&nbsp </span>' + '<br><span>'+ wkplcNm + '</span></div>';",
                                                            "result += '<div style=\"height:100%;display:table-cell;padding:0px;\"><div>'+chulgun+'</div><div>' + ovtChk + '</div><div>'+ wkplcNm + '</div>';",
                                                            "",
                                                            "var workData = {'outYn' : '외근',",
                                                            "                'btrYn' : '출장',",
                                                            "                'lateYn' : '지각',",
                                                            "                'elvYn' : '조퇴',",
                                                            "                'absnYn' : '결근',",
                                                            "                'vctYn' : '휴가',",
                                                            "                'ovtYn' : '연장근무',",
                                                            "                'hodYn' : '휴일근무'};",
                                                            "",
                                                            "var styleColumn = 'float:left; margin : 0 5px 0 0;';",
                                                            "",
                                                            "var styleValue =  'font-size:13px;'+",
                                                            "    'font-weight:bold;'+",
                                                            "    'width:100%;'+",
                                                            "    'overflow: hidden;'+",
                                                            "    'white-space:nowrap;'+",
                                                            "    'text-overflow:ellipsis;'+",
                                                            "    'text-align:center;'+",
                                                            "    'display:inline-block;';",
                                                            "",
                                                            "var emptyChk = true;",
                                                            "",
                                                            "var etcInfo = '<div style=\"width: 100%;\">';",
