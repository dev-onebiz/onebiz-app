                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    store = vm.get('ExpNteConf01Store'),",
                    "    platform = null,",
                    "    model = null,",
                    "    uuid = null,",
                    "    version = null,",
                    "    manufacturer = null,",
                    "    serial = null;",
                    "",
                    "try {",
                    "    version = Property.MOBILE_VERSION;",
                    "    // 서버와 앱버전이 상이할 경우",
                    "    if (Property.MOBILE_VERSION != Property.MOBILE_SERVER_VERSION) {",
                    "        version += ' <img src=\"resources/images/new.png\" />';",
                    "    }",
                    "    platform = device.platform + ' ' + device.version;",
                    "    model = device.model;",
                    "    uuid = device.uuid;",
                    "    manufacturer = device.manufacturer;",
                    "    serial = device.serial;",
                    "} catch(error) {",
                    "",
                    "}",
                    "",
                    "store.add([",
                    "    {",
                    "        name  : 'version',",
                    "        text  : '버전',",
                    "        value : version",
                    "    },",
                    "    {",
                    "        name  : 'platform',",
                    "        text  : '플랫폼',",
                    "        value : platform",
                    "    }, {",
                    "        name  : 'model',",
                    "        text  : '모델명',",
                    "        value : model",
                    "    }, {",
                    "        name  : 'serial',",
                    "        text  : '모델번호',",
                    "        value : serial",
                    "    },",
