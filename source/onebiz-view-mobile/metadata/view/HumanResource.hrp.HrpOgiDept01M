                                        ],
                                        "fn": "renderer",
                                        "implHandler": [
                                            "",
                                            "var data = record.data;",
                                            "var infoData = '';",
                                            "",
                                            "// 직책 = 부장, 팀장, 부장대우 (HRP005) -> 직책으로 표시",
                                            "if(data.empeRsbCd && data.empeRsbCd === '001' || data.empeRsbCd === '002' || data.empeRsbCd === '010'){",
                                            "    infoData = data.empeNm + '  ' +  data.empeRsbNm;",
                                            "} else { // 그 외 -> 직위로 표시",
                                            "    infoData = data.empeNm + '  ' +  data.empePsitNm;",
                                            "}",
                                            "",
                                            "var neson = data.neson;",
                                            "var phone = data.phone;",
                                            "",
                                            "if(phone && phone.length === 11)",
                                            "    phone = phone.substr(0, 3) + '-' + phone.substr(3, 4) + '-' + phone.substr(7, 4);",
                                            "if(phone && phone.length === 10)",
                                            "    phone = phone.substr(0, 3) + '-' + phone.substr(3, 3) + '-' + phone.substr(6, 4);",
                                            "",
                                            "if(neson && neson.length === 11)",
                                            "    neson = neson.substr(0, 3) + '-' + neson.substr(3, 4) + '-' + neson.substr(7, 4);",
                                            "if(neson && neson.length === 10)",
                                            "    neson = neson.substr(0, 3) + '-' + neson.substr(3, 3) + '-' + neson.substr(6, 4);",
                                            "",
                                            "// E-Mail // phone",
                                            "var dtlInfoDt = 'E-mail. ' + (data.compEmladr === null ? '-' : data.compEmladr ) + '<br>' +",
                                            "    'T. ' +( neson === null ? '-' : neson )  + '<br>H.' + ( phone === null ? '-' : phone );",
                                            "",
                                            "// 사진",
                                            "var tmpImg = data.imgSrc;",
                                            "var getImgByHttp = '';",
                                            "",
                                            "if(tmpImg.indexOf('down') > -1){",
                                            "    getImgByHttp = Property.BASE_URL + tmpImg;",
                                            "} else {",
                                            "    getImgByHttp = tmpImg;",
                                            "}",
                                            "",
                                            "/*",
                                            "사진",
                                            "이름 직위(직책)",
                                            "이메일 근무지전화 휴대폰번호",
                                            "*/",
                                            "",
                                            "var result = '<div class=\"thumb\" style=\"float:left;\" ><img style=\"height : 80px; margin-right: 10px; width:70px;\" src=\"' + getImgByHttp + '\" /></div>';",
                                            "result += '<div style=\"float:left;\"><span style=\"font-size:15px;font-weight:bold;width:100%;overflow: hidden;white-space:nowrap;text-overflow:ellipsis;display:inline-block;\">'+infoData+'</span><br>';",
                                            "result += '<span>' +dtlInfoDt+ '</span>' +'</div>';",
                                            "",
                                            "result = '<div class=\"thumb-wrap\" id=\"code-{empeRsbCd}\">' + result + '</div>';",
                                            "cell.setStyle('padding:0px;');",
                                            "return result;"
                                        ]
                                    },
