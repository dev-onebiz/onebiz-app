    "cn": [
        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "월별 급여명세서 변경"
                ],
                "designer|params": [
                    "paySeq"
                ],
                "fn": "onSelect",
                "implHandler": [
                    "var me = this;",
                    "var vm = me.getViewModel();",
                    "var refs = me.getReferences();",
                    "var principal = SecurityUtils.getPrincipal();",
                    "",
                    "//PARAM SET",
                    "var params = {",
                    "    hrHrpmCompId : principal.hrHrpmCompId, //회사",
                    "    comCmmCmgrpId : principal.cmgrpId, //그룹회사ID",
                    "    comCmmSystemId : principal.sysId, //시스템ID",
                    "    hrHrpmEmpId : principal.hrHrpmEmpId, //사번",
                    "    yyyyMM : DateUtils.encodeDate(refs.yearMonth.getValue(), 'Ym'),//년월",
                    "    paySeq : !Ext.isEmpty(paySeq) ? paySeq : 0",
                    "};",
                    "//END PARAM SET",
                    "",
                    "//Service 호출",
                    "Ext.Ajax.request({",
                    "    headers : {",
                    "        serviceId : 'HroSalSvc.findOneHroSalSpec',",
                    "        viewId : me.getViewId(),",
                    "    },",
                    "    jsonData : params,",
                    "    scope : me,",
                    "    success : function(response) {",
                    "        var res = Ext.JSON.decode(response.responseText);",
                    "        // 합계, 최종 금액 출력",
                    "        var year = '', month = '';",
                    "        var date = refs.yearMonth.getValue();",
                    "        year = date.getFullYear();",
                    "        if(date.getMonth() >= 9)",
                    "            month = (date.getMonth()+1);",
                    "        else",
                    "            month = '0' + (date.getMonth()+1);",
                    "",
                    "        if(Ext.isEmpty(paySeq)){",
                    "            if(res.paySeqInfo.length > 0){",
                    "                ComboboxUtils.makeCustomCbx(refs.cbxPaySeq, []); // 검색조건에 설정",
                    "                ComboboxUtils.makeCustomCbx(refs.cbxPaySeq, res.paySeqInfo); // 검색조건에 설정",
                    "//                 refs.cbxPaySeq.setValue(res.paySeqInfo[0].value);",
                    "                refs.cbxPaySeq.setDisabled(false);",
                    "                return;",
                    "            }",
                    "            else{",
                    "                ComboboxUtils.makeCustomCbx(refs.cbxPaySeq, []); // 검색조건에 설정",
                    "                refs.cbxPaySeq.setValue(null);",
                    "                refs.cbxPaySeq.setDisabled(true);",
                    "            }",
                    "        }",
                    "",
                    "        // 합계액 초기화",
                    "        if(!Ext.isEmpty(res.paySeqInfo)){",
                    "            refs.tot01.setHtml(FormatUtils.moneyFormat(res.salInfoList[2]['m'+month]) +' 원');",
                    "            refs.pay01.setHtml(FormatUtils.moneyFormat(res.salInfoList[0]['m'+month]) +' 원');",
                    "            refs.pay02.setHtml(FormatUtils.moneyFormat(res.salInfoList[0]['m'+month]) +' 원');",
                    "            refs.ded01.setHtml(FormatUtils.moneyFormat(res.salInfoList[1]['m'+month]) +' 원');",
                    "            refs.ded02.setHtml(FormatUtils.moneyFormat(res.salInfoList[1]['m'+month]) +' 원');",
                    "//             refs.print.setHidden(false);",
                    "        }",
                    "        else{",
                    "            refs.tot01.setHtml('-'); \t// 차인지급액",
                    "            refs.pay01.setHtml('-'); \t// 지급합계액",
                    "            refs.pay02.setHtml('-'); \t// 지급합계액",
                    "            refs.ded01.setHtml('-'); \t// 공제합계액",
                    "            refs.ded02.setHtml('-'); \t// 공제합계액",
                    "//             refs.print.setHidden(true);\t// 인쇄 버튼 숨김",
                    "            Ext.Msg.alert('알림','해당월에 급여정보가 없습니다.');",
                    "        }",
                    "",
                    "        // 개인정보 초기화",
                    "        if(!Ext.isEmpty(res.empeInfo)){",
                    "            var userNm = res.empeInfo.empeNm + ' ' + res.empeInfo.empePsitNm; \t// 이름 직위",
                    "            refs.cmgrpNm.setHtml(res.empeInfo.compNm); \t\t\t\t\t\t\t// 회사명",
                    "            refs.userNm.setHtml(userNm); \t\t\t\t\t\t\t\t\t\t// 이름 직위 (사번)",
                    "            refs.dpnm.setHtml(res.empeInfo.dpnm); \t\t\t\t\t\t\t\t// 부서",
                    "            refs.etcoDt.setHtml(DateUtils.parseDate(res.empeInfo.etcoDt)); \t\t// 입사일자",
                    "        }",
                    "        else{",
                    "            refs.cmgrpNm.setHtml('-'); \t// 회사명",
                    "            refs.userNm.setHtml('-'); \t// 이름 직위 (사번)",
                    "            refs.dpnm.setHtml('-'); \t// 부서",
                    "            refs.etcoDt.setHtml('-'); \t// 입사일자",
                    "        }",
                    "",
                    "        // 지급, 공제, 근태 내역",
                    "        var tmpPayInfo = [];\t// 지급내역",
                    "        var tmpDedInfo = [];\t// 공제내역",
                    "        var tmpWrksInfo = [];\t// 근태내역",
                    "",
                    "        //지급내역 설정",
                    "        if (!Ext.isEmpty(res.payInfo)) {",
                    "            var tmpPayInfoAll = [];",
                    "",
                    "            for(var i in res.payInfo){",
                    "                tmpPayInfoAll.push(res.payInfo[i]);",
                    "            }",
                    "            for(var i in tmpPayInfoAll){",
                    "                if(typeof(tmpPayInfoAll[i]) === 'string' && Ext.isEmpty(tmpPayInfoAll[i].trim())){",
                    "                    continue;",
                    "                }",
                    "                else{",
                    "                    tmpPayInfo.push(tmpPayInfoAll[i]);",
                    "                }",
                    "            }",
                    "        }",
                    "",
                    "        // 컨테이너 컨텐츠",
                    "        var payname  = [];",
                    "        var payvalue = [];",
                    "",
                    "        for(var i in tmpPayInfo){",
                    "            if(i % 2 === 0){",
                    "                payname.push({",
                    "                    xtype: 'container',",
                    "                    style: 'font-size:min(4vw,16px);',",
                    "                    html: tmpPayInfo[i],",
                    "                    padding: '5vw',",
                    "                });",
                    "            }",
                    "            else{",
                    "                payvalue.push({",
                    "                    xtype: 'container',",
                    "                    style: 'font-size:min(4vw,16px); text-align:right;',",
                    "                    html: FormatUtils.moneyFormat(tmpPayInfo[i]) + '원',",
                    "                    padding: '5vw',",
                    "                });",
                    "            }",
                    "        }",
                    "",
                    "        refs.payname.removeAll();",
                    "        refs.payname.add(payname);",
                    "        refs.payvalue.removeAll();",
                    "        refs.payvalue.add(payvalue);",
                    "",
                    "",
                    "        //공제내역 설정",
                    "        if (!Ext.isEmpty(res.dedInfo)) {",
                    "            var tmpDedInfoAll = [];",
                    "",
                    "            for(var i in res.dedInfo){",
                    "                tmpDedInfoAll.push(res.dedInfo[i]);",
                    "            }",
                    "            for(var i in tmpDedInfoAll){",
                    "                if(typeof(tmpDedInfoAll[i]) === 'string' && Ext.isEmpty(tmpDedInfoAll[i].trim())){",
                    "                    continue;",
                    "                }",
                    "                else{",
                    "                    tmpDedInfo.push(tmpDedInfoAll[i]);",
                    "                }",
                    "            }",
                    "        }",
                    "",
                    "        // 컨테이너 컨텐츠",
                    "        var dedname  = [];",
                    "        var dedvalue = [];",
                    "",
                    "        for(var i in tmpDedInfo){",
                    "            if(i % 2 === 0){",
                    "                dedname.push({",
                    "                    xtype: 'container',",
                    "                    style: 'font-size:min(4vw,16px);',",
                    "                    html: tmpDedInfo[i],",
                    "                    padding: '5vw',",
                    "                });",
                    "            }",
                    "            else{",
                    "                dedvalue.push({",
                    "                    xtype: 'container',",
                    "                    style: 'font-size:min(4vw,16px); text-align:right;',",
                    "                    html: FormatUtils.moneyFormat(tmpDedInfo[i]) + '원',",
                    "                    padding: '5vw',",
                    "                });",
                    "            }",
                    "        }",
                    "",
                    "        refs.dedname.removeAll();",
                    "        refs.dedname.add(dedname);",
                    "        refs.dedvalue.removeAll();",
                    "        refs.dedvalue.add(dedvalue);",
                    "",
                    "        // 근태 내역 설정",
                    "        if (res.wrksInfo.wrksInfoFlag) {",
                    "            refs.wrksTab01.setHidden(false);",
                    "            refs.wrksTab02.setDisabled(false);",
                    "",
                    "            for(var i in res.wrksInfo){",
                    "                if(typeof(res.wrksInfo[i]) === 'string' && !Ext.isEmpty(res.wrksInfo[i].trim())){",
                    "                    tmpWrksInfo.push(res.wrksInfo[i]);",
                    "                }",
                    "            }",
                    "        }",
                    "        else{",
                    "            refs.wrksTab01.setHidden(true);",
                    "            refs.wrksTab02.setDisabled(true);",
                    "",
                    "        }",
                    "",
                    "        // 컨테이너 컨텐츠",
                    "        var totname  = [];",
                    "        var totvalue = [];",
                    "",
                    "        for(var i in tmpWrksInfo){",
                    "            if(i % 2 === 0){",
                    "                totname.push({",
                    "                    xtype: 'container',",
                    "                    style: 'font-size:min(4vw,16px);',",
                    "                    html: tmpWrksInfo[i],",
                    "                    padding: '5vw',",
                    "                });",
                    "            }",
                    "            else{",
                    "                totvalue.push({",
                    "                    xtype: 'container',",
                    "                    style: 'font-size:min(4vw,16px); text-align:right;',",
                    "                    html: FormatUtils.moneyFormat(tmpWrksInfo[i]), // 근태내역 시간 표시",
                    "                    padding: '5vw',",
                    "                });",
                    "            }",
                    "        }",
                    "",
                    "        // 반영",
                    "        refs.totname.removeAll();",
                    "        refs.totname.add(totname);",
                    "        refs.totvalue.removeAll();",
                    "        refs.totvalue.add(totvalue);",
                    "",
                    "",
                    "        // 날짜 변경 시 '지금/공제 내역'으로 화면 초기화",
                    "        refs.payDedTab01.setStyle('border-bottom : 5px solid #d71822;');",
                    "        refs.wrksTab01.setStyle('border-bottom:5px solid #fff;');",
                    "        refs.payDedTab02.setHidden(false);\t// 지급.공제가 보이고",
                    "        refs.wrksTab02.setHidden(true);\t\t// 근태는 안보임",
                    "",
                    "        //지급내역 설정",
                    "        if (res.payInfo.itemNm1) {",
                    "            vm.set('payInfo', res.payInfo);",
                    "        }",
                    "",
                    "        //공제내역 설정",
                    "        if (res.dedInfo.itemNm1) {",
                    "            vm.set('dedInfo', res.dedInfo);",
                    "        }",
                    "",
                    "        // 근태내역 설정",
                    "        vm.set('wrksInfo', res.wrksInfo);",
                    "",
                    "        //빈값이 아닐때 금액 포맷팅",
                    "        for (var i = 1; i <= 30; i++) {",
                    "            if (vm.get('payInfo.payAmt' + i).toString() != '　') {",
                    "                vm.set('payInfo.payAmt' + i, vm.get('payInfo.payAmt' + i).toString().replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\") + '원');",
                    "            }",
                    "            if (vm.get('dedInfo.payAmt' + i).toString() != '　') {",
                    "                vm.set('dedInfo.payAmt' + i, vm.get('dedInfo.payAmt' + i).toString().replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\") + '원');",
                    "            }",
                    "        }",
                    "",
                    "        vm.set('empeInfo', res.empeInfo);",
                    "        vm.set('empeInfo.etcoDt', DateUtils.parseDate(vm.get('empeInfo.etcoDt'))); // 입사일자 날짜 포맷",
                    "",
                    "        vm.set(\"payTot\", res.payTot.toString().replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\") + '원'); //지급합계액",
                    "        vm.set(\"dedTot\", res.dedTot.toString().replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\") + '원'); //공제합계액",
                    "        vm.set(\"payMinusDedTot\", res.payMinusDedTot.toString().replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\") + '원'); //차인지급액",
                    "        vm.set('yyyyMM', DateUtils.encodeDate(refs.yearMonth.getValue(), 'Y년 m월')); //급여지급명세서 라벨 설정",
                    "        vm.set('yyyy', refs.yearMonth.getValue().getFullYear().toString());",
                    "    }",
                    "});",
                    ""
                ]
            },
            "configAlternates": {
                "designer|commentHeader": "comment",
                "fn": "string",
                "implHandler": "code",
                "designer|params": "typedarray"
            },
            "name": "onSelect",
            "designerId": "71eca0e7-2293-408a-927d-1bc99d8d1215"
        }
    ]
