                    "name": "MyButton8",
                    "designerId": "8da82dc6-98bf-413a-aa59-096c0f3a78e0",
                    "cn": [
                        {
                            "type": "viewcontrollereventbinding",
                            "reference": {
                                "name": "listeners",
                                "type": "array"
                            },
                            "codeClass": null,
                            "userConfig": {
                                "fn": "onSendBtnTap",
                                "implHandler": [
                                    "var me = this;",
                                    "var vm = me.getViewModel();",
                                    "var refs = me.getReferences();",
                                    "",
                                    "",
                                    "var data = {};",
                                    "if(Ext.isEmpty(refs.phoneNumber.getValue())){",
                                    "    Ext.Msg.show({",
                                    "            buttons :  {",
                                    "                yes : {itemId : Ext.MessageBox.YES, text : '확인'}",
                                    "            },",
                                    "            title : '모바일 기기 유효성 검증',",
                                    "            message : '휴대폰번호를 확인해주세요.',",
                                    "            alwaysOnTop : true,",
                                    "            fn : function(btn) {",
                                    "                return;",
                                    "            }",
                                    "        });",
                                    "    return;",
                                    "}",
                                    "data.phoneNumber = refs.phoneNumber.getValue().replace(/-/g,'');",
                                    "refs.sendBtn.setDisabled(true);",
                                    "",
                                    "Ext.Ajax.request({",
                                    "    headers: {",
                                    "        viewId: me.getViewId(),",
                                    "        serviceId: 'BizComSvc.sendAuthNumber'",
                                    "    },",
                                    "    jsonData : data,",
                                    "    scope : me,",
                                    "    success : function(res) {",
                                    "        Ext.Viewport.setMasked(false);",
                                    "        Ext.Msg.show({",
                                    "            buttons :  {",
                                    "                yes : {itemId : Ext.MessageBox.YES, text : '확인'}",
                                    "            },",
                                    "            title : '모바일 기기 유효성 검증',",
                                    "            message : '인증번호가 발송되었습니다.',",
                                    "            alwaysOnTop : true,",
                                    "            fn : function(btn) {",
                                    "                return;",
                                    "            }",
                                    "        });",
                                    "    },",
                                    "    failure : function(res){",
                                    "        var responseText = Ext.decode(arguments[0].responseText);",
                                    "        Ext.Msg.show({",
                                    "            buttons :  {",
                                    "                yes : {itemId : Ext.MessageBox.YES, text : '확인'}",
                                    "            },",
                                    "            title : '모바일기기 유효성 검증',",
                                    "            message : responseText.errMsg,",
                                    "            alwaysOnTop : true,",
                                    "            fn : function(btn) {",
                                    "                return;",
                                    "            }",
                                    "        });",
                                    "        Ext.Viewport.setMasked(false);",
                                    "        refs.sendBtn.setDisabled(false);",
                                    "    }",
                                    "",
                                    "});",
                                    ""
                                ],
                                "name": "tap",
                                "scope": "me"
                            },
                            "configAlternates": {
                                "fn": "string",
                                "implHandler": "code",
                                "name": "string",
                                "scope": "string"
                            },
                            "name": "onSendBtnTap",
                            "designerId": "b385dfee-6d3b-4462-8b59-5bbcee6c39e9"
                        }
                    ]
                }
