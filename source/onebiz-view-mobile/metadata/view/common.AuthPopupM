                {
                    "type": "Ext.Button",
                    "reference": {
                        "name": "items",
                        "type": "array"
                    },
                    "codeClass": null,
                    "userConfig": {
                        "layout|flex": 1,
                        "text": "인증확인"
                    },
                    "configAlternates": {
                        "layout|flex": "number",
                        "text": "string"
                    },
                    "name": "MyButton12",
                    "designerId": "6800b1c8-250e-44f7-ba60-64e55f79723d",
                    "cn": [
                        {
                            "type": "viewcontrollereventbinding",
                            "reference": {
                                "name": "listeners",
                                "type": "array"
                            },
                            "codeClass": null,
                            "userConfig": {
                                "fn": "onBtnConfirmTap",
                                "implHandler": [
                                    "var me = this;",
                                    "var vm = me.getViewModel();",
                                    "var refs = me.getReferences();",
                                    "",
                                    "var data = {};",
                                    "var deviceUuid = '';",
                                    "if(Ext.isEmpty(window.device) && 'P'!==Property.PROFILE){",
                                    "    deviceUuid = 'empty';",
                                    "}",
                                    "else{",
                                    "    deviceUuid = device.uuid;",
                                    "}",
                                    "data.deviceUuid = deviceUuid;",
                                    "data.authNumber = refs.authNumber.getValue();",
                                    "if(Ext.isEmpty(data.authNumber)||data.authNumber.length<6){",
                                    "    refs.authNumber.setInputValue('');",
                                    "    Ext.Msg.show({",
                                    "        buttons :  {",
                                    "            yes : {itemId : Ext.MessageBox.YES, text : '확인'}",
                                    "        },",
                                    "        title : '인증번호 유효성 검증',",
                                    "        message : '인증번호를 다시 입력해주세요',",
                                    "        alwaysOnTop : true,",
                                    "        fn : function(btn) {",
                                    "            return;",
                                    "        }",
                                    "    });",
                                    "    return;",
                                    "}",
                                    "",
                                    "Ext.Ajax.request({",
                                    "    headers: {",
                                    "        viewId: me.getViewId(),",
                                    "        serviceId: 'BizComSvc.checkAuthNumber'",
                                    "    },",
                                    "    jsonData : data,",
                                    "    scope : me,",
                                    "    success : function(res) {",
                                    "        Ext.Viewport.setMasked(false);",
                                    "        Ext.Msg.show({",
                                    "                buttons :  {",
                                    "                    yes : {itemId : Ext.MessageBox.YES, text : '확인'}",
                                    "                },",
                                    "                title : '인증번호 유효성 검증',",
                                    "                message : '인증이 완료되었습니다.',",
                                    "                alwaysOnTop : true,",
                                    "                fn : function(btn) {",
                                    "                    me.getView().fireEvent('complete');",
                                    "                    me.getView().close();",
                                    "                }",
                                    "        });",
                                    "    },",
                                    "    failure : function(res){",
                                    "        var responseText = Ext.decode(arguments[0].responseText);",
                                    "        Ext.Msg.show({",
                                    "            buttons :  {",
                                    "                yes : {itemId : Ext.MessageBox.YES, text : '확인'}",
                                    "            },",
                                    "            title : '인증번호 유효성 검증',",
                                    "            message : responseText.errMsg,",
                                    "            alwaysOnTop : true,",
                                    "            fn : function(btn) {",
                                    "                return;",
                                    "            }",
                                    "        });",
                                    "        Ext.Viewport.setMasked(false);",
                                    "        refs.sendBtn.setDisabled(false);",
                                    "    }",
                                    "});",
                                    "",
                                    ""
                                ],
                                "name": "tap",
                                "scope": "me"
                            },
