        {
            "type": "viewcontrollereventbinding",
            "reference": {
                "name": "listeners",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "초기화"
                ],
                "fn": "onContainerInitialize",
                "implHandler": [
                    "",
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences();",
                    "",
                    "/* 상단 컴포넌트 정보 vm 저장해놓음 */",
                    "var popupData = component.config.popupData;",
                    "vm.set('popupData',popupData);",
                    "",
                    "var infoMsg = Messages.getMessage('BOM00002');",
                    "refs.infoMsg.setHtml(infoMsg);",
                    "",
                    "if(Ext.isEmpty(popupData.reptData)){ // 신규작성",
                    "    //     refs.closeBtn.setHidden(true);   // 닫기",
                    "    refs.cancelBtn.setHidden(false); // 취소",
                    "    refs.confirmBtn.setHidden(false);// 확인",
                    "    refs.deleteBtn.setHidden(true);  // 삭제",
                    "    refs.updateBtn.setHidden(true);  // 수정",
                    "    refs.prgrField.setBind();// 진척률 바인딩 제거",
                    "}",
                    "else{ // 주간업무수정",
                    "    //     refs.closeBtn.setHidden(false);  // 닫기",
                    "    refs.cancelBtn.setHidden(true);  // 취소",
                    "    refs.confirmBtn.setHidden(true); // 확인",
                    "    refs.deleteBtn.setHidden(false); // 삭제",
                    "    refs.updateBtn.setHidden(false); // 수정",
                    "    if(popupData.tmrdInfo.wrtrState == 'FALSE'){ // 수정가능여부",
                    "        vm.set('disabled',true);",
                    "    }",
                    "    else{",
                    "        vm.set('disabled',false);",
                    "        refs.prgrField.setBind(); // 진척률 바인딩 제거",
                    "    }",
                    "}",
                    "",
                    "",
                    "var rolCbx = [];",
                    "var pjtCbx = [];",
                    "var bizCbx = [];",
                    "",
                    "for ( var i in popupData.rolList) {",
                    "    rolCbx[Number(i)] = popupData.rolList[Number(i)];",
                    "}",
                    "rolCbx.push({text : '기타', value : 0});",
                    "",
                    "for ( var i in popupData.prjList) {",
                    "    pjtCbx[Number(i)] = popupData.prjList[Number(i)];",
                    "}",
                    "",
                    "for ( var i in popupData.bizList) {",
                    "    bizCbx[Number(i)] = popupData.bizList[Number(i)];",
                    "}",
                    "",
                    "ComboboxUtils.makeCustomCbx(refs.rolCbx, rolCbx);",
                    "ComboboxUtils.makeCustomCbx(refs.pjtCbx, pjtCbx);",
                    "ComboboxUtils.makeCustomCbx(refs.bizCbx, bizCbx);",
                    "",
                    "// inputForm을 통한 setValues, getValues  활용을 위해 name지정 (view단에서 name지정할경우 duplicate name 에러 발생)",
                    "refs.rolCbx.setName('hrHrocJasRolId');",
                    "refs.pjtCbx.setName('boPrjmInfoId');",
                    "refs.bizCbx.setName('bizDvnm');",
                    "refs.workStcdCbx.setName('weekWorkStcd');",
                    "refs.strdt.setName('strdt');",
                    "refs.edt.setName('edt');",
                    "",
                    "refs.prgrField.setDisabled(true);",
                    "refs.baseInfo.setHtml('<strong>※기준정보 : ' + DateUtils.parseDate(popupData.tmrdInfo.strdt) + ' / ' + popupData.empInfo.dpnm + '</strong>');",
                    "",
                    "refs.workStcdCbx.suspendEvents();",
                    "refs.inputForm.setValues(popupData.reptData);",
                    "",
                    "",
                    "if(refs.workStcdCbx.getValue() == '10'){ // 예정",
                    "    refs.prgrField.setDisabled(true);",
                    "}",
                    "else if(refs.workStcdCbx.getValue() == '90'){ // 완료",
                    "    refs.prgrField.setDisabled(true);",
                    "}",
                    "else if(refs.workStcdCbx.getValue() == '20'){ //진행",
                    "    refs.prgrField.setDisabled(false);",
                    "}",
                    "",
                    "refs.workStcdCbx.resumeEvents();",
                    "",
                    "if(!Ext.isEmpty(vm.get('popupData.reptData.hrHrocJasRolId'))){",
                    "    if(!isNaN(refs.rolCbx.getInputValue())){ // 없는 사무분담일 경우 기타로 세팅",
                    "        refs.rolCbx.setValue(0);",
                    "        me.onShowAlert('알림','기준일자에 해당하는 사무분담이 없습니다.');",
                    "    }",
                    "}",
                    "",
                    "",
                    "",
                    "//"
                ],
                "name": "initialize",
                "scope": "me"
            },
