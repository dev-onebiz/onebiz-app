            "codeClass": null,
            "userConfig": {
                "fn": "Initialize",
                "implHandler": [
                    "var me = this;",
                    "var vm = me.getViewModel();",
                    "var refs = me.getReferences();",
                    "var items = component.records;",
                    "var aplTotSmamt = 0;",
                    "me.setParentView(component.parentView);",
                    "",
                    "var componentList = [",
                    "                    ,'bfrCrrStrdt'",
                    "                    ,'bfrCrrStrtm'",
                    "                    ,'bfrCrrEdt'",
                    "                    ,'bfrCrrEdtm'",
                    "                    ,'aplWrkStrdt'",
                    "                    ,'aplWrkStrtm'",
                    "                    ,'aplWrkEdt'",
                    "                    ,'aplWrkEdtm'",
                    "                    ,'aplCntn'",
                    "                    ,'aplDvcd'",
                    "                    ,'aplWrkDt'",
                    "                    ,'bfrHrWrkmWkplcId'",
                    "                    ,'bfrWkplcNm'",
                    "                    ,'aplHrWrkmEmpWkplcId'",
                    "                    ,'aplHrWrkmWkplcId'",
                    "                    ,'aplWkplcNm'];",
                    "",
                    "// aplWrkDt 는 맨마지막에 두어서 자동으로 데이터 입력시 데이터 정정이 되지 않도록 함",
                    "",
                    "if(items.length == 0){",
                    "    var vm = me.getViewModel();",
                    "    var principal = SecurityUtils.getPrincipal();",
                    "    var ovwUsr = principal.hrHrpmEmpId+\" / \"+ principal.dpnm + \" / \" +",
                    "        principal.empeNm +\" / \" + principal.empePsitNm;",
                    "    refs.rqpr.setValue(ovwUsr);",
                    "    refs.aplDvcd.setValue(Constants.wrkAplDvcd.APPLY );",
                    "",
                    "    refs.aplCntn.setValue('근태 정정 신청하겠습니다.');",
                    "    vm.check = \"\";",
                    "",
                    "    var date = new Date();",
                    "    var nHour = date.getHours();",
                    "    nHour = nHour  < 10 ? '0'+nHour :  nHour;",
                    "    var nMin = date.getMinutes();",
                    "    nMin = nMin  < 10 ? '0'+nMin :  nMin;",
                    "    var nSec = date.getSeconds();",
                    "    nSec = nSec  < 10 ? '0'+nSec :  nSec;",
                    "    refs.aplTm.setValue(nHour+\"\"+nMin+\"\"+nSec);",
                    "    refs.cbxAplWkplcNm.setHidden(false);",
                    "    refs.aplWkplcNm.setHidden(true);",
                    "    refs.bfrWkplcNm.setValue(' ');",
                    "",
                    "}else{",
                    "    vm.check = \"clicked\";",
                    "    var data = items[0].data;",
                    "",
                    "    var ovwUsr = data.empeNo +\" / \"+data.dpnm +\" / \"+data.empeNm +\" / \"+data.lv ;",
                    "    refs.rqpr.setValue(ovwUsr);",
                    "    refs.button.setVisibility(false);",
                    "    for(var i in componentList){",
                    "        var compNm = componentList[i];",
                    "        var temp = refs[compNm];",
                    "        temp.setValue(data[compNm]);",
                    "        temp.setDisabled(true);",
                    "    }",
                    "",
                    "    refs.aplTm.setValue(data.aplTm);",
                    "    refs.cbxAplWkplcNm.setHidden(true);",
                    "    refs.aplWkplcNm.setHidden(false);",
                    "",
                    "    if (data.bfrWkplcNm == null) {",
                    "        refs.bfrWkplcNm.setValue(' ');",
                    "    }",
                    "    if (data.aplWkplcNm == null) {",
                    "        refs.aplWkplcNm.setValue(' ');",
                    "    }",
                    "}",
                    "",
                    "refs.aplWrkStrtm.el.select('.x-error-el').setStyle('margin',\t'0px');",
                    "refs.aplWrkEdtm.el.select('.x-error-el').setStyle('margin','0px');",
                    "",
                    "refs.bfrCrrStrtm.el.select('.x-error-el').setStyle('margin','0px');",
                    "refs.bfrCrrEdtm.el.select('.x-error-el').setStyle('margin',\t'0px');",
                    "",
                    "ApprovalBoxSvc.setup({",
