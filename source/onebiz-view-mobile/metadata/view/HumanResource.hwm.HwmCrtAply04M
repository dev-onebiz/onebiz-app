                            "codeClass": null,
                            "userConfig": {
                                "fn": "onDatefieldChange",
                                "implHandler": [
                                    "var me = this,",
                                    "    vm = me.getViewModel(),",
                                    "    refs = me.getReferences(),",
                                    "    viewId = 'HwmCrtAply04M';",
                                    "",
                                    "",
                                    "var param = {",
                                    "    stlmDvcd : '09',",
                                    "    aplStcd : '11',",
                                    "    aplTct : 1, // 총 건수",
                                    "};",
                                    "",
                                    "",
                                    "param.stcd = Constants.stcd.OUTSTANDING;",
                                    "param.hrHrpmEmpId = SecurityUtils.getPrincipal().hrHrpmEmpId;",
                                    "param.aplWrkDt = me.dateFormat(newDate).replace(/-/g,'');",
                                    "",
                                    "if(vm.check == \"clicked\" ){",
                                    "    vm.check = '';",
                                    "    return;",
                                    "}",
                                    "",
                                    "Ext.Ajax.request({",
                                    "    headers : {",
                                    "        serviceId : 'HwmCrtSvc.findAllHwmCrtAply',",
                                    "        viewId : viewId",
                                    "    },",
                                    "    scope : me,",
                                    "    jsonData :param,",
                                    "    success : function(response) {",
                                    "        var ob = JSON.parse(response.responseText);",
                                    "        var content = ob.page.content;",
                                    "        var strJson = JSON.stringify(content);",
                                    "",
                                    "        // 호출한 데이터가 있는지 없는지 확인",
                                    "        var checkFun = function(data){",
                                    "            for(var i in content){",
                                    "                var temp = content[i];",
                                    "                if(temp.name == data){",
                                    "                    return temp;",
                                    "                }",
                                    "            }",
                                    "            return null;",
                                    "        };",
                                    "",
                                    "        var temp = null;",
                                    "",
                                    "        var checkData = [\"hrWrkiDayCrr\", \"hrWrkiDay\" ,\"hrWrkdCri\"];",
                                    "        // 결과값 대상으로 우선순위대로 데이터 호출후 해당 이름 데이터가 있을 화면에 출력",
                                    "        for(var i in checkData){",
                                    "            temp = checkFun(checkData[i]);",
                                    "            if(temp != null){",
                                    "                break;",
                                    "            }",
                                    "        }",
                                    "",
                                    "        var message = \"\";",
                                    "",
                                    "        var MSG_NOCHULGUN = refs.aplWrkDt.getDisabled() ? \"\" :\"출근 기록이 없습니다.\";",
                                    "",
                                    "        if(temp != null){",
                                    "",
                                    "            if(temp.name != \"hrWrkdCri\"){",
                                    "                refs.bfrCrrStrdt.setValue(temp.aplWrkStrdt);",
                                    "                refs.bfrCrrStrtm.setValue(temp.aplWrkStrtm);",
                                    "                refs.bfrCrrEdt.setValue(temp.aplWrkEdt);",
                                    "                refs.bfrCrrEdtm.setValue(temp.aplWrkEdtm);",
                                    "",
                                    "            }else{",
                                    "                refs.bfrCrrStrdt.setValue(\"\");",
                                    "                refs.bfrCrrStrtm.setValue(\"\");",
                                    "                refs.bfrCrrEdt.setValue(\"\");",
                                    "                refs.bfrCrrEdtm.setValue(\"\");",
                                    "                message = MSG_NOCHULGUN;",
                                    "            }",
                                    "",
                                    "            refs.aplWrkStrdt.setValue(temp.aplWrkStrdt);",
                                    "            refs.aplWrkStrtm.setValue('08:50');",
                                    "            refs.aplWrkEdt.setValue(temp.aplWrkEdt);",
                                    "            refs.aplWrkEdtm.setValue(temp.aplWrkEdtm);",
                                    "        }else{",
                                    "            var date = refs.aplWrkDt.getValue();",
                                    "            var tempMonth = date.getMonth()+1 ;",
                                    "            tempMonth += \"\";",
                                    "            tempMonth = (tempMonth.length == 1 ? \"0\" :\"\") + tempMonth;",
                                    "",
                                    "            var dateDD = date.getDate()+\"\";",
                                    "            dateDD = (dateDD.length == 1 ? \"0\" :\"\") + dateDD;",
                                    "            var resultDt = date.getFullYear() +\"-\" + tempMonth + \"-\" + dateDD;",
                                    "",
                                    "            refs.bfrCrrStrdt.setValue(\"\");",
                                    "            refs.bfrCrrStrtm.setValue(\"\");",
                                    "            refs.bfrCrrEdt.setValue(\"\");",
                                    "            refs.bfrCrrEdtm.setValue(\"\");",
                                    "            refs.aplWrkStrdt.setValue(resultDt);",
                                    "            refs.aplWrkStrtm.setValue('08:50');",
                                    "            refs.aplWrkEdt.setValue(resultDt);",
                                    "            refs.aplWrkEdtm.setValue('18:00');",
                                    "",
                                    "            message = MSG_NOCHULGUN;",
                                    "        }",
                                    "",
                                    "        // 근무지정보 추가",
                                    "        var cbxAplWkplc = refs.cbxAplWkplcNm,",
                                    "            store = vm.get('WkplcStore'),",
                                    "            wkplcInfo = null;",
                                    "",
                                    "        // findOneHwmCrtAply",
                                    "        for(var name in content) {",
                                    "            if (content[name].name == \"wkplcInfo\") {",
                                    "                wkplcInfo = content[name];",
                                    "            }",
                                    "        }",
                                    "",
                                    "        store.removeAll();",
                                    "        cbxAplWkplc.setStore(store);",
                                    "        cbxAplWkplc.setValue(null);",
                                    "        if (wkplcInfo == null || wkplcInfo.aplHrWrkmWkplcId == null || wkplcInfo.aplWkplcNm == null) {",
                                    "            refs.bfrHrWrkmWkplcId.setValue(null);",
                                    "            refs.bfrWkplcNm.setValue(' ');",
                                    "        } else {",
                                    "            refs.bfrHrWrkmWkplcId.setValue(wkplcInfo.aplHrWrkmWkplcId);",
                                    "            refs.bfrWkplcNm.setValue(wkplcInfo.aplWkplcNm);",
                                    "        }",
                                    "        refs.hrWrkhEmpDayWkplcId.setValue((wkplcInfo == null || wkplcInfo.hrWrkhEmpDayWkplcId == null) ? null : wkplcInfo.hrWrkhEmpDayWkplcId);",
                                    "        refs.aplHrWrkmWkplcId.setValue(null);",
                                    "        refs.aplHrWrkmEmpWkplcId.setValue(null);",
                                    "        refs.aplWkplcNm.setValue(null);",
                                    "",
                                    "        param = {",
                                    "            crtDt : DateUtils.getDate(param.aplWrkDt),",
                                    "            hrHrpmEmpId : SecurityUtils.getPrincipal().hrHrpmEmpId,",
                                    "            stcd : Constants.stcd.NORMAL,",
                                    "            filterHrWrkmWkplcId : Constants.wkplcId.EMPTY_WKPLC //'근무지없음'에 대한 데이터 제외",
                                    "        };",
                                    "",
                                    "        Ext.Ajax.request({",
                                    "            headers : {",
                                    "                serviceId : 'HwmWplSvc.findAllHwmWplInfo',",
                                    "                viewId : viewId,",
                                    "                scope : me",
                                    "            },",
                                    "            jsonData : param,",
                                    "            success : function(response){",
                                    "                var wkplcList = [],",
                                    "                    cbxAplWkplc = refs.cbxAplWkplcNm,",
                                    "                    res = JSON.parse(response.responseText);",
                                    "",
                                    "                for(var i in res.page){",
                                    "                    var value = {",
                                    "                        wkplcNm : res.page[i].wkplcNm,",
                                    "                        hrWrkmWkplcId : res.page[i].hrWrkmWkplcId,",
                                    "                        hrWrkmEmpWkplcId : res.page[i].hrWrkmEmpWkplcId,",
                                    "                    };",
                                    "",
                                    "                    var item = store.data.items,",
                                    "                        cnt = 0;",
                                    "                    for (var j in item) {",
                                    "                        if (item[j].data.value.hrWrkmWkplcId == value.hrWrkmWkplcId) {",
                                    "                            cnt++;",
                                    "                            break;",
                                    "                        }",
                                    "                    }",
                                    "                    if (item.length == 0 || cnt == 0) {",
                                    "                        store.add({ text : res.page[i].wkplcNm, value : value});",
                                    "                    }",
                                    "                }",
                                    "                cbxAplWkplc.setStore(store);",
                                    "                cbxAplWkplc.setValue((store.getAt(0) != null) ? store.getAt(0).get('value') : null);",
                                    "                //               if (!(cbxAplWkplc.getValue())) {",
                                    "                //                   refs.aplWkplcNmErrMsg.setHidden(false);",
                                    "                //               } else {",
                                    "                //                   refs.aplWkplcNmErrMsg.setHidden(true);",
                                    "                //               }",
                                    "            }",
                                    "        });",
                                    "",
                                    "        if(message != \"\"){",
                                    "            Ext.Msg.alert('확인', MSG_NOCHULGUN);",
                                    "        }",
                                    "    }",
                                    "});",
                                    ""
                                ],
