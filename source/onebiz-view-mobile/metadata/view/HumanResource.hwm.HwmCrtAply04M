                                    "userConfig": {
                                        "designer|commentHeader": [
                                            "근무지 선택"
                                        ],
                                        "fn": "onCbxAplWkplcNmSelect",
                                        "implHandler": [
                                            "var me = this,",
                                            "    vm = me.getViewModel(),",
                                            "    refs = me.getReferences();",
                                            "",
                                            "if (newValue != null) {",
                                            "    var data = newValue.data.value;",
                                            "    refs.aplHrWrkmEmpWkplcId.setValue(data.hrWrkmEmpWkplcId);",
                                            "    refs.aplHrWrkmWkplcId.setValue(data.hrWrkmWkplcId);",
                                            "    refs.aplWkplcNm.setValue(data.wkplcNm);",
                                            "}",
                                            "",
                                            " // 근무지정보 리로드",
                                            "var store = vm.get('WkplcStore');",
                                            "if (refs.aplWrkDt.getValue() != null) {",
                                            "    param = {",
                                            "        crtDt : DateUtils.getDate(refs.aplWrkDt.getValue()),",
                                            "        hrHrpmEmpId : SecurityUtils.getPrincipal().hrHrpmEmpId,",
                                            "        stcd : Constants.stcd.NORMAL",
                                            "    };",
                                            "",
                                            "    Ext.Ajax.request({",
                                            "        headers : {",
                                            "            serviceId : 'HwmWplSvc.findAllHwmWplInfo',",
                                            "            viewId : 'HwmCrtAply04M',",
                                            "            scope : me",
                                            "        },",
                                            "        jsonData : param,",
                                            "        success : function(response){",
                                            "            var res = JSON.parse(response.responseText);",
                                            "            if (store.data != null) {",
                                            "                store.removeAll();",
                                            "",
                                            "                for(var i in res.page){",
                                            "                    var value = {",
                                            "                        wkplcNm : res.page[i].wkplcNm,",
                                            "                        hrWrkmWkplcId : res.page[i].hrWrkmWkplcId,",
                                            "                        hrWrkmEmpWkplcId : res.page[i].hrWrkmEmpWkplcId,",
                                            "                    };",
                                            "",
                                            "                    var item = store.data.items,",
                                            "                        cnt = 0;",
                                            "                    for (var j in item) {",
                                            "                        if (item[j].data.value.hrWrkmWkplcId == value.hrWrkmWkplcId) {",
                                            "                            cnt++;",
                                            "                            break;",
                                            "                        }",
                                            "                    }",
                                            "                    if (item.length == 0 || cnt == 0) {",
                                            "                        store.add({ text : res.page[i].wkplcNm, value : value});",
                                            "                    }",
                                            "                }",
                                            "                combobox.setStore(store);",
                                            "            }",
                                            "        }",
                                            "    });",
                                            "}"
                                        ],
