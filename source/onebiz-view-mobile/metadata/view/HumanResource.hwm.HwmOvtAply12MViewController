                "fn": "timeValidate",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences();",
                    "",
                    "",
                    "var params = new Object();",
                    "params.hrHrpmEmpId = SecurityUtils.getPrincipal().hrHrpmEmpId;",
                    "var wrkDtDate = refs.aplOvtDt.getValue();",
                    "params.wrkDt = me.dateToTimeTable(wrkDtDate,\"\");",
                    "params.wrkStdt = me.dateToTimeTable(wrkDtDate,\"\").substr(0,6) + '01';",
                    "params.wrkEddt = me.dateToTimeTable(wrkDtDate,\"\").substr(0,6) + new Date(wrkDtDate.getYear(), wrkDtDate.getMonth(),\"\").getDate();",
                    "",
                    "params.aplTm = refs.aplTm.getValue();",
                    "Ext.Ajax.request({",
                    "    headers : {",
                    "        serviceId : 'HwmOvtSvc.findAllHwmOvtHist',",
                    "        viewId : 'ExpNteApr02M'",
                    "    },",
                    "    scope : me,",
                    "    jsonData :params,",
                    "    success : function(response) {",
                    "        var res = JSON.parse(response.responseText);",
                    "        var refs = me.getReferences();",
                    "        var ovttmMnth = 0;",
                    "",
                    "        for(var i=0; i<res.initData.length;i++){",
                    "            var value = res.initData[i];",
                    "",
                    "            value.rplOvtEdtm = ''+(value.rplOvtEdtm/1 + (value.rplOvtEdt-value.rplOvtStrdt)*240000);",
                    "",
                    "            var ovtLength = value.rplOvtEdtm.length;",
                    "            for(var j=0;j<6-ovtLength;j++){",
                    "                value.rplOvtEdtm = 0 + value.rplOvtEdtm;",
                    "            }",
                    "",
                    "            ovttmMnth += me.timeDiff(value.rplOvtStrtm, value.rplOvtEdtm);",
                    "        }",
                    "",
                    "        ovttmMnth = Math.floor(ovttmMnth*2)*0.5;",
                    "        refs.ovttmMnth.setValue(ovttmMnth);",
                    "",
                    "        var Dt = res.maxOvttm[0].wrkEdt;",
                    "        var tm = res.maxOvttm[0].wrkEdtm;",
                    "",
                    "        var strdtm = new Date(Dt.substr(0,4),Dt.substr(4,2)-1,Dt.substr(6,2),Number(tm.substr(0,2))+1,tm.substr(2,2));",
                    "        var enddtm = new Date(Dt.substr(0,4),Dt.substr(4,2)-1,Dt.substr(6,2),Number(tm.substr(0,2))+3,tm.substr(2,2));",
                    "",
                    "",
                    "        refs.wrkDt.setValue(Dt);",
                    "        refs.wrkTm.setValue(DateUtils.encodeDate(strdtm).substr(11,8).replace(/:/g,''));",
                    "",
                    "        refs.aplOvtStrdt.setValue(strdtm);",
                    "        refs.aplOvtEdt.setValue(enddtm);",
                    "        refs.aplOvtStrtm.setValue(strdtm);",
                    "        refs.aplOvtEdtm.setValue(enddtm);",
                    "",
                    "        refs.maxOvttmMnth.setValue((res.maxOvttm[0]==null ||res.maxOvttm[0].maxOvttmMnth==null)?0:res.maxOvttm[0].maxOvttmMnth);",
                    "        refs.maxOvttmDay.setValue((res.maxOvttm[0]==null ||res.maxOvttm[0].maxOvttmDay==null)?0:res.maxOvttm[0].maxOvttmDay);",
                    "        refs.mnth.setValue(ovttmMnth +\" / \"+refs.maxOvttmMnth.getValue());",
                    "",
                    "",
                    "        if(!refs.cancel.getHidden()){",
                    "            refs.aplOvtDt.setReadOnly(true);",
                    "            refs.aplOvtStrtm.setReadOnly(true);",
                    "            refs.aplOvtEdtm.setReadOnly(true);",
                    "            refs.aplCntn.setValue('취소 신청하겠습니다.');",
                    "            refs.aplDvcd.setValue(Constants.wrkAplDvcd.CANCEL);",
                    "            refs.aplOvtStrtm.setValue(DateUtils.encodeDate(DateUtils.getTimeToDate(refs.aplOvtStrtm.getValue()),\"H:i\"));",
                    "            refs.aplOvtEdtm.setValue(DateUtils.encodeDate(DateUtils.getTimeToDate(refs.aplOvtEdtm.getValue()),\"H:i\"));",
                    "            refs.wrkDt.setValue(null);",
                    "            refs.wrkTm.setValue(null);",
                    "            return;",
                    "        } else{",
                    "            refs.aplOvtDt.setReadOnly(false);",
                    "            refs.aplOvtStrtm.setReadOnly(false);",
                    "            refs.aplOvtEdtm.setReadOnly(false);",
                    "        }",
                    "",
                    "        if(res.maxOvttm[0]==null ||res.maxOvttm[0].wrkDt==null){",
                    "            Ext.Msg.alert(\"안내\", \"연장근무 일자에 해당되는 근무기준이 존재하지 않습니다. <br/> 관리자에게 문의해주십시오.\");",
                    "            refs.aplOvtStrdt.setValue(DateUtils.getDate(refs.aplOvtDt.getValue()));",
                    "            refs.aplOvtStrtm.setValue('19:00');",
                    "            refs.aplOvtEdt.setValue(DateUtils.getDate(refs.aplOvtDt.getValue()));",
                    "            refs.aplOvtEdtm.setValue('21:00');",
                    "            refs.maxOvttmMnth.setValue((res.maxOvttm[0]==null || res.maxOvttm[0].maxOvttmMnth==null)?0:res.maxOvttm[0].maxOvttmMnth);",
                    "            refs.maxOvttmDay.setValue((res.maxOvttm[0]==null || res.maxOvttm[0].maxOvttmDay==null)?0:res.maxOvttm[0].maxOvttmDay);",
                    "            refs.mnth.setValue(ovttmMnth +\" / \"+refs.maxOvttmMnth.getValue());",
                    "            return;",
                    "        } else if(refs.reAp.getHidden()){ //재기안이 아닐 때",
                    "            refs.aplOvtStrdt.setValue(strdtm);",
                    "            refs.aplOvtEdt.setValue(enddtm);",
                    "            refs.aplOvtStrtm.setValue(DateUtils.encodeDate(strdtm).substr(11,8).replace(/:/g,''));",
                    "            refs.aplOvtEdtm.setValue(DateUtils.encodeDate(enddtm).substr(11,8).replace(/:/g,''));",
                    "            refs.wrkDt.setValue(Dt);",
                    "            refs.wrkTm.setValue(DateUtils.encodeDate(strdtm).substr(11,8).replace(/:/g,''));",
                    "        } else {//근무기준이 존재하지만 재기안일 때",
                    "            refs.aplOvtStrtm.setValue(DateUtils.encodeDate(DateUtils.getTimeToDate(refs.aplOvtStrtm.getValue()),\"H:i\"));",
                    "            refs.aplOvtEdtm.setValue(DateUtils.encodeDate(DateUtils.getTimeToDate(refs.aplOvtEdtm.getValue()),\"H:i\"));",
                    "        }",
                    "        //총 시간외근무시간 표시 (금월/금주)",
                    "        refs.totOvtHodMonthHr.setValue(res.totAdmtOvtHod.totOvtHodMonthHr);",
                    "        refs.totOvtHodWeekHr.setValue(res.totAdmtOvtHod.totOvtHodWeekHr);",
                    "",
                    "        //결재진행중인 시간 표시",
                    "        vm.set('criTime' , res.criTime); //기준시간",
                    "        vm.set('totAdmtOvthodHr' , res.totAdmtOvtHod.totOvtHodMonthHr); //인정시간",
                    "        vm.set('totIngOvthodHr' , res.totIngOvthodHr); //현재 보고 결재 진행중이거나, 보고 전인 시간외근무 시간",
                    "    }",
                    "});"
                ]
            },
