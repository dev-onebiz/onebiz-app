            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "기타영수증 필수값 검증"
                ],
                "designer|params": [
                    "formData"
                ],
                "fn": "formValid",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    reNo = /[^\\d]/,",
                    "    errMsg = '';",
                    "",
                    "if(formData.apvlDt){",
                    "    if(formData.apvlDt && String(formData.apvlDt).length !== 8){",
                    "        errMsg += '승인일자는 숫자 8자리입니다.<br>';",
                    "    } else if(Number(formData.apvlDt) >= 20200701) {",
                    "        /* 20.07.01 예산오픈으로 인한 분기처리 */",
                    "        errMsg += '2020-07-01 부터는 [경비신청]-[결의서 작성] 메뉴를 이용바랍니다.<br>';",
                    "    }",
                    "    ",
                    "    //     if(reNo.test(formData.apvlDt)){",
                    "    //         errMsg += '승인일자는 숫자만 입력해주세요.<br>';",
                    "    //     }",
                    "    if(String(formData.apvlDt).substr(0, 4) < '2000' ||",
                    "       String(formData.apvlDt).substr(0, 4) > '2100' ||",
                    "       String(formData.apvlDt).substr(4, 2) > '12' ||",
                    "       String(formData.apvlDt).substr(6, 2) > '31'){",
                    "        errMsg += '승인일자는 날짜형식으로 입력해주세요.<br>';",
                    "    }",
                    "} else {",
                    "    errMsg += '승인일자를 입력해주세요.<br>';",
                    "}",
                    "",
                    "if(!formData.aprno){",
                    "    errMsg += '승인번호를 입력해주세요.<br>';",
                    "}",
                    "if(formData.aprno && String(formData.aprno).length > 11){",
                    "    errMsg += '승인번호는 최대 11자리입니다.<br>'; // 승인번호 : 숫자 + 알파벳",
                    "}",
                    "// if(formData.aprno && reNo.test(formData.aprno)){",
                    "//     errMsg += '승인번호는 숫자만 입력해주세요.<br>';",
                    "// }",
                    "",
                    "// if(!formData.canYn){",
                    "//     errMsg += '취소여부<br>';",
                    "// }",
                    "if(!formData.mcNm){",
                    "    errMsg += '상호명을 입력해주세요.<br>';",
                    "}",
                    "",
                    "// if(!formData.mcBzno){",
                    "if(formData.mcBzno === null || String(formData.mcBzno).length < 1){",
                    "    errMsg += '사업자번호를 입력해주세요.<br>';",
                    "}",
                    "if(formData.mcBzno && String(formData.mcBzno).length > 10){",
                    "    errMsg += '사업자번호는 최대 숫자 10자리입니다.<br>';",
                    "}",
                    "// if(formData.mcBzno && reNo.test(formData.mcBzno)){",
                    "//     errMsg += '사업자번호는 숫자만 입력해주세요.<br>';",
                    "// }",
                    "",
                    "// if(!formData.mcAddr){",
                    "//     errMsg += '주소<br>';",
                    "// }",
                    "if(!formData.trnsAmtWc){",
                    "    errMsg += '공급가액을 입력해주세요.<br>';",
                    "}",
                    "if(formData.trnsAmtWc && String(formData.trnsAmtWc).length > 13){",
                    "    errMsg += '공급가액은 최대 숫자 13자리입니다.<br>';",
                    "}",
                    "",
                    "if(formData.stxat === undefined || formData.stxat === null || formData.stxat < 0){",
                    "    errMsg += '부가세를 입력해주세요.<br>';",
                    "}",
                    "if(formData.stxat && String(formData.stxat).length > 13){",
                    "    errMsg += '부가세는 최대 숫자 13자리입니다.<br>';",
                    "}",
                    "",
                    "if(!formData.apvlAmtDom){",
                    "    errMsg += '승인금액을 입력해주세요.<br>';",
                    "}",
                    "if(formData.apvlAmtDom && String(formData.apvlAmtDom).length > 13){",
                    "    errMsg += '승인금액은 최대 숫자 13자리입니다.<br>';",
                    "}",
                    "// if(formData.apvlAmtDom && reNo.test(formData.apvlAmtDom)){",
                    "//     errMsg += '승인금액은 숫자만 입력해주세요.<br>';",
                    "// }",
                    "",
                    "// if(!formData.hrHromJasPrjId){",
                    "//     errMsg += '사용부문을 입력해주세요.<br>';",
                    "// }",
                    "if(!formData.userOrUseDept){",
                    "    errMsg += '사용자를 입력해주세요.<br>';",
                    "}",
                    "var userInfoList = formData.userInfoList;",
                    "for (var i in userInfoList) {",
                    "    var record = userInfoList[i];",
                    "    // 내부직원(01)이면서 사용부문이 존재하지 않는 경우, 오류메시지표시",
                    "    if (record.stfDvcd === '01' && !record.jasPrj) {",
                    "        errMsg += '내부직원의 사용부문을 선택해주세요.<br>';",
                    "        break;",
                    "    } else if (record.stfDvcd !== '01'){",
                    "        // 외부직원인 경우, 사용부문이 적용되는 버그가 존재하여 데이터 보정처리함",
                    "        record.jasPrj = null;",
                    "        record.jasPrjText = null;",
                    "    }",
                    "}",
                    "",
                    "if(!formData.accItemCd){",
                    "    errMsg += '사용분류를 입력해주세요.<br>';",
                    "}",
                    "if(!formData.aplRscn){",
                    "    errMsg += '적요를 입력해주세요.<br>';",
                    "}",
                    "if(formData.aplRscn){",
                    "    if(formData.aplRscn.length > 65){",
                    "        errMsg += '적요의 길이를 확인해주세요.<br>';",
                    "    }",
                    "}",
                    "if(!formData.hrHrpmDeptId){",
                    "    errMsg += '사용부서를 입력해주세요.<br>';",
                    "}",
                    "// if(!formData.userOrUseDept){",
                    "//     errMsg += '사용자를 입력해주세요.<br>';",
                    "// }",
                    "",
                    "var innerEmp = true;",
                    "for(var i in formData.gridData){",
                    "    if(formData.gridData[i].data.stfDvcd === '02'){",
                    "        innerEmp = false;",
                    "    }",
                    "}",
                    "if(formData.accItemCd !== '09' && !innerEmp){  // && 외부 사용자 있는지 체크",
                    "    errMsg += '사용분류가 업무추진비인 경우만 외부직원을 추가할 수 있습니다. 외부직원은 제외해 주시기바랍니다.<br>';",
                    "} else if(formData.accItemCd === '09' && innerEmp){",
                    "    errMsg += '사용분류가 업무추진비인 경우, 외부직원 입력은 필수입니다.<br>';",
                    "}",
                    "",
                    "// 사용분류 === 회의비인 경우 회의록이 필수",
                    "if(formData.accItemCd &&",
                    "   formData.accItemCd === '06' &&",
                    "   !formData.conferencePopupSuccess){",
                    "    errMsg += '사용분류가 회의비인 경우 회의록을 작성해주세요.<br>';",
                    "}",
                    "",
                    "",
                    "// + 버튼을 눌렀을때에는 결재선 체크 X",
                    "if(!formData.btnPlus){",
                    "    if(!vm.get('applyLine')){",
                    "        errMsg += '결재선을 선택해주세요.<br>';",
                    "    }",
                    "}",
                    "",
                    "if(!formData.imgPhoto){",
                    "    errMsg += '사진을 등록해 주세요.<br>';",
                    "}",
                    "",
                    "return errMsg;",
                    "",
                    ""
                ]
            },
            "configAlternates": {
                "designer|commentHeader": "comment",
                "designer|params": "typedarray",
                "fn": "string",
                "implHandler": "code"
            },
            "name": "formValid",
            "designerId": "0bb33498-6fc3-4b43-a490-4b9c1be7daac"
        },
