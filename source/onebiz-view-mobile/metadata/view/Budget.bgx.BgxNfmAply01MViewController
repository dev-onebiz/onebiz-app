                "designer|params": [
                    "data",
                    "readOnlyFlag"
                ],
                "fn": "fnChangeApplyForm",
                "implHandler": [
                    "var  me = this,",
                    "     naviView = me.getView().up('navigationview');",
                    "",
                    "if (readOnlyFlag && data && data.applyInfo) {",
                    "    var applyInfo = data.applyInfo;",
                    "    switch (applyInfo.aplKndcd) {",
                    "        case Constants.aplKndcd.CARD : \t\t// 법인카드",
                    "            break;",
                    "        case Constants.aplKndcd.CSH_RCT : \t// 현금영수증",
                    "            break;",
                    "        case Constants.aplKndcd.ETC_RCT : \t// 기타영수증",
                    "            break;",
                    "        case Constants.aplKndcd.TXINV : \t// 세금계산서",
                    "        case Constants.aplKndcd.XPNS : \t\t// 여비정산서",
                    "            Ext.Msg.alert('알림', '세금계산서와 여비정산서는 PC에서만 조회가능합니다.');",
                    "            return;",
                    "            default :",
                    "            return;",
                    "    }",
                    "",
                    "    data.readOnlyFlag = readOnlyFlag;",
                    "    me.PUSH_VIEW(naviView, {",
                    "        menuId  : 'BgxNfmAply02M',",
                    "        title   : '결의서 작성',",
                    "        isSubView : true,",
                    "        data : data",
                    "    });",
                    "}"
                ]
            },
