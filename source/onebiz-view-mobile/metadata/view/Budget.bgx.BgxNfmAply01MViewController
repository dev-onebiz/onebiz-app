            "userConfig": {
                "designer|commentHeader": [
                    "목록 조회"
                ],
                "fn": "onSelect",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    dateCnt = refs.dateStartEndContainer,",
                    "    dateCntRef = dateCnt.getReferences(),",
                    "    dateCntCtrl = dateCnt.controller,",
                    "    strdt = dateCntRef.strdt,",
                    "    edt = dateCntRef.edt,",
                    "    aplStcd = refs.aplStcd,",
                    "    aplKndcd = refs.aplKndcd,",
                    "    params = {},",
                    "    store = refs.grid_container.getViewModel().storeInfo.ExpListStore;",
                    "//     store = vm.storeInfo.ExpListStore;",
                    "",
                    "params.aplEmpId = SecurityUtils.getPrincipal().hrHrpmEmpId;",
                    "",
                    "// 조회기간",
                    "var result = dateCntCtrl.dateValid();",
                    "if (result != '') {",
                    "    Ext.Msg.alert('알림', result);",
                    "    return;",
                    "} else {",
                    "    params.inbizStartdt = Ext.Date.format(strdt.getValue(), 'Ymd');",
                    "    params.inbizEnddt = Ext.Date.format(edt.getValue(), 'Ymd');",
                    "}",
                    "",
                    "// 신청분류",
                    "if (aplKndcd && aplKndcd.getValue() && aplKndcd.getValue() != '99') {",
                    "    params.aplKndcd = aplKndcd.getValue();",
                    "}",
                    "",
                    "// 신청상태",
                    "if (aplStcd && aplStcd.getValue() && aplStcd.getValue() != '99') {",
                    "    params.aplStcd = aplStcd.getValue();",
                    "}",
                    "",
                    "",
                    "store.getProxy().extraParams = params;",
                    "store.removeAll();",
                    "store.loadPage(1);"
                ]
            },
