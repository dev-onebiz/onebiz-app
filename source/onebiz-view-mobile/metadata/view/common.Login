{
    "type": "Ext.Container",
    "reference": {
        "name": "items",
        "type": "array"
    },
    "codeClass": null,
    "userConfig": {
        "designer|commentHeader": [
            "메인 / 로그인 View",
            "",
            "@author BNK시스템/팀장/손승범",
            "@since 2019.06.17.",
            "@version 1.0",
            "@see",
            "",
            "<< 개정이력(Modification Information) >>",
            "",
            "  수정일         수정자                      수정내용",
            " ------------   ---------                 --------------------------",
            "  2019.06.17.   BNK시스템/팀장/손승범         최초 생성"
        ],
        "designer|userAlias": "Login",
        "designer|userClassName": "common.Login",
        "layout": "vbox",
        "padding": 20,
        "style": "background-image: url(\"resources/images/background.png\"); background-size: 100%; background-repeat: no-repeat; background-color: #FFF;"
    },
    "configAlternates": {
        "designer|userClassName": "string",
        "extend": "string",
        "designer|userAlias": "string",
        "designer|initialView": "boolean",
        "style": "string",
        "designer|commentHeader": "comment",
        "layout": "string",
        "padding": "auto"
    },
    "designerId": "3d4c14d6-fc46-4f22-8e75-b90ff8a54386",
    "viewControllerInstanceId": "5b35c0c4-37e1-4e91-bbcb-fa89aa156e18",
    "viewModelInstanceId": "a32508fe-e4b4-473b-91b9-da9bc5c96d59",
    "cn": [
        {
            "type": "viewcontrollereventbinding",
            "reference": {
                "name": "listeners",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "fn": "init",
                "implHandler": [
                    "// Application launch 영역보다 먼저 실행되어 Ajax headers 설정을 함",
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    loginType = refs.loginType,",
                    "    loadingView = refs.loadingView,",
                    "    rememberUserId = refs.rememberUserId,",
                    "    fastRememberUserId = refs.fastRememberUserId,",
                    "    loginForm = refs.loginForm,",
                    "    userId = refs.userId,",
                    "    loginTypeCard = refs.loginTypeCard,",
                    "    loginUserId = localStorage.getItem('loginUserId'),",
                    "    loginTypeValue = localStorage.getItem('loginType'),",
                    "    initialConfig = component.initialConfig;",
                    "",
                    "// 로컬스토리지의 사용자아이디가 존재하는 경우, 아이디 필드에 설정",
                    "if (loginUserId) {",
                    "    vm.set('loginUserId', loginUserId);",
                    "    rememberUserId.setChecked(true);",
                    "    userId.setValue(loginUserId);",
                    "}",
                    "else if (initialConfig.hasOwnProperty('userId')) {",
                    "    rememberUserId.setChecked(true);",
                    "    userId.setValue(initialConfig.userId);",
                    "}",
                    "// 로그인타입선택",
                    "if (!loginTypeValue) {",
                    "    loginType.setValue(0);",
                    "}",
                    "else {",
                    "    loginType.setValue(1);",
                    "    loginTypeCard.setActiveItem(1);",
                    "}",
                    "",
                    "// JWT 토큰 쿠키가 존재하는 경우에만 실행",
                    "if (WebUtils.getCookie(Property.JWT_TOKEN_NAME)) {",
                    "    console.log('Cookie OK!');",
                    "    me.initApplication().then(function(isInit) {",
                    "        // 어플리케이션 데이터가 정상처리 되었으면 HOME화면으로 이동",
                    "        if (isInit) {",
                    "            me.REDIRECT(Property.ROUTE_HOME);",
                    "        }",
                    "    });",
                    "}",
                    "else {",
                    "    //loadingView.setHidden(true);",
                    "    // loginForm.setHidden(false);",
                    "}",
                    "",
                    "// 프로퍼티 표시",
                    "var profileText = '';",
                    "if (Property.PROFILE === 'T') {",
                    "    profileText = '개발환경';",
                    "    refs.password.setValue('aa12345^');",
                    "}",
                    "else if (Property.PROFILE === 'L') {",
                    "    profileText = '로컬환경';",
                    "    refs.password.setValue('aa12345^');",
                    "}",
                    "refs.profile.setHtml(Ext.String.format('<h1 style=\"color:red;\">{0}</h1>', profileText));",
                    ""
                ],
                "name": "initialize",
                "scope": "me"
            },
            "configAlternates": {
                "fn": "string",
                "implHandler": "code",
                "name": "string",
                "scope": "string"
            },
            "name": "init",
            "designerId": "ed1509ed-ad2c-4bab-91e7-a241bbc9883e"
        },
