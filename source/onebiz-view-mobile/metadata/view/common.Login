                                                "fn": "onResetPassword",
                                                "implHandler": [
                                                    "var me = this,",
                                                    "    refs = me.getReferences(),",
                                                    "    userId = refs.userId,",
                                                    "    fastUserId = refs.fastUserId,",
                                                    "    userIdValue = null;",
                                                    "",
                                                    "if (userId.getValue()) {",
                                                    "    userIdValue = userId.getValue();",
                                                    "}",
                                                    "else if (fastUserId.getValue()) {",
                                                    "    userIdValue = fastUserId.getValue();",
                                                    "}",
                                                    "",
                                                    "this.REDIRECT('ResetPassword', {",
                                                    "    userId : userIdValue,",
                                                    "    closable : true",
                                                    "});"
                                                ],
                                                "name": "tap",
                                                "scope": "me"
                                            },
                                            "configAlternates": {
                                                "fn": "string",
                                                "implHandler": "code",
                                                "name": "string",
                                                "scope": "string"
                                            },
                                            "name": "onResetPassword",
