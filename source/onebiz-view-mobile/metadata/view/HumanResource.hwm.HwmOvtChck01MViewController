                    "                        month = date.getMonth();",
                    "                        day = date.getDate();",
                    "                        hour = date.getHours();",
                    "                        minute = date.getMinutes();",
                    "                        second = date.getSeconds();",
                    "",
                    "                        me.getReferences().monitorDate.setHtml(fullDate);",
                    "                        me.getReferences().monitorTime.setHtml(nowTime);",
                    "",
                    "                        cnt++;",
                    "                        cnt = cnt % 60;",
                    "                    }",
                    "",
                    "                }",
                    "            } catch(e){",
                    "                runner.stopAll();",
                    "                console.log('timer stop');",
                    "            }",
                    "",
