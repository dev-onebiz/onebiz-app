        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|params": [
                    "crudState"
                ],
                "fn": "onSave",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences();",
                    "",
                    "if(refs.prgrField.getInputValue() > refs.prgrField.getMaxValue() ){",
                    "    me.onShowAlert('유효성검증','진행율은 ' + refs.prgrField.getMaxValue() +'%를 넘길 수 없습니다.');",
                    "    return false;",
                    "}",
                    "",
                    "",
                    "var saveData = refs.inputForm.getValues();",
                    "var errMsg = me.onValidationCheck(saveData);",
                    "if(errMsg.length>0 && crudState != 'D'){",
                    "    me.onShowAlert('유효성검증',errMsg);",
                    "    return false;",
                    "}",
                    "",
                    "if(crudState == 'D'){",
                    "    saveData.deleteYn = 'Y';",
                    "}",
                    "var popupData = vm.get('popupData');",
                    "",
                    "saveData.boWekmTmrdId = popupData.boWekmTmrdId;",
                    "saveData.boWekdTmrdEmpId = popupData.boWekdTmrdEmpId;",
                    "saveData.wrtDevc = 2; // 단말기구분 : 모바일",
                    "saveData.strdt = DateUtils.getDate(saveData.strdt);",
                    "saveData.edt = DateUtils.getDate(saveData.edt);",
                    "if(!Ext.isEmpty(saveData.rawCntn)){",
                    "    saveData.cntn = saveData.rawCntn.replace(/\\n/g,'<br/>');",
                    "}",
                    "",
                    "if(!Ext.isEmpty(popupData.reptData)){",
                    "    saveData.boWekhTmrdEmpReptId = popupData.reptData.boWekhTmrdEmpReptId;",
                    "}",
                    "",
                    "Ext.Ajax.request({",
                    "    headers: {",
                    "        viewId : me.getViewId(),",
                    "        serviceId : 'BomWekWorkSvc.saveBomWekWorkRept'",
                    "    },",
                    "    jsonData : saveData,",
                    "    scope : me,",
                    "    success : function(response) {",
                    "        var res = Ext.JSON.decode(response.responseText);",
                    "",
                    "        //         me.getView().fireEvent('complete');",
                    "        me.onShowAlert('알림','정상처리되었습니다.');",
                    "        //         me.getView().close();",
                    "        me.getView().up().down('BomWekWork01M').controller.onSelectRept();",
                    "        // 홈으로",
                    "        vm.getView().up().pop();",
                    "    }",
                    "});"
                ]
            },
            "configAlternates": {
                "fn": "string",
                "implHandler": "code",
                "designer|params": "typedarray"
            },
