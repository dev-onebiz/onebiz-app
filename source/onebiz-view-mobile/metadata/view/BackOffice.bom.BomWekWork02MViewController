            "codeClass": null,
            "userConfig": {
                "designer|params": [
                    "formData"
                ],
                "fn": "onValidationCheck",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences();",
                    "",
                    "var errMsg = '';",
                    "",
                    "// 필수값 체크 : 사무분담, 업무상태, 제목, 개발수행보고여부",
                    "if(Ext.isEmpty(formData.hrHrocJasRolId)){",
                    "    errMsg += '사무분담은 필수값입니다.<br/>';",
                    "}",
                    "if(Ext.isEmpty(formData.weekWorkStcd)){",
                    "    errMsg += '업무상태는 필수값입니다.<br/>';",
                    "}",
                    "if(Ext.isEmpty(formData.title)){",
                    "    errMsg += '제목은 필수값입니다.<br/>';",
                    "}",
                    "else if(refs.title.getValue().length > refs.title.getMaxLength()){",
                    "    errMsg += '제목은 ' + refs.title.getMaxLength() +'자를 넘길 수 없습니다.';",
                    "}",
                    "if(Ext.isEmpty(formData.reprtYn)){",
                    "    errMsg += '개발수행보고서는 필수값입니다.<br/>';",
                    "} ",
                    "if(formData.weekWorkStcd =='20'){",
                    "    if(Ext.isEmpty(formData.pstlyPrgr)){",
                    "        errMsg += '상태가 \"진행\"일경우 진척률은 필수값입니다.<br/>';",
                    "    }",
                    "}",
                    "",
                    "if(formData.reprtYn == '1'){",
                    "    if(Ext.isEmpty(refs.strdt.getValue()) || Ext.isEmpty(refs.edt.getValue())){",
                    "        errMsg += '개발수행보고서 적용일 경우 작업기간은 필수값입니다.<br/>';",
                    "    }",
                    "}",
                    "// 데이터 변경 체크 (사무분담, 프로젝트, 업무상태, 진척률, 시작, 종료, 업무명, 업무내용, 개발수행보고)",
                    "var beforeData = vm.get('popupData.reptData');",
                    "if(!Ext.isEmpty(beforeData)){",
                    "    if(\t!(",
                    "       (beforeData.hrHrocJasRolId != refs.rolCbx.getValue() && refs.rolCbx.getValue() !== '') ||",
                    "       (beforeData.boPrjmInfoId   != refs.pjtCbx.getValue() && refs.pjtCbx.getValue() !== '') ||",
                    "       (beforeData.weekWorkStcd   != refs.workStcdCbx.getValue() && refs.workStcdCbx.getValue() !== '') ||",
                    "        beforeData.pstlyPrgr \t  != refs.prgrField.getValue() ||",
                    "        DateUtils.getDate(beforeData.strdt) != DateUtils.getDate(refs.strdt.getValue()) ||",
                    "        DateUtils.getDate(beforeData.edt)   != DateUtils.getDate(refs.edt.getValue()) ||",
                    "        beforeData.title          != refs.title.getValue() ||",
                    "       ( (beforeData.rawCntn \t\t  != refs.cntn.getValue()) && (refs.cntn.getValue()!==null) )  ||",
                    "        beforeData.reprtYn \t\t  != refs.reprtYn.getValues()['reprtYn'] ||",
                    "        beforeData.bizDvnm        != refs.bizCbx.getValue()",
                    "     )",
                    "  ){",
                    "    errMsg += '변경된 내용이 없습니다.<br/>';",
                    "  }",
                    "}",
                    "",
                    "",
                    "return errMsg;",
                    ""
                ]
            },
