                                    "var items = refs.searchForm.getItems().items;",
                                    "var msg = ''; //validation message",
                                    "var fieldName = '';",
                                    "for(var i in items){",
                                    "    if(!Ext.isEmpty(items[i].validate) && !items[i].validate()){",
                                    "",
                                    "        fieldName = !Ext.isEmpty(items[i].getPlaceholder()) ? items[i].getPlaceholder() : '';",
