                "fn": "Initialize",
                "implHandler": [
                    "var me = this;",
                    "var vm = me.getViewModel();",
                    "var refs = me.getReferences();",
                    "var items = component.records;",
                    "var aplTotSmamt = 0;",
                    "",
                    "// 포맷팅 제거",
                    "items = this.recoveryFormRender(items);",
                    "",
                    "// 결재문서 초기화 설정",
                    "ApprovalBoxSvc.setup({",
                    "    command   : '01',",
                    "    viewModel : vm,",
                    "    edocCd    : 'ExpNteAply71',",
                    "    scope     : me",
                    "});",
                    "",
                    "for(var i in items){",
                    "    items[i].isAply = false; // 결재 화면으로 사용하는 Items에서는 readOnly 처리하기 위해 사용하는 플래그",
                    "",
                    "    // 뒤로 갔다가 다시 들어올 경우를 대비",
                    "    items[i].hrHromJasPrjId   = null;",
                    "    items[i].hrHromJasPrjText = null;",
                    "    items[i].accItemCd        = null;",
                    "    items[i].accItemCdText    = null;",
                    "    items[i].aplRscn          = null;",
                    "    items[i].hrHrpmDeptId     = null;",
                    "    items[i].dpnm             = null;",
                    "    items[i].userOrUseDept    = null;",
                    "    items[i].imgPhoto         = null;",
                    "}",
                    "",
                    "refs.item_container.getViewModel().set('records', items);",
                    "refs.item_container.getViewModel().set('stlmDvcd', '법인카드');",
                    "refs.item_container.getViewModel().set('aply02', true);",
                    "",
                    "for(var i in items){",
                    "    aplTotSmamt += Number(items[i].apvlAmtDom);",
                    "}",
                    "",
                    "vm.set('aplTct', items ? items.length : 0); // 총 건수",
                    "vm.set('aplTotSmamt', aplTotSmamt); // 합계금액",
                    "",
                    "var str = String(aplTotSmamt);",
                    "aplTotSmamt = str.replace(/(\\d)(?=(?:\\d{3})+(?!\\d))/g, '$1,');",
                    "vm.set('aplTotSmamtRender', aplTotSmamt); // render 합계금액",
                    "",
                    "refs.item_container.controller.addForm();",
                    ""
                ],
                "name": "initialize",
                "scope": "me"
