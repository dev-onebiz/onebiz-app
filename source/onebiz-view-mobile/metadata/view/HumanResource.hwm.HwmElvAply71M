            "userConfig": {
                "fn": "Initialize",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    aprHistId = component.initialConfig.aprHistId,",
                    "    record = component.initialConfig.record,",
                    "    command = component.command,",
                    "    docData = component.docData,",
                    "    afterchange = docData.afterchange,",
                    "    items = afterchange.items,",
                    "    aplTct = afterchange.aplTct, // 건수",
                    "    aplTotSmamt = afterchange.aplTotSmamt, // render 합계금액",
                    "    str = String(aplTotSmamt),",
                    "    aplTotSmamtRender = str.replace(/(\\d)(?=(?:\\d{3})+(?!\\d))/g, '$1,'),",
                    "    fromDoc = component.initialConfig.fromDoc;",
                    "",
                    "",
                    "items = me.recoveryFormRender(items);",
                    "",
                    "for(var i in items){",
                    "    items[i].isAply = true; // 결재 화면으로 사용하는 Items에서는 readOnly 처리하기 위해 사용하는 플래그",
                    "}",
                    "",
                    "var data = {",
                    "    aplTct : aplTct,",
                    "    aplTotSmamtRender : aplTotSmamtRender",
                    "};",
                    "",
                    "vm.set('data', data);",
                    "vm.set('records', items);",
                    "vm.set('afterchange', afterchange);",
                    "vm.set('docData', docData);",
                    "vm.set('aplTct', aplTct); // 건수",
                    "vm.set('aplTotSmamtRender', aplTotSmamtRender); // render 합계금액",
                    "",
                    "vm.set('aprHistId', aprHistId);",
                    "vm.set('record', record);",
                    "",
                    "",
                    "var dataAft = docData.afterchange;",
                    "refs.rgdt.setHtml(record.rgdt);",
                    "",
                    "refs.rqpr.setValue(dataAft.rqpr);",
                    "",
                    "refs.headTitle.setHtml( \"조퇴\"+ (dataAft.aplDvcd == '01' ? '신청' : '취소신청' ));",
                    "refs.aplDvcdNm.setValue(dataAft.aplDvcd == '01' ? '신청' : '취소신청');",
                    "refs.aplDvcd.setValue(dataAft.aplDvcd);",
                    "",
                    "refs.aplCmpDt.setValue(me.dateFormat(dataAft.aplElvDt,'date'));",
                    "refs.aplCmpStrdt.setValue(me.dateFormat(dataAft.aplElvStrdt,'date'));",
                    "refs.aplCmpStrtm.setValue(me.dateFormat(dataAft.aplElvStrtm,'time'));",
                    "refs.aplCmpEdt.setValue(me.dateFormat(dataAft.aplElvEdt,'date'));",
                    "refs.aplCmpEdtm.setValue(me.dateFormat(dataAft.aplElvEdtm,'time'));",
                    "refs.aplCntn.setValue(dataAft.aplCntn);",
                    "",
                    "if(dataAft.aplDvcd == '01'){",
                    "    vm.set('docCd', 'HwmElvAply71');",
                    "    vm.set('docNm', '조퇴 신청서');",
                    "} else {",
                    "    vm.set('docCd', 'HwmElvAply72');",
                    "    vm.set('docNm', '조퇴 취소신청서');",
                    "}",
                    "",
                    "refs.aplCmpStrtm.el.select('.x-error-el').setStyle('margin','0px');",
                    "refs.aplCmpEdtm.el.select('.x-error-el').setStyle('margin',\t'0px');",
                    "",
                    "refs.aplTm.setValue(dataAft.aplTm);",
                    "// 결재문서 초기화 설정",
                    "ApprovalBoxSvc.setup({",
                    "    command   : command,",
                    "    viewModel : vm,",
                    "    aprHistId : aprHistId,",
                    "    edocCd    : vm.get('docCd'),",
                    "    scope     : me",
                    "});"
                ],
                "name": "initialize",
                "scope": "me"
            },
