                                    "codeClass": null,
                                    "userConfig": {
                                        "designer|commentHeader": [
                                            "날짜 선택"
                                        ],
                                        "fn": "onDatefieldChange",
                                        "implHandler": [
                                            "var me = this,",
                                            "    vm = me.getViewModel(),",
                                            "    refs = me.getReferences();",
                                            "",
                                            "switch (datefield.name) {",
                                            "    case 'aplOvtStrdt':",
                                            "        var date = refs.aplOvtStrdt.getValue();",
                                            "        if (date) {",
                                            "            refs.aplOvtEdt.setMinDate(date);",
                                            "            refs.aplOvtEdt.setMaxDate(DateUtils.addDate(date , 1));",
                                            "        }",
                                            "        break;",
                                            "    case 'aplOvtDt':",
                                            "        if(!Ext.isDate(datefield.getValue()) || refs.aplOvtDt.getValue()==null)",
                                            "            return;",
                                            "",
                                            "        var values = {",
                                            "            wrkDt : DateUtils.getDate(datefield.getValue()),",
                                            "            hrHrpmEmpId : vm.get('detail.hrHrpmEmpId'),",
                                            "            wrkStdt : DateUtils.getDate(DateUtils.getFirstDateOfMonth(datefield.getValue())),",
                                            "            wrkEddt : DateUtils.getDate(DateUtils.getLastDateOfMonth(datefield.getValue()))",
                                            "        };",
                                            "",
                                            "        Ext.Ajax.request({",
                                            "            headers : {",
                                            "                serviceId : 'HwmOvtSvc.findAllHwmOvtHist',",
                                            "                viewId : me.getViewId(),",
                                            "                scope : me,",
                                            "            },",
                                            "            jsonData : values,",
                                            "            success : function(response) {",
                                            "                var res = Ext.JSON.decode(response.responseText),",
                                            "                    ovttmMnth = 0;",
                                            "                for(var i=0; i<res.initData.length;i++){",
                                            "                    var value = res.initData[i];",
                                            "                    value.rplOvtEdtm = ''+(value.rplOvtEdtm/1 + (value.rplOvtEdt-value.rplOvtStrdt)*240000);",
                                            "                    var ovtLength = value.rplOvtEdtm.length;",
                                            "                    for(var j=0;j<6-ovtLength;j++)",
                                            "                        value.rplOvtEdtm = 0 + value.rplOvtEdtm;",
                                            "                    //            if(this.data.wrkDt != value.ovtDt) // 해당일 시간 빼기",
                                            "                    ovttmMnth += me.timeDiff(value.rplOvtStrtm, value.rplOvtEdtm);",
                                            "                    ovttmMnth = Math.floor(ovttmMnth*2)*0.5;",
                                            "",
                                            "                }",
                                            "                refs.aplDt.setValue(res.time.aplDt);",
                                            "                refs.aplTm.setValue(res.time.aplTm);",
                                            "                refs.ovttmMnth.setValue(ovttmMnth);",
                                            "                refs.aplOvtStrdt.setValue(datefield.getValue());",
                                            "                refs.aplOvtEdt.setValue(datefield.getValue());",
                                            "",
                                            "                refs.maxOvttmMnth.setValue((res.maxOvttm==null ||res.maxOvttm.maxOvttmMnth==null)? 0:res.maxOvttm.maxOvttmMnth);",
                                            "                refs.maxOvttmDay.setValue((res.maxOvttm==null ||res.maxOvttm.maxOvttmDay==null)? 0:res.maxOvttm.maxOvttmDay);",
                                            "                refs.mnth.setValue(ovttmMnth +\" / \"+refs.maxOvttmMnth.getValue());",
                                            "",
                                            "                if(vm.get('btnCancel') !=null){ //취소신청일 때",
                                            "                    refs.aplOvtDt.setDisabled(true);",
                                            "                    //            refs.aplOvtStrdt.setReadOnly(true);",
                                            "                    refs.aplOvtStrtm.setDisabled(true);",
                                            "                    //            refs.aplOvtEdt.setReadOnly(true);",
                                            "                    refs.aplOvtEdtm.setDisabled(true);",
                                            "                    refs.aplCntn.setValue('취소 신청하겠습니다.');",
                                            "                    refs.aplDvcd.setValue(Constants.wrkAplDvcd.CANCEL);",
                                            "                    refs.aplDvcdNm.setValue(CodeUtils.getText('HWM009', Constants.wrkAplDvcd.CANCEL));",
                                            "                    refs.aplOvtStrtm.setValue(DateUtils.encodeDate(DateUtils.getTimeToDate(refs.aplOvtStrtm.getValue()),\"H:i\"));",
                                            "                    refs.aplOvtEdtm.setValue(DateUtils.encodeDate(DateUtils.getTimeToDate(refs.aplOvtEdtm.getValue()),\"H:i\"));",
                                            "                    refs.wrkDt.setValue(null);",
                                            "                    refs.wrkTm.setValue(null);",
                                            "                    return;",
                                            "                } else{",
                                            "                    refs.aplOvtDt.setDisabled(false);",
                                            "                    //            refs.aplOvtStrdt.setReadOnly(false);",
                                            "                    refs.aplOvtStrtm.setDisabled(false);",
                                            "                    //            refs.aplOvtEdt.setReadOnly(false);",
                                            "                    refs.aplOvtEdtm.setDisabled(false);",
                                            "                }",
                                            "",
                                            "                if(res.maxOvttm==null ||res.maxOvttm.wrkDt==null){ //근무기준이 존재하지 않을 때.",
                                            "                    Ext.Msg.alert(\"안내\", \"연장근무일자에 해당되는 근무기준이 존재하지 않습니다. <br/> 관리자에게 문의해주십시오.\");",
                                            "                    if(vm.get('btnReApply') ==null){",
                                            "                        refs.aplOvtStrtm.setValue(DateUtils.parseTime('1900'));",
                                            "                        refs.aplOvtEdtm.setValue(DateUtils.parseTime('2100'));",
                                            "                    }",
                                            "                }",
                                            "                else if(vm.get('btnReApply') == null){ //재기안이 아닐 때",
                                            "                    var Dt = res.maxOvttm.wrkEdt;",
                                            "                    var tm = res.maxOvttm.wrkEdtm;",
                                            "",
                                            "                    var strdtm = new Date(Dt.substr(0,4),Dt.substr(4,2)-1,Dt.substr(6,2),Number(tm.substr(0,2))+1,tm.substr(2,2));",
                                            "                    var enddtm = new Date(Dt.substr(0,4),Dt.substr(4,2)-1,Dt.substr(6,2),Number(tm.substr(0,2))+3,tm.substr(2,2));",
                                            "                    refs.aplOvtStrdt.setValue(strdtm);",
                                            "                    refs.aplOvtStrtm.setValue(DateUtils.encodeDate(DateUtils.getTimeToDate(strdtm),\"H:i\"));",
                                            "                    refs.aplOvtEdt.setValue(enddtm);",
                                            "                    refs.aplOvtEdtm.setValue(DateUtils.encodeDate(DateUtils.getTimeToDate(enddtm),\"H:i\"));",
                                            "                    refs.wrkDt.setValue(strdtm);",
                                            "                    refs.wrkTm.setValue(DateUtils.encodeDate(DateUtils.getTimeToDate(strdtm),\"H:i\"));",
                                            "                } else {//근무기준이 존재하지만 재기안일 때",
                                            "                    refs.aplOvtStrtm.setValue(DateUtils.encodeDate(DateUtils.getTimeToDate(refs.aplOvtStrtm.getValue()),\"H:i\"));",
                                            "                    refs.aplOvtEdtm.setValue(DateUtils.encodeDate(DateUtils.getTimeToDate(refs.aplOvtEdtm.getValue()),\"H:i\"));",
                                            "                }",
                                            "                //총 시간외근무시간 표시 (금월/금주)",
                                            "                refs.totOvtHodMonthHr.setValue(res.totAdmtOvtHod.totOvtHodMonthHr);",
                                            "                refs.totOvtHodWeekHr.setValue(res.totAdmtOvtHod.totOvtHodWeekHr);",
                                            "",
                                            "                //결재진행중인 시간 표시",
                                            "                vm.set('criTime' , res.criTime); //기준시간",
                                            "                vm.set('totAdmtOvthodHr' , res.totAdmtOvtHod.totOvtHodMonthHr); //인정시간",
                                            "                vm.set('totIngOvthodHr' , res.totIngOvthodHr); //현재 보고 결재 진행중이거나, 보고 전인 시간외근무 시간",
                                            "            }",
                                            "        });",
                                            "}"
                                        ],
                                        "name": "change",
                                        "scope": "me"
                                    },
