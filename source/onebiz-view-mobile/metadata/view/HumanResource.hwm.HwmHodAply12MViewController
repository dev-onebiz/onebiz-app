                "fn": "updateAplyAndCheck",
                "implHandler": [
                    "if(!aplyYn) return;",
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    approvalLineGrid = refs.approvalLineGrid,",
                    "    hodStrtm= DateUtils.encodeDate(refs.hodStrtm.getValue()).substr(11,8).replace(/:/g,''),",
                    "    hodEdtm=DateUtils.encodeDate(refs.hodEdtm.getValue()).substr(11,8).replace(/:/g,''),",
                    "    timediff = me.timeDiff(hodStrtm, hodEdtm);",
                    "",
                    "var afterchange = {",
                    "            stlmDvcd : '09',",
                    "            aplStcd : '11',",
                    "            aplTct : 1, // 총 건수",
                    "        };",
                    "",
                    "afterchange.id = Ext.id();",
                    "afterchange.crud = 'C';",
                    "afterchange.rqpr =refs.rqpr.getValue() ;",
                    "",
                    "afterchange.stcd = Constants.stcd.OUTSTANDING;",
                    "afterchange.hrHrpmCompId = SecurityUtils.getPrincipal().hrHrpmCompId;",
                    "",
                    "var date = new Date();",
                    "var nHour = date.getHours();",
                    "nHour = nHour  < 10 ? '0'+nHour :  nHour;",
                    "var nMin = date.getMinutes();",
                    "nMin = nMin  < 10 ? '0'+nMin :  nMin;",
                    "var nSec = date.getSeconds();",
                    "nSec = nSec  < 10 ? '0'+nSec :  nSec;",
                    "refs.aplTm.setValue(nHour+\"\"+nMin+\"\"+nSec);",
                    "",
                    "var month = (date.getMonth()+1) +\"\";",
                    "month = month.length == 1 ? \"0\" + month: month;",
                    "var dateDD = date.getDate()+\"\";",
                    "dateDD = dateDD.length == 1 ? \"0\" + dateDD: dateDD;",
                    "",
                    "afterchange.aplDt =date.getFullYear() + month + dateDD;",
                    "afterchange.aplTm =nHour+\"\"+nMin+\"\"+nSec;",
                    "",
                    "// 날자관련 데이터 변환",
                    "var dateCompoList = ['aplHodDt',",
                    "                     'hodStrdt',",
                    "                     'hodEdt'",
                    "                    ];",
                    "",
                    "for(var key in dateCompoList ){",
                    "    var dateObj = refs[dateCompoList[key]];",
                    "    var date = dateObj.getValue();",
                    "    var tempMonth = date.getMonth()+1 ;",
                    "    tempMonth += \"\";",
                    "    tempMonth = (tempMonth.length == 1 ? \"0\" :\"\") + tempMonth;",
                    "",
                    "    var dateDD = date.getDate()+\"\";",
                    "    dateDD = (dateDD.length == 1 ? \"0\" :\"\") + dateDD;",
                    "    afterchange[dateCompoList[key]] = date.getFullYear() +\"\" + tempMonth + \"\" + dateDD;",
                    "}",
                    "",
                    "",
                    "// 시간관련 데이터 변환",
                    "var hourCompoList  = ['hodStrtm',",
                    "                      'hodEdtm'];",
                    "",
                    "for(var key in hourCompoList ){",
                    "    var timeObj = refs[hourCompoList[key]].getValue();",
                    "    var hh = timeObj.getHours()+\"\";",
                    "    var mi = timeObj.getMinutes()+\"\";",
                    "    hh = (hh.length == 1 ? '0' : \"\") + hh;",
                    "    mi = (mi.length == 1 ? '0' : \"\") + mi;",
                    "",
                    "    afterchange[hourCompoList[key]] = hh + \"\" + mi+'00';",
                    "}",
                    "",
                    "afterchange.hrHrpmEmpId = SecurityUtils.getPrincipal().hrHrpmEmpId;",
                    "afterchange.aplCntn = refs.aplCntn.getValue();",
                    "afterchange.aplDvcd = refs.aplDvcd.getValue();",
                    "afterchange.aplTm = refs.aplTm.getValue();",
                    "afterchange.mnth         = refs.mnth.getValue();",
                    "afterchange.maxHodtmMnth = refs.maxHodtmMnth.getValue();",
                    "afterchange.maxHodtmDay  = refs.maxHodtmDay.getValue();",
                    "afterchange.hodtmMnth    = refs.hodtmMnth.getValue();",
                    "",
                    "afterchange.totOvtHodMonthDds = refs.totOvtHodMonthDds.getValue();",
                    "afterchange.totOvtHodMonthHr = refs.totOvtHodMonthHr.getValue();",
                    "afterchange.totOvtHodWeekDds = refs.totOvtHodWeekDds.getValue();",
                    "afterchange.totOvtHodWeekHr = refs.totOvtHodWeekHr.getValue();",
                    "",
                    "afterchange.wrkDt = afterchange.aplHodDt;",
                    "afterchange.wrkTm = afterchange.hodStrtm;",
                    "",
                    "var formData = afterchange;",
                    "",
                    "afterchange.upcheck =\"chk\";",
                    "",
                    "",
                    "if (refs.ap.getText() == '취소완료') {",
                    "    // 취소",
                    "    me.reqServer(afterchange, aplyYn);",
                    "} else {",
