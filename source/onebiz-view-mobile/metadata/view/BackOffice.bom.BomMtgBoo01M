        {
            "type": "viewcontrollereventbinding",
            "reference": {
                "name": "listeners",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "화면초기화"
                ],
                "fn": "initialize",
                "implHandler": [
                    "var me = this;",
                    "var refs = me.getReferences();",
                    "var vm = me.getViewModel();",
                    "",
                    "// 회의실 콤보박스 설정",
                    "me.onSelectCodeList(refs.selectedMtgRoomDvcd,'MTG');",
                    "",
                    "// 달력 클릭 이벤트 부여",
                    "me.addEventListener();",
                    "",
                    "// 달력 조회",
                    "// 날짜 선택 <-> 캘린더 -> 월 동기화",
                    "var date =new Date();",
                    "var mm = date.getMonth() +1;",
                    "if(mm < 10){",
                    "    mm =  \"0\"+ mm;",
                    "} else {",
                    "    mm = mm.toString();",
                    "}",
                    "refs.dtpStDt.setValue(date.getFullYear()+'년 ' + mm +\"월\");",
                    "",
                    "",
                    "",
                    "// 달력 사이드바 제거",
                    "var calRefs = refs.cal.getReferences();",
                    "calRefs.titleBar.setVisibility(false);",
                    "if(!Ext.isEmpty(calRefs.sideBar)){",
                    "    calRefs.sideBar.setVisibility(false);",
                    "}"
                ],
                "name": "initialize",
                "scope": "me"
            },
            "configAlternates": {
                "fn": "string",
                "implHandler": "code",
                "name": "string",
                "scope": "string",
                "designer|commentHeader": "comment"
            },
            "name": "initialize",
            "designerId": "bdabe7a5-ffa7-4933-b71e-4db954097e72"
        }
    ]
}