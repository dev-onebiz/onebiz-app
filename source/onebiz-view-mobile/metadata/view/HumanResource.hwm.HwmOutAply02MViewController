        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "기타영수증 필수값 검증"
                ],
                "designer|params": [
                    "aplyYn"
                ],
                "fn": "updateAplyAndCheck",
                "implHandler": [
                    "if(!aplyYn) return;",
                    "",
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    approvalLineGrid = refs.approvalLineGrid;",
                    "",
                    "var afterchange = {",
                    "            stlmDvcd : '09',",
                    "            aplStcd : '11',",
                    "            aplTct : 1, // 총 건수",
                    "        };",
                    "",
                    "afterchange.id = Ext.id();",
                    "afterchange.crud = 'C';",
                    "",
                    "afterchange.stcd = Constants.stcd.OUTSTANDING;",
                    "",
                    "afterchange.rqpr =refs.rqpr.getValue() ;",
                    "",
                    "var date = new Date();",
                    "var nHour = date.getHours();",
                    "nHour = nHour  < 10 ? '0'+nHour :  nHour;",
                    "var nMin = date.getMinutes();",
                    "nMin = nMin  < 10 ? '0'+nMin :  nMin;",
                    "var nSec = date.getSeconds();",
                    "nSec = nSec  < 10 ? '0'+nSec :  nSec;",
                    "refs.aplTm.setValue(nHour+\"\"+nMin+\"\"+nSec);",
                    "",
                    "afterchange.aplTm =nHour+\"\"+nMin+\"\"+nSec;",
                    "// 날자관련 데이터 변환",
                    "var dateCompoList = ['aplOutDt',",
                    "                     'aplOutStrdt',",
                    "                     'aplOutEdt'",
                    "                    ];",
                    "",
                    "for(var key in dateCompoList ){",
                    "    var dateObj = refs[dateCompoList[key]];",
                    "    var date = dateObj.getValue();",
                    "    var tempMonth = date.getMonth()+1 ;",
                    "    tempMonth += \"\";",
                    "    tempMonth = (tempMonth.length == 1 ? \"0\" :\"\") + tempMonth;",
                    "",
                    "    var dateDD = date.getDate()+\"\";",
                    "    dateDD = (dateDD.length == 1 ? \"0\" :\"\") + dateDD;",
                    "    afterchange[dateCompoList[key]] = date.getFullYear() +\"\" + tempMonth + \"\" + dateDD;",
                    "}",
                    "",
                    "",
                    "",
                    "",
                    "// 시간관련 데이터 변환",
                    "var hourCompoList  = ['aplOutStrtm',",
                    "                      'aplOutEdtm'];",
                    "",
                    "for(var key in hourCompoList ){",
                    "    var timeObj = refs[hourCompoList[key]].getValue();",
                    "    var hh = timeObj.getHours()+\"\";",
                    "    var mi = timeObj.getMinutes()+\"\";",
                    "    hh = (hh.length == 1 ? '0' : \"\") + hh;",
                    "    mi = (mi.length == 1 ? '0' : \"\") + mi;",
                    "",
                    "    afterchange[hourCompoList[key]] = hh + \"\" + mi+\"00\";;",
                    "}",
                    "",
                    "",
                    "afterchange.hrHrpmEmpId = SecurityUtils.getPrincipal().hrHrpmEmpId;",
                    "afterchange.aplCntn = refs.aplCntn.getValue();",
                    "afterchange.aplDvcd = refs.aplDvcd.getValue();",
                    "",
                    "",
                    "",
                    "//var docNm = '외근'+(afterchange.aplDvcd  != '01' ?\"취소\" : \"\" )+'신청서';",
                    "var docNm = vm.get('docNm');",
                    "var formData = afterchange;",
                    "",
                    "",
                    "afterchange.upcheck =\"chk\";",
                    "// 결재이력데이터조회",
                    "Ext.Ajax.request({",
                    "    headers : {",
                    "        serviceId : 'HwmOutSvc.findAllHwmOutAply',",
                    "        viewId : 'HwmOutAply02M'",
                    "    },",
                    "    scope : me,",
                    "    jsonData :afterchange,",
                    "    success : function(response) {",
                    "        var ob = JSON.parse(response.responseText);",
                    "        var row1Cnt,row2Cnt,row3Cnt,row4Cnt, row5Cnt;",
                    "        var cont =ob.page.content;",
                    "",
                    "",
                    "        for(var i in cont){",
                    "            var name = cont[i].name;",
                    "",
                    "            if(name == 'f'){",
                    "                row1Cnt = cont[i].total;",
                    "            }else if(name == 'd'){",
                    "                row2Cnt = cont[i].total;",
                    "            }else if(name == 'yuhyo'){",
                    "                row4Cnt = cont[i].total;",
                    "            }else if(name =='mth'){",
                    "                row5Cnt = cont[i].total;",
                    "            }else{",
                    "                row3Cnt = cont[i].total;",
                    "            }",
                    "        }",
                    "",
                    "        if(row5Cnt > 0){",
                    "            Ext.Msg.alert('확인','월근태 결재 내역이 있습니다. <br/> 결재를 취소한 뒤 신청 부탁드리겠습니다.');",
                    "            return;",
                    "        }",
                    "",
                    "        var bizServiceId = 'HwmOutSvc.saveHwmOutAply';",
                    "        var edocCd = vm.get('docCd');",
                    "",
                    "        if(refs.aplDvcd.getValue() == '01' && row1Cnt > 0){",
                    "            Ext.Msg.alert('확인','이미 승인된 이력이 있습니다.');",
                    "            return;",
                    "",
                    "        }",
                    "",
                    "        if(refs.aplDvcd.getValue() == '02' && row1Cnt === 0){",
                    "            Ext.Msg.alert('확인','취소할 내역이 없습니다. 확인 부탁드리겠습니다.');",
                    "            return;",
                    "        }",
                    "",
                    "        if(refs.aplDvcd.getValue() == '01' && row2Cnt > 0){",
                    "            Ext.Msg.alert('확인','이미 신청된 이력이 있습니다.');",
                    "            return;",
                    "        }",
                    "",
                    "        if(row3Cnt > 0 && afterchange.aplDvcd == Constants.wrkAplDvcd.APPLY ){",
                    "            Ext.Msg.alert('확인','관리자가 수정한 내역이 있습니다. <br/> 관리자에게 확인 부탁드리겠습니다.');",
                    "            return;",
                    "        }",
                    "",
                    "        if(row4Cnt == 0 && afterchange.aplDvcd == Constants.wrkAplDvcd.APPLY ){",
                    "            Ext.Msg.alert('확인','신청일자에 해당되는 근무기준이 존재하지 않습니다. <br/> 관리자에게 문의해주십시오.');",
                    "            return;",
                    "        }",
                    "",
                    "        if(aplyYn){",
                    "            // + 버튼이 아님(formValid 에서 필요)",
                    "            formData.btnPlus = false;",
                    "            var errMsg = this.formValid(formData);",
                    "            if(errMsg.length > 0){",
                    "                Ext.Msg.alert('입력값을 확인해주세요.', errMsg);",
                    "                return false;",
                    "            }",
                    "            ApprovalBoxSvc.draft({",
                    "                scope                 : me,",
                    "                edocCd                : edocCd,\t\t\t\t \t \t\t// 전자문서관리에서 설정된 문서코드: 화면ID를 사용함",
                    "                docNm                 : docNm, \t\t\t\t\t\t\t \t\t// 문서명",
                    "                bizDvcd               : 'HWM', \t\t\t\t\t\t\t \t\t// 업무구분코드",
                    "                bizServiceId          : bizServiceId,   // 연관 업무서비스ID",
                    "                aprHistId             : null,\t\t\t\t\t\t \t \t\t// 결재이력ID",
                    "                approvalLineRecords   : approvalLineGrid.getJsonAllRecords(), \t// 결재선 그리드 데이터",
                    "                docData               : {\t\t\t\t\t\t\t\t \t\t// 결재문서 데이터",
                    "                    fieldValues       : vm.get('fieldValues'),",
                    "                    beforechange      : null,",
                    "                    afterchange       : afterchange \t\t\t // 결재문서 필드값",
                    "                }",
                    "            });",
                    "",
                    "        }",
                    "",
                    "",
                    "",
                    "    }",
                    "});"
                ]
            },
            "configAlternates": {
                "designer|commentHeader": "comment",
                "designer|params": "typedarray",
                "fn": "string",
                "implHandler": "code"
            },
            "name": "updateAplyAndCheck",
            "designerId": "5576197e-517f-41f4-860b-b597a232178b"
