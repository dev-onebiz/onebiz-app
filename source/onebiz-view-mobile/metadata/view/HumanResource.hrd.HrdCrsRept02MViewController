        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "유효성 검증"
                ],
                "designer|params": [
                    "formData"
                ],
                "fn": "formValid",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    reNo = /[^\\d]/,",
                    "    errMsg = '';",
                    "",
                    "// 기본검증",
                    "var form = refs.frmDetail,",
                    "    fields = form.getFields();",
                    "if(!form.validate()) {",
                    "    for(var i in fields) {",
                    "        var field = fields[i];",
                    "        if (!Ext.isArray(field) && field.name != 'null' && !field.isValid()) {",
                    "            var oriMsg = field.getErrorMessage(),",
                    "                fieldLabel = field.up('container').down('label');",
                    "",
                    "            if(fieldLabel) {",
                    "                fieldLabel = fieldLabel.getHtml();",
                    "            } else {",
                    "                fieldLabel = field.name;",
                    "            }",
                    "",
                    "            if (oriMsg.indexOf('This field is required') != -1) {\t\t\t\t// 필수값 누락",
                    "                errMsg += '- ' + fieldLabel + ' 을(를) 입력해주세요.<br>';",
                    "            } else if(oriMsg.indexOf('Is in the wrong format') != -1){\t\t\t// 포맷 오류",
                    "                errMsg += '- ' + fieldLabel + ' 입력값형식이 잘못되었습니다.<br>';",
                    "            } else if (errMsg.indexOf('- 입력값을 확인해주세요.<br>') == -1) {",
                    "                errMsg += '- 입력값을 확인해주세요.<br>';",
                    "            }",
                    "        }",
                    "    }",
                    "}",
                    "",
                    "// 연수과정 주요내용",
                    "if(formData.sttnMnCntn && formData.sttnMnCntn.length < 100){",
                    "    errMsg += '- 연수과정 주요내용을 100자 이상 입력해주세요.<br>';",
                    "} else if (formData.sttnMnCntn && formData.sttnMnCntn.length > 400) {",
                    "    errMsg += '- 연수과정 주요내용을 400자 이하로 입력해주세요.<br>';",
                    "}",
                    "",
                    "// 활용계획",
                    "if(formData.sttnPusePln && formData.sttnPusePln.length < 100){",
                    "    errMsg += '- 활용계획을 100자 이상 입력해주세요.<br>';",
                    "} else if (formData.sttnPusePln && formData.sttnPusePln.length > 400) {",
                    "    errMsg += '- 활용계획을 400자 이하로 입력해주세요.<br>';",
                    "}",
                    "",
                    "// 결재선",
                    "if(!formData.applyLine && formData.aplDvcd == Constants.aplDvcd.APPLY){",
                    "    errMsg += '- 결재선을 선택해주세요.';",
                    "}",
                    "",
                    "return errMsg;"
                ]
            },
            "configAlternates": {
                "designer|commentHeader": "comment",
                "designer|params": "typedarray",
                "fn": "string",
                "implHandler": "code"
            },
            "name": "formValid",
            "designerId": "8663a233-16f5-43c1-9619-924bd205bdb6"
        }
