            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "내부함수 / 신규일 때, 데이터 세팅"
                ],
                "designer|params": [
                    "params"
                ],
                "fn": "fnInitValueWhenNew",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    form = refs.frmDetail;",
                    "",
                    "vm.set('detail.id', Ext.id());",
                    "vm.set('detail.crud', 'C');",
                    "",
                    "// 2020.11.09  - form 바인딩이 제대로 되지 않아 아래와 같이 처리",
                    "vm.set('detail.stcd', (params.stcd) ? params.stcd : Constants.stcd.OUTSTANDING);",
                    "",
                    "vm.set('detail.aplDvcd', Constants.wrkAplDvcd.APPLY);",
                    "vm.set('detail.aplStcd', Constants.aplStcd.PROGRESS_APPLY);",
                    "",
                    "vm.set('detail.hrHrpmCompId', SecurityUtils.getPrincipal().hrHrpmCompId); //회사",
                    "vm.set('detail.hrHrpmEmpId', SecurityUtils.getPrincipal().hrHrpmEmpId);",
                    "vm.set('detail.empeNo', SecurityUtils.getPrincipal().hrHrpmEmpId);",
                    "vm.set('detail.dpnm', SecurityUtils.getPrincipal().dpnm);",
                    "vm.set('detail.empeNm', SecurityUtils.getPrincipal().empeNm);",
                    "vm.set('detail.empePsitNm', SecurityUtils.getPrincipal().empePsitNm);",
                    "vm.set('detail.rqpr', SecurityUtils.getPrincipal().hrHrpmEmpId + \" / \" + SecurityUtils.getPrincipal().dpnm + \" / \" + SecurityUtils.getPrincipal().empeNm + \" / \" + SecurityUtils.getPrincipal().empePsitNm);",
                    "",
                    "vm.set('detail.aplDvcdNm', CodeUtils.getText('HWM009', vm.get('detail.aplDvcd')));\t\t// 신청구분 (HWM009)",
                    "vm.set('detail.stcdNm', CodeUtils.getText('INB014', vm.get('detail.stcd')));\t\t// 상태 (INB014)",
                    "vm.set('detail.aplStcdNm', CodeUtils.getText('INB025', vm.get('detail.aplStcd')));\t\t// 결재상태 (INB025)",
                    "params.sttnStrdtHiphone = DateUtils.parseDate(params.sttnStrdt).substr(0,10);\t\t// 연수시작일자",
                    "params.sttnEdtHiphone = DateUtils.parseDate(params.sttnEdt).substr(0,10);\t\t// 연수종료일자",
                    "",
                    "",
                    "vm.set('stnApfInfo', params);",
                    "if (params.comAprHistApfId) {",
                    "    params.hrHrdmStnApfName = DateUtils.parseDate(params.sttnStrdt) + '일 ' + ' ~ ' + DateUtils.parseDate(params.sttnEdt) + '일 ' + '(' + params.sttnPridCntNm + ')';",
                    "//     refs.hrHrdmStnApfForm.setHidden(false);",
                    "    refs.hrHrdmStnApfName.setReadOnly(true);",
                    "} else {",
                    "    refs.hrHrdmStnApfForm.setHidden(true);",
                    "}",
                    "",
                    "",
                    "form.setValues(vm.get('detail'));",
                    "form.setValues(vm.get('stnApfInfo'));"
                ]
            },
