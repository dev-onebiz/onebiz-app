                                                "designer|params": [
                                                    "value",
                                                    "record",
                                                    "dataIndex",
                                                    "cell",
                                                    "column"
                                                ],
                                                "fn": "renderer",
                                                "implHandler": [
                                                    "var mainCtt = '<div style=\"width:100%; font:normal normal normal 16px/27px SF Compact Display; color:#333333;  overflow:hidden; display:inline-block; text-overflow:ellipsis; -webkit-line-clamp:1; -webkit-box-orient:vertical;\">'",
                                                    "                        + record.data.title + '</div>';",
                                                    "",
                                                    "var date = record.data.cttDate;",
                                                    "date = date.substr(0, 4) + '. ' + date.substr(4, 2) + '. ' + date.substr(6, 2);",
                                                    "mainCtt += '<div style=\"font:normal normal normal 13px/18px SF Compact Display; color:#666666;\">' + record.data.src + '<span style=\"margin:0px 8px; color:#DDDDDD\">|</span>' + date + '</div>';",
                                                    "cell.setStyle('padding:0px;background-color:#F3F4F6;');",
                                                    "cell.el.dom.firstElementChild.style.padding = \"8px 0px\";",
                                                    "return mainCtt;"
                                                ]
                                            },
