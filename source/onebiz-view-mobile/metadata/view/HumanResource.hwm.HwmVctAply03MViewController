            "userConfig": {
                "designer|commentHeader": [
                    "상세화면 조회"
                ],
                "fn": "onSelect",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    values = {",
                    "        hrWrkmVctApfId : vm.get('hrWrkmVctApfId'),",
                    "        detailSelect : true,",
                    "        overLapCheck : false",
                    "    };",
                    "",
                    "// Service 호출",
                    "Ext.Ajax.request({",
                    "    headers : {",
                    "        viewId : this.getView().xtype, // userAlias",
                    "        serviceId : 'HwmVctSvc.findAllHwmVctDetail'",
                    "    },",
                    "    jsonData : values,",
                    "    scope : me,",
                    "    success : function(response) {",
                    "        var result = Ext.JSON.decode(response.responseText); // 서버응답결과 JSON 변환",
                    "",
                    "        // Service 성공 했을 경우 기능",
                    "        console.log('휴가 상세 select Service success');",
                    "",
                    "        var content = result.content;",
                    "        if(content.length > 0){",
                    "            vm.set('detail', content);",
                    "",
                    "            var container = refs.item_container,",
                    "                containerVm = container.getViewModel(),",
                    "                containerController = container.controller;",
                    "",
                    "            // 휴가 일수 만큼 폼 반복 생성",
                    "            containerController.addForm(result.content);",
                    "",
                    "        } else {",
                    "            Ext.Msg.alert('알림', '휴가 신청내역이 없습니다.');",
                    "            return false;",
                    "        }",
                    "",
                    "    },",
                    "    failure : function(response, opts){",
                    "        // Service 실패 했을 경우 기능",
                    "        console.log('휴가 상세 select Service failure');",
                    "    }",
                    "});",
                    ""
                ]
            },
