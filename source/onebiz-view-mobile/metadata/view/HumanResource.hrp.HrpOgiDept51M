                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    emp = component.initialConfig;",
                    "",
                    "var phone = emp.phone; // 휴대전화번호",
                    "if(phone && phone.length === 11){",
                    "    phone = phone.substr(0, 3) + '-' + phone.substr(3, 4) + '-' + phone.substr(7, 4);",
                    "}",
                    "if(phone && phone.length === 10){",
                    "    phone = phone.substr(0, 3) + '-' + phone.substr(3, 3) + '-' + phone.substr(6, 4);",
                    "}",
                    "",
                    "if(!phone){",
                    "    phone = '-';",
                    "}",
                    "",
                    "var neson = emp.neson; // 근무지전화번호",
                    "if(neson && neson.length === 11){",
                    "    neson = neson.substr(0, 3) + '-' + neson.substr(3, 4) + '-' + neson.substr(7, 4);",
                    "}",
                    "if(neson && neson.length === 10){",
                    "    neson = neson.substr(0, 3) + '-' + neson.substr(3, 3) + '-' + neson.substr(6, 4);",
                    "}",
                    "if(!neson){",
                    "    neson = '-';",
                    "}",
                    "",
                    "var fieldList = [ ",
                    "                  'dpnm' \t  \t//부서",
                    "                , 'empePsitNm'\t//직위",
                    "                , 'empeRsbNm' \t//직책",
                    "                , 'jobSrNm'\t\t//직렬",
                    "                , 'rolNm'\t\t//사무분담",
                    "                , 'wkplcNm'\t\t//근무지",
                    "                , 'compEmladr'\t//이메일",
                    "                ];",
                    "",
                    "for(var i in fieldList){",
                    "    if(Ext.isEmpty(emp[fieldList[i]])){",
                    "        emp[fieldList[i]] = '-';",
                    "    }",
                    "}",
                    "",
                    "vm.set('emp', emp);",
                    "vm.set('emp.phone', phone);",
                    "vm.set('emp.neson', neson);",
                    "",
                    "",
                    "",
                    "",
