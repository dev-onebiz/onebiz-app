        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "신청구분 :: 각 구분코드에 맞게 '변경 후' 필드 초기화"
                ],
                "fn": "redrawAplField",
                "implHandler": [
                    "var me = this,",
                    "    refs = me.getReferences(),",
                    "    bfrStrdt = refs.strdt.getValue(),",
                    "    bfrEdt = refs.edt.getValue(),",
                    "    wplcAplDvcd = refs.wplcAplDvcd;",
                    "",
                    "if(!refs.hrWrkmWkplcId.getValue() || wplcAplDvcd.getValue() == null){",
                    "    return;",
                    "}",
                    "",
                    "if(wplcAplDvcd.getValue() === Constants.wplcAplDvcd.WK_PLC){ //근무지변경(01)",
                    "      refs.btnFindWkplc.setHidden(false);",
                    "      refs.aplStrdt.setEditable(true);",
                    "      refs.aplStrdt.setDisabled(false);",
                    "      refs.aplStrdt.setValue(null);",
                    "",
                    "      refs.aplWkplcDvcd.setValue(null);",
                    "      refs.aplHrWrkmWkplcId.setValue(null);",
                    "      refs.aplWkplcNm.setValue(null);",
                    "",
                    "      //근무지 없음 상태일 때는 aplStrdt = bfrStrdt",
                    "      if(refs.hrWrkmWkplcId.getValue() == \"0\") {",
                    "        refs.aplStrdt.setMinDate(bfrStrdt);",
                    "        refs.aplStrdt.setMaxDate(bfrStrdt);",
                    "      }",
                    "      else if(DateUtils.getDate(bfrEdt) < DateUtils.getDate(new Date())){ //bfrEdt < 오늘",
                    "        refs.aplStrdt.setMinDate(new Date(bfrEdt.getFullYear(), bfrEdt.getMonth(), bfrEdt.getDate() + 1));",
                    "        refs.aplStrdt.setMaxDate(new Date());",
                    "      }",
                    "      else { //bfrEdt >= 오늘",
                    "        refs.aplStrdt.setMinDate(new Date());",
                    "        refs.aplStrdt.setMaxDate(new Date(bfrEdt.getFullYear(), bfrEdt.getMonth(), bfrEdt.getDate() + 1));",
                    "      }",
                    "    }",
                    "    else { //근무일자변경(02)",
                    "",
                    "      //근무지없음 상태인 경우 근무일자 변경 불가",
                    "      if(refs.hrWrkmWkplcId.getValue() == Constants.wkplcId.EMPTY_WKPLC){",
                    "        Ext.Msg.show({",
                    "            title : \"안내\",",
                    "            message : \"현재 정보로는 근무지변경만 가능합니다.\",",
                    "            fn : function() {",
                    "                refs.wplcAplDvcd.setValue(Constants.wplcAplDvcd.WK_PLC);",
                    "            }});",
                    "        return;",
                    "      }",
                    "",
                    "        refs.btnFindWkplc.setHidden(true);",
                    "        refs.aplStrdt.setEditable(false);",
                    "        refs.aplStrdt.setDisabled(true);",
                    "",
                    "        refs.aplWkplcDvcd.setValue(refs.wkplcDvcd.getValue());",
                    "        refs.aplHrWrkmWkplcId.setValue(refs.hrWrkmWkplcId.getValue());",
                    "        refs.aplWkplcNm.setValue(refs.wkplcNm.getValue());",
                    "",
                    "        refs.aplStrdt.setMinDate(refs.strdt.getValue());",
                    "        refs.aplStrdt.setValue(refs.strdt.getValue());",
                    "",
                    "        //aplStrdt에 event listener가 설정 되어 있기 때문에",
                    "        //aplEdt에 대한 변경은 해당 순서를 유지해야함.",
                    "        refs.aplEdt.setMinDate(new Date());",
                    "    }",
                    "",
                    "    refs.aplEdt.setValue(null);",
                    "    refs.rmrkCntn.setValue(\"프로젝트명 : \\r\\n사유 : \");"
                ]
            },
            "configAlternates": {
                "designer|commentHeader": "comment",
                "fn": "string",
                "implHandler": "code"
            },
            "name": "redrawAplField",
            "designerId": "3da945d4-d058-499d-8de6-d2a63c44d512"
        },
