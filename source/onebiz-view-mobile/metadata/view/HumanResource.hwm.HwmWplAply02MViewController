        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "입력값 검증"
                ],
                "fn": "formValid",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    form = refs.frmDetail.getFields(),",
                    "    errMsg = '' ;",
                    "",
                    "// 필드값 기본 검증",
                    "refs.frmDetail.validate();",
                    "for(var i = 0; i < form.null.length; i++) {",
                    "    var field = form.null[i];",
                    "    if (!field.isValid()) {",
                    "        var tmp = field.getErrorMessage();",
                    "        if (tmp.indexOf('This field is required') != -1) {",
                    "            errMsg += '- ' + field.getLabel() + ' 을(를) 입력해주세요.<br>';",
                    "        } else if (tmp.indexOf('The date in this field must be equal to or after') != -1) {",
                    "            errMsg += '- ' + field.getLabel() + ' 은(는) ' + tmp.split('after ')[1] +' 부터 입력가능합니다.<br>';",
                    "        } else {",
                    "            errMsg += '- ' + field.getLabel() + ' : ' + tmp + '<br>';",
                    "        }",
                    "        //console.log(field.getLabel() + \" : \" + field.getErrorMessage());",
                    "    }",
                    "}",
                    "",
                    "if (refs.rmrkCntn.getValue().length < 30) {",
                    "    errMsg += '- ' + '사유를 30자 이상 입력해주세요.<br>';",
                    "}",
                    "",
                    "if(!vm.get('applyLine')){",
                    "    errMsg += '- ' + '결재선을 선택해주세요.';",
                    "}",
                    "",
                    "",
                    "// 추가 검증 : 변경 유무 확인",
                    "if (errMsg == '') {",
                    "    var check = false;",
                    "",
                    "    if(refs.wkplcNm.getValue() != refs.aplWkplcNm.getValue()){",
                    "        check = true;",
                    "    }",
                    "    if(DateUtils.getDate(refs.strdt.getValue()) != DateUtils.getDate(refs.aplStrdt.getValue())){",
                    "        check = true;",
                    "    }",
                    "    if(DateUtils.getDate(refs.edt.getValue()) != DateUtils.getDate(refs.aplEdt.getValue())){",
                    "        check = true;",
                    "    }",
                    "",
                    "    if(!check){",
                    "        errMsg += '변경된 정보가 없습니다. 다시 확인 하십시오.';",
                    "    }",
                    "}",
                    "",
                    "return errMsg;"
                ]
            },
