        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "현재 근무지 정보 조회"
                ],
                "fn": "onSelect",
                "implHandler": [
                    "var me = this,",
                    "    refs = me.getReferences(),",
                    "    vm = me.getViewModel();",
                    "",
                    "var params = {",
                    "    hrHrpmEmpId : refs.hrHrpmEmpId.getValue(),",
                    "    stcd: refs.stcd.getValue(),",
                    "    crtDt: DateUtils.getDate(new Date()),",
                    "    wkplcDvcd: Constants.wkplcDvcd.MAIN_WKPLC",
                    "};",
                    "",
                    "var wplInfoForm = refs.wplInfoForm;",
                    "Ext.Ajax.request({",
                    "    headers: {",
                    "        serviceId: 'HwmWplSvc.findOneHwmWplInfo',",
                    "        viewId: 'HwmWplAply02M'",
                    "    },",
                    "    scope : me,",
                    "    jsonData :params,",
                    "    success : function(res) {",
                    "        var result = JSON.parse(res.responseText).result,",
                    "            wkplcNm = refs.wkplcNm,",
                    "            strdt = refs.strdt,",
                    "            edt = refs.edt,",
                    "            hrWrkmWkplcId = refs.hrWrkmWkplcId,",
                    "            wkplcDvcd = refs.wkplcDvcd,",
                    "            hrWrkmEmpWkplcId = refs.hrWrkmEmpWkplcId;",
                    "        if(result){",
                    "            var strdtTmp = result.strdt,",
                    "                edtTmp = result.edt;",
                    "            hrWrkmWkplcId.setValue(result.hrWrkmWkplcId);",
                    "            wkplcDvcd.setValue(result.wkplcDvcd);",
                    "            wkplcNm.setValue(result.wkplcNm);",
                    "            strdt.setValue(strdtTmp.substr(0,4)+\"-\"+strdtTmp.substr(4,2)+\"-\"+strdtTmp.substr(6,2));",
                    "            edt.setValue(edtTmp.substr(0,4)+\"-\"+edtTmp.substr(4,2)+\"-\"+edtTmp.substr(6,2));",
                    "            hrWrkmEmpWkplcId.setValue(result.hrWrkmEmpWkplcId);",
                    "        }",
                    "        else{",
                    "            hrWrkmWkplcId.setValue(Constants.wkplcId.EMPTY_WKPLC); \t\t//근무지ID:근무지없음(0)",
                    "            wkplcDvcd.setValue(Constants.wkplcDvcd.MAIN_WKPLC); \t\t//근무지구분코드:근무지(10)",
                    "            wkplcNm.setValue(\"근무지없음\"); \t\t\t\t\t\t\t\t //근무지명:근무지없음",
                    "            strdt.setValue(Ext.Date.format(new Date(), 'Y-m-d')); \t\t//근무시작일자",
                    "            edt.setValue(\"2999-12-31\"); \t\t\t\t\t\t\t\t//근무종료일자",
                    "        }",
                    "        me.redrawAplField();",
                    "    }",
                    "});"
                ]
            },
