                                "fn": "onBtnAplyTap",
                                "implHandler": [
                                    "var me = this,",
                                    "    vm = me.getViewModel(),",
                                    "    refs = me.getReferences(),",
                                    "    frmDetail = refs.frmDetail,",
                                    "    approvalLineGrid = refs.approvalLineGrid,",
                                    "    aprHistId = null;",
                                    "",
                                    "// formData",
                                    "var afterchange = {} ;",
                                    "for(var field in frmDetail.getFields()) {",
                                    "    var item = frmDetail.getFields()[field];",
                                    "    if (Ext.isArray(item) || item.name == 'null') {",
                                    "        continue;",
                                    "    }",
                                    "    if ( Ext.isDate(item.getValue()) ) {",
                                    "        afterchange[item.name] =  DateUtils.encodeDate(item.getValue(), item.submitFormat);",
                                    "    } else {",
                                    "        afterchange[item.name] = item.getValue();",
                                    "    }",
                                    "}",
                                    "afterchange.applyLine = vm.get('applyLine');\t// 결재선",
                                    "",
                                    "",
                                    "// FORM 내에 있는 값이 제대로 입력이되어있는지 확인 후 처리",
                                    "var errMsg = me.formValid(afterchange);",
                                    "if(errMsg.length > 0){",
                                    "    Ext.Msg.alert('유효성 검증', errMsg);",
                                    "    refs.frmDetail.clearErrors();",
                                    "    return false;",
                                    "}",
                                    "",
                                    "var hodStrdt = DateUtils.getDate(refs.hodStrdt.getValue());",
                                    "var hodEdt = DateUtils.getDate(refs.hodEdt.getValue());",
                                    "var hodStrtm= DateUtils.encodeDate(refs.hodStrtm.getValue(),'His');",
                                    "var hodEdtm= DateUtils.encodeDate(refs.hodEdtm.getValue(),'His');",
                                    "",
                                    "/* [2020.04.03] 급하게 임시 코드 추가함. add by HJ */",
                                    "afterchange.aplHodStrtm = hodStrtm;",
                                    "",
                                    "hodEdtm = ''+(hodEdtm/1 + (hodEdt-hodStrdt)*240000);",
