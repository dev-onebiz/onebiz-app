                                ],
                                "fn": "renderer",
                                "implHandler": [
                                    "var data = record.data,",
                                    "    msgDvcd = data.msgDvcd,\t\t// 메시지구분 코드",
                                    "    title = data.title,\t\t\t// 제목",
                                    "    fwDt = data.fwDt,\t\t\t// 발송일자",
                                    "    fwTm = data.fwTm;\t\t\t// 발송시간",
                                    "",
                                    "",
                                    "var code = 'TAS004',",
                                    "    codeStore = Ext.StoreMgr.get('CodeStore'),",
                                    "    items = codeStore.getData().items,",
                                    "    msgDvnm = '';\t\t\t\t\t// 메시지구분 명",
                                    "",
                                    "for (var i = 0, l = items.length; i < l; i++) {",
                                    "    if (code === items[i].data.code) {",
                                    "        var children = items[i].data.children;",
                                    "        for (var j = 0, l2 = children.length; j < l2; j++) {",
                                    "            var text = children[j].text,",
                                    "                value = children[j].value;",
                                    "            if (value === msgDvcd) {",
                                    "                msgDvnm = text;",
                                    "            }",
                                    "        }",
                                    "    }",
                                    "}",
                                    "",
                                    "var result = '';",
                                    "if (msgDvnm && fwDt.length == 8 && fwTm.length == 6) {",
                                    "    result = '<div style=font-size:16px;font-weight:bold;width:100%;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;display:inline-block;>[' + msgDvnm + '] ' + title + '</div><div>' + fwDt.substr(0,4) + '-' + fwDt.substr(4,2) + '-' + fwDt.substr(6,2) + ' ' + fwTm.substr(0,2) + ':' + fwTm.substr(2,2) + ':' + fwTm.substr(4,2) + '</div>';",
                                    "}",
                                    "return result;"
                                ]
                            },
                            "configAlternates": {
                                "designer|params": "typedarray",
