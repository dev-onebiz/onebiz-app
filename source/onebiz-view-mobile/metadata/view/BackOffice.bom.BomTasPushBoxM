                            " if(msgChkActDvcd == Constants.msgChkActDvcd.NORMAL) {",
                            "     // 일반",
                            "     win = Ext.create('BomTasPushDetailPopupM', {boTasmTrsId : selected[0].data.boTasmTrsId, refresh : true});",
                            "     ",
                            "     me.mon(win, 'refresh', function() {",
                            "         me.onSelect();",
                            "     }, me);",
                            "     ",
                            "     me.mon(win, 'redirect', function(viewId){",
                            "         me.onRedirectPage(viewId); ",
                            "     });",
                            "     ",
                            "     win.show();",
                            " } else if(msgChkActDvcd == Constants.msgChkActDvcd.APPROVAL) {",
                            "     // 결재",
                            "     win = Ext.create('BomTasPushDetailPopupM', {boTasmTrsId : selected[0].data.boTasmTrsId, refresh : true});",
                            "     me.mon(win, 'refresh', function() {",
                            "         me.onSelect();",
                            "     }, me);",
                            "     win.show();",
                            " }",
