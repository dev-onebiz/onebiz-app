            "userConfig": {
                "designer|commentHeader": [
                    "기타영수증 필수값 검증"
                ],
                "designer|params": [
                    "formData"
                ],
                "fn": "formValid",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    reNo = /[^\\d]/,",
                    "    errMsg = '';",
                    "",
                    "var userInfoList = formData.userInfoList;",
                    "for (var i in userInfoList) {",
                    "    var record = userInfoList[i];",
                    "    // 내부직원(01)이면서 사용부문이 존재하지 않는 경우, 오류메시지표시",
                    "    if (record.stfDvcd === '01') {",
                    "        if (!record.jasPrj) {",
                    "            errMsg += '내부직원의 사용부문을 선택해주세요.<br>';",
                    "            break;",
                    "        }",
                    "    }",
                    "    else {",
                    "        // 외부직원인 경우, 사용부문이 적용되는 버그가 존재하여 데이터 보정처리함",
                    "        record.jasPrj = null;",
                    "        record.jasPrjText = null;",
                    "    }",
                    "}",
                    "if(!formData.accItemCd){ // NTE011",
                    "    errMsg += '사용분류를 입력해주세요.<br>';",
                    "}",
                    "if(!formData.aplRscn){",
                    "    errMsg += '적요를 입력해주세요.<br>';",
                    "}",
                    "if(formData.aplRscn){",
                    "    if(formData.aplRscn.length > 65){",
                    "        errMsg += '적요의 길이를 확인해주세요.<br>';",
                    "    }",
                    "}",
                    "if(!formData.hrHrpmDeptId){",
                    "    errMsg += '사용부서를 입력해주세요.<br>';",
                    "}",
                    "if(!formData.userOrUseDept){",
                    "    errMsg += '사용자를 입력해주세요.<br>';",
                    "}",
                    "",
                    "var innerEmp = true;",
                    "for(var i in formData.gridData){",
                    "    if(formData.gridData[i].data.stfDvcd === '02'){",
                    "        innerEmp = false;",
                    "    }",
                    "}",
                    "if(formData.accItemCd !== '09' && !innerEmp){  // && 외부 사용자 있는지 체크",
                    "    errMsg += '사용분류가 업무추진비인 경우만 외부직원을 추가할 수 있습니다. 외부직원은 제외해 주시기바랍니다.<br>';",
                    "} else if(formData.accItemCd === '09' && innerEmp){",
                    "    errMsg += '사용분류가 업무추진비인 경우, 외부직원 입력은 필수입니다.<br>';",
                    "}",
                    "",
                    "// 사용분류 === 회의비인 경우 회의록이 필수",
                    "if(formData.accItemCd &&",
                    "   formData.accItemCd === '06' &&",
                    "   !formData.conferencePopupSuccess){",
                    "    errMsg += '사용분류가 회의비인 경우 회의록을 작성해주세요.<br>';",
                    "}",
                    "if(!vm.get('applyLine')){",
                    "    errMsg += '결재선을 선택해주세요.<br>';",
                    "}",
                    "",
                    "// 소모품비",
                    "if(formData.accItemCd && formData.accItemCd === '05' && !formData.imgPhoto){",
                    "    errMsg += '사용분류가 소모품비인경우 사진을 등록해 주세요.<br>';",
                    "}",
                    "",
                    "return errMsg;",
                    ""
                ]
            },
