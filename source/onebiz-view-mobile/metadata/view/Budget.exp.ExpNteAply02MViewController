                "fn": "recoveryFormRender",
                "implHandler": [
                    "for(var i in records){",
                    "    records[i].apvlAmtDom = String(records[i].apvlAmtDom).replace(/,/gi, '');",
                    "    records[i].apvlAmtDom = String(records[i].apvlAmtDom).replace(/ 원/gi, '');",
                    "",
                    "    records[i].apvlDt    = String(records[i].apvlDt).replace(/-/gi, '').substring(0, 8);",
                    "    records[i].apvlHr    = String(records[i].apvlHr).replace(/:/gi, '');",
                    "",
                    "    if(records[i].canYn != 'Y' && records[i].canYn != 'N'){",
                    "        records[i].canYn = this.getValue('NTE008', records[i].canYn);",
                    "    }",
                    "",
                    "    if(records[i].cdno)   records[i].cdno   = String(records[i].cdno).replace(/-/gi, '');",
                    "    if(records[i].mcBzno) records[i].mcBzno = String(records[i].mcBzno).replace(/-/gi, '');",
                    "",
                    "    if(records[i].stxat){",
                    "        records[i].stxat = String(records[i].stxat).replace(/,/gi, '');",
                    "        records[i].stxat = String(records[i].stxat).replace(/ 원/gi, '');",
                    "    }",
                    "    if(records[i].trnsAmtWc){",
                    "        records[i].trnsAmtWc = String(records[i].trnsAmtWc).replace(/,/gi, '');",
                    "        records[i].trnsAmtWc = String(records[i].trnsAmtWc).replace(/ 원/gi, '');",
                    "    }",
                    "",
                    "}",
                    "",
                    "return records;",
                    ""
                ]
