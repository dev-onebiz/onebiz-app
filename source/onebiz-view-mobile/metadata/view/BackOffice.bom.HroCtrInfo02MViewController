    "cn": [
        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "화면 처리 이벤트",
                    "",
                    "최초 : 작성 페이지에서 조회한 내용을 인자로 받아 화면 처리",
                    "계약서 작성 후에는 받은 인자가 아닌",
                    "DB에 저장된 새로운 데이터로 화면를 처리해야 함 -> AJAX"
                ],
                "fn": "onSelect",
                "implHandler": [
                    "var me = this;",
                    "var refs = me.getReferences();",
                    "var vm = me.getViewModel();",
                    "var principal = SecurityUtils.getPrincipal();",
                    "",
                    "var params = {",
                    "    hrHrpmEmpId : principal.hrHrpmEmpId,",
                    "    inbizDpnm : principal.dpnm,",
                    "    empePsitCd : principal.empePsitCd,",
                    "    inbizEmpeNo : principal.hrHrpmEmpId,",
                    "    stcd : '01',",
                    "    hrHrpmCompId : principal.hrHrpmCompId,",
                    "    id : vm.get('id') // id 검색으로 결과는 무조건 1개",
                    "};",
                    "",
                    "Ext.Ajax.request({",
                    "    headers : {",
                    "        serviceId : 'HroCtrInfoSvc.findAllHroCtrInfo',",
                    "        viewId : me.getViewId(),",
                    "    },",
                    "    jsonData : params,",
                    "    scope : me,",
                    "    success : function(response) {",
                    "        var res = Ext.JSON.decode(response.responseText);",
                    "        vm.set('selectedData', res.page.content[0]);",
                    "",
                    "        // 부서명",
                    "        if(!Ext.isEmpty(vm.get('selectedData').dpnm))",
                    "            refs.dpnm.setHtml(vm.get('selectedData').dpnm);",
                    "",
                    "        // 사번",
                    "        if(!Ext.isEmpty(vm.get('selectedData').empeNo))",
                    "            refs.empeNo.setHtml(vm.get('selectedData').empeNo);",
                    "",
                    "        // 이름 직위",
                    "        var userNm = '';",
                    "        if(!Ext.isEmpty(vm.get('selectedData').empeNm))",
                    "            userNm += vm.get('selectedData').empeNm;",
                    "        if(!Ext.isEmpty(userNm) && !Ext.isEmpty(vm.get('selectedData').empePsitNm))",
                    "            userNm += ' ' + vm.get('selectedData').empePsitNm;",
                    "        if(!Ext.isEmpty(userNm))",
                    "            refs.userNm.setHtml(userNm);",
                    "",
                    "        // 입사일자",
                    "        if(!Ext.isEmpty(vm.get('selectedData').etcoDt))",
                    "            refs.etcoDt.setHtml(DateUtils.parseDate(vm.get('selectedData').etcoDt));",
                    "",
                    "        // 나이",
                    "        if(vm.get('selectedData').empeAge != '세')",
                    "            refs.empeAge.setHtml(vm.get('selectedData').empeAge);",
                    "",
                    "        // 출생년도",
                    "        if(!Ext.isEmpty(vm.get('selectedData').empeBirdYear))",
                    "            refs.empeBird.setHtml(DateUtils.parseDate(vm.get('selectedData').empeBirdYear) + \"년\");",
                    "",
                    "        refs.criYy.setHtml(vm.get('selectedData').criYy + '년 연봉계약서'); // 기준년도",
                    "        refs.ctrcDt.setHtml('계약일자 : ' + DateUtils.parseDate(vm.get('selectedData').ctrcDt)); // 계약일자",
                    "",
                    "        var ctrcStrdtEdt = DateUtils.parseDate(vm.get('selectedData').ctrcStrdt) + ' ~ ' + DateUtils.parseDate(vm.get('selectedData').ctrcEdt);",
                    "        refs.ctrcStrdtEdt.setHtml('계약기간 : ' + ctrcStrdtEdt);",
                    "",
                    "        refs.ctrcAmt.setHtml(FormatUtils.moneyFormat(vm.get('selectedData').ctrcAmt) + '원'); // 연봉[기본급]",
                    "        refs.ctrcTotAmt.setHtml(FormatUtils.moneyFormat(vm.get('selectedData').ctrcTotAmt) + '원'); // 연봉등계약금액",
                    "        refs.ayrCtrcAmt.setHtml(FormatUtils.moneyFormat(vm.get('selectedData').ayrCtrcAmt) + '원'); // 연환산금액",
                    "        refs.pmCtrcAmt.setHtml(FormatUtils.moneyFormat(vm.get('selectedData').pmCtrcAmt) + '원'); // 월할지급액",
                    "        refs.rmrkCntn.setHtml(vm.get('selectedData').rmrkCntn); // 비고",
                    "",
                    "        // 계약 후",
                    "        if(vm.get('selectedData').comFrmDatasetId){",
                    "            refs.printBtn.setText('계약서 확인 - 계약 후');",
                    "            refs.printBtn.setStyle('background-color : #fff; color:#000;');",
                    "            refs.save.setHidden(true);",
                    "        }",
                    "        // 계약 전",
                    "        else{",
                    "            refs.printBtn.setText('계약서 확인 - 계약 전');",
                    "            refs.printBtn.setStyle('background-color : #d71822; color:#fff;');",
                    "            refs.save.setHidden(false);",
                    "        }",
                    "",
                    "    }",
                    "});"
                ]
            },
            "configAlternates": {
                "fn": "string",
                "implHandler": "code",
                "designer|commentHeader": "comment"
            },
            "name": "onSelect",
            "designerId": "bb7927c0-2be5-4767-b4ab-f0fdbc56a0fe"
        }
    ]
}