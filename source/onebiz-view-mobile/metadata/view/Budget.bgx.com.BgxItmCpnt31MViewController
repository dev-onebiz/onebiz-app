        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "계좌정보조회"
                ],
                "designer|params": [
                    "item"
                ],
                "fn": "fnSelectBcncAcnoInfo",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    D = new Ext.Deferred();",
                    "",
                    "Ext.Ajax.request({",
                    "    headers : {",
                    "        serviceId : 'BgxNfmSvc.findAllBcncAcnoInfo',",
                    "        viewId : me.getViewId(),",
                    "    },",
                    "    jsonData : item ,",
                    "    success : function(response, component) {",
                    "        var res = Ext.JSON.decode(response.responseText);",
                    "",
                    "        D.resolve(res.bcncAcnoInfo); // 성공",
                    "    },",
                    "    failure : function(res, vm) {",
                    "        D.reject(res.result); // 실패",
                    "    }",
                    "});",
                    "",
                    "return D.promise;"
                ]
            },
            "configAlternates": {
                "designer|commentHeader": "comment",
                "designer|params": "typedarray",
                "fn": "string",
                "implHandler": "code"
            },
            "name": "fnSelectBcncAcnoInfo",
            "designerId": "a9557d67-1b78-494d-a49c-ffb0c236f918"
        },
        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "유효성 검증"
                ],
                "fn": "fnApplyValid",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    valid = true,",
                    "    errMsg = '',",
                    "    userInfo = vm.get('expItemInputData.expItemUserInfo'),",
                    "    dgDsbInfo = vm.get('applyInfo.dgDsbInfo'),",
                    "    expItemData = vm.get('expItemData'),",
                    "    expItemInputData = vm.get('expItemInputData');",
                    "",
                    "// 집행대상",
                    "if (!userInfo || userInfo.length == 0) {",
                    "    valid = false;",
                    "    errMsg += '- 집행대상을 선택해주세요.<br>';",
                    "}",
                    "",
                    "// 계정과목",
                    "var xpnitKeyCd = refs.xpnitKeyCd.getValue();",
                    "if (!xpnitKeyCd) {",
                    "    valid = false;",
                    "    errMsg += '- 계정과목을 선택해주세요.<br>';",
                    "} else if (xpnitKeyCd == Constants.xpnitKeyCd.CONFERENCE && !expItemInputData.expItemMtgInfo) {",
                    "    // 회의록 - 회의비",
                    "    valid = false;",
                    "    errMsg += '- 회의록을 입력해주세요.<br>';",
                    "} else if (xpnitKeyCd == Constants.xpnitKeyCd.SUPPLIES_EXPENSES && !expItemInputData.imgPhoto) {",
                    "    // 영수증 - 소모품비",
                    "    valid = false;",
                    "    errMsg += '- 영수증을 첨부해주세요.<br>';",
                    "}",
                    "",
                    "// 영수증 - 기타영수증 (필수)",
                    "if (expItemData.nfcmEvidKndcd == Constants.nfcmEvidKndcd.ETC_RCT && !expItemInputData.imgPhoto) {",
                    "    valid = false;",
                    "    errMsg += '- 영수증을 첨부해주세요.<br>';",
                    "}",
                    "",
                    "// 지급정보 (법인카드 제외)",
                    "if (expItemData.nfcmEvidKndcd == Constants.nfcmEvidKndcd.ETC_RCT || expItemData.nfcmEvidKndcd == Constants.nfcmEvidKndcd.CSH_RCT) {",
                    "    if (refs.dgDsbInfoGrid.getStore().data.length == 0 ||!dgDsbInfo || !dgDsbInfo.bcncSeq) {",
                    "        valid = false;",
                    "        errMsg += '- 지급정보를 선택해주세요.<br>';",
                    "    }",
                    "}",
                    "",
                    "// 적요 (외부업체명 포함 100자이내)",
                    "var aplRscn = refs.aplRscn;",
                    "if (aplRscn.getValue() && aplRscn.getValue().length > 100) {",
                    "    valid = false;",
                    "    errMsg += '- 적요를 100자 이내로 작성해주세요.<br>';",
                    "}",
                    "",
                    "return {valid : valid, errMsg : errMsg};"
                ]
            },
            "configAlternates": {
                "designer|commentHeader": "comment",
                "fn": "string",
                "implHandler": "code"
            },
            "name": "fnApplyValid",
            "designerId": "d728e7dd-52a2-4abb-b6f3-a1dbb1103447"
        }
    ]
