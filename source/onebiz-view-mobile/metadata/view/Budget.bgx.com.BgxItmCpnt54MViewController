                "designer|params": [
                    "param",
                    "isAssigned"
                ],
                "fn": "fnSelectAssignedCodeList",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    D = new Ext.Deferred();",
                    "",
                    "var actgDt = vm.get('expItemInputData.bsnsDt');",
                    "var bsnsYy = DateUtils.getFormatValue(new Date(DateUtils.parseDate(actgDt)), 'Y'); //사업연도",
                    "var actgQut = DateUtils.getQuarter(new Date(DateUtils.parseDate(actgDt))); //회계분기",
                    "param['hrHrpmCompId'] = SecurityUtils.getPrincipal().hrHrpmCompId;",
                    "param['bsnsYy'] = bsnsYy;",
                    "param['bgDvcd1'] = Constants.bgDvcd1.EXPN;",
                    "param['isAsnQut'+actgQut] = isAssigned;",
                    "param['bgNfcmAplYn'] = Constants.yesNo.YES;",
                    "param['asnTrnsDvcd'] = Constants.asnTrnsDvcd.TOTAL_AMOUNT;",
                    "param['criYy'] = bsnsYy; //인력배정에서 필요한 기준연도",
                    "param['criDate'] = actgDt; //인력배정에서 필요한 기준일자.",
                    "",
                    "//TODO: 예산한도 같이 들고 와야 함. 화면에 뿌려줘야 해서.",
                    "Ext.Ajax.request({",
                    "    headers : {",
                    "        serviceId : 'BgxNfmSvc.findAllExpItemCodeList',",
                    "        viewId : me.getViewId()",
                    "    },",
                    "    jsonData : param,",
                    "    success : function(response) {",
                    "        var res = Ext.JSON.decode(response.responseText);",
                    "        D.resolve(res.codeList);",
                    "    },",
                    "    failure : function(response, scope) {",
                    "        var res = Ext.JSON.decode(response.responseText);",
                    "        console.log('status: ' + res.status);",
                    "        console.log('statusText: ' + res.statusText);",
                    "        console.log('responseText: ' + res.responseText);",
                    "",
                    "        D.reject(res.result);",
                    "    }",
                    "",
                    "});",
                    "",
                    "return D.promise;"
                ]
            },
