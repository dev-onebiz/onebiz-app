                    "var me = this;",
                    "var refs = me.getReferences();",
                    "",
                    "var msgList = Ext.StoreMgr.get('MessageStore').data.filterBy('code','M_HwmOvtAply51').items;",
                    "msgList.sort(function(data1, data2) {",
                    "    data1.data.code = data1.data.code.toLowerCase();",
                    "    data2.data.code = data2.data.code.toLowerCase();",
                    "    if (data1.data.code < data2.data.code) return -1;",
                    "    if (data1.data.code > data2.data.code) return 1;",
                    "    return 0;",
                    "});",
                    "",
                    "refs.contentArea.removeAll();",
                    "for( var i in msgList){",
                    "    refs.contentArea.add({",
