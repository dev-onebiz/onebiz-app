                                        "fn": "onBtnAplyLineTap",
                                        "implHandler": [
                                            "var me = this,",
                                            "    vm = me.getViewModel(),",
                                            "    win = Ext.create('BNK.view.common.ApprovalLinePopup', {});",
                                            "",
                                            "",
                                            "",
                                            "me.mon(win, 'selected', function(data, popup) {",
                                            "    var me = this,",
                                            "        vm = me.getViewModel(),",
                                            "        refs = me.getReferences(),",
                                            "        approvalLineGrid = refs.approvalLineGrid;",
                                            "",
                                            "    // 부장일때 validation 통과해버리는 문제",
                                            "    if(data.length > 0){",
                                            "        vm.set('applyLine', data);",
                                            "    } else {",
                                            "        return false;",
                                            "    }",
                                            "",
                                            "    ApprovalBoxSvc.setApprovalLine({",
                                            "      scope               : me,",
                                            "      command             : '01', // 결재선구분자 : 기안(01)",
                                            "      approvalLineGrid    : approvalLineGrid,   // 결재선 그리드 객체",
                                            "      approvalLineRecords : data        // 결재선선택 데이터",
                                            "     });",
                                            "",
                                            "    popup.close();",
                                            "}, me);",
                                            "",
                                            "win.show();"
                                        ],
