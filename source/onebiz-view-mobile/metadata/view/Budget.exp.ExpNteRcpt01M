                            "name": "MyButton28",
                            "designerId": "e993664d-c2a8-4aec-b4e9-a0a189f1ebf8",
                            "cn": [
                                {
                                    "type": "viewcontrollereventbinding",
                                    "reference": {
                                        "name": "listeners",
                                        "type": "array"
                                    },
                                    "codeClass": null,
                                    "userConfig": {
                                        "designer|commentHeader": [
                                            "결재 버튼 클릭 이벤트"
                                        ],
                                        "fn": "onBtnAplyTap",
                                        "implHandler": [
                                            "var me = this,",
                                            "    vm = me.getViewModel(),",
                                            "    refs = me.getReferences(),",
                                            "    items = [],",
                                            "    k = 0,",
                                            "    innerItems = this.getView().getReferences().item_container.getReferences().items.innerItems;",
                                            "",
                                            "// 입력값 검증 후 작성 데이터 items[] 에 모으기",
                                            "for(var i in innerItems){",
                                            "    var innerVm = innerItems[i].getViewModel();",
                                            "    var formData = innerVm.get('etcItem');",
                                            "",
                                            "    // + 버튼이 아님(formValid 에서 필요)",
                                            "    formData.btnPlus = false;",
                                            "    if(formData.useYn){",
                                            "        var errMsg = this.formValid(formData);",
                                            "        if(errMsg.length > 0){",
                                            "            Ext.Msg.alert('입력값을 확인해주세요.', errMsg);",
                                            "            return false;",
                                            "        }",
                                            "    }",
                                            "",
                                            "    // 입력받은 데이터",
                                            "    if(vm.data.moneyList[formData.atomItemIdx] !== null && formData.useYn){",
                                            "        items[k] = formData;",
                                            "        items[k].canYn = 'N';",
                                            "        items[k].mcAddr = ' ';",
                                            "        items[k].stlmDvcd = '09';",
                                            "",
                                            "        // 화면에서 입력받지 않지만 not null 인 경우",
                                            "        items[k].trnsStcd = '02';",
                                            "        k++;",
                                            "    }",
                                            "}",
                                            "",
                                            "",
                                            "// [START] 기안처리 후, 완료팝업에서 데이터 사용을 위해 저장함",
                                            "var successPopupData = {",
                                            "    paymentTitle   : '기타영수증 결재',",
                                            "    aplTct : vm.get('aplTct'), // 총 건수",
                                            "    aplTotSmamt : vm.get('aplTotSmamt'), // 합계금액",
                                            "    aplTotSmamtRender : vm.get('aplTotSmamtRender') // render 합계금액",
                                            "};",
                                            "vm.set('successPopupData', successPopupData);",
                                            "// [END] 기안처리 후, 완료팝업에서 데이터 사용을 위해 저장함",
                                            "",
                                            "// 각각 영수증 정보들",
                                            "vm.set('items', items);",
                                            "",
                                            "// [START] 결재에 필요한 데이터",
                                            "var aplTotSmamt = String(vm.get('aplTotSmamt')).replace(/,/gi, '');",
                                            "aplTotSmamt = aplTotSmamt.replace(/ 원/gi, '');",
                                            "",
                                            "var afterchange = {",
                                            "    items : items,",
                                            "    stlmDvcd : '09',",
                                            "    aplStcd : '10',",
                                            "    aplTct : vm.get('aplTct'), // 총 건수",
                                            "    aplTotSmamt : aplTotSmamt, // 합계금액",
                                            "};",
                                            "vm.set('afterchange', afterchange);",
                                            "// [END] 결재에 필요한 데이터",
                                            "",
                                            "// 기안",
                                            "this.onClickDraft();",
                                            "",
                                            ""
                                        ],
                                        "name": "tap",
                                        "scope": "me"
