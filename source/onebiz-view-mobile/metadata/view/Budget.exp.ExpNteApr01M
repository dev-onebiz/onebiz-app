            "type": "viewcontrollereventbinding",
            "reference": {
                "name": "listeners",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "fn": "onListSelect",
                "implHandler": [
                    "var me = this,",
                    "    data = selected.data,",
                    "    naviView = me.getView().up('navigationview');",
                    "",
                    "me.PUSH_VIEW(naviView, {",
                    "    menuId  : 'ExpNteApr02M',",
                    "    title   : data.menuName,",
                    "    command : data.command,",
                    "    isSubView : true",
                    "});"
                ],
                "name": "select",
                "scope": "me"
            },
            "configAlternates": {
                "fn": "string",
                "implHandler": "code",
