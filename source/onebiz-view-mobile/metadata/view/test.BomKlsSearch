                    "var vm = me.getViewModel();",
                    "var refs = me.getReferences();",
                    "var ctn = refs.subCtn2;",
                    "vm.set('start',false);",
                    "vm.set('total',1);",
                    "ctn.bodyElement.on('scroll',function(){",
                    "    me.onScrollEvent();",
                    "});",
                    "refs.searchForm.setValue(vm.initialConfig.view.config.searchText);",
                    "me.onClear();",
