                                                        "fn": "onChangeWrkStrdt",
                                                        "implHandler": [
                                                            "var me = this,",
                                                            "    vm = me.getViewModel(),",
                                                            "    refs = me.getReferences();",
                                                            "",
                                                            "if (!newDate)",
                                                            "    return;",
                                                            "",
                                                            "//PARAM SET",
                                                            "var params = {",
                                                            "    //공통",
                                                            "    hrHrpmCompId : SecurityUtils.getPrincipal().hrHrpmCompId, //회사",
                                                            "    hrHrpmEmpId : SecurityUtils.getPrincipal().hrHrpmEmpId, //사번",
                                                            "    stcd : Constants.stcd.NORMAL, //상태",
                                                            "    searchDate : DateUtils.getDate(new Date()), //오늘날짜",
                                                            "    wrkDt : DateUtils.getDate(newDate),",
                                                            "    noPaging : true,",
                                                            "};",
                                                            "",
                                                            "Ext.Ajax.request({",
                                                            "    headers : {",
                                                            "        serviceId : 'HwmDaySvc.findAllHwmDayWebGrid', // 2019.06.25 13:40 등록완료 (10시방향 그리드만)",
                                                            "        viewId : me.getViewId(),",
                                                            "        scope : me",
                                                            "    },",
                                                            "    jsonData : params,",
                                                            "    success : function(response) {",
                                                            "        var res = Ext.JSON.decode(response.responseText);",
                                                            "        //총 시간외근무시간 표시 (금월/금주)",
                                                            "        if (res.totAdmtOvtHod) {",
                                                            "            refs.totOvtHodMonthHr.setValue(res.totAdmtOvtHod.totOvtHodMonthHr);",
                                                            "            refs.totOvtHodWeekHr.setValue(res.totAdmtOvtHod.totOvtHodWeekHr);",
                                                            "        }",
                                                            "",
                                                            "        if (res.page.content.length > 0 && res.page.content[0].wrkStrdt) {",
                                                            "            var wrkInfo = {",
                                                            "                wrkEdt : DateUtils.parseDate(res.page.content[0].wrkEdt),",
                                                            "                wrkStrtm : DateUtils.getTimeFormat(res.page.content[0].wrkStrtm, 'H:i:s'),",
                                                            "                wrkEdtm : DateUtils.getTimeFormat(res.page.content[0].wrkEdtm, 'H:i:s'),",
                                                            "            };",
                                                            "            vm.set('wrkInfo', wrkInfo);",
                                                            "        } else {",
                                                            "            Ext.Msg.alert('알림', '해당 날짜에 출/퇴근 기록이 없습니다 <br> 정정 신청 후 진행하시기 바랍니다.');",
                                                            "            datefield.setValue('');",
                                                            "            vm.set('wrkInfo', '');",
                                                            "        }",
                                                            "    }",
                                                            "});"
                                                        ],
