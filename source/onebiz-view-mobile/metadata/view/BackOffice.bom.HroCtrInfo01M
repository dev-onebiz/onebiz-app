                                                "fn": "onButtonTapCheckPasswd",
                                                "implHandler": [
                                                    "var me = this;",
                                                    "var refs = me.getReferences();",
                                                    "var vm = me.getViewModel();",
                                                    "var principal = SecurityUtils.getPrincipal();",
                                                    "",
                                                    "",
                                                    "if(Ext.isEmpty(refs.passwordCtrInfo.getValue())){",
                                                    "    return;",
                                                    "}",
                                                    "",
                                                    "// var loginType = refs.loginType.getValue();",
                                                    "// var loginform = refs.loginform;",
                                                    "// var idErrMsg = refs.idErrMsg;",
                                                    "// var fastErrMsg = refs.fastErrMsg;",
                                                    "var values = null;",
                                                    "var data = {};",
                                                    "var isProcessLogin = vm.get('isProcessLogin');",
                                                    "",
                                                    "// 연타입력으로 인한 이벤트 중복호출 방어코드 추가",
                                                    "if (!isProcessLogin) {",
                                                    "    vm.set('isProcessLogin', true);",
                                                    "}",
                                                    "",
                                                    "data = {",
                                                    "    loginType: 'ID',",
                                                    "    cmgrpCd : Property.CMGRP_CD,",
                                                    "    userId : principal.hrHrpmEmpId,",
                                                    "    password : refs.passwordCtrInfo.getValue(),",
                                                    "};",
                                                    "",
                                                    "// [START] Device 모델명 (iOS, Android, etc)",
                                                    "var userAgent = window.navigator.userAgent,",
                                                    "    startIdx = userAgent.indexOf(\"(\"),",
                                                    "    endIdx = userAgent.indexOf(\")\"),",
                                                    "    mobileModelName = userAgent.substring(startIdx + 1, endIdx),",
                                                    "    modelNameList = null,",
                                                    "    modelName = null;",
                                                    "// Apple",
                                                    "if (mobileModelName.indexOf(\"iPhone\") > -1 || mobileModelName.indexOf(\"iPad\") > -1 || mobileModelName.indexOf(\"Mac OS X\") > -1) {",
                                                    "    //     if (mobileModelName.indexOf(\";\") > -1) {",
                                                    "    //         modelNameList = mobileModelName.split(\"; \");",
                                                    "    //         if (modelNameList.length > 0) {",
                                                    "    //             modelName = modelNameList[0].length > 50 ? modelNameList[0].substring(0, 50) : modelNameList[0];",
                                                    "    //         }",
                                                    "    //     }",
                                                    "    //     else {",
                                                    "    //         modelName = mobileModelName.length > 50 ? mobileModelName.substring(0, 50) : mobileModelName;",
                                                    "    //     }",
                                                    "    modelName = 'iPhone';",
                                                    "}",
                                                    "// Android",
                                                    "else if (mobileModelName.indexOf(\"Android\") > -1) {",
                                                    "    //     if (mobileModelName.indexOf(\";\") > -1) {",
                                                    "    //         modelNameList = mobileModelName.split(\"; \"); // SM-G900P Build/LRX21T : ANDROID Galaxy S5",
                                                    "    //         if (modelNameList.length > 2) {",
                                                    "    //             modelName = modelNameList[2].length > 50 ? modelNameList[2].substring(0, 50) : modelNameList[2]; // SM-G900P Build/LRX21",
                                                    "    //         }",
                                                    "    //     }",
                                                    "    //     else {",
                                                    "    //         modelName = mobileModelName.length > 50 ? mobileModelName.substring(0, 50) : mobileModelName;",
                                                    "    //     }",
                                                    "    modelName = 'Android';",
                                                    "}",
                                                    "else {",
                                                    "    modelName = mobileModelName.length > 50 ? mobileModelName.substring(0, 50) : mobileModelName;",
                                                    "}",
                                                    "// [END] Device 모델명",
                                                    "",
                                                    "// // 푸시",
                                                    "// if (Property.PUSH_TOKEN && modelName) {",
                                                    "//     console.log('token: ' + Property.PUSH_TOKEN + '\\n model: ' + modelName);",
                                                    "//     data.pushCtfKeyVal = Property.PUSH_TOKEN;\t// 푸시토큰",
                                                    "//     data.pushDvcOsNm = modelName;\t\t\t\t// 모바일디바이스",
                                                    "// }",
                                                    "",
                                                    "// 로그인거래",
                                                    "Ext.Viewport.setMasked({",
                                                    "    xtype: 'loadmask',",
                                                    "    message: '',",
                                                    "    indicator: false,",
                                                    "    html : '<img src=\"resources/images/loading-bar.gif\"></img>'",
                                                    "});",
                                                    "Ext.Ajax.request({",
                                                    "    headers: {",
                                                    "        viewId: me.getViewId(),",
                                                    "        serviceId: 'COMAPP0002R01M'",
                                                    "    },",
                                                    "    jsonData : data,",
                                                    "    scope : me,",
                                                    "    success : function(res) {",
                                                    "        Ext.Viewport.setMasked(false);",
                                                    "        var me = this,",
                                                    "            vm = me.getViewModel(),",
                                                    "            refs = me.getReferences();",
                                                    "//             loginType = refs.loginType,",
                                                    "//             loginform = refs.loginform,",
                                                    "//             fastLoginform = refs.fastLoginform,",
                                                    "//             rememberUserId = refs.rememberUserId,",
                                                    "//             values = loginform.getValues(),",
                                                    "            result = Ext.JSON.decode(res.responseText);",
                                                    "",
                                                    "",
                                                    "",
                                                    "        vm.set('isProcessLogin', false);",
                                                    "        if (Property.IS_DEBUG) console.log('로그인결과: ', result);",
                                                    "        // 비밀번호만료된 경우, 비밀번호 변경화면으로 전환",
                                                    "        if (result && result.hasOwnProperty('principal') && result.principal",
                                                    "            && result.principal.hasOwnProperty('pwExpiredYn') && result.principal.pwExpiredYn",
                                                    "            && result.principal.pwExpiredYn ==='Y') {",
                                                    "            me.REDIRECT('ChangePassword', {",
                                                    "                title : '비밀번호변경'",
                                                    "            });",
                                                    "            return;",
                                                    "        }",
                                                    "",
                                                    "        // 파일처리인경우, 쿠키를 저장하는 처리 추가함",
                                                    "        if ('F' === Property.PROFILE) {",
                                                    "            if (result.hasOwnProperty(Property.JWT_TOKEN_NAME)) {",
                                                    "                var jwtToken = result[Property.JWT_TOKEN_NAME];",
                                                    "                WebUtils.setCookie(Property.JWT_TOKEN_NAME, jwtToken);",
                                                    "                localStorage.setItem(Property.JWT_TOKEN_NAME, jwtToken);",
                                                    "            }",
                                                    "        }",
                                                    "",
                                                    "        /************************",
                                                    "        detail",
                                                    "        ************************/",
                                                    "",
                                                    "        // 로그인 성공 시",
                                                    "        // 기준 년/월 초기화",
                                                    "        // 화면 전환",
                                                    "        refs.master.setHidden(true);",
                                                    "        refs.detail.setHidden(false);",
                                                    "        me.onSelect();",
                                                    "",
                                                    "",
                                                    "    },",
                                                    "    failure: function(response, opts) {",
                                                    "        Ext.Viewport.setMasked(false);",
                                                    "        var me = this,",
                                                    "            vm = me.getViewModel(),",
                                                    "            refs = me.getReferences();",
                                                    "",
                                                    "        vm.set('isProcessLogin', false);",
                                                    "        refs.passwordCtrInfo.setValue(null); // 입력된 비밀번호제거",
                                                    "",
                                                    "        refs.passwordCtrInfo.focus(true);",
                                                    "",
                                                    "        refs.initMsg.setHidden(true);",
                                                    "        refs.failMsg.setHidden(false);",
                                                    "",
                                                    "        // 권한오류인 경우, 오류메시지 표시하고 별도의 예외처리하지 않음",
                                                    "        if (response && response.status === 401) {",
                                                    "            var errMsg = '아이디 또는 비밀번호를 다시 확인하세요.<br />등록되지 않은 아이디이거나, 아이디 또는 비밀번호를 잘못 입력하셨습니다.';",
                                                    "",
                                                    "            if (response.hasOwnProperty('responseText')) {",
                                                    "                var responseJson = Ext.JSON.decode(response.responseText);",
                                                    "                if (responseJson.hasOwnProperty('moreInfo')) {",
                                                    "                    var moreInfo = responseJson.moreInfo;",
                                                    "                    for (var key in moreInfo) {",
                                                    "                        var msg = moreInfo[key];",
                                                    "                        if (msg) {",
                                                    "                            errMsg = msg;",
                                                    "                        }",
                                                    "                        break;",
                                                    "                    }",
                                                    "                }",
                                                    "            }",
                                                    "",
                                                    "            return;",
                                                    "        }",
                                                    "",
                                                    "        // failure 를 직접구현하는 경우, 공통 실패응답처리 메소드를 호출한다.",
                                                    "        me.HANDLE_RESPONSE_FAILURE(response, opts);",
                                                    "    }",
                                                    "});"
                                                ],
