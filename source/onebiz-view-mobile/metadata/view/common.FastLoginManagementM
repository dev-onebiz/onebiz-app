                                            "    form = refs.form,",
                                            "    values = form.getValues(),",
                                            "    currPassword = values.currPassword,",
                                            "    fastPassword = values.fastPassword,",
                                            "    fastPasswordCheck = values.fastPasswordCheck;",
                                            "",
                                            "SecurityUtils.encrypt(me, {",
                                            "    currPassword\t  : currPassword,",
                                            "    fastPassword\t  : fastPassword,",
                                            "    fastPasswordCheck : fastPasswordCheck",
                                            "}).then(function(result){",
                                            "",
                                            "    Ext.Ajax.request({",
                                            "        headers: {",
                                            "            viewId: 'FastLoginManagementM',",
                                            "            serviceId: 'ComEnvSvc.saveFastLoginM'",
                                            "        },",
                                            "        jsonData: result,",
                                            "        scope : me,",
                                            "        success: function(response) {",
                                            "            var me = this,",
                                            "                responseJson = Ext.JSON.decode(response.responseText);",
                                            "",
                                            "            // 로그아웃",
                                            "            Ext.Msg.confirm('안내', '<p>빠른 로그인 비밀번호가 변경되었습니다.<br/>재로그인하시겠습니까?</p>', function(buttonId) {",
                                            "                var me = this;",
                                            "",
                                            "                if ('yes' === buttonId) {",
                                            "                    // 토큰삭제",
                                            "                    sessionStorage.removeItem(Property.JWT_TOKEN_NAME);",
                                            "                    WebUtils.setCookie(Property.JWT_TOKEN_NAME, null, -1);",
                                            "",
                                            "                    // 서버로그아웃",
                                            "                    Ext.Ajax.request({",
                                            "                        headers: {",
                                            "                            viewId: 'FastLoginManagementM',",
                                            "                            serviceId: 'COMAPP0002R02M'",
                                            "                        },",
                                            "                        scope : me,",
                                            "                        success : function(res) {",
                                            "                            if (Property.IS_DEBUG) console.log('로그아웃 성공');",
                                            "                        },",
                                            "                        failure: function(response, opts) {",
                                            "                            if (Property.IS_DEBUG) console.log('로그아웃 실패');",
                                            "                        }",
                                            "                    });",
                                            "",
                                            "                    // 메인화면제거 및 로그인화면 표시",
                                            "                    // 메인화면 표시",
                                            "                    Ext.create(Property.ROUTE_LOGIN, {fullscreen: true});",
                                            "                }",
                                            "            }, me);",
                                            "",
                                            "        },",
