                                            "                currPassword.setValue(null);",
                                            "                fastPassword.setValue(null);",
                                            "                fastPasswordCheck.setValue(null);",
                                            "",
                                            "                Ext.Msg.alert('빠른로그인 저장오류', Ext.String.format('<p>{0}</p>', responseJson.errMsg));",
