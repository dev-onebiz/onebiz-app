                                "fn": "renderer",
                                "implHandler": [
                                    "var value1 = record.data.aplVctStrdt; // 휴가 시작 일자",
                                    "",
                                    "var aplStcd = record.data.aplStcd; // 신청 상태",
                                    "/*  INB025",
                                    "10\t진행",
                                    "11\t진행(신청)",
                                    "20\t반려",
                                    "21\t반려(담당)",
                                    "22\t반려(부서)",
                                    "30\t회수",
                                    "31\t회수(본인)",
                                    "80\t임시저장",
                                    "90\t완료",
                                    "91\t완료(신청)",
                                    "*/",
                                    "var aplStcdText = CodeUtils.getText('INB025', aplStcd);",
                                    "// var aplStcdRender = '<span>' + aplStcdText + '</span>';",
                                    "var aplDvcdRender = record.data.aplDvcd == 01 ? '<span style=\"color:blue;font-weight:bold;\">신청</span>' :  '<span style=\"color:red;font-weight:bold;\">취소신청</span>';",
                                    "if(aplStcd === '30' || aplStcd === '31'){",
                                    "    //aplStcdRender = '<span style=\"color: grey;\">' + aplStcdText + '</span>'; // 상태별 색 넣기",
                                    "}",
                                    "",
                                    "//value1 = value1.substr(4, 2) + '월 ' + value1.substr(6, 2) + '일 휴가 ' + aplStcdText;",
                                    "value1 = value1.substr(4, 2) + '월 ' + value1.substr(6, 2) + '일 휴가 ';",
                                    "",
                                    "var strdt = DateUtils.parseDate(record.data.aplVctStrdt); // 휴가 시작 일자",
                                    "var edt = DateUtils.parseDate(record.data.aplVctEdt); // 휴가 종료 일자",
                                    "",
                                    "var value2 = strdt + '~' + edt;",
                                    "",
                                    "result = '<div style=\"font-size:15px;font-weight:bold;width:100%;overflow: hidden;white-space:nowrap;text-overflow:ellipsis;display:inline-block;\"><span>'+value1+'</span>'+aplDvcdRender+'</div>';",
                                    "result += '<div>' + value2 + '</div>';",
                                    "",
                                    "cell.setStyle('padding:0px;');",
                                    "return result;"
                                ]
                            },
