                        ],
                        "fn": "onGridSelect",
                        "implHandler": [
                            "var me = this,",
                            "    vm = me.getViewModel(),",
                            "    refs = me.getReferences(),",
                            "    record = selected[0].data;",
                            "",
                            "record.beforePage = 'HwmVctAply01M';",
                            "",
                            "/* window - HwmVctAply71M 화면은 window를 상속받으므로 네비게이션뷰를 사용할 수 없다",
                            "var win = Ext.create('HwmVctAply71M', {",
                            "    command : 94,",
                            "    aprHistId : record.comAprHistId,",
                            "    vctRecord : record",
                            "});",
                            "me.mon(win, 'complete', function(popup) {",
                            "    popup.close(); //팝업창닫기",
                            "    me.onSelect();",
                            "}, me);",
                            "win.show();",
                            "/* window */",
                            "",
                            "",
                            "// 결재이력데이터조회",
                            "Ext.Ajax.request({",
                            "    headers : {",
                            "        serviceId : 'COMAPR0001R04M',",
                            "        viewId : 'HwmVctAply01M'",
                            "    },",
                            "    scope : me,",
                            "    jsonData : {",
                            "        aprHistId : record.comAprHistId // 결재이력아이디",
                            "    },",
                            "    success : function(response) {",
                            "        var responseJson = Ext.JSON.decode(Ext.JSON.decode(response.responseText).result);",
                            "        if (!responseJson) {",
                            "            return;",
                            "        }",
                            "",
                            "        vm.set('responseJson', responseJson);",
                            "",
                            "        var docData = responseJson.docData;",
                            "        if (!docData) {",
                            "            docData = {};",
                            "            if (responseJson.fieldValues)  docData.fieldValues  = responseJson.fieldValues;",
                            "            if (responseJson.afterchange)  docData.afterchange  = responseJson.afterchange;",
                            "            if (responseJson.beforechange) docData.beforechange = responseJson.beforechange;",
                            "        }",
                            "",
                            "        /* container */",
                            "        var naviView = me.getView().up('navigationview');",
                            "        me.PUSH_VIEW(naviView, {",
                            "            menuId : 'HwmVctAply05M',",
                            "            title  : '휴가 신청',",
                            "            parentView : me.getView(),",
                            "            isSubView : true,",
                            "            vctRecord : record,",
                            "            docData : docData,",
                            "            afterchange : docData.afterchange",
                            "        });",
                            "        /* container */",
                            "    }",
                            "});",
                            "",
                            "",
                            "",
