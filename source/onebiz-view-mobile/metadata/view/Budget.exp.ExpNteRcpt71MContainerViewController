                "fn": "onAplyAddForm",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    items = refs.items,",
                    "    item = null,",
                    "    datas = vm.get('items'),",
                    "    command = vm.get('command'),",
                    "    aprHistId = vm.get('aprHistId');",
                    "",
                    "for(var i in datas){",
                    "    item = Ext.create('ExpNteRcpt71MItems', { // alternateClassName : ITEMs // userClassName과 다름",
                    "        data : datas[i]",
                    "    });",
                    "    items.add(item);",
                    "",
                    "}",
                    "",
                    "// 결재문서 초기화 설정",
                    "ApprovalBoxSvc.setup({",
                    "    command   : command,",
                    "    viewModel : vm,",
                    "    aprHistId : aprHistId,",
                    "    edocCd    : 'ExpNteRcpt71',",
                    "    scope     : me",
                    "});",
