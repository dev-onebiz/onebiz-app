                "fn": "Initialize",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    vctRecord = component.initialConfig.vctRecord, // HwmVctAply01M 화면에서 넘긴 데이터",
                    "    title = component.initialConfig.title;",
                    "",
                    "var aprHistId = null,",
                    "    command = null,",
                    "    docData = null,",
                    "    afterchange = null,",
                    "    hrWrkmVctApfId = null,",
                    "    record = null;",
                    "",
                    "// 휴가신청서 목록에서 상세보기",
                    "if(vctRecord && vctRecord.beforePage === 'HwmVctAply01M'){",
                    "    aprHistId = vctRecord.comAprHistId;",
                    "    command = Constants.sanction.COMPLETED_BOX; // 단순 조회이므로 완료함 처럼 보이도록",
                    "    //docData",
                    "    afterchange = vctRecord;",
                    "    hrWrkmVctApfId = afterchange.hrWrkmVctApfId;",
                    "}",
                    "else { // 결재함",
                    "    aprHistId = component.initialConfig.aprHistId;",
                    "    command = component.initialConfig.command;",
                    "    docData = component.initialConfig.docData;",
                    "    afterchange = docData.afterchange;",
                    "    hrWrkmVctApfId = afterchange.hrWrkmVctApfId;",
                    "    record = component.initialConfig.record;",
                    "}",
                    "",
                    "/* 화면에서 필요한 데이터 */",
                    "vm.set('vct', afterchange);",
                    "vm.set('hrWrkmVctApfId', hrWrkmVctApfId);",
                    "/* 화면에서 필요한 데이터 */",
                    "",
                    "",
                    "/* 결재에 필요한 데이터 */",
                    "vm.set('afterchange', afterchange);",
                    "vm.set('aprHistId', aprHistId);",
                    "vm.set('record', record);",
                    "vm.set('command', command);",
                    "/* 결재에 필요한 데이터 */",
                    "",
                    "refs.rgdt.setHtml(record.rgdt);",
                    "refs.headTitle.setHtml(record.docNm);",
                    "",
                    "",
                    "// 결재문서 초기화 설정",
                    "ApprovalBoxSvc.setup({",
                    "    command   : command,",
                    "    viewModel : vm,",
                    "    aprHistId : aprHistId,",
                    "    edocCd    : 'HwmVctAply71',",
                    "    scope     : me",
                    "});",
                    "",
                    "this.onSelect();",
                    "",
                    ""
                ],
