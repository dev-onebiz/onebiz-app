            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "신청취소 저장함수"
                ],
                "fn": "onApfCancelSave",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    grid = refs.grid,",
                    "    selectedData = grid.getSelection().data;",
                    "",
                    "//VALIDATION AREA",
                    "if (selectedData.aplDvcd == Constants.wrkAplDvcd.CANCEL) {",
                    "    Ext.Msg.alert(\"안내\", \"정상 신청서만 신청취소이 가능합니다.\");",
                    "    return false;",
                    "}",
                    "if (selectedData.hrWrkmHodReptId && selectedData.reptAplDvcd != Constants.wrkAplDvcd.CANCEL) {",
                    "    Ext.Msg.alert(\"안내\", \"해당건에 대해서 휴일근무 보고서가 '진행/완료' 된 신청서가 있습니다. <br> 휴일근무 보고서 회수/취소 후 다시 신청바랍니다.\");",
                    "    return false;",
                    "}",
                    "if (selectedData.aplStcd != Constants.aplStcd.COMPLETED_APPLY) {",
                    "    Ext.Msg.alert(\"안내\", \"신청상태가 \\'완료(신청)\\'인 신청서만 신청취소이 가능합니다.<br><br>신청상태가 \\'진행(신청)\\'인 경우에는 결재함에서 회수 하시기 바랍니다.\");",
                    "    return false;",
                    "}",
                    "if (selectedData.existBgBtrYn == Constants.exYesNo.YES.LETTER ) {",
                    "    Ext.Msg.alert(\"안내\", \"해당 건에 대해서 예산_여비정산서신청이 '진행/완료'된 신청서가 있습니다.<br> 신청 회수/취소 후 다시 신청바랍니다. \");",
                    "    return false;",
                    "}",
                    "//END VALIDATION AREA",
                    "",
                    "selectedData.stcd = Constants.stcd.OUTSTANDING; //상태 - 결재로 변경",
                    "selectedData.aplStcd = Constants.aplStcd.COMPLETED_APPLY; //신청상태 - 완료",
                    "selectedData.aplDvcd = Constants.wrkAplDvcd.CANCEL; //신청구분 - 취소",
                    "",
                    "Ext.Ajax.request({",
                    "    headers : {",
                    "        serviceId : 'HwmHodSvc.findAllHwmHodAply',",
                    "        viewId : me.getViewId(),",
                    "        scope : me",
                    "    },",
                    "    jsonData : selectedData,",
                    "    success : function(res) {",
                    "        if (res.errMsg) {",
                    "            Ext.Msg.alert(\"안내\", res.errMsg);",
                    "            return;",
                    "        }",
                    "",
                    "        Ext.Msg.confirm('알림', '<b>※유의사항<br> 신청취소시 결재 없이 바로 취소 됩니다.</b> <br><br> 정말로 취소하시겠습니까? <br>', function(btn) {",
                    "            if (btn == 'yes') {",
                    "                var result = {",
                    "                    newRecords : [],",
                    "                    modifiedRecords : [],",
                    "                    removedRecords : []",
                    "                };",
                    "                result.newRecords.push(selectedData);",
                    "",
                    "                //SERVICE 호출",
                    "                Ext.Ajax.request({",
                    "                    headers : {",
                    "                        serviceId : 'HwmHodSvc.saveHwmHodAply_withoutRept',",
                    "                        viewId : me.getViewId()",
                    "                    },",
                    "                    jsonData : result,",
                    "                    success : function(res) {",
                    "                        Ext.Msg.alert('알림', Messages.getMessage('I0000'));",
                    "                        me.onBtnSearchTap();",
                    "                    }",
                    "                });",
                    "            } else {",
                    "                return false;",
                    "            }",
                    "        });",
                    "    }",
                    "});",
                    ""
                ]
            },
            "configAlternates": {
                "designer|commentHeader": "comment",
                "fn": "string",
                "implHandler": "code"
            },
            "name": "onApfCancelSave",
            "designerId": "f82206a8-ec3e-4dfe-ae63-76466b142039"
        }
