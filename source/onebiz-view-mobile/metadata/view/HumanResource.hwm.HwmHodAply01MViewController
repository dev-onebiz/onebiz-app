                "fn": "onSelect",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    grid = refs.grid,",
                    "    store = vm.storeInfo.Store;",
                    "",
                    "// VALIDATION AERA",
                    "var dateCompont = ['startDate',",
                    "                   'endDate'",
                    "                  ];",
                    "",
                    "if(refs[dateCompont[0]].getValue() > refs[dateCompont[1]].getValue()){",
                    "    Ext.Msg.alert('확인','시작일이 종료일보다 클 수 없습니다.');",
                    "    return;",
                    "}",
                    "",
                    "",
                    "//PARAM SET",
                    "var params = {",
                    "    //공통",
                    "    hrHrpmCompId : SecurityUtils.getPrincipal().hrHrpmCompId, //회사",
                    "    hrHrpmEmpId : SecurityUtils.getPrincipal().hrHrpmEmpId,",
                    "    stcd : Constants.stcd.NORMAL,",
                    "    aplDvcd : Constants.wrkAplDvcd.APPLY, //신청서의 신청구분 (신청만)",
                    "    //     aplStcd : Constants.aplStcd.COMPLETED_APPLY, //신청서의 신청상태 (완료만)",
                    "    aplStcdList : [Constants.aplStcd.PROGRESS_APPLY, Constants.aplStcd.COMPLETED_APPLY], //신청서의 신청상태 (진행&완료)",
                    "",
                    "    //검색조건",
                    "//     aplStcd : refs.aplStcd.getValue(),",
                    "    startDate : Ext.Date.format(refs[dateCompont[0]].getValue(), 'Ymd'),",
                    "    endDate : Ext.Date.format(refs[dateCompont[1]].getValue(), 'Ymd'),",
                    "};",
                    "",
                    "store.getProxy().extraParams = params;",
                    "store.removeAll();",
                    "store.loadPage(1);",
                    "",
                    "",
                    "// 메뉴 추가",
                    "me.menu = Ext.create({",
                    "    xtype: 'actionsheet',",
                    "    scope : me.getView(),",
                    "    displayed: false,",
                    "    cover: true,",
                    "    side: 'bottom',",
                    "    listeners: {",
                    "        show : me.onActionSheetShow",
                    "    },",
                    "    items: [",
                    "        {",
                    "            xtype: 'button',",
                    "            disabled: true,",
                    "            itemId: 'btnReApply',",
                    "            ui: 'action',",
                    "            margin: 5,",
                    "            text: '재기안',",
                    "            scope : me,",
                    "            handler : 'onApfData'",
                    "        },",
                    "        {",
                    "            xtype: 'button',",
                    "            disabled: true,",
                    "            itemId: 'btnCancel',",
                    "            ui: 'action',",
                    "            margin: 5,",
                    "            text: '신청취소',",
                    "            scope : me,",
                    "            handler : 'onApfData'",
                    "        },",
                    "        {",
                    "            xtype: 'button',",
                    "            disabled: true,",
                    "            itemId: 'actAprHistData',",
                    "            ui: 'action',",
                    "            margin: '5 5 10 5',",
                    "            text: '신청서 보기',",
                    "            scope : me,",
                    "            handler : 'onClickActColumn'",
                    "        },",
                    "    ]",
                    "});"
                ]
