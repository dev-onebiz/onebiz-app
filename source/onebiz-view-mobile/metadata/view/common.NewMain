                            "codeClass": null,
                            "userConfig": {
                                "designer|displayName": "btnLogout",
                                "docked": "right",
                                "margin": 15,
                                "style": "background-color: #999999; color: #fff;",
                                "text": "LOGOUT"
                            },
                            "configAlternates": {
                                "designer|displayName": "string",
                                "layout|flex": "number",
                                "text": "string",
                                "style": "string",
                                "width": "auto",
