                            "name": "MyButton19",
                            "designerId": "0f27353e-80db-4b6c-bd50-7e49df8fe1dc",
                            "cn": [
                                {
                                    "type": "viewcontrollereventbinding",
                                    "reference": {
                                        "name": "listeners",
                                        "type": "array"
                                    },
                                    "codeClass": null,
                                    "userConfig": {
                                        "fn": "onBtnLogoutTap",
                                        "implHandler": [
                                            "var me = this;",
                                            "",
                                            "Ext.Msg.confirm(Property.SYSTEM_NAME, '로그아웃하시겠습니까?', function(choice) {",
                                            "    var me = this;",
                                            "    if (choice === 'yes') {",
                                            "        Ext.Ajax.request({",
                                            "            headers: {",
                                            "                viewId: 'NewMain',",
                                            "                serviceId: 'COMAPP0002R02M'",
                                            "            },",
                                            "            scope : me,",
                                            "            success : function(res) {",
                                            "                if (Property.IS_DEBUG) console.log('로그아웃 성공');",
                                            "            },",
                                            "            failure: function(response, opts) {",
                                            "                if (Property.IS_DEBUG) console.log('로그아웃 실패');",
                                            "            }",
                                            "        });",
                                            "",
                                            "        // 토큰정보 삭제",
                                            "        localStorage.removeItem(Property.JWT_TOKEN_NAME);",
                                            "        WebUtils.setCookie(Property.JWT_TOKEN_NAME, null, -1);",
                                            "",
                                            "        // 로그인화면으로 이동",
                                            "        me.REDIRECT('Login');",
                                            "        ",
                                            "        var homes = Ext.ComponentQuery.query('#' + Property.ROUTE_HOME);",
                                            "        if (homes.length !== 0) {",
                                            "            homes[0].destroy();",
                                            "        }",
                                            "    }",
                                            "}, me);"
                                        ],
                                        "name": "tap",
                                        "scope": "me"
                                    },
                                    "configAlternates": {
                                        "fn": "string",
                                        "implHandler": "code",
                                        "name": "string",
                                        "scope": "string"
                                    },
                                    "name": "onBtnLogoutTap",
                                    "designerId": "650183de-2b32-4535-abd5-73c3fa98b897"
                                }
                            ]
                        }
                    ]
                },
