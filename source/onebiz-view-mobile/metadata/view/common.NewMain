                                                        "fn": "onExpNteAply01MTap",
                                                        "implHandler": [
                                                            "var me = this,",
                                                            "    refs = me.getReferences(),",
                                                            "    naviView = refs.NaviView;",
                                                            "",
                                                            "// 20.07.01 예산오픈으로 인한 분기처리",
                                                            "var date = Ext.Date.format(new Date(), 'Ymd'),",
                                                            "    stdDt = 20200701,",
                                                            "    param = {} ;",
                                                            "",
                                                            "if (Number(date) >= stdDt) {",
                                                            "    param.menuId = 'BgxNfmAply01M';",
                                                            "    param.title = '결의서 작성';",
                                                            "} else {",
                                                            "    param.menuId = 'ExpNteAply01M';",
                                                            "    param.title = '법인카드';",
                                                            "}",
                                                            "",
                                                            "me.PUSH_VIEW(naviView, param);",
                                                            ""
                                                        ],
                                                        "name": "tap",
                                                        "scope": "me"
                                                    },
