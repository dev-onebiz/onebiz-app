        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "신청서 작성에 필요한 CodeList 한번에 불러오기"
                ],
                "fn": "fnCodeSetting",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    D = new Ext.Deferred();",
                    "",
                    "// year공통 컴포넌트가 Date형식으로 되어있어 ,간혹 Date형식으로 들어올때가 있어 YYYY String으로 변환",
                    "// var bsnsYy =  vm.get('applyInfo.bsnsYy');",
                    "var bsnsYy =  refs.bsnsYy.getValue();",
                    "if(Ext.isDate(bsnsYy)){",
                    "//     var bsnsYy =  vm.get('applyInfo.bsnsYy').getFullYear().toString();",
                    "       var bsnsYy =  refs.bsnsYy.getValue().getFullYear().toString();",
                    "}",
                    "vm.set('searchBsnsYy',bsnsYy);",
                    "",
                    "Ext.Ajax.request({",
                    "    headers : {",
                    "        serviceId : 'BgxNfmSvc.findAllExpItemCodeList',",
                    "        viewId : me.getViewId(),",
                    "    },",
                    "    jsonData : {",
                    "        noPaging : 'dummpyForNoPaging',",
                    "        codeDvcdLists : [\"XPNIT\",\"BSNS\",\"XPNS\"],",
                    "        bgDvcd1 : Constants.bgDvcd1.EXPN,",
                    "        bsnsYy : bsnsYy,",
                    "    },",
                    "    success : function(response, component) {",
                    "        var res = Ext.JSON.decode(response.responseText);",
                    "        vm.set('codeList', res.codeList);",
                    "        D.resolve(res.codeList); // 성공",
                    "    },",
                    "    failure : function(res, vm) {",
                    "        me.getView().unmask();",
                    "        D.reject(res.result); // 실패",
                    "    }",
                    "});",
                    "",
                    "return D.promise;"
                ]
            },
            "configAlternates": {
                "designer|commentHeader": "comment",
                "fn": "string",
                "implHandler": "code"
            },
            "name": "fnCodeSetting",
            "designerId": "29ab3870-d356-4e18-9c24-d323355e4eae"
        },
        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "유효성 검증"
                ],
                "fn": "fnApplyValid",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    itemCnt = refs.item_container.items.items[0],",
                    "    inputRefs = itemCnt.controller.getReferences(),",
                    "    inputForm = inputRefs.inputForm,",
                    "    cmmCnt = inputRefs.common_input_container,",
                    "    cmmCtrl = cmmCnt.controller,",
                    "    inputfields = inputForm.getFields(),",
                    "    errMsg = '',",
                    "    cmmValidData = cmmCtrl.fnApplyValid();",
                    "",
                    "if(!inputForm.validate() || (cmmValidData && !cmmValidData.valid) || !vm.get('applyLine')) {",
                    "    if (!inputForm.validate()) {",
                    "        // expItemData",
                    "        for(var i = 0; i < inputfields.null.length; i++) {",
                    "            var field = inputfields.null[i];",
                    "            if (!field.isValid()) {",
                    "                var tmp = field.getErrorMessage();",
                    "                if (tmp.indexOf('This field is required') != -1) {",
                    "                    errMsg += '- ' + field.parent.down('displayfield').getHtml() + ' 을(를) 입력해주세요.<br>';",
                    "                } else {",
                    "                    errMsg += '- ' + field.parent.items.items[0].getHtml() + ' : ' + tmp + '<br>';",
                    "                }",
                    "            }",
                    "        }",
                    "    }",
                    "",
                    "    if (!cmmValidData.valid) {",
                    "        // expItemInputData",
                    "        errMsg += cmmValidData.errMsg;",
                    "    }",
                    "",
                    "    if (!vm.get('applyLine')) {",
                    "        errMsg += '- 결재선을 선택해주세요.<br>';",
                    "    }",
                    "",
                    "    Ext.Msg.show({",
                    "        buttons :  {",
                    "            yes : {itemId : Ext.MessageBox.YES, text : '확인'}",
                    "        },",
                    "        title : '알림',",
                    "        message : errMsg,",
                    "        alwaysOnTop : true",
                    "    });",
                    "    return false;",
                    "}",
                    "return true;"
                ]
            },
            "configAlternates": {
                "designer|commentHeader": "comment",
                "fn": "string",
                "implHandler": "code"
            },
            "name": "fnApplyValid",
            "designerId": "1bba7698-7cae-4e32-86aa-744079a15603"
        },
        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "docData 생성"
                ],
                "fn": "makAprHistData",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    itemVm = refs.item_container.items.items[0].controller.getViewModel();",
                    "",
                    "var applyInfo = itemVm.get('applyInfo'),",
                    "    expItemData = itemVm.get('expItemData');",
                    "applyInfo.aplDt = Ext.Date.format(new Date(), 'Ymd');",
                    "applyInfo.bsnsYy = refs.bsnsYy.getValue().getFullYear().toString();  /* 년도 컴포넌트가 Date()형식으로 되어있어, String으로 변환 */",
                    "",
                    "var expItemDsbInfo = [];",
                    "if (applyInfo.aplKndcd == Constants.aplKndcd.CSH_RCT || applyInfo.aplKndcd == Constants.aplKndcd.ETC_RCT) {",
                    "    // 현금영수증, 기타영수증 지급정보 추가",
                    "    var dgDsbInfo = applyInfo.dgDsbInfo;",
                    "    dgDsbInfo.trnfAmt = expItemData.trnsAmt;\t\t// 지급금액",
                    "    expItemDsbInfo.push(dgDsbInfo);",
                    "}",
                    "expItemData.expItemDsbInfo = expItemDsbInfo;",
                    "",
                    "// list 로 넘겨줌 (웹-다건)",
                    "var expItemInfo = [];",
                    "expItemInfo.push(expItemData);",
                    "applyInfo.expItemInfo = expItemInfo;",
                    "",
                    "/* 결재 데이터 구조 */",
                    "var aprHistData = {",
                    "    docData : {",
                    "        beforechange : {}, /* 신청 전 데이터를 저장 : 현재 사용되고 있지 않지만 공통을 위해 추가함.*/",
                    "        afterchange : {",
                    "            applyInfo : applyInfo, /* 신청 데이터 저장 */",
                    "        },",
                    "    }",
                    "};",
                    "",
                    "return aprHistData;"
                ]
            },
            "configAlternates": {
                "fn": "string",
                "implHandler": "code",
                "designer|commentHeader": "comment"
            },
            "name": "makAprHistData",
            "designerId": "b263fc31-2c8c-4365-a2c5-19a8e2db7bf1"
        }
    ]
