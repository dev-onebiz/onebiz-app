        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "법인카드, 현금영수증"
                ],
                "designer|params": [
                    "aplKndcd"
                ],
                "fn": "fnCallScrapingPopup",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    itemCnt = refs.item_container;",
                    "",
                    "vm.set('applyInfo.aplKndcd', aplKndcd);",
                    "",
                    "var win = Ext.create('BgxComScrp51M',  { data : {",
                    "    aplKndcd : aplKndcd,",
                    "    aplEmpId : SecurityUtils.getPrincipal().hrHrpmEmpId,",
                    "    /* 처리여부 : 부  , 마감일자 체크 : N 로 default 세팅 */",
                    "    /* 200603 마감일자는 화면단에서 처리 */",
                    "    dlngYn : Constants.YesNoType.N,",
                    "    fndcYn : Constants.fndcYn.N,",
                    "    fndcDt : vm.get('applyInfo.fndcDt'), //마감일자",
                    "    //[2020-09-11 추가] bsnsYy기준으로 기준년도의 1월1일부터 12월 31까지만 검색하도록 파라미터설정",
                    "    strdt : DateUtils.getFirstDateOfYear(refs.bsnsYy.getValue().getFullYear().toString()),",
                    "    edt : DateUtils.getLastDateOfYear(refs.bsnsYy.getValue().getFullYear().toString())",
                    "}});",
                    "",
                    "me.mon(win, 'onConfirm', function(data) {",
                    "    var childId = (data.nfcmEvidKndcd == Constants.nfcmEvidKndcd.CARD) ? 'BgxItmCpnt01M' : (data.nfcmEvidKndcd == Constants.nfcmEvidKndcd.CSH_RCT) ? 'BgxItmCpnt02M' : '';",
                    "    if (!childId) {",
                    "        return;",
                    "    }",
                    "    ",
                    "    // CodeList",
                    "    if(!vm.get('codeList')) {",
                    "        me.fnCodeSetting().then(function() {",
                    "            itemCnt.add(Ext.create(childId, {",
                    "                codeList : vm.get('codeList'),",
                    "                applyInfo : vm.get('applyInfo'),",
                    "                readOnlyFlag : vm.get('readOnlyFlag'),",
                    "                expItemData : data",
                    "            }));",
                    "        });",
                    "    } else {",
                    "        itemCnt.add(Ext.create(childId, {",
                    "            codeList : vm.get('codeList'),",
                    "            applyInfo : vm.get('applyInfo'),",
                    "            readOnlyFlag : vm.get('readOnlyFlag'),",
                    "            expItemData : data",
                    "        }));",
                    "    }",
                    "});",
                    "",
                    "me.mon(win, 'onClose', function() {",
                    "   vm.set('applyInfo.aplKndcd', '');",
                    "   refs.aplKndcd.setValue(0);",
                    "});",
                    "",
                    "win.show();"
                ]
            },
