                            },
                            "codeClass": null,
                            "userConfig": {
                                "fn": "onFilefieldChange",
                                "implHandler": [
                                    "    var me = this,",
                                    "        vm = me.getViewModel(),",
                                    "        refs = me.getReferences(),",
                                    "        file = field.getFiles()[0];",
                                    "",
                                    "    if (!file) {",
                                    "        Ext.Msg.show({",
                                    "                        title : '알림',",
                                    "                        message : '파일을 선택해주세요.',",
                                    "                        buttons : {",
                                    "                            yes : {itemId : Ext.MessageBox.YES, text : '확인'}",
                                    "                        },",
                                    "                        alwaysOnTop : true",
                                    "        });",
                                    "        return;",
                                    "    }",
                                    "",
                                    "    if (file.size > 5 * 1024 * 1024) {",
                                    "        Ext.Msg.show({",
                                    "                        title : '알림',",
                                    "                        message : '파일 크기는 5MB 이하로 업로드 가능합니다.',",
                                    "                        buttons : {",
                                    "                            yes : {itemId : Ext.MessageBox.YES, text : '확인'}",
                                    "                        },",
                                    "                        alwaysOnTop : true",
                                    "        });",
                                    "        return;",
                                    "    }",
                                    "",
                                    "    var reader = new FileReader();",
                                    "    reader.onload = function(e) {",
                                    "        var base64File = e.target.result.split(',')[1]; // \"data:...\" 제거",
                                    "",
                                    "        Ext.Ajax.request({",
                                    "            method: 'POST',",
                                    "            jsonData: {",
                                    "                fileName: file.name,",
                                    "                fileData: base64File,",
                                    "                fileId: null,",
                                    "                encrypt: null,",
                                    "                maxFileSize: null",
                                    "            },",
                                    "            headers: {",
                                    "                serviceId: 'COMFIL0010C01.singleFileUploadToTempDir',",
                                    "                viewId: me.getViewId()",
                                    "            },",
                                    "            success : function(response, scope) {",
                                    "                    var res = Ext.JSON.decode(response.responseText);",
                                    "                    if (res && res.result && res.result.details) {",
                                    "                        var result = res.result,",
                                    "                            details = result.details;",
                                    "                        vm.set('dtlFileId', details.id);",
                                    "                        vm.set('fileExt', details.fileExt);",
                                    "                        vm.set('orgnFileNm', details.orgnFileNm);",
                                    "                        vm.set('fileNm', details.orgnFileNm + '.' + details.fileExt);",
                                    "                        vm.set('fileSize', details.fileSize);",
                                    "                        vm.set('fileId', result.id);",
                                    "",
                                    "                        me.onBtnSave();",
                                    "                    }",
                                    "                    else if(!Ext.isEmpty(res.errMsg)){",
                                    "                        refs.infoField.setHtml(res.errMsg);",
                                    "                    }",
                                    "                },",
                                    "                failure : function(response){",
                                    "                    var res = Ext.JSON.decode(response.responseText);",
                                    "",
                                    "                    console.log(res);",
                                    "",
                                    "                    Ext.Msg.show({",
                                    "                        title : res.errTitle,",
                                    "                        message : res.errMsg,",
                                    "                        buttons : {",
                                    "                            yes : {itemId : Ext.MessageBox.YES, text : '확인'}",
                                    "                        },",
                                    "                        alwaysOnTop : true",
                                    "                    });",
                                    "",
                                    "                }",
                                    "        });",
                                    "    };",
                                    "",
                                    "    reader.readAsDataURL(file);"
                                ],
