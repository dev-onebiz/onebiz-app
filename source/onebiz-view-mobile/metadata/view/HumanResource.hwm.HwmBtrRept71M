                                                                    "var data = {aprHistId :  aprHistId};",
                                                                    "",
                                                                    "// Service 호출",
                                                                    "Ext.Ajax.request({",
                                                                    "    headers : {",
                                                                    "        serviceId : 'COMAPR0001R04M',",
                                                                    "        viewId : 'HwmBtrAply71M'",
                                                                    "    },",
                                                                    "    jsonData : data,",
                                                                    "    scope : me,",
                                                                    "    success : function(response, opts) {",
                                                                    "        var me = this,",
                                                                    "            refs = me.getReferences(),",
                                                                    "            vm = me.getViewModel(),",
                                                                    "            command = Constants.sanction.COMPLETED_BOX, // 아무 동작도 하지 않아야 하므로 완료.",
                                                                    "            result = Ext.JSON.decode(Ext.JSON.decode(response.responseText).result), // 서버응답결과 JSON 변환",
                                                                    "            aprHistId = result.aprHistId,",
                                                                    "            docData = result.docData,",
                                                                    "            fieldValues = docData.fieldValues,",
                                                                    "            record = {",
                                                                    "                rgdt : fieldValues.rgdt.split(' ')[0], \t// 문서 제목",
                                                                    "                docNm : fieldValues.docNm,\t\t\t\t// 출장품의서 데이터",
                                                                    "                viewOption : 'search'\t\t\t\t\t// 출장품의서 닫기버튼만 남도록하는 플래그",
                                                                    "            };",
                                                                    "",
                                                                    "       var win = Ext.create(aprViewId, {",
                                                                    "            command : command,",
                                                                    "            aprHistId : aprHistId,",
                                                                    "            docData : docData,",
                                                                    "            record : record",
                                                                    "        });",
                                                                    "",
                                                                    "        me.mon(win, 'complete', function(popup) {",
                                                                    "            popup.close(); //팝업창닫기",
                                                                    "        }, me);",
                                                                    "",
                                                                    "",
                                                                    "        win.show();",
                                                                    "    },",
                                                                    "    failure : function(response, opts){",
                                                                    "        // Service 실패 했을 경우 기능",
