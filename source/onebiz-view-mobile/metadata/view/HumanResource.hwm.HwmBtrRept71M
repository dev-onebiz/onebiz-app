                                                                "fn": "onBtnAply71Tap",
                                                                "implHandler": [
                                                                    "var me = this,",
                                                                    "    refs = me.getReferences(),",
                                                                    "    vm = me.getViewModel(),",
                                                                    "    cntView = me.getView(),",
                                                                    "    docData = vm.get('docData'),",
                                                                    "    aprHistId = docData.afterchange.comAprHistApfId, // 출장품의서 결재 이력 id",
                                                                    "    record = {},\t\t\t\t\t\t// 출장품의서 record 초기화",
                                                                    "    command = '',\t\t\t\t\t\t// 출장품의서 command 초기화",
