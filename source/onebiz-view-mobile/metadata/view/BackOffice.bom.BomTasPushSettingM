                        "fn": "onBtnSaveTap",
                        "implHandler": [
                            "var me = this,",
                            "    vm = me.getViewModel(),",
                            "    refs = me.getReferences(),",
                            "    rcvDenyStrtm = refs.rcvDenyStrtm.getValue(),",
                            "    rcvDenyEdtm = refs.rcvDenyEdtm.getValue(),",
                            "    param = {",
                            "        rcvDenyStrtm : Ext.Date.format(rcvDenyStrtm, 'His'),",
                            "        rcvDenyEdtm : Ext.Date.format(rcvDenyEdtm, 'His'),",
                            "    };",
                            "",
                            "for(var i in refs.items.items.items) {",
                            "    var ctrl = refs.items.items.items[i].controller;",
                            "    param.msgDvcd = ctrl.getMsgDvcd();",
                            "    param.recvYn = ctrl.getRecvYn();",
                            "",
                            "    Ext.Ajax.request({",
                            "        headers: {",
                            "            viewId : me.getViewId(),",
                            "            serviceId : 'BomTasSvc.saveOnePushSetting'",
                            "        },",
                            "        jsonData : param,",
                            "        scope : me,",
                            "        async : false,",
                            "        success : function(response) {",
                            "            var res = Ext.JSON.decode(response.responseText);",
                            "        }",
                            "    });",
                            "}",
                            "",
                            "var home = this.getView().up(Property.ROUTE_HOME),",
                            "    naviView = home.lookup('NaviView'),",
                            "    backButton = naviView.getNavigationBar().getBackButton();",
                            "",
                            "backButton.onTap();\t// 뒤로가기"
                        ],
                        "name": "tap",
                        "scope": "me"
                    },
