        {
            "type": "viewcontrollereventbinding",
            "reference": {
                "name": "listeners",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "fn": "onContainerInitialize",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    code = 'TAS004',",
                    "    codeStore = Ext.StoreMgr.get('CodeStore'),",
                    "    items = codeStore.getData().items,",
                    "    pushSetting = [];",
                    "",
                    "for (var i = 0, l = items.length; i < l; i++) {",
                    "    if (code === items[i].data.code) {",
                    "        var children = items[i].data.children;",
                    "        for (var j = 0, l2 = children.length; j < l2; j++) {",
                    "            var text = children[j].text,",
                    "                value = children[j].value;",
                    "",
                    "            // 메시지구분 코드 && 명",
                    "            if (text && value) {",
                    "                    me.getRecvYn(value, text).then(function(result) {",
                    "                        if (result && result.msgDvcd && result.msgDvnm && result.recvYn) {",
                    "                            var msgDvcd = result.msgDvcd,",
                    "                                msgDvnm = result.msgDvnm,",
                    "                                recvYn = result.recvYn,",
                    "                                recvYnVal = (recvYn == 'Y') ? 1 : 0,\t\t// 수신여부",
                    "                                rcvDenyStrtm = (result.rcvDenyStrtm) ? result.rcvDenyStrtm : \"000000\", \t// 수신거부 시작시간",
                    "                                rcvDenyEdtm = (result.rcvDenyEdtm) ? result.rcvDenyEdtm : \"000000\",\t\t// 수신거부 종료시간",
                    "                                now = new Date();",
                    "",
                    "                            refs.rcvDenyStrtm.setValue(new Date(now.getYear(), now.getMonth(), now.getDate(), rcvDenyStrtm.substr(0,2), rcvDenyStrtm.substr(2,2), rcvDenyStrtm.substr(4,2), 0));",
                    "                            refs.rcvDenyEdtm.setValue(new Date(now.getYear(), now.getMonth(), now.getDate(), rcvDenyEdtm.substr(0,2), rcvDenyEdtm.substr(2,2), rcvDenyEdtm.substr(4,2), 0));",
                    "",
                    "                            pushSetting.push({",
                    "                                msgDvnm : msgDvnm,",
                    "                                msgDvcd : msgDvcd,",
                    "                                recvYn : recvYn",
                    "                            });",
                    "",
                    "                            // 아이템 추가",
                    "                            refs.items.add(Ext.create('BomTasPushSettingItemsM', {",
                    "                                msgDvnm : msgDvnm,",
                    "                                msgDvcd : msgDvcd,",
                    "                                recvYnVal : recvYnVal",
                    "                            }));",
                    "                        }",
                    "                });",
                    "            }",
                    "        }",
                    "    }",
                    "}",
                    "",
                    "vm.set('pushSetting', pushSetting);"
                ],
                "name": "initialize",
                "scope": "me"
            },
