            "codeClass": null,
            "userConfig": {
                "fn": "onScrollEvent",
                "implHandler": [
                    "        var me = this;",
                    "        var vm = me.getViewModel();",
                    "        var refs = me.getReferences();",
                    "            var termCtn = refs.termCtn.el.dom.firstElementChild;",
                    "",
                    "        if(termCtn.scrollHeight - termCtn.clientHeight == termCtn.scrollTop){",
                    "            if(vm.get('total')!=refs.termCtn.items.length-4)",
                    "                me.onSelect();",
                    "        }",
                    "        if(termCtn.scrollTop>0){",
                    "            refs.topBtn.setHidden(false);",
                    "        }",
                    "        else if(termCtn.scrollTop==0){",
                    "            refs.topBtn.setHidden(true);",
                    "        }",
                    "        if(termCtn.scrollTop > vm.get('last')) {",
                    "            refs.searchCtn.setHeight('0');",
                    "        }",
                    "        else if (termCtn.scrollTop< vm.get('last')){",
                    "            refs.searchCtn.setHeight('50');",
                    "        }",
                    "",
                    "",
                    "        vm.set('last',termCtn.scrollTop || 0);",
                    ""
                ]
            },
            "configAlternates": {
                "fn": "string",
                "implHandler": "code"
            },
            "name": "onScrollEvent",
