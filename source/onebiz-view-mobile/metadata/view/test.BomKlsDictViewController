    "cn": [
        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "fn": "onSelect",
                "implHandler": [
                    "",
                    "var me = this;",
                    "var vm = me.getViewModel();",
                    "var refs = me.getReferences();",
                    "var values = {",
                    "    length : refs.termCtn.items.length-4,",
                    "    searchText : refs.searchForm.getValue(),",
                    "    termDvcd: vm.initialConfig.view.config.termDvcd, // IT용어 : '01' , 금융용어 : '02'",
                    "};",
                    "",
                    "//if(values.length==vm.get('total')) return;",
                    "",
                    "Ext.Ajax.request({",
                    "    headers : {",
                    "        serviceId : 'BomKlsSvc.findAllKlsTerm',",
                    "    },",
                    "    jsonData : values,",
                    "    success : function(response) {",
                    "        var content = Ext.JSON.decode(response.responseText).content;",
                    "        var total = Ext.JSON.decode(response.responseText).total;",
                    "        var kTerm = '', eTerm = '';",
                    "        var html = '';",
                    "",
                    "        refs.searchTotal.setHtml('<div style=\"font:normal normal bold 14px/27px SF Compact Display; color:#666666;\">검색결과 <span style=\"color:#CB2B11;\">' + total.toLocaleString('ko-KR') + '</span>건</div>');",
                    "        vm.set('total',total);",
                    "",
                    "        if(total==0){",
                    "            refs.termCtn.add({",
                    "                xtype : 'container',",
                    "                width : '90%',",
                    "                height : 350,",
                    "                layout: {",
                    "                     type: 'vbox',",
                    "                     align: 'center'",
                    "                },",
                    "                items :[",
                    "                    {",
                    "                        xtype : 'image',",
                    "                          src : 'resources/images/kls/icon_64_onebiz@2x.png',",
                    "                        margin : '44 0 0 0',",
                    "                        width : 64,",
                    "                        height : 64,",
                    "                    },",
                    "                    {",
                    "                        xtype : 'displayfield',",
                    "                        style : 'font:normal normal normal 16px/24px SF Compact Display; color:#6E6F6F',",
                    "                        html : '검색 결과가 존재하지 않아요',",
                    "                        margin : '0 0 14 0',",
                    "                    },",
                    "                    {",
                    "                        xtype : 'button',",
                    "                        width : '100%',",
                    "                        height : 48,",
                    "                        text: '메인으로',",
                    "                        style : 'background:#939393 0% 0% no-repeat padding-box; border-radius: 4px;font:normal normal bold 18px/27px SF Compact Display; color:#FFFFFF;',",
                    "                    }",
                    "                ]",
                    "            }\t);",
                    "            return;",
                    "        }",
                    "",
                    "        for(var i=0; i<content.length; i++){",
                    "",
                    "            if(content[i].term.indexOf('[')!=-1){",
                    "                kTerm = content[i].term.substr(0,content[i].term.indexOf('[')-1);",
                    "                eTerm = content[i].term.substr(content[i].term.indexOf('['));",
                    "            }",
                    "            else{",
                    "                kTerm = content[i].term;",
                    "                eTerm = '';",
                    "            }",
                    "",
                    "",
                    "            html += '<div style=\"padding:16px;font:normal normal 600 16px/24px SF Compact Display; color:#333333; \">' + kTerm + '<br/><span style=\"font-size:13px; font-weight:normal;color:#666666;\t\">' + eTerm + '</span></div>';",
                    "            html += '<div id=\"' + content[i].id + '\"style=\"line-height:18px;max-height:0px; overflow:hidden; font:normal normal normal 13px/18px SF Compact Display; color:#666666;transition:0.3s;\"><div style=\"padding:17px 16px 16px 16px;\">' + content[i].mean + '</div></div>';",
                    "",
                    "            refs.termCtn.add({",
                    "                xtype: 'container',",
                    "                maxWidth : '600px',",
                    "                minHeight: '70px',",
                    "                html : html,",
                    "                style: 'box-shadow: 0px 4px 10px #0000001A; position:relative;z-index:0;background-color : #FFFFFF; border-radius : 8px;',",
                    "                width: '90%',",
                    "                margin : '0 0 15 0',",
                    "                items : [",
                    "                {",
                    "                    xtype: 'button',",
                    "                    itemId : content[i].id,",
                    "                    width: '100%',",
                    "                    height : '46',",
                    "                    style : 'background-size:100% 100%;background : url(\"/resources/images/icon_fold_down.png\") no-repeat center center;transition:0.3s',",
                    "                    listeners : {",
                    "                        tap : function(button, e, eOpts){",
                    "                                var term = document.getElementById(button.config.itemId);",
                    "                                if(term.style.maxHeight=='0px'){\t// 단어 컨테이너 펼치기",
                    "                                    term.style.maxHeight = '2000px';",
                    "                                    button.el.dom.style.background = 'url(\"/resources/images/icon_fold_up.png\") no-repeat center center';",
                    "                                    button.el.dom.style.height = '46px';",
                    "                                }",
                    "                                else{",
                    "                                    term.style.maxHeight = '0px';   // 단어 컨테이너 접기",
                    "                                    button.el.dom.style.background = 'url(\"/resources/images/icon_fold_down.png\") no-repeat center center';",
                    "                                }",
                    "                                button.blur();",
                    "                        }",
                    "                    }",
                    "                },",
                    "                ],",
                    "            });",
                    "            html = '';",
                    "",
                    "        }",
                    "    }",
                    "});"
                ]
            },
            "configAlternates": {
                "fn": "string",
                "implHandler": "code"
            },
            "name": "onSelect",
