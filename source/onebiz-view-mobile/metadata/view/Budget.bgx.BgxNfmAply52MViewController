        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "BEFORE EVENT를 타는 것처럼 보이지만 제어할 수 없는 부분들이 있어 임의로 FUNCTION을 구현함."
                ],
                "designer|params": [
                    "obj",
                    "fnDoOnSelect"
                ],
                "fn": "onBeforeChangeSearchCnt",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    grid = refs.userGrid;",
                    "",
                    "switch (obj.reference) {",
                    "    case 'bgBudcBsnsId': // 사업부문",
                    "        //계정과목 콤보박스 filtering(계정과목 바뀌는 이벤트는 발생시키지 않음.)",
                    "        me.fnMakeCbxAsnXpnitFilteredByBsns(obj.getValue(), vm.get('expItemInputData.bsnsDt'), true).then(function(){",
                    "            try{",
                    "                //계정과목이 readOnly가 아닐 때",
                    "                if(!refs.xpnitKeyCd.readOnly){",
                    "                    vm.set('BfrBgBudcBsnsIdRec', refs.bgBudcBsnsId.getSelection());",
                    "                    vm.set('BfrXpnitKeyCdRec', refs.xpnitKeyCd.getSelection());",
                    "",
                    "                    fnDoOnSelect(true);",
                    "                }",
                    "",
                    "                //계정과목이 readOnly일 때",
                    "                if(refs.xpnitKeyCd.readOnly){",
                    "                    if(vm.get('BfrXpnitKeyCdRec') && (vm.get('BfrXpnitKeyCdRec.xpnitKeyCd') == refs.xpnitKeyCd.getValue()) ){",
                    "                        //  - 배정O면 select (배정이 있는 계정과목을 필터링 해오므로 해당 계정과목이 직전 선택된 계정과목과 같다면 배정됐다고 볼 수 있음.)",
                    "",
                    "                        //  - 직전 데이터를 세팅해준다.",
                    "                        vm.set('BfrBgBudcBsnsIdRec', refs.bgBudcBsnsId.getSelection());",
                    "                        vm.set('BfrXpnitKeyCdRec', refs.xpnitKeyCd.getSelection());",
                    "",
                    "                        fnDoOnSelect(true);",
                    "                    } else {",
                    "                        //  - 배정X면",
                    "                        //  ::현재 선택한 값을 return false 한 것처럼 되돌려야 하므로 먼저 띄어주고",
                    "                        Ext.Msg.alert('확인', Ext.String.format('[{0}] 계정에 배정받지 못한 [{1}] 사업은 선택할 수 없습니다.'",
                    "                                                              , vm.get('BfrXpnitKeyCdRec.text')",
                    "                                                              , obj.getSelection().get('bsnsNm')));",
                    "",
                    "                        //  :: 직전값으로 모두 되돌려줘야 함.",
                    "                        var oldBsnsRec = vm.get('BfrBgBudcBsnsIdRec') ? vm.get('BfrBgBudcBsnsIdRec.bgBudcBsnsId') : '';",
                    "                        refs.bgBudcBsnsId.suspendEvents();",
                    "                        refs.bgBudcBsnsId.setValue(oldBsnsRec);",
                    "                        refs.bgBudcBsnsId.resumeEvents();",
                    "",
                    "                        //  : 계정과목의 경우 스토어도 다시 세팅해줘야 함.",
                    "                        var oldXpnitKeyCd = vm.get('BfrXpnitKeyCdRec') ? vm.get('BfrXpnitKeyCdRec.xpnitKeyCd') : '';",
                    "                        refs.xpnitKeyCd.setStore(vm.get('BfrXpnitKeyCdStore'));",
                    "                        refs.xpnitKeyCd.suspendEvents();",
                    "                        refs.xpnitKeyCd.setValue(oldXpnitKeyCd);",
                    "                        refs.xpnitKeyCd.resumeEvents();",
                    "",
                    "                        fnDoOnSelect(false);",
                    "                    }",
                    "                }",
                    "            } catch (e) {",
                    "                console.log(e);",
                    "                D.reject(e);",
                    "            }",
                    "",
                    "        });",
                    "        break;",
                    "    case 'xpnitKeyCd' : //계정과목",
                    "        //(사업부문이 무조건 선택돼야 선택할 수 있으므로, 얘가 선택되면 사업부문&계정과목이 모두 있는 거라 select",
                    "        vm.set('BfrXpnitKeyCdRec', refs.xpnitKeyCd.getSelection());",
                    "",
                    "        fnDoOnSelect(true);",
                    "        break;",
                    "}"
                ]
            },
            "configAlternates": {
