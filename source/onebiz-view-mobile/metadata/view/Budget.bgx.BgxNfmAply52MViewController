        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "계정과목을 필터링한다. [DEFFERED]",
                    "회계일자를 기준으로, 해당 사업이 배정받은 계정과목들만 들고 오도록 한다."
                ],
                "designer|params": [
                    "bgBudcBsnsId"
                ],
                "fn": "fnMakeCbxAsnXpnitFilteredByBsns",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    D = new Ext.Deferred();",
                    "",
                    "if(Ext.isEmpty(bgBudcBsnsId)){",
                    "    refs.xpnitKeyCd.getStore().removeAll();",
                    "    return;",
                    "}",
                    "",
                    "var param = {",
                    "    bgBudcBsnsId : bgBudcBsnsId,",
                    "    codeDvcdLists : ['XPNIT_ASN'] //예산과목(배정받은 것)",
                    "};",
                    "me.fnSelectAssignedCodeList(param, true).then(function(codeList){",
                    "    try {",
                    "        var bsnsXpnitCodeList = codeList.xpnitCodeAsnList;",
                    "        var isSelectedValExist = false;",
                    "        for ( var i in bsnsXpnitCodeList) {",
                    "            var bsnsXpnitCodeRec = bsnsXpnitCodeList[i];",
                    "",
                    "            if(refs.xpnitKeyCd.getValue() == bsnsXpnitCodeRec.xpnitKeyCd) {",
                    "                isSelectedValExist = true;",
                    "            }",
                    "        }",
                    "        var currXpnitKeyCd = refs.xpnitKeyCd.getValue();",
                    "        vm.set('BfrXpnitKeyCdStore', refs.xpnitKeyCd.getStore());",
                    "        ComboboxUtils.makeCustomCbx(refs.xpnitKeyCd, bsnsXpnitCodeList, ['text', 'value', 'xpnitKeyCd','bgBudcXpnitYyId']);",
                    "        if(isSelectedValExist){        //이미 선택된 계정과정이 있으면 선택시켜준다(사업부문만 바뀐 거나 마찬가지므로 계정과목 이벤트 동작은 막는다.)",
                    "            refs.xpnitKeyCd.suspendEvents();",
                    "            refs.xpnitKeyCd.setValue(currXpnitKeyCd);",
                    "            refs.xpnitKeyCd.resumeEvents();",
                    "        }",
                    "        D.resolve();",
                    "    } catch (e) {",
                    "        console.log(e);",
                    "        D.reject(e);",
                    "    }",
                    "});",
                    "",
                    "",
                    "return D.promise;",
                    ""
                ]
            },
            "configAlternates": {
                "designer|commentHeader": "comment",
                "designer|params": "typedarray",
                "fn": "string",
                "implHandler": "code"
            },
            "name": "fnMakeCbxAsnXpnitFilteredByBsns",
            "designerId": "86ec1b8e-60a9-4940-9e30-2bd41727d7a2"
        },
