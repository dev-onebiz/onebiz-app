                ],
                "fn": "timeDiff",
                "implHandler": [
                    "var endH = endTm.substr(0,2);",
                    "var endM = endTm.substr(2,2);",
                    "var startH = startTm.substr(0,2);",
                    "var startM = startTm.substr(2,2);",
                    "if(endM < startM){",
                    "    endM = Number(endM)+60;",
                    "    endH -= 1;",
                    "}",
                    "return (endH-startH) + (((endM-startM))/60*10).toFixed(1)/10;"
                ]
            },
