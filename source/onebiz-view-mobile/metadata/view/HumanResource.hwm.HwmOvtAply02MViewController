            "userConfig": {
                "designer|commentHeader": [
                    "유효성 검증"
                ],
                "designer|params": [
                    "formData"
                ],
                "fn": "formValid",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    reNo = /[^\\d]/,",
                    "    errMsg = '';",
                    "",
                    "// 기본검증",
                    "var form = refs.frmDetail,",
                    "    fields = form.getFields();",
                    "if(!form.validate()) {",
                    "    for(var i in fields) {",
                    "        var field = fields[i];",
                    "        if (!Ext.isArray(field) && field.name != 'null' && !field.isValid()) {",
                    "            var oriMsg = field.getErrorMessage(),",
                    "                fieldLabel = field.config.label;",
                    "",
                    "            if (oriMsg.indexOf('This field is required') != -1) {\t\t\t\t// 필수값 누락",
                    "                errMsg += '- ' + fieldLabel + ' 을(를) 입력해주세요.<br>';",
                    "            } else if(oriMsg.indexOf('Is in the wrong format') != -1){\t\t\t// 포맷 오류",
                    "                errMsg += '- ' + fieldLabel + ' 입력값형식이 잘못되었습니다.<br>';",
                    "            } else if (errMsg.indexOf('- 입력값을 확인해주세요.<br>') == -1) {",
                    "                errMsg += '- 입력값을 확인해주세요.<br>';",
                    "            }",
                    "        }",
                    "    }",
                    "}",
                    "",
                    "// date",
                    "if(!formData.aplOvtStrdt){",
                    "    errMsg += '- 시작일을 입력 하여주세요<br>';",
                    "}",
                    "if(!formData.aplOvtStrtm){",
                    "    errMsg += '- 시작시간을 입력해주세요.<br>';",
                    "}",
                    "if(!formData.aplOvtEdt){",
                    "    errMsg += '- 종료일을 입력해주세요.<br>';",
                    "}",
                    "if(!formData.aplOvtEdtm){",
                    "    errMsg += '- 종료시간을 입력해주세요.<br>';",
                    "}",
                    "if (formData.aplOvtStrdt && formData.aplOvtStrtm && formData.aplOvtEdt && formData.aplOvtEdtm) {",
                    "    // ms로 계산",
                    "    var oneMm = 1000 * 60,",
                    "        oneHr = oneMm * 60,",
                    "        aplOvtStrtm = formData.aplOvtStrtm,",
                    "        aplOvtEdtm = formData.aplOvtEdtm,",
                    "        cvtStrtm = (aplOvtStrtm.substr(0,2) * oneHr) + (aplOvtStrtm.substr(2,2) * oneMm),",
                    "        cvtEdtm = (aplOvtEdtm.substr(0,2) * oneHr) + (aplOvtEdtm.substr(2,2) * oneMm);",
                    "    ",
                    "//     if (cvtStrtm > cvtEdtm) {",
                    "//         errMsg += '- 시작일시는 종료일시보다 클 수 없습니다. <br>';",
                    "//     }",
                    "    ",
                    "    if (formData.aplOvtStrdt + formData.aplOvtStrtm > formData.aplOvtEdt + formData.aplOvtEdtm) {",
                    "        errMsg += '- 시작일시는 종료일시보다 클 수 없습니다. <br>';",
                    "    }",
                    "}",
                    "",
                    "// 사유",
                    "if(formData.aplCntn && formData.aplCntn.length < 50){",
                    "    errMsg += '- 사유를 50자 이상 입력해주세요.<br>';",
                    "}",
                    "",
                    "// 결재선",
                    "if(!formData.applyLine && formData.aplDvcd == Constants.aplDvcd.APPLY){",
                    "    errMsg += '- 결재선을 선택해주세요.';",
                    "}",
                    "",
                    "return errMsg;"
                ]
            },
