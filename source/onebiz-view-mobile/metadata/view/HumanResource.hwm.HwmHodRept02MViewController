                    "afterchange.aplDt = DateUtils.getDate(new Date());",
                    "",
                    "Ext.Ajax.request({",
                    "    headers : {",
                    "        serviceId : 'HwmHodSvc.findAllHwmHodRept',",
                    "        viewId : me.getViewId(),",
                    "        scope : me",
                    "    },",
                    "    jsonData : afterchange,",
                    "    success : function(response) {",
                    "        var res = Ext.JSON.decode(response.responseText);",
                    "        if (res.errMsg != null) {",
                    "            Ext.Msg.alert(\"안내\", res.errMsg);",
                    "            return;",
                    "        }",
