        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "유효성 검증"
                ],
                "designer|params": [
                    "formData"
                ],
                "fn": "formValid",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    reNo = /[^\\d]/,",
                    "    errMsg = '';",
                    "",
                    "// 기본검증",
                    "var form = refs.frmDetail,",
                    "    fields = form.getFields();",
                    "if(!form.validate()) {",
                    "    for(var i in fields) {",
                    "        var field = fields[i];",
                    "        if (!Ext.isArray(field) && field.name != 'null' && !field.isValid()) {",
                    "            var oriMsg = field.getErrorMessage(),",
                    "                fieldLabel = field.config.label;",
                    "",
                    "            if (oriMsg.indexOf('This field is required') != -1) {\t\t\t\t// 필수값 누락",
                    "                errMsg += '- ' + fieldLabel + ' 을(를) 입력해주세요.<br>';",
                    "            } else if(oriMsg.indexOf('Is in the wrong format') != -1){\t\t\t// 포맷 오류",
                    "                errMsg += '- ' + fieldLabel + ' 입력값형식이 잘못되었습니다.<br>';",
                    "            } else if (errMsg.indexOf('- 입력값을 확인해주세요.<br>') == -1) {",
                    "                errMsg += '- 입력값을 확인해주세요.<br>';",
                    "            }",
                    "        }",
                    "    }",
                    "}",
                    "",
                    "// date",
                    "if(!formData.wrkStrdt){",
                    "    errMsg += '- 출근일을 확인해주세요<br>';",
                    "}",
                    "if(!formData.wrkStrtm){",
                    "    errMsg += '- 출근시간을 확인해주세요.<br>';",
                    "}",
                    "if(!formData.wrkEdt){",
                    "    errMsg += '- 퇴근일을 확인해주세요.<br>';",
                    "}",
                    "if(!formData.wrkEdtm){",
                    "    errMsg += '- 퇴근시간을 확인해주세요.<br>';",
                    "}",
                    "",
                    "// 사유",
                    "if(formData.reptCntn && formData.reptCntn.length < 50){",
                    "    errMsg += '- 사유를 50자 이상 입력해주세요.<br>';",
                    "}",
                    "",
                    "// 결재선",
                    "if(!formData.applyLine && formData.aplDvcd == Constants.aplDvcd.APPLY){",
                    "    errMsg += '- 결재선을 선택해주세요.';",
                    "}",
                    "",
                    "return errMsg;",
                    "",
                    ""
                ]
            },
