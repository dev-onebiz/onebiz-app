                    "",
                    "if (config) {",
                    "    vm.set('codeList', config.codeList);",
                    "    vm.set('applyInfo', config.applyInfo);",
                    "    vm.set('readOnlyFlag', config.readOnlyFlag);",
                    "    var expItemData = config.expItemData;",
