            "userConfig": {
                "designer|commentHeader": [
                    "초기화"
                ],
                "fn": "onContainerInitialize",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    approvalLineGrid = refs.approvalLineGrid, \t// 결재선",
                    "    afterchangeform = refs.detailForm,",
                    "    initialConfig = component.config, \t\t\t// 화면초기데이터",
                    "    aprHistId = initialConfig.aprHistId, \t\t// 결재내역ID",
                    "    command = initialConfig.command,",
                    "    aprHistData = initialConfig.aprHistData, \t// 결재이력데이터",
                    "    // 결재함(ExpNteApr02)에서는 docData,",
                    "    // 연수보고(HrdCrsInfo01)에서는 aprHistData.docData",
                    "    docData = (aprHistData) ? aprHistData.docData : initialConfig.docData, \t\t\t\t// 문서데이터",
                    "    afterchange = docData.afterchange,",
                    "    record = initialConfig.record, \t\t\t\t// 결재함 목록에서 선택한 레코드",
                    "    edocCd = 'HrdCrsAply71',\t\t\t\t\t// 문서코드",
                    "    edocNm = '연수신청서',",
                    "    userId = SecurityUtils.getPrincipal().hrHrpmEmpId, // 사용자ID",
                    "    grid = refs.detailGrid;",
                    "",
                    "",
                    "vm.set('docCd', edocCd);",
                    "vm.set('docNm', edocNm);",
                    "vm.set('aprHistId', aprHistId);",
                    "vm.set('record', record);",
                    "vm.set('command', command);",
                    "vm.set('docData', docData);",
                    "",
                    "me.setAprHistId(aprHistId); // 결재이력아이디",
                    "me.setRecord(record); // 동시성 제어를 하기 위한 용도로 Config에 저장함",
                    "me.setCommand(command); // 결재처리 커맨드",
                    "",
                    "",
                    "// 결재문서 초기화 설정",
                    "ApprovalBoxSvc.setup({",
                    "    command : command, \t\t// 결재선구분커맨드",
                    "    viewModel : vm,",
                    "    edocCd : edocCd, \t\t// 전자문서관리화면에 설정된 문서코드: 화면ID를 사용",
                    "    aprHistId : aprHistId, \t// 결재이력ID",
                    "    scope : me",
                    "});",
                    "",
                    "afterchange[0].sttnStrdtHiphone = DateUtils.parseDate(afterchange[0].sttnStrdt).substr(0,10);",
                    "afterchange[0].sttnEdtHiphone = DateUtils.parseDate(afterchange[0].sttnEdt).substr(0,10);",
                    "vm.set('detail', afterchange[0]);",
                    "afterchangeform.setValues(vm.get('detail'));",
                    "vm.set('afterchange', afterchange);\t\t\t\t// formData",
                    "",
                    "var rgdt = (aprHistData) ? record.sttnAplDt : record.fstRgDtti;\t\t// 연수보고(sttnAplDt) , 결재함(fstRgDtti)",
                    "refs.rgdt.setHtml(DateUtils.parseDate(rgdt).substr(0,10));",
                    "",
                    "grid.el.select('.x-headercontainer').setStyle('height',\t'0px');",
                    "grid.setData(afterchange);\t\t\t\t\t\t// gridData"
                ],
                "name": "initialize",
                "scope": "me"
            },
