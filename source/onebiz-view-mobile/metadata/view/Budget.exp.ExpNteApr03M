            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "초기화"
                ],
                "fn": "initialize",
                "implHandler": [
                    "var me = this,",
                    "    refs = me.getReferences(),",
                    "    vm = me.getViewModel(),",
                    "    searchYear = refs.searchYear,",
                    "    vwId = refs.vwId,",
                    "    searchVwIdStore = component.initialConfig.searchVwIdStore, // 검색조건 : 결재문서명",
                    "    command = component.command;  ",
                    "",
                    "vm.set('command', command);",
                    "",
                    "searchYear.setValue(component.initialConfig.searchYear);",
                    "vwId.setStore(searchVwIdStore);",
                    ""
                ],
