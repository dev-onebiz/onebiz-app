                    "name": "MyNumberField",
                    "designerId": "14e8036c-a069-42d4-a5f9-dffa212208d7",
                    "cn": [
                        {
                            "type": "viewcontrollereventbinding",
                            "reference": {
                                "name": "listeners",
                                "type": "array"
                            },
                            "codeClass": null,
                            "userConfig": {
                                "designer|commentHeader": [
                                    "조회일자 변경시 해당연도에 존재하는 결재 문서 리스트 가져오기"
                                ],
                                "fn": "onSearchYearChange",
                                "implHandler": [
                                    "",
                                    "if(newValue.toString().length == 4){",
                                    "    var me = this,",
                                    "    vm = me.getViewModel(),",
                                    "    refs = me.getReferences(),",
                                    "    command = vm.get('command'),",
                                    "    vwId = refs.vwId,",
                                    "    searchVwIdStore = vwId.getStore();",
                                    "    data = {",
                                    "        command : command,",
                                    "        searchYear : newValue",
                                    "    };",
                                    "",
                                    "    if(command == Constants.sanction.DEPT_COMPLETED_BOX){ // 부서완료함인 경우 부서구분 포함",
                                    "        data.dpDvcdNm = '부서';",
                                    "    }",
                                    "",
                                    "    // 조회문서 데이터 초기화",
                                    "    searchVwIdStore.removeAll();",
                                    "",
                                    "    Ext.Ajax.request({",
                                    "        headers : {",
                                    "            serviceId : 'COMAPR0001R03M'",
                                    "        },",
                                    "        jsonData:data,",
                                    "        success : function(response, scope) {",
                                    "            // 결재 조회 조건을 리스트에 있는 것들만으로 전달",
                                    "            var res = JSON.parse(response.responseText);",
                                    "            var edocCodeList = res.edocCodeList;",
                                    "",
                                    "            for (var i in edocCodeList) {",
                                    "                var record = {",
                                    "                    text : edocCodeList[i].edocNm,",
                                    "                    value : edocCodeList[i].edocCd",
                                    "                };",
                                    "                searchVwIdStore.add(record);",
                                    "            }",
                                    "        },",
                                    "        failure : function(response){",
                                    "            Ext.Msg.alert('오류', '조회문서를 가져오는 도중 오류가 발생했습니다.');",
                                    "        }",
                                    "    });",
                                    "}",
                                    ""
                                ],
                                "name": "change",
                                "scope": "me"
                            },
                            "configAlternates": {
                                "designer|commentHeader": "comment",
                                "fn": "string",
                                "implHandler": "code",
                                "name": "string",
                                "scope": "string"
                            },
                            "name": "onSearchYearChange",
                            "designerId": "774178c0-a560-421e-8ba8-fabde27c8dd2"
                        }
                    ]
