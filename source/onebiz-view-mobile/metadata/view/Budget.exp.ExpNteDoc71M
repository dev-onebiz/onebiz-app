            "",
            "@author BNK시스템/계장/김정균",
            "@since 2019.04.16",
            "@version 1.0",
            "@see",
            "",
            "<< 개정이력(Modification Information) >>",
            "",
            "수정일\t\t  수정자                수정내용",
            "----------\t------------------   --------------------------",
            "2019.04.16\tBNK시스템/계장/김정균   최초 생성"
        ],
        "designer|extend": "Ext.window.Window",
        "designer|userAlias": "ExpNteDoc71M",
        "designer|userClassName": "Budget.exp.ExpNteDoc71M",
        "height": "98%",
        "layout": "vbox",
        "scrollable": "both",
        "width": "98%"
    },
