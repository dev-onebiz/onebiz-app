            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "신청 전 유효성 검사"
                ],
                "fn": "validateOnApply",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    D = new Ext.Deferred(),",
                    "    record = vm.get('detail');\t\t//연수과정신청 데이터",
                    "",
                    "var param = {",
                    "    hrHrpmCompId : SecurityUtils.getPrincipal().hrHrpmCompId,",
                    "    hrHrpmEmpId : SecurityUtils.getPrincipal().hrHrpmEmpId,",
                    "    hrHrdcStnCrsId : record.hrHrdcStnCrsId,",
                    "};",
                    "",
                    "//동일과목신청한 적이 있는지 확인한다.",
                    "Ext.Ajax.request({",
                    "    headers : {",
                    "        serviceId : 'HrdCrsSvc.findDupHrdCrsWithAply',",
                    "        viewId : me.getViewId(),",
                    "        scope : me",
                    "    },",
                    "    jsonData : param,",
                    "    success : function(response) {",
                    "        var res = Ext.JSON.decode(response.responseText);",
                    "        if (res.dupHrdCrsCmp.length < 1) { //중복신청된 게 없다면 다음 로직으로",
                    "            D.resolve(true);",
                    "            return;",
                    "        }",
                    "",
                    "        var dts = '';",
                    "        for ( var i in res.dupHrdCrsCmp) {",
                    "            var dupHrdCrsCmp = res.dupHrdCrsCmp[i];",
                    "            var strdtFmt = DateUtils.parseDate(dupHrdCrsCmp.sttnStrdt);",
                    "            var edtFmt = DateUtils.parseDate(dupHrdCrsCmp.sttnEdt);",
                    "",
                    "            if (dts.length == 0) {",
                    "                dts = Ext.String.format('{0}~{1}', strdtFmt, edtFmt);",
                    "                continue;",
                    "            }",
                    "",
                    "            dts += ', ' + Ext.String.format('{0}~{1}', strdtFmt, edtFmt);",
                    "        }",
                    "        var errMsg = Ext.String.format('동일한 과정을 이수한 적이 있어,<br />재수강 시 점수 반영이 되지 않을 수 있습니다.<br />계속 하시겠습니까?<br /><br />(수료한 연수기간: {0})', dts);",
                    "",
                    "        Ext.Msg.confirm('확인', errMsg, function(btn) {",
                    "            switch (btn) {",
                    "                case 'yes':",
                    "                    D.resolve(true);",
                    "                    break;",
                    "                default:",
                    "                    D.reject();",
                    "                    break;",
                    "            }",
                    "        });",
                    "",
                    "    },",
                    "    failure : function(res, scope) {",
                    "        D.reject();",
                    "    }",
                    "});",
                    "",
                    "return D.promise;"
                ]
            },
            "configAlternates": {
                "designer|commentHeader": "comment",
                "fn": "string",
                "implHandler": "code"
            },
            "name": "validateOnApply",
            "designerId": "d6f80625-3c49-404b-912f-eb3cb8413546"
