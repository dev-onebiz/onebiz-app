                "fn": "fnSetDetailInfo",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    data = vm.get('detail'),",
                    "    keyArr = Object.keys(data),",
                    "    skipKeys = [ 'rn', 'id', 'hrHrpmCompId' ];",
                    "",
                    "for ( var j in keyArr) {",
                    "    var key = keyArr[j];",
                    "    if (skipKeys.indexOf(key) > -1) {",
                    "        continue;",
                    "    }",
                    "    targetData[key] = data[key];",
                    "}",
                    "",
                    "return targetData;"
                ]
            },
