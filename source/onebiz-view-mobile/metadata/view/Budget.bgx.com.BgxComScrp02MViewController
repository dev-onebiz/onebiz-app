        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "조회"
                ],
                "fn": "onSelect",
                "implHandler": [
                    "var me = this,",
                    "    vm = me.getViewModel(),",
                    "    refs = me.getReferences(),",
                    "    data = vm.get('initData'),",
                    "    params = {",
                    "        aplEmpId : data.aplEmpId,",
                    "        dlngYn : data.dlngYn,",
                    "        fudcYn : data.fudcYn,",
                    "        onlyScrpTab : 'csh'",
                    "    },",
                    "    store = vm.storeInfo.CshRctStore,",
                    "    dateCnt = refs.date_container,",
                    "    dateCntCtrl = dateCnt.controller,",
                    "    strdt = dateCnt.refs.strdt,",
                    "    edt = dateCnt.refs.edt,",
                    "    aprno = refs.txtAprNo;",
                    "",
                    "// 조회기간",
                    "var result = dateCntCtrl.dateValid();",
                    "if (result != '') {",
                    "    Ext.Msg.alert('알림', result);",
                    "    return;",
                    "} else {",
                    "    if (strdt.getValue() < data.strdt || edt.getValue() > data.edt) {",
                    "        // [이가영] : bsnsYy년의 1월 1일 부터 12월 31일까지만 신청가능하도록 해야한다.",
                    "        me.showAlert(DateUtils.parseDate(data.strdt) + ' ~ ' + DateUtils.parseDate(data.edt) + ' 사이만 조회가능합니다.');",
                    "        strdt.setValue(data.strdt);",
                    "        edt.setValue(data.edt);",
                    "        me.onSelect();",
                    "        return;",
                    "    }",
                    "",
                    "    params.tStrdt = Ext.Date.format(strdt.getValue(), 'Ymd');",
                    "    params.tEdt = Ext.Date.format(edt.getValue(), 'Ymd');",
                    "}",
                    "",
                    "// 승인번호",
                    "if (aprno && aprno.getValue()) {",
                    "    params.aprno = aprno.getValue();",
                    "}",
                    "",
                    "store.getProxy().extraParams = params;",
                    "store.removeAll();",
                    "store.loadPage(1);"
                ]
            },
            "configAlternates": {
