        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "어플리케이션 데이터 초기화"
                ],
                "designer|params": [
                    "data"
                ],
                "fn": "INIT_APPLICATION_DATA",
                "implHandler": [
                    "// 메뉴스토어 데이터설정",
                    "var menus = data.menus;",
                    "var menuStore = Ext.StoreMgr.get('MenuStore');",
                    "var menuRoot = menuStore.getRoot();",
                    "menuRoot.removeAll();",
                    "if (menus && menus.children) {",
                    "\tfor ( var i in menus.children) {",
                    "\t\tmenuRoot.appendChild(menus.children[i]);",
                    "\t}",
                    "}",
                    "",
                    "// 코드스토어 데이터설정",
                    "var codes = data.codes;",
                    "var codeStore = Ext.StoreMgr.get('CodeStore');",
                    "var codeRoot = codeStore.getRoot();",
                    "codeRoot.removeAll();",
                    "if (codes && codes.children) {",
                    "\tfor ( var j in codes.children) {",
                    "\t\tcodeRoot.appendChild(codes.children[j]);",
                    "\t}",
                    "}",
                    "",
                    "",
                    "// 메시지스토어 데이터설정",
                    "var messages = data.messages;",
                    "if (messages) {",
                    "",
                    "    var messageStore = Ext.StoreMgr.get('MessageStore');",
                    "",
                    "    if(messageStore.getData().length > 0){",
                    "        messageStore.removeAll();",
                    "    }",
                    "",
                    "\tfor (let i in messages) {",
                    "\t\tmessageStore.add({",
                    "\t\t\tcode : messages[i].code,",
                    "\t\t\ttext : messages[i].text",
                    "\t\t});",
                    "\t}",
                    "}",
                    "",
                    "// 프로퍼티데이터",
                    "var properties = data.properties;",
                    "if (properties) {",
                    "    var propertyStore = Ext.StoreMgr.get('PropertyStore');",
                    "    ",
                    "    if(propertyStore.getData().length > 0){",
                    "        propertyStore.removeAll();",
                    "    }",
                    "",
                    "    for ( var i in properties) {",
                    "        propertyStore.add({",
                    "            property : properties[i].property,",
                    "            text : properties[i].text",
                    "        });",
                    "    }",
                    "}",
                    "",
                    "// 모바일버전과 관리자사이트의 프로퍼티설정 중 모바일버전 정보가 상이할 경우, 업데이트 메시지 표시",
                    "Property.MOBILE_SERVER_VERSION = data.version;"
                ]
            },
