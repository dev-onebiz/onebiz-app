            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "코드목록조회",
                    "",
                    "관리자사이트의 코드관리가 아닌 테이블 조회로 코드성 데이터를 사용하는 경우의 처리"
                ],
                "designer|params": [
                    "jsonData",
                    "scope"
                ],
                "fn": "GET_CODELIST",
                "implHandler": [
                    "// Deferred 성공시 resolve 처리, 실패시 reject 처리",
                    "var D = new Ext.Deferred();",
                    "",
                    "Ext.Ajax.request({",
                    "\theaders: {",
                    "\t\tviewId: this.getViewId(),",
                    "\t\tserviceId: 'BizComSvc.findOneCodelistM'",
                    "\t},",
                    "\tjsonData : jsonData,",
                    "\tscope : scope,",
                    "\tsuccess : function(res) {",
                    "\t\tvar responseJson = Ext.JSON.decode(res.responseText);",
                    "",
                    "\t\tD.resolve({",
                    "\t\t\tdata : responseJson.result,",
                    "\t\t\tscope : this",
                    "\t\t});",
                    "\t},",
                    "\tfailure: function(response, opts) {",
                    "\t\tD.reject(this);",
                    "\t}",
                    "});",
                    "",
                    "return D.promise;"
                ]
            },
            "configAlternates": {
