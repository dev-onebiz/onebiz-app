        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "메인 NavigationView 에 화면을 PUSH시킨다"
                ],
                "designer|params": [
                    "naviView",
                    "jsonData"
                ],
                "fn": "PUSH_VIEW",
                "implHandler": [
                    "// 2019-07-26/손승범 : 화면스택을 쌓은 뒤 처리하면 오류가 발생하여, 부득이하게 화면전환시마다 pop 한 뒤에 navigation view 에 push 처리하였음.",
                    "// 2019-07-26/손승범 : 서브화면에서 메인화면 객체참조하는 경우에, 메인화면을 pop 시키는 경우, 오류가 발생하여 isSubView 옵션을 추가함",
                    "if (!(jsonData.hasOwnProperty('isSubView') && jsonData.isSubView)) {",
                    "",
                    "    naviView.pop(naviView.innerItems.length - 1);",
                    "}",
                    "",
                    "var me = this,",
                    "\tmenuId = jsonData.menuId,",
                    "\ttitle = jsonData.title,",
                    "\tclassName = me.GET_CLASS_NAME(menuId),",
                    "\titem;",
                    "",
                    "if (Property.IS_DEBUG) console.log('메뉴선택: ', jsonData);",
                    "",
                    "//메뉴아이디 누락인 경우",
                    "if(!menuId){",
                    "    alert('메뉴아이디 값이 누락되었습니다.');",
                    "    return;",
                    "}",
                    "",
                    "var menu = null;",
                    "var menuStore = Ext.StoreMgr.get('MenuStore').byIdMap;",
                    "for(var key in menuStore){",
                    "    if(!Ext.isEmpty(menuStore[key].data) && menuStore[key].data.menuId == menuId){",
                    "        title = menuStore[key].data.text.replace('- ', '');",
                    "        break;",
                    "    }",
                    "}",
                    "",
                    "if(!title){ //메뉴에 대한 정보가 없을 경우 입력 받은 title 값 사용",
                    "    alert('타이틀 값이 누락되었습니다.');",
                    "    return;",
                    "}",
                    "",
                    "jsonData.title = title;",
                    "",
                    "",
                    "// 기존 등록된 화면의 메뉴아이디와 타이틀을 체크함",
                    "if (naviView.child('component[menuId=' + menuId + ']') && naviView.child('component[title=' + title + ']')) {",
                    "\titem = naviView.child('component[menuId=' + menuId + ']');",
                    "}",
                    "",
                    "// 클래스가 존재하지 않는 경우, 404 화면 표시함",
                    "if (!className) {",
                    "\tmenuId = 'Error404';",
                    "\titem = naviView.child('component[menuId=' + menuId + ']');",
                    "}",
                    "",
                    "if (!item) {",
                    "\tjsonData.xtype = menuId; // menuId 를 xtype으로 사용함",
                    "\tnaviView.push(jsonData);",
                    "}",
                    "else {",
                    "\tnaviView.setActiveItem(item);",
                    "}"
                ]
            },
            "configAlternates": {
                "designer|commentHeader": "comment",
                "designer|params": "typedarray",
                "fn": "string",
                "implHandler": "code"
            },
            "name": "PUSH_VIEW",
            "designerId": "ad51c3cb-eaf4-4d8e-b36e-8026ac12d725"
