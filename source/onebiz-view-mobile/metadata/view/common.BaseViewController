        {
            "type": "basicfunction",
            "reference": {
                "name": "items",
                "type": "array"
            },
            "codeClass": null,
            "userConfig": {
                "designer|commentHeader": [
                    "응답값 공통처리",
                    "",
                    "Application 에 정의되어 있는 예외처리와 같게 처리할 것!!!"
                ],
                "designer|params": [
                    "response",
                    "options"
                ],
                "fn": "HANDLE_RESPONSE_FAILURE",
                "implHandler": [
                    "Ext.Viewport.setMasked(false);",
                    "",
                    "var error = response.status + ' - ' + response.statusText,",
                    "\tstatus = response.status,",
                    "\tresponseJson = null,",
                    "\terrCode = null,",
                    "\terrTitle = null,",
                    "\terrMsg = null,",
                    "\tmessage = null,",
                    "\tmoreInfo = null;",
                    "",
                    "if (Property.IS_DEBUG) {",
                    "\tconsole.log('서버요청오류 : ', response);",
                    "}",
                    "",
                    "switch (status) {",
                    "    case 0: // 서버 접속이 안될경우, 0 이 반환되어 대응처리함",
                    "    case 404:",
                    "        Ext.create(Property.ROUTE_LOGIN, {fullscreen: true});",
                    "        Ext.Msg.alert(Property.SYSTEM_NAME, '서버와 연결이 원활하지 않습니다.<br />인터넷 연결 상태를 확인하고 다시 시도해주시길 바랍니다.');",
                    "        break;",
                    "    case 400:",
                    "        errCode = 'E5000';",
                    "        errTitle = '입력값검증에러';",
                    "        errMsg = '입력값 검증처리중 에러가 발생하였습니다.';",
                    "",
                    "        if (response.hasOwnProperty('responseText') && response.responseText.length > 0) {",
                    "            responseJson = Ext.JSON.decode(response.responseText);",
                    "            if (responseJson.hasOwnProperty('code'))     errCode = responseJson.code;",
                    "            if (responseJson.hasOwnProperty('errTitle')) errTitle = responseJson.errTitle;",
                    "            if (responseJson.hasOwnProperty('errMsg'))   errMsg = responseJson.errMsg;",
                    "            if (responseJson.hasOwnProperty('moreInfo')) moreInfo = responseJson.moreInfo; if (Property.profile !== 'P' && Property.IS_DEBUG) console.log('오류상세내역: ', responseJson.moreInfo);",
                    "        }",
                    "",
                    "        Ext.Msg.alert(Property.SYSTEM_NAME, Ext.String.format('<strong>{0} [{1}]</strong><br /><br />{2}', errTitle, errCode, errMsg));",
                    "        break;",
                    "    case 401:",
                    "        errCode = 'E9500';",
                    "        errTitle = '인증오류';",
                    "        errMsg = '인증 처리중 에러가 발생하였습니다.';",
                    "",
                    "        try {",
                    "            var existResponseJson = false;",
                    "            if (response.hasOwnProperty('responseJson') && JsonUtils.isJson(response.responseJson)) {",
                    "                responseJson = response.responseJson;",
                    "                existResponseJson = true;",
                    "            }",
                    "            else if (response.hasOwnProperty('responseText') && response.responseText.length > 0) {",
                    "                responseJson = Ext.JSON.decode(response.responseText);",
                    "                existResponseJson = true;",
                    "            }",
                    "",
                    "            if (existResponseJson) {",
                    "                if (responseJson.hasOwnProperty('code'))     errCode = responseJson.code;",
                    "                if (responseJson.hasOwnProperty('errTitle')) errTitle = responseJson.errTitle;",
                    "                if (responseJson.hasOwnProperty('errMsg'))   errMsg = responseJson.errMsg;",
                    "                if (responseJson.hasOwnProperty('moreInfo')) moreInfo = responseJson.moreInfo; if (Property.profile !== 'P' && Property.IS_DEBUG) console.log('오류상세내역: ', responseJson.moreInfo);",
                    "",
                    "                //세션시간만료일 경우 세션시간을 확인하여 시간을 표시하도록 로직 추가해줌 MS202107121327",
                    "                if (errCode == 'E9514') {",
                    "                    var iat = SecurityUtils.getJwt().iat; //세션시작",
                    "                    var exp = parseInt(SecurityUtils.getJwt().exp + '000'); //세션종료",
                    "                    var min = Math.floor((exp - iat)/(1000*60)) + 1;",
                    "                    var sec = Math.ceil((exp - iat)/(1000)); //초",
                    "",
                    "                    errMsg = (min < 1) ? \"\" :  min + \"분 \";",
                    "                    errMsg += \"동안 서비스 이용이 없어<br>안전한 개인정보 보호를 위해 로그아웃 되었습니다.\";",
                    "                }",
                    "            }",
                    "        }",
                    "        catch(e) {",
                    "            if (response.responseText && response.responseText.length > 0) errMsg = response.responseText;",
                    "        }",
                    "",
                    "        Ext.create(Property.ROUTE_LOGIN, {fullscreen: true});",
                    "        Ext.Msg.alert(Property.SYSTEM_NAME, Ext.String.format('<strong>{0} [{1}]</strong><br /><br />{2}', errTitle, errCode, errMsg));",
                    "        break;",
                    "    case 500:",
                    "        errCode = 'E9000';",
                    "        errTitle = '시스템오류';",
                    "        errMsg = '이용에 불편을 드려 죄송합니다.';",
                    "",
                    "        if (response.hasOwnProperty('responseText') && response.responseText.length > 0) {",
                    "            responseJson = Ext.JSON.decode(response.responseText);",
                    "            if (responseJson.hasOwnProperty('code'))     errCode = responseJson.code;",
                    "            if (responseJson.hasOwnProperty('errTitle')) errTitle = responseJson.errTitle;",
                    "            if (responseJson.hasOwnProperty('errMsg'))   errMsg = responseJson.errMsg;",
                    "            if (responseJson.hasOwnProperty('moreInfo')) moreInfo = responseJson.moreInfo; if (Property.profile !== 'P' && Property.IS_DEBUG) console.log('오류상세내역: ', responseJson.moreInfo);",
                    "        }",
                    "",
                    "        if (errCode.startsWith('E9')) {",
                    "            Ext.create(Property.ROUTE_LOGIN, {fullscreen: true});",
                    "        }",
                    "",
                    "        Ext.Msg.alert(Property.SYSTEM_NAME, Ext.String.format('<strong>{0} [{1}]</strong><br /><br />{2}', errTitle, errCode, errMsg));",
                    "        break;",
                    "     case -1:",
                    "        if (response.statusText) {",
                    "            var errorData = response.statusText;",
                    "            console.log('Ajax request Error: ', response.status);",
                    "            console.log('ajax req error: ', errorData);",
                    "        }",
                    "        break;",
                    "    default:",
                    "        if (response.statusText) {",
                    "            if (response.status != 200) {",
                    "                var errorData = Ext.JSON.decode(response.responseText);",
                    "                console.log('Ajax request Error: ', response.status);",
                    "                console.log('ajax req error: ', errorData);",
                    "            }",
                    "        }",
                    "        break;",
                    "}"
                ]
            },
